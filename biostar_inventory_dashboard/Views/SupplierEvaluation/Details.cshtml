@{
    ViewData["Title"] = "Supplier Evaluation Details";
    var evaluationId = ViewBag.EvaluationId;
}

<style>
    .spe-page-header {
        border-left: 4px solid #0d6efd;
        padding-left: 12px;
    }

    .spe-card {
        border: 0;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }

    .spe-label {
        color: #6c757d;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .spe-value {
        margin-top: 4px;
        font-size: .95rem;
        font-weight: 600;
    }

    .score-card {
        border: 0;
        border-radius: 9px;
        height: 100%;
    }

    .score-quality {
        background: #f8dede;
    }

    .score-delivery {
        background: #fff0c7;
    }

    .score-cost {
        background: #dcebd9;
    }

    .score-reliability {
        background: #e6def3;
    }

    .score-title {
        font-size: .78rem;
        font-weight: 700;
    }

    .score-value {
        margin-top: 8px;
        font-size: 1.35rem;
        font-weight: 700;
    }

    .overall-score {
        font-size: 1.7rem;
        font-weight: 700;
        color: #0d6efd;
    }

    .evaluation-line-table {
        font-size: .78rem;
        white-space: nowrap;
    }

        .evaluation-line-table thead th {
            background: #f8f9fa;
            font-size: .68rem;
            text-transform: uppercase;
            vertical-align: middle;
        }

    .reliability-input {
        min-width: 80px;
    }

    .price-down {
        color: #198754;
        font-weight: 700;
    }

    .price-up {
        color: #dc3545;
        font-weight: 700;
    }

    .price-same {
        color: #6c757d;
        font-weight: 700;
    }

    .workflow-item {
        border-left: 2px solid #dee2e6;
        padding-left: 15px;
        margin-left: 5px;
        padding-bottom: 15px;
    }
</style>


<div class="container-fluid px-4 py-4">

    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">

        <div class="spe-page-header">

            <div class="text-muted small">
                Purchasing &gt; Supplier Evaluation &gt; Details
            </div>

            <h4 id="pageTitle" class="mb-0">
                Supplier Performance Evaluation
            </h4>

            <div class="text-muted small">
                Delivery-based supplier performance evaluation.
            </div>

        </div>


        <div class="d-flex gap-2">

            <a href="/purchasing/supplier-evaluation"
               class="btn btn-outline-secondary btn-sm">

                <i class="bi bi-arrow-left"></i>
                Back

            </a>


            <button id="btnFinalize"
                    type="button"
                    class="btn btn-dark btn-sm d-none">

                <i class="bi bi-check-circle me-1"></i>
                Finalize

            </button>

        </div>

    </div>


    <div id="pageAlert"
         class="alert alert-danger d-none">
    </div>


    <div id="pageSuccess"
         class="alert alert-success d-none">
    </div>


    <!-- LOADING -->
    <div id="loadingPanel"
         class="card spe-card">

        <div class="card-body text-center text-muted py-5">

            <div class="spinner-border spinner-border-sm me-2"></div>
            Loading supplier evaluation...

        </div>

    </div>


    <div id="detailsContent"
         class="d-none">


        <!-- EVALUATION HEADER -->
        <div class="card spe-card mb-3">

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-xl-2 col-md-4">

                        <div class="spe-label">
                            Evaluation No.
                        </div>

                        <div id="evaluationNo"
                             class="spe-value">
                            -
                        </div>

                    </div>


                    <div class="col-xl-3 col-md-4">

                        <div class="spe-label">
                            Supplier
                        </div>

                        <div id="supplierName"
                             class="spe-value">
                            -
                        </div>

                        <div id="supplierCode"
                             class="small text-muted">
                            -
                        </div>

                    </div>


                    <div class="col-xl-2 col-md-4">

                        <div class="spe-label">
                            Evaluation Date
                        </div>

                        <div id="evaluationDate"
                             class="spe-value">
                            -
                        </div>

                    </div>


                    <div class="col-xl-2 col-md-4">

                        <div class="spe-label">
                            Delivery Date
                        </div>

                        <div id="deliveryDate"
                             class="spe-value">
                            -
                        </div>

                    </div>


                    <div class="col-xl-1 col-md-4">

                        <div class="spe-label">
                            Status
                        </div>

                        <div id="evaluationStatus"
                             class="spe-value">
                            -
                        </div>

                    </div>


                    <div class="col-xl-2 col-md-4">

                        <div class="spe-label">
                            Overall Score
                        </div>

                        <div id="overallScore"
                             class="overall-score">
                            0.00%
                        </div>

                    </div>

                </div>


                <hr>


                <div class="row g-3">

                    <div class="col-md-3">
                        <div class="spe-label">PO No.</div>
                        <div id="poNo" class="spe-value">-</div>
                    </div>

                    <div class="col-md-3">
                        <div class="spe-label">RR No.</div>
                        <div id="rrNo" class="spe-value">-</div>
                    </div>

                    <div class="col-md-3">
                        <div class="spe-label">QC No.</div>
                        <div id="qcNo" class="spe-value">-</div>
                    </div>

                    <div class="col-md-3">
                        <div class="spe-label">Rating</div>
                        <div id="rating" class="spe-value">-</div>
                    </div>

                </div>

            </div>

        </div>


        <!-- SCORES -->
        <div class="card spe-card mb-3">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>
                        <h6 class="mb-0">
                            Evaluation Scores
                        </h6>

                        <small class="text-muted">
                            Weighted score contribution
                        </small>
                    </div>

                    <span class="badge bg-dark">
                        Total Weight: 100%
                    </span>

                </div>


                <div class="row g-3">

                    <div class="col-xl-3 col-md-6">

                        <div class="card score-card score-quality">

                            <div class="card-body">

                                <div class="score-title">
                                    Quality
                                </div>

                                <small class="text-muted">
                                    Maximum 40
                                </small>

                                <div id="qualityScore"
                                     class="score-value">
                                    0.00 / 40
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-xl-3 col-md-6">

                        <div class="card score-card score-delivery">

                            <div class="card-body">

                                <div class="score-title">
                                    Delivery
                                </div>

                                <small class="text-muted">
                                    On-Time + In-Full / 30
                                </small>

                                <div id="deliveryScore"
                                     class="score-value">
                                    0.00 / 30
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-xl-3 col-md-6">

                        <div class="card score-card score-cost">

                            <div class="card-body">

                                <div class="score-title">
                                    Cost Competitiveness
                                </div>

                                <small class="text-muted">
                                    New vs Previous Price / 20
                                </small>

                                <div id="costScore"
                                     class="score-value">
                                    0.00 / 20
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-xl-3 col-md-6">

                        <div class="card score-card score-reliability">

                            <div class="card-body">

                                <div class="score-title">
                                    Reliability / After Sales
                                </div>

                                <small class="text-muted">
                                    Purchasing / 10
                                </small>

                                <div id="reliabilityScore"
                                     class="score-value">
                                    0.00 / 10
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PER MATERIAL DETAILS -->
        <div class="card spe-card mb-3">

            <div class="card-header bg-white border-0 pt-3">

                <div class="d-flex flex-wrap justify-content-between gap-2">

                    <div>

                        <h6 class="mb-0">
                            Material Evaluation
                        </h6>

                        <small class="text-muted">
                            Automatic scores plus Purchasing reliability assessment.
                        </small>

                    </div>

                    <span id="lineCount"
                          class="badge bg-light text-dark border">
                        0 lines
                    </span>

                </div>

            </div>


            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0 evaluation-line-table">

                    <thead>

                        <tr>

                            <th rowspan="2">
                                Material
                            </th>

                            <th colspan="4"
                                class="text-center">
                                Quality
                            </th>

                            <th colspan="5"
                                class="text-center">
                                Delivery
                            </th>

                            <th colspan="5"
                                class="text-center">
                                Cost Competitiveness
                            </th>

                            <th colspan="4"
                                class="text-center">
                                Purchasing Reliability
                            </th>

                            <th rowspan="2"
                                class="text-center">
                                Total
                            </th>

                        </tr>


                        <tr>

                            <th class="text-end">Inspected</th>
                            <th class="text-end">Accepted</th>
                            <th class="text-end">Rejected</th>
                            <th class="text-center">Grade / 40</th>

                            <th>Scheduled</th>
                            <th>Delivered</th>
                            <th class="text-end">Sched Qty</th>
                            <th class="text-end">Delivered Qty</th>
                            <th class="text-center">Grade / 30</th>

                            <th class="text-end">Previous Price</th>
                            <th class="text-end">New Price</th>
                            <th class="text-center">Change</th>
                            <th>Result</th>
                            <th class="text-center">Grade / 20</th>

                            <th class="text-center">COA / 5</th>
                            <th class="text-center">Terms / 10</th>
                            <th class="text-center">Others / 5</th>
                            <th class="text-center">Grade / 10</th>

                        </tr>

                    </thead>


                    <tbody id="evaluationLineBody">

                        <tr>

                            <td colspan="19"
                                class="text-center text-muted py-4">

                                Loading evaluation lines...

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <div id="reliabilityActionPanel"
                 class="card-footer bg-white text-end d-none">

                <button id="btnSaveReliability"
                        type="button"
                        class="btn btn-success">

                    <i class="bi bi-save me-1"></i>
                    Save Purchasing Assessment

                </button>

            </div>

        </div>


        <!-- REMARKS / WORKFLOW -->
        <div class="row g-3">

            <div class="col-xl-5">

                <div class="card spe-card h-100">

                    <div class="card-body">

                        <h6>
                            Evaluation Remarks
                        </h6>

                        <div id="evaluationRemarks"
                             class="small text-muted">
                            No remarks.
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-xl-7">

                <div class="card spe-card h-100">

                    <div class="card-body">

                        <h6 class="mb-3">
                            Workflow History
                        </h6>

                        <div id="workflowContainer">

                            <div class="text-muted small">
                                No workflow history.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const evaluationId =
            Number('@evaluationId');

        let evaluationData = null;


        document.addEventListener(
            "DOMContentLoaded",
            function () {

                document
                    .getElementById(
                        "btnSaveReliability"
                    )
                    .addEventListener(
                        "click",
                        saveReliability
                    );


                document
                    .getElementById(
                        "btnFinalize"
                    )
                    .addEventListener(
                        "click",
                        finalizeEvaluation
                    );


                loadEvaluation();
            }
        );


        async function loadEvaluation() {

            hideAlert();

            try {

                const response =
                    await fetch(
                        `/purchasing/supplier-evaluation/${evaluationId}`
                    );


                const result =
                    await readResponse(response);


                if (!response.ok) {

                    throw new Error(
                        result.message ??
                        "Supplier evaluation was not found."
                    );
                }


                evaluationData =
                    result.data ?? result;


                renderEvaluation(
                    evaluationData
                );


                document
                    .getElementById(
                        "loadingPanel"
                    )
                    .classList.add(
                        "d-none"
                    );


                document
                    .getElementById(
                        "detailsContent"
                    )
                    .classList.remove(
                        "d-none"
                    );

            }
            catch (error) {

                document
                    .getElementById(
                        "loadingPanel"
                    )
                    .classList.add(
                        "d-none"
                    );


                showAlert(
                    error.message ??
                    "Unable to load supplier evaluation."
                );
            }
        }


        function renderEvaluation(data) {

            const status =
                normalizeStatus(
                    data.status
                );


            setText(
                "evaluationNo",
                data.evaluationNo ?? "-"
            );


            setText(
                "pageTitle",
                data.evaluationNo ??
                "Supplier Performance Evaluation"
            );


            setText(
                "supplierName",
                data.supplierName ?? "-"
            );


            setText(
                "supplierCode",
                data.supplierCode
                    ? `Supplier Code: ${data.supplierCode}`
                    : "-"
            );


            setText(
                "evaluationDate",
                formatDate(
                    data.evaluationDate
                )
            );


            setText(
                "deliveryDate",
                formatDate(
                    data.deliveryDate
                )
            );


            setText(
                "poNo",
                data.poNo ?? "-"
            );


            setText(
                "rrNo",
                data.rrNo ?? "-"
            );


            setText(
                "qcNo",
                data.qcNo ?? "-"
            );


            document
                .getElementById(
                    "evaluationStatus"
                )
                .innerHTML =
                    statusBadge(status);


            document
                .getElementById(
                    "rating"
                )
                .innerHTML =
                    ratingBadge(
                        data.performanceRating,
                        status
                    );


            setText(
                "qualityScore",
                `${formatScore(
                    data.qualityWeightedScore
                )} / 40`
            );


            setText(
                "deliveryScore",
                `${formatScore(
                    data.deliveryWeightedScore
                )} / 30`
            );


            setText(
                "costScore",
                `${formatScore(
                    data.costWeightedScore
                )} / 20`
            );


            setText(
                "reliabilityScore",
                `${formatScore(
                    data.reliabilityWeightedScore
                )} / 10`
            );


            setText(
                "overallScore",
                `${formatScore(
                    data.totalScore
                )}%`
            );


            setText(
                "evaluationRemarks",
                data.remarks ??
                "No remarks."
            );


            renderLines(
                data.lines ?? [],
                status
            );


            renderWorkflow(
                data.workflowHistory ?? []
            );


            updateActions(status);
        }


        function renderLines(
            lines,
            status
        ) {

            const body =
                document.getElementById(
                    "evaluationLineBody"
                );


            const editable =
                status ===
                "PENDING_PURCHASING";


            setText(
                "lineCount",
                `${lines.length} line${lines.length === 1 ? "" : "s"}`
            );


            if (!Array.isArray(lines) ||
                lines.length === 0) {

                body.innerHTML = `
                    <tr>
                        <td colspan="19"
                            class="text-center text-muted py-4">
                            No evaluation lines found.
                        </td>
                    </tr>
                `;

                return;
            }


            body.innerHTML =
                lines.map(line => {

                    const priceClass =
                        getPriceClass(
                            line.priceChangePercent
                        );


                    return `
                        <tr data-line-id="${Number(
                            line.evaluationLineId
                        )}">

                            <td>
                                <div class="fw-semibold">
                                    ${escapeHtml(
                                        line.materialName ?? "-"
                                    )}
                                </div>

                                <small class="text-muted">
                                    ${escapeHtml(
                                        line.materialCode ?? ""
                                    )}
                                </small>
                            </td>


                            <td class="text-end">
                                ${formatQty(
                                    line.totalInspectedQty
                                )}
                            </td>

                            <td class="text-end">
                                ${formatQty(
                                    line.approvedQty
                                )}
                            </td>

                            <td class="text-end">
                                ${formatQty(
                                    line.rejectedQty
                                )}
                            </td>

                            <td class="text-center fw-bold">
                                ${formatScore(
                                    line.qualityGrade
                                )}
                            </td>


                            <td>
                                ${formatDate(
                                    line.scheduledDate
                                )}
                            </td>

                            <td>
                                ${formatDate(
                                    line.actualDeliveryDate
                                )}
                            </td>

                            <td class="text-end">
                                ${formatQty(
                                    line.scheduledQty
                                )}
                            </td>

                            <td class="text-end">
                                ${formatQty(
                                    line.deliveredQty
                                )}
                            </td>

                            <td class="text-center fw-bold">
                                ${formatScore(
                                    line.deliveryGrade
                                )}
                            </td>


                            <td class="text-end">
                                ${
                                    line.previousUnitPrice == null
                                        ? '<span class="text-muted">No history</span>'
                                        : formatMoney(
                                            line.previousUnitPrice
                                          )
                                }
                            </td>

                            <td class="text-end fw-semibold">
                                ${formatMoney(
                                    line.newUnitPrice
                                )}
                            </td>

                            <td class="text-center ${priceClass}">
                                ${formatPriceChange(
                                    line.priceChangePercent
                                )}
                            </td>

                            <td>
                                ${costStatusBadge(
                                    line.costStatus
                                )}
                            </td>

                            <td class="text-center fw-bold">
                                ${formatScore(
                                    line.costGrade
                                )}
                            </td>


                            <td>
                                ${reliabilityInput(
                                    "coa",
                                    line.evaluationLineId,
                                    line.coaPoints,
                                    5,
                                    editable
                                )}
                            </td>

                            <td>
                                ${reliabilityInput(
                                    "terms",
                                    line.evaluationLineId,
                                    line.termsPoints,
                                    10,
                                    editable
                                )}
                            </td>

                            <td>
                                ${reliabilityInput(
                                    "other",
                                    line.evaluationLineId,
                                    line.otherPoints,
                                    5,
                                    editable
                                )}
                            </td>

                            <td class="text-center fw-bold">
                                ${formatScore(
                                    line.reliabilityGrade
                                )}
                            </td>


                            <td class="text-center fw-bold">
                                ${formatScore(
                                    line.totalGrade
                                )}
                            </td>

                        </tr>
                    `;

                }).join("");
        }


        function reliabilityInput(
            type,
            lineId,
            value,
            max,
            editable
        ) {

            return `
                <input type="number"
                       class="form-control form-control-sm reliability-input"
                       data-type="${type}"
                       data-line-id="${lineId}"
                       value="${Number(value ?? 0)}"
                       min="0"
                       max="${max}"
                       step="0.5"
                       ${editable ? "" : "disabled"}>
            `;
        }


        function updateActions(status) {

            const editable =
                status ===
                "PENDING_PURCHASING";


            document
                .getElementById(
                    "reliabilityActionPanel"
                )
                .classList.toggle(
                    "d-none",
                    !editable
                );


            document
                .getElementById(
                    "btnFinalize"
                )
                .classList.toggle(
                    "d-none",
                    !editable
                );
        }


        async function saveReliability() {

            hideAlert();
            hideSuccess();


            const rows =
                Array.from(
                    document.querySelectorAll(
                        "#evaluationLineBody tr[data-line-id]"
                    )
                );


            if (rows.length === 0) {

                showAlert(
                    "No evaluation lines are available."
                );

                return;
            }


            const lines =
                rows.map(row => {

                    const lineId =
                        Number(
                            row.dataset.lineId
                        );


                    return {

                        evaluationLineId:
                            lineId,

                        coaPoints:
                            getInputValue(
                                row,
                                "coa"
                            ),

                        termsPoints:
                            getInputValue(
                                row,
                                "terms"
                            ),

                        otherPoints:
                            getInputValue(
                                row,
                                "other"
                            )
                    };
                });


            for (const line of lines) {

                if (line.coaPoints < 0 ||
                    line.coaPoints > 5) {

                    showAlert(
                        "COA points must be between 0 and 5."
                    );

                    return;
                }


                if (line.termsPoints < 0 ||
                    line.termsPoints > 10) {

                    showAlert(
                        "Terms points must be between 0 and 10."
                    );

                    return;
                }


                if (line.otherPoints < 0 ||
                    line.otherPoints > 5) {

                    showAlert(
                        "Other points must be between 0 and 5."
                    );

                    return;
                }
            }


            const button =
                document.getElementById(
                    "btnSaveReliability"
                );


            button.disabled = true;


            try {

                const response =
                    await fetch(
                        `/purchasing/supplier-evaluation/${evaluationId}/reliability`,
                        {
                            method: "PUT",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                lines
                            })
                        }
                    );


                const result =
                    await readResponse(
                        response
                    );


                if (!response.ok ||
                    result.success === false) {

                    throw new Error(
                        result.message ??
                        "Unable to save Purchasing assessment."
                    );
                }


                showSuccess(
                    result.message ??
                    "Purchasing assessment saved successfully."
                );


                await loadEvaluation();

            }
            catch (error) {

                showAlert(
                    error.message ??
                    "Unable to save Purchasing assessment."
                );
            }
            finally {

                button.disabled = false;
            }
        }


        function getInputValue(
            row,
            type
        ) {

            const input =
                row.querySelector(
                    `[data-type="${type}"]`
                );


            return Number(
                input?.value ?? 0
            );
        }


        async function finalizeEvaluation() {

            hideAlert();


            if (!confirm(
                "Finalize this supplier evaluation? After finalization, Purchasing scores can no longer be changed."
            )) {
                return;
            }


            const remarks =
                window.prompt(
                    "Finalization remarks:",
                    ""
                );


            if (remarks === null)
                return;


            const button =
                document.getElementById(
                    "btnFinalize"
                );


            button.disabled = true;


            try {

                const response =
                    await fetch(
                        `/purchasing/supplier-evaluation/${evaluationId}/finalize`,
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                remarks
                            })
                        }
                    );


                const result =
                    await readResponse(
                        response
                    );


                if (!response.ok ||
                    result.success === false) {

                    throw new Error(
                        result.message ??
                        "Unable to finalize evaluation."
                    );
                }


                showSuccess(
                    result.message ??
                    "Supplier evaluation finalized successfully."
                );


                await loadEvaluation();

            }
            catch (error) {

                showAlert(
                    error.message ??
                    "Unable to finalize evaluation."
                );
            }
            finally {

                button.disabled = false;
            }
        }


        function renderWorkflow(history) {

            const container =
                document.getElementById(
                    "workflowContainer"
                );


            if (!Array.isArray(history) ||
                history.length === 0) {

                container.innerHTML = `
                    <div class="text-muted small">
                        No workflow history.
                    </div>
                `;

                return;
            }


            container.innerHTML =
                history.map(item => `

                    <div class="workflow-item">

                        <div class="fw-semibold small">
                            ${escapeHtml(
                                formatStatus(
                                    item.action
                                )
                            )}
                        </div>

                        <div class="small">
                            ${escapeHtml(
                                item.actionBy ?? "-"
                            )}
                        </div>

                        <div class="small text-muted">
                            ${formatDateTime(
                                item.actionAt
                            )}
                        </div>

                        ${
                            item.remarks
                                ? `
                                    <div class="small mt-1">
                                        ${escapeHtml(
                                            item.remarks
                                        )}
                                    </div>
                                  `
                                : ""
                        }

                    </div>

                `).join("");
        }


        function costStatusBadge(status) {

            const value =
                normalizeStatus(
                    status
                );


            switch (value) {

                case "PRICE_DECREASED":

                    return `
                        <span class="badge bg-success">
                            Price Decreased
                        </span>
                    `;


                case "PRICE_UNCHANGED":

                    return `
                        <span class="badge bg-secondary">
                            No Change
                        </span>
                    `;


                case "PRICE_INCREASED":

                    return `
                        <span class="badge bg-danger">
                            Price Increased
                        </span>
                    `;


                case "NO_PREVIOUS_PRICE":

                    return `
                        <span class="badge bg-light text-dark border">
                            No Previous Price
                        </span>
                    `;


                default:

                    return `
                        <span class="badge bg-light text-dark border">
                            ${escapeHtml(
                                formatStatus(value)
                            )}
                        </span>
                    `;
            }
        }


        function formatPriceChange(value) {

            if (value == null)
                return "-";


            const number =
                Number(value);


            return `${
                number > 0 ? "+" : ""
            }${formatScore(number)}%`;
        }


        function getPriceClass(value) {

            if (value == null)
                return "price-same";


            const number =
                Number(value);


            if (number < 0)
                return "price-down";


            if (number > 0)
                return "price-up";


            return "price-same";
        }


        function statusBadge(status) {

            if (status ===
                "PENDING_PURCHASING") {

                return `
                    <span class="badge bg-warning text-dark">
                        Pending Purchasing
                    </span>
                `;
            }


            if (status ===
                "FINALIZED") {

                return `
                    <span class="badge bg-success">
                        Finalized
                    </span>
                `;
            }


            return `
                <span class="badge bg-secondary">
                    ${escapeHtml(
                        formatStatus(status)
                    )}
                </span>
            `;
        }


        function ratingBadge(
            rating,
            status
        ) {

            /*
             * Do not present a partial rating as final
             * while Purchasing assessment is incomplete.
             */
            if (status !== "FINALIZED") {

                return `
                    <span class="badge bg-light text-dark border">
                        Pending
                    </span>
                `;
            }


            const value =
                normalizeRating(
                    rating
                );


            switch (value) {

                case "EXCELLENT":
                    return '<span class="badge bg-success">Excellent</span>';

                case "VERY GOOD":
                    return '<span class="badge bg-info text-dark">Very Good</span>';

                case "GOOD":
                    return '<span class="badge bg-warning text-dark">Good</span>';

                case "NEEDS IMPROVEMENT":
                    return '<span class="badge bg-danger">Needs Improvement</span>';

                default:
                    return '<span class="badge bg-danger">Poor</span>';
            }
        }


        function normalizeStatus(value) {

            return String(
                value ?? ""
            )
            .trim()
            .replaceAll(" ", "_")
            .toUpperCase();
        }


        function normalizeRating(value) {

            return String(
                value ?? ""
            )
            .trim()
            .replaceAll("_", " ")
            .toUpperCase();
        }


        function formatStatus(value) {

            if (!value)
                return "-";


            return String(value)
                .replaceAll("_", " ")
                .toLowerCase()
                .replace(
                    /\b\w/g,
                    x => x.toUpperCase()
                );
        }


        function formatScore(value) {

            return Number(
                value ?? 0
            )
            .toLocaleString(
                "en-PH",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );
        }


        function formatQty(value) {

            return Number(
                value ?? 0
            )
            .toLocaleString(
                "en-PH",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 4
                }
            );
        }


        function formatMoney(value) {

            return Number(
                value ?? 0
            )
            .toLocaleString(
                "en-PH",
                {
                    style: "currency",
                    currency: "PHP",
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 4
                }
            );
        }


        function formatDate(value) {

            if (!value)
                return "-";


            const date =
                new Date(value);


            if (Number.isNaN(
                date.getTime()
            )) {
                return "-";
            }


            return date.toLocaleDateString(
                "en-PH",
                {
                    year: "numeric",
                    month: "short",
                    day: "2-digit"
                }
            );
        }


        function formatDateTime(value) {

            if (!value)
                return "-";


            const date =
                new Date(value);


            if (Number.isNaN(
                date.getTime()
            )) {
                return "-";
            }


            return date.toLocaleString(
                "en-PH",
                {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                    hour: "2-digit",
                    minute: "2-digit"
                }
            );
        }


        function setText(
            id,
            value
        ) {

            const element =
                document.getElementById(id);


            if (element)
                element.textContent =
                    value ?? "-";
        }


        async function readResponse(
            response
        ) {

            const text =
                await response.text();


            if (!text)
                return {};


            try {

                return JSON.parse(text);

            }
            catch {

                return {
                    message: text
                };
            }
        }


        function showAlert(message) {

            hideSuccess();

            const alert =
                document.getElementById(
                    "pageAlert"
                );

            alert.textContent =
                message;

            alert.classList.remove(
                "d-none"
            );
        }


        function hideAlert() {

            const alert =
                document.getElementById(
                    "pageAlert"
                );

            alert.textContent = "";

            alert.classList.add(
                "d-none"
            );
        }


        function showSuccess(message) {

            hideAlert();

            const alert =
                document.getElementById(
                    "pageSuccess"
                );

            alert.textContent =
                message;

            alert.classList.remove(
                "d-none"
            );
        }


        function hideSuccess() {

            const alert =
                document.getElementById(
                    "pageSuccess"
                );

            alert.textContent = "";

            alert.classList.add(
                "d-none"
            );
        }


        function escapeHtml(value) {

            return String(
                value ?? ""
            )
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
        }

    </script>

}