@{
    ViewData["Title"] = "Supplier Evaluation Details";
    var evaluationId = ViewBag.EvaluationId;
}

<style>
    .spe-page-header {
        border-left: 4px solid #0d6efd;
        padding-left: 12px;
    }

    .spe-card {
        border: 0;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .06);
    }

    .spe-label {
        color: #6c757d;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .spe-value {
        margin-top: 4px;
        font-size: .95rem;
        font-weight: 600;
    }

    .score-card {
        border: 0;
        border-radius: 9px;
        height: 100%;
    }

    .score-quality {
        background: #f8dede;
    }

    .score-delivery {
        background: #fff0c7;
    }

    .score-cost {
        background: #dcebd9;
    }

    .score-reliability {
        background: #e6def3;
    }

    .score-title {
        font-size: .78rem;
        font-weight: 700;
    }

    .score-subtitle {
        color: #6c757d;
        font-size: .68rem;
    }

    .score-value {
        margin-top: 8px;
        font-size: 1.35rem;
        font-weight: 700;
    }

    .breakdown-card {
        border: 1px solid #e8eaed;
        border-radius: 9px;
        height: 100%;
    }

    .breakdown-title {
        font-size: .9rem;
        font-weight: 700;
    }

    .breakdown-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .breakdown-row:last-child {
            border-bottom: 0;
        }

        .breakdown-row span:first-child {
            color: #6c757d;
            font-size: .8rem;
        }

        .breakdown-row span:last-child {
            font-size: .82rem;
            font-weight: 700;
        }

    .workflow-item {
        position: relative;
        padding-left: 24px;
    }

        .workflow-item::before {
            position: absolute;
            top: 5px;
            left: 4px;
            width: 10px;
            height: 10px;
            content: "";
            background: #0d6efd;
            border-radius: 50%;
        }

        .workflow-item::after {
            position: absolute;
            top: 16px;
            bottom: -18px;
            left: 8px;
            width: 2px;
            content: "";
            background: #dee2e6;
        }

        .workflow-item:last-child::after {
            display: none;
        }

    .table-evaluation {
        white-space: nowrap;
        font-size: .78rem;
    }

        .table-evaluation thead th {
            font-size: .68rem;
            text-transform: uppercase;
            vertical-align: middle;
        }

    .overall-score {
        font-size: 1.7rem;
        font-weight: 700;
        color: #0d6efd;
    }
</style>

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">

        <div class="spe-page-header">
            <div class="text-muted small">
                Purchasing &gt; Supplier Evaluation &gt; Details
            </div>

            <h4 id="pageTitle" class="mb-0">
                Supplier Performance Evaluation
            </h4>

            <div class="text-muted small">
                Detailed evaluation of supplier quality, delivery, cost and reliability.
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a href="/purchasing/supplier-evaluation"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

            <button id="btnRegenerate"
                    type="button"
                    class="btn btn-outline-primary btn-sm d-none">
                <i class="bi bi-arrow-repeat"></i>
                Regenerate
            </button>

          

            <button id="btnFinalize"
                    type="button"
                    class="btn btn-dark btn-sm d-none">
                Finalize
            </button>

        </div>
    </div>

    <div id="pageAlert" class="alert alert-danger d-none"></div>

    <div id="loadingPanel"
         class="card spe-card">
        <div class="card-body text-center text-muted py-5">
            <div class="spinner-border spinner-border-sm me-2"></div>
            Loading supplier evaluation...
        </div>
    </div>

    <div id="detailsContent" class="d-none">

        <!-- Evaluation Header -->
        <div class="card spe-card mb-3">
            <div class="card-body">

                <div class="row g-3 align-items-center">

                    <div class="col-xl-2 col-md-4">
                        <div class="spe-label">Evaluation No.</div>
                        <div id="evaluationNo" class="spe-value">-</div>
                    </div>

                    <div class="col-xl-3 col-md-4">
                        <div class="spe-label">Supplier</div>
                        <div id="supplierName" class="spe-value">-</div>
                        <div id="supplierCode" class="small text-muted">-</div>
                    </div>

                    <div class="col-xl-2 col-md-4">
                        <div class="spe-label">Evaluation Period</div>
                        <div id="evaluationPeriod" class="spe-value">-</div>
                    </div>

                    <div class="col-xl-2 col-md-4">
                        <div class="spe-label">Status</div>
                        <div id="evaluationStatus" class="spe-value">-</div>
                    </div>

                    <div class="col-xl-1 col-md-4">
                        <div class="spe-label">Rating</div>
                        <div id="rating" class="spe-value">-</div>
                    </div>

                    <div class="col-xl-2 col-md-4">
                        <div class="spe-label">Overall Score</div>
                        <div id="overallScore" class="overall-score">0.00%</div>
                    </div>

                </div>

            </div>
        </div>

        <!-- Weighted Scores -->
        <div class="card spe-card mb-3">
            <div class="card-body">

                <div class="d-flex justify-content-between mb-3">
                    <div>
                        <h6 class="mb-0">Evaluation Scores</h6>
                        <small class="text-muted">
                            Weighted supplier performance scores
                        </small>
                    </div>

                    <span class="badge bg-dark align-self-start">
                        Total Weight: 100%
                    </span>
                </div>

                <div class="row g-3">

                    <div class="col-xl-3 col-md-6">
                        <div class="card score-card score-quality">
                            <div class="card-body">
                                <div class="score-title">Quality</div>
                                <div class="score-subtitle">Maximum Weight</div>
                                <div class="fw-semibold">40%</div>

                                <div id="qualityScore"
                                     class="score-value">
                                    0.00 / 40
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card score-card score-delivery">
                            <div class="card-body">
                                <div class="score-title">On-Time Delivery</div>
                                <div class="score-subtitle">Maximum Weight</div>
                                <div class="fw-semibold">30%</div>

                                <div id="deliveryScore"
                                     class="score-value">
                                    0.00 / 30
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card score-card score-cost">
                            <div class="card-body">
                                <div class="score-title">
                                    Cost Competitiveness
                                </div>

                                <div class="score-subtitle">Maximum Weight</div>
                                <div class="fw-semibold">20%</div>

                                <div id="costScore"
                                     class="score-value">
                                    0.00 / 20
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card score-card score-reliability">
                            <div class="card-body">
                                <div class="score-title">
                                    Reliability / After Sales
                                </div>

                                <div class="score-subtitle">Maximum Weight</div>
                                <div class="fw-semibold">10%</div>

                                <div id="reliabilityScore"
                                     class="score-value">
                                    0.00 / 10
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- Score Breakdown -->
        <div class="card spe-card mb-3">
            <div class="card-body">

                <h6 class="mb-1">Score Breakdown</h6>

                <div class="small text-muted mb-3">
                    Supporting values used to calculate each score.
                </div>

                <div class="row g-3">

                    <!-- Quality Breakdown -->
                    <div class="col-xl-4 col-md-6">
                        <div class="breakdown-card p-3">

                            <div class="breakdown-title mb-2">
                                Quality Performance
                            </div>

                            <div class="breakdown-row">
                                <span>Receiving Reports</span>
                                <span id="qualityReceivingCount">0</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Received Quantity</span>
                                <span id="totalReceivedQty">0.00</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Accepted Quantity</span>
                                <span id="totalAcceptedQty">0.00</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Rejected Quantity</span>
                                <span id="totalRejectedQty">0.00</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Quality Rate</span>
                                <span id="qualityRate">0.00%</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Weighted Score</span>
                                <span id="qualityWeightedScore">0.00 / 40</span>
                            </div>

                        </div>
                    </div>

                    <!-- Delivery Breakdown -->
                    <div class="col-xl-4 col-md-6">
                        <div class="breakdown-card p-3">

                            <div class="breakdown-title mb-2">
                                Delivery Performance
                            </div>

                            <div class="breakdown-row">
                                <span>Scheduled Deliveries</span>
                                <span id="scheduledDeliveries">0</span>
                            </div>

                            <div class="breakdown-row">
                                <span>On-Time Deliveries</span>
                                <span id="onTimeDeliveries">0</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Delayed Deliveries</span>
                                <span id="delayedDeliveries">0</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Delivery Rate</span>
                                <span id="deliveryRate">0.00%</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Weighted Score</span>
                                <span id="deliveryWeightedScore">0.00 / 30</span>
                            </div>

                        </div>
                    </div>

                    <!-- Cost Breakdown -->
                    <div class="col-xl-4 col-md-6">
                        <div class="breakdown-card p-3">

                            <div class="breakdown-title mb-2">
                                Cost Performance
                            </div>

                            <div class="breakdown-row">
                                <span>Items Compared</span>
                                <span id="itemsCompared">0</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Competitive Price Count</span>
                                <span id="competitivePriceCount">0</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Average Price Difference</span>
                                <span id="averagePriceDifference">0.00%</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Cost Rate</span>
                                <span id="costRate">0.00%</span>
                            </div>

                            <div class="breakdown-row">
                                <span>Weighted Score</span>
                                <span id="costWeightedScore">0.00 / 20</span>
                            </div>

                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- Reliability -->
        <div class="card spe-card mb-3">
            <div class="card-body">

                <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">

                    <div>
                        <h6 class="mb-0">
                            Reliability / After-Sales Assessment
                        </h6>

                        <small class="text-muted">
                            Manual assessment completed by Purchasing.
                        </small>
                    </div>

                    <div class="badge bg-light text-dark border align-self-start">
                        Total:
                        <span id="reliabilityTotal">0.00</span>
                        / 10
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">
                            Documentation / COA
                        </label>

                        <div class="input-group input-group-sm">
                            <input id="documentationScore"
                                   type="number"
                                   class="form-control"
                                   min="0"
                                   max="5"
                                   step="0.5">

                            <span class="input-group-text">/ 5</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">
                            Terms Compliance
                        </label>

                        <div class="input-group input-group-sm">
                            <input id="termsScore"
                                   type="number"
                                   class="form-control"
                                   min="0"
                                   max="3"
                                   step="0.5">

                            <span class="input-group-text">/ 3</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">
                            After-Sales Support
                        </label>

                        <div class="input-group input-group-sm">
                            <input id="afterSalesScore"
                                   type="number"
                                   class="form-control"
                                   min="0"
                                   max="2"
                                   step="0.5">

                            <span class="input-group-text">/ 2</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold">
                            Reliability Remarks
                        </label>

                        <textarea id="reliabilityRemarks"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter assessment remarks"></textarea>
                    </div>

                    <div class="col-12 text-end">
                        <button id="btnSaveReliability"
                                type="button"
                                class="btn btn-success btn-sm d-none">
                            <i class="bi bi-save"></i>
                            Save Reliability
                        </button>
                    </div>

                </div>

            </div>
        </div>

        <!-- Evaluated Transactions -->
        <div class="card spe-card mb-3">

            <div class="card-header bg-white border-0 pt-3">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <h6 class="mb-0">
                            Evaluated Transactions
                        </h6>

                        <small class="text-muted">
                            Purchase, receiving and QC records included in the evaluation.
                        </small>
                    </div>

                    <span id="transactionCount"
                          class="badge bg-light text-dark border">
                        0 records
                    </span>

                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0 table-evaluation">

                    <thead class="table-light">
                        <tr>
                            <th>PO No.</th>
                            <th>RR No.</th>
                            <th>QC No.</th>
                            <th>Material</th>
                            <th class="text-end">Received</th>
                            <th class="text-end">Accepted</th>
                            <th class="text-end">Rejected</th>
                            <th>Scheduled Date</th>
                            <th>Delivered Date</th>
                            <th>Delivery</th>
                            <th class="text-end">Unit Price</th>
                        </tr>
                    </thead>

                    <tbody id="transactionBody">
                        <tr>
                            <td colspan="11"
                                class="text-center text-muted py-4">
                                Loading transactions...
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>

        <!-- Remarks and Workflow -->
        <div class="row g-3">

            <div class="col-xl-5">
                <div class="card spe-card h-100">
                    <div class="card-body">

                        <h6>Evaluation Remarks</h6>

                        <div id="evaluationRemarks"
                             class="small text-muted">
                            No remarks.
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-xl-7">
                <div class="card spe-card h-100">
                    <div class="card-body">

                        <h6 class="mb-3">Evaluation Workflow</h6>

                        <div id="workflowContainer">
                            <div class="text-muted small">
                                No workflow history available.
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

<script>
    const evaluationId = Number('@evaluationId');

    let evaluationData = null;

    document.addEventListener("DOMContentLoaded", function () {

        document
            .querySelectorAll(".reliability-field")
            .forEach(field => {
                field.addEventListener(
                    "input",
                    updateReliabilityTotal
                );
            });

       

        document
            .getElementById("btnRegenerate")
            .addEventListener("click", regenerateEvaluation);

      

       

      

        document
            .getElementById("btnFinalize")
            .addEventListener("click", finalizeEvaluation);

        loadEvaluation();
    });

    async function loadEvaluation() {

        hidePageAlert();

        try {

            const response = await fetch(
                `/purchasing/supplier-evaluation/${evaluationId}`
            );

            const result = await readResponse(response);

            if (!response.ok) {
                throw new Error(
                    result.message ??
                    "Supplier evaluation was not found."
                );
            }

            evaluationData = result.data ?? result;

            renderEvaluation(evaluationData);

            document
                .getElementById("loadingPanel")
                .classList.add("d-none");

            document
                .getElementById("detailsContent")
                .classList.remove("d-none");
        }
        catch (error) {

            document
                .getElementById("loadingPanel")
                .classList.add("d-none");

            showPageAlert(
                error.message ??
                "Failed to load supplier evaluation."
            );
        }
    }
        function updateWorkflowButtons(status) {

        const normalized =
            String(status ?? "")
                .trim()
                .toUpperCase();

        const btnRegenerate =
            document.getElementById("btnRegenerate");

        const btnFinalize =
            document.getElementById("btnFinalize");

        if (btnRegenerate)
            btnRegenerate.classList.add("d-none");

        if (btnFinalize)
            btnFinalize.classList.add("d-none");

        if (normalized === "GENERATED") {

            btnRegenerate?.classList.remove("d-none");
            btnFinalize?.classList.remove("d-none");
        }

        // Reliability is read-only now
        [
            "documentationScore",
            "termsScore",
            "afterSalesScore",
            "reliabilityRemarks"
        ].forEach(id => {

            const control =
                document.getElementById(id);

            if (control)
                control.disabled = true;
        });
    }
        

    function renderEvaluation(data) {

        const status = normalizeStatus(
            valueOf(data, "status")
        );

        const evaluationNo =
            valueOf(
                data,
                "evaluationNo",
                "supplierEvaluationNo",
                "evaluation_no"
            ) ?? `Evaluation #${evaluationId}`;

        setText("evaluationNo", evaluationNo);
        setText("pageTitle", evaluationNo);

        setText(
            "supplierName",
            valueOf(data, "supplierName", "supplier_name") ?? "-"
        );

        const supplierCode =
            valueOf(data, "supplierCode", "supplier_code");

        setText(
            "supplierCode",
            supplierCode
                ? `Supplier Code: ${supplierCode}`
                : "-"
        );

        setText(
            "evaluationPeriod",
            getEvaluationPeriod(data)
        );

        document.getElementById(
            "evaluationStatus"
        ).innerHTML = statusBadge(status);

        document.getElementById(
            "rating"
        ).innerHTML = ratingBadge(
            valueOf(data, "rating") ?? "-"
        );

            const qualityScore = numberOf(
        data,
        "qualityWeightedScore",
        "qualityScore"
    );

    const deliveryScore = numberOf(
        data,
        "deliveryWeightedScore",
        "onTimeDeliveryScore",
        "deliveryScore"
    );

    const costScore = numberOf(
        data,
        "costWeightedScore",
        "costCompetitivenessScore",
        "costScore"
    );

    const reliabilityScore = numberOf(
        data,
        "reliabilityWeightedScore",
        "reliabilityScore"
    );

        const overallScore =
            valueOf(
                data,
                "overallScore",
                "totalScore"
            ) ??
            qualityScore +
            deliveryScore +
            costScore +
            reliabilityScore;

        setText(
            "qualityScore",
            `${formatScore(qualityScore)} / 40`
        );

        setText(
            "deliveryScore",
            `${formatScore(deliveryScore)} / 30`
        );

        setText(
            "costScore",
            `${formatScore(costScore)} / 20`
        );

        setText(
            "reliabilityScore",
            `${formatScore(reliabilityScore)} / 10`
        );

        setText(
            "overallScore",
            `${formatScore(overallScore)}%`
        );

        renderQualityBreakdown(data, qualityScore);
        renderDeliveryBreakdown(data, deliveryScore);
        renderCostBreakdown(data, costScore);
        renderReliability(data);
        renderTransactions(data);
        renderWorkflow(data);

        setText(
            "evaluationRemarks",
            valueOf(
                data,
                "remarks",
                "evaluationRemarks"
            ) ?? "No remarks."
        );

        updateWorkflowButtons(status);
    }

    function renderQualityBreakdown(data, score) {

        setText(
            "qualityReceivingCount",
            numberOf(
                data,
                "receivingReportCount",
                "qualityTransactionCount",
                "rrCount"
            )
        );

        setText(
            "totalReceivedQty",
            formatQty(numberOf(data, "totalReceivedQty"))
        );

        setText(
            "totalAcceptedQty",
            formatQty(numberOf(data, "totalAcceptedQty"))
        );

        setText(
            "totalRejectedQty",
            formatQty(numberOf(data, "totalRejectedQty"))
        );

        setText(
            "qualityRate",
            `${formatScore(numberOf(
                data,
                "qualityRate",
                "qualityPercentage"
            ))}%`
        );

        setText(
            "qualityWeightedScore",
            `${formatScore(score)} / 40`
        );
    }

    function renderDeliveryBreakdown(data, score) {

        setText(
            "scheduledDeliveries",
            numberOf(
                data,
                "scheduledDeliveryCount",
                "totalScheduledDeliveries"
            )
        );

        setText(
            "onTimeDeliveries",
            numberOf(
                data,
                "onTimeDeliveryCount",
                "onTimeDeliveries"
            )
        );

        setText(
            "delayedDeliveries",
            numberOf(
                data,
                "delayedDeliveryCount",
                "delayedDeliveries"
            )
        );

        setText(
            "deliveryRate",
            `${formatScore(numberOf(
                data,
                "deliveryRate",
                "onTimeDeliveryRate"
            ))}%`
        );

        setText(
            "deliveryWeightedScore",
            `${formatScore(score)} / 30`
        );
    }

    function renderCostBreakdown(data, score) {

        setText(
            "itemsCompared",
            numberOf(
                data,
                "itemsCompared",
                "costComparisonCount"
            )
        );

        setText(
            "competitivePriceCount",
            numberOf(
                data,
                "competitivePriceCount",
                "lowestPriceCount"
            )
        );

        setText(
            "averagePriceDifference",
            `${formatScore(numberOf(
                data,
                "averagePriceDifference",
                "averagePriceDifferencePercent"
            ))}%`
        );

        setText(
            "costRate",
            `${formatScore(numberOf(
                data,
                "costRate",
                "costCompetitivenessRate"
            ))}%`
        );

        setText(
            "costWeightedScore",
            `${formatScore(score)} / 20`
        );
    }

    function renderReliability(data) {

        document.getElementById(
            "documentationScore"
        ).value = numberOf(
            data,
            "documentationScore",
            "coaScore"
        );

        document.getElementById(
            "termsScore"
        ).value = numberOf(
            data,
            "termsScore",
            "termsComplianceScore"
        );

        document.getElementById(
            "afterSalesScore"
        ).value = numberOf(
            data,
            "afterSalesScore",
            "afterSalesSupportScore"
        );

        document.getElementById(
            "reliabilityRemarks"
        ).value =
            valueOf(
                data,
                "reliabilityRemarks"
            ) ?? "";

        updateReliabilityTotal();
    }

    function renderTransactions(data) {

        const rows =
            valueOf(
                data,
                "transactions",
                "lines",
                "evaluationLines",
                "details"
            ) ?? [];

        const transactions =
            Array.isArray(rows)
                ? rows
                : [];

        const body =
            document.getElementById("transactionBody");

        document.getElementById(
            "transactionCount"
        ).textContent =
            `${transactions.length} record${transactions.length === 1 ? "" : "s"}`;

        if (transactions.length === 0) {

            body.innerHTML = `
                <tr>
                    <td colspan="11"
                        class="text-center text-muted py-4">
                        No evaluated transactions found.
                    </td>
                </tr>
            `;

            return;
        }

        body.innerHTML = transactions.map(row => {

            const deliveryStatus =
                normalizeStatus(
                    valueOf(
                        row,
                        "deliveryStatus",
                        "status"
                    )
                );

            const materialName =
                valueOf(
                    row,
                    "materialName",
                    "itemName"
                ) ?? "-";

            const materialCode =
                valueOf(
                    row,
                    "materialCode",
                    "itemCode"
                );

            return `
                <tr>
                    <td>${html(valueOf(row, "poNo") ?? "-")}</td>
                    <td>${html(valueOf(row, "rrNo") ?? "-")}</td>
                    <td>${html(valueOf(row, "qcNo") ?? "-")}</td>

                    <td>
                        <div class="fw-semibold">
                            ${html(materialName)}
                        </div>

                        ${
                            materialCode
                                ? `<small class="text-muted">${html(materialCode)}</small>`
                                : ""
                        }
                    </td>

                    <td class="text-end">
                        ${formatQty(numberOf(row, "receivedQty"))}
                    </td>

                    <td class="text-end">
                        ${formatQty(numberOf(row, "acceptedQty"))}
                    </td>

                    <td class="text-end">
                        ${formatQty(numberOf(row, "rejectedQty"))}
                    </td>

                    <td>
                        ${formatDate(valueOf(row, "scheduledDate"))}
                    </td>

                    <td>
                        ${formatDate(valueOf(
                            row,
                            "deliveredDate",
                            "deliveryDate"
                        ))}
                    </td>

                    <td>
                        ${deliveryBadge(deliveryStatus)}
                    </td>

                    <td class="text-end">
                        ${formatMoney(numberOf(
                            row,
                            "unitPrice",
                            "poUnitPrice"
                        ))}
                    </td>
                </tr>
            `;
        }).join("");
    }

    function renderWorkflow(data) {

            const workflow = [
        {
            label: "Generated",
            user: valueOf(data, "generatedBy", "createdBy"),
            date: valueOf(data, "generatedAt", "createdAt")
        },
        {
            label: "Finalized",
            user: valueOf(data, "finalizedBy"),
            date: valueOf(data, "finalizedAt")
        }
    ].filter(item => item.user || item.date);

        const container =
            document.getElementById("workflowContainer");

        if (workflow.length === 0) {

            container.innerHTML = `
                <div class="text-muted small">
                    No workflow history available.
                </div>
            `;

            return;
        }

        container.innerHTML = workflow.map(item => `
            <div class="workflow-item pb-3">
                <div class="small fw-semibold">
                    ${html(item.label)}
                </div>

                <div class="small">
                    ${html(item.user ?? "-")}
                </div>

                <div class="small text-muted">
                    ${formatDateTime(item.date)}
                </div>
            </div>
        `).join("");
    }

 

    function updateReliabilityTotal() {

        const documentation =
            Number(
                document.getElementById(
                    "documentationScore"
                ).value || 0
            );

        const terms =
            Number(
                document.getElementById(
                    "termsScore"
                ).value || 0
            );

        const afterSales =
            Number(
                document.getElementById(
                    "afterSalesScore"
                ).value || 0
            );

        setText(
            "reliabilityTotal",
            formatScore(
                documentation +
                terms +
                afterSales
            )
        );
    }

 

    async function regenerateEvaluation() {

        await executeAction(
            "regenerate",
            {},
            "Regenerate this evaluation using the latest available records?"
        );
    }




 

    async function finalizeEvaluation() {

        const remarks =
            window.prompt("Finalization remarks:", "");

        if (remarks === null) return;

        await executeAction(
            "finalize",
            { remarks },
            "Finalize this supplier evaluation?"
        );
    }

    async function executeAction(
        action,
        payload,
        confirmation
    ) {

        const confirmed =
            await confirmAction(confirmation);

        if (!confirmed) return;

        try {

            const response = await fetch(
                `/purchasing/supplier-evaluation/${evaluationId}/${action}`,
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(payload ?? {})
                }
            );

            const result =
                await readResponse(response);

            if (!response.ok) {
                throw new Error(
                    result.message ??
                    "Unable to update supplier evaluation."
                );
            }

            await showMessage(
                result.message ??
                "Supplier evaluation updated successfully.",
                "success"
            );

            await loadEvaluation();
        }
        catch (error) {

            showMessage(
                error.message ??
                "Supplier evaluation action failed.",
                "error"
            );
        }
    }

    async function confirmAction(message) {

        if (window.Swal) {

            const result = await Swal.fire({
                icon: "question",
                title: "Please Confirm",
                text: message,
                showCancelButton: true,
                confirmButtonText: "Continue",
                cancelButtonText: "Cancel"
            });

            return result.isConfirmed;
        }

        return confirm(message);
    }

    async function showMessage(message, icon) {

        if (window.Swal) {

            await Swal.fire({
                icon: icon,
                title:
                    icon === "success"
                        ? "Success"
                        : icon === "warning"
                            ? "Validation"
                            : "Error",
                text: message
            });

            return;
        }

        alert(message);
    }

    function statusBadge(status) {

        let cssClass = "bg-secondary";

          if (status === "GENERATED") {
        cssClass = "bg-primary";
    }
    else if (status === "FINALIZED") {
        cssClass = "bg-success";
    }

        return `
            <span class="badge ${cssClass}">
                ${html(formatStatus(status))}
            </span>
        `;
    }

    function ratingBadge(rating) {

        const normalized =
            String(rating ?? "")
                .trim()
                .toUpperCase();

        let cssClass = "bg-secondary";

        if (normalized === "EXCELLENT") {
            cssClass = "bg-success";
        }
        else if (normalized === "VERY GOOD") {
            cssClass = "bg-info text-dark";
        }
        else if (
            normalized === "SATISFACTORY" ||
            normalized === "GOOD"
        ) {
            cssClass = "bg-warning text-dark";
        }
        else if (
            normalized === "POOR" ||
            normalized === "UNSATISFACTORY"
        ) {
            cssClass = "bg-danger";
        }

        return `
            <span class="badge ${cssClass}">
                ${html(rating)}
            </span>
        `;
    }

    function deliveryBadge(status) {

        if (!status) {
            return `<span class="text-muted">-</span>`;
        }

        let cssClass = "bg-secondary";

        if (
            status === "ON_TIME" ||
            status === "ONTIME"
        ) {
            cssClass = "bg-success";
        }
        else if (
            status === "DELAYED" ||
            status === "LATE"
        ) {
            cssClass = "bg-danger";
        }

        return `
            <span class="badge ${cssClass}">
                ${html(formatStatus(status))}
            </span>
        `;
    }

    function getEvaluationPeriod(data) {

        const period =
            valueOf(
                data,
                "evaluationPeriod",
                "period"
            );

        if (period) return period;

        const year =
            numberOf(
                data,
                "evaluationYear",
                "year"
            );

        const month =
            numberOf(
                data,
                "evaluationMonth",
                "month"
            );

        if (!year || month < 1 || month > 12) {
            return "-";
        }

        return new Date(
            year,
            month - 1,
            1
        ).toLocaleDateString("en-US", {
            month: "long",
            year: "numeric"
        });
    }

    function valueOf(object, ...keys) {

        if (!object) return null;

        for (const key of keys) {

            if (
                Object.prototype.hasOwnProperty.call(
                    object,
                    key
                ) &&
                object[key] !== null &&
                object[key] !== undefined
            ) {
                return object[key];
            }
        }

        return null;
    }

    function numberOf(object, ...keys) {

        const result =
            Number(valueOf(object, ...keys) ?? 0);

        return Number.isFinite(result)
            ? result
            : 0;
    }

    function setText(id, value) {

        document.getElementById(id).textContent =
            value === null ||
            value === undefined ||
            value === ""
                ? "-"
                : value;
    }

    function showButton(id) {
        document
            .getElementById(id)
            .classList.remove("d-none");
    }

    function normalizeStatus(value) {

        return String(value ?? "")
            .trim()
            .toUpperCase()
            .replaceAll(" ", "_");
    }

    function formatStatus(value) {

        if (!value) return "-";

        return String(value)
            .replaceAll("_", " ")
            .toLowerCase()
            .replace(/\b\w/g, letter =>
                letter.toUpperCase()
            );
    }

    function formatScore(value) {

        return Number(value ?? 0).toLocaleString(
            "en-US",
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }
        );
    }

    function formatQty(value) {

        return Number(value ?? 0).toLocaleString(
            "en-US",
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 4
            }
        );
    }

    function formatMoney(value) {

        return Number(value ?? 0).toLocaleString(
            "en-US",
            {
                style: "currency",
                currency: "PHP"
            }
        );
    }

    function formatDate(value) {

        if (!value) return "-";

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return html(value);
        }

        return date.toLocaleDateString(
            "en-US",
            {
                month: "short",
                day: "2-digit",
                year: "numeric"
            }
        );
    }

    function formatDateTime(value) {

        if (!value) return "-";

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return html(value);
        }

        return date.toLocaleString(
            "en-US",
            {
                month: "short",
                day: "2-digit",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            }
        );
    }

    async function readResponse(response) {

        const text = await response.text();

        if (!text) return {};

        try {
            return JSON.parse(text);
        }
        catch {
            return { message: text };
        }
    }

    function showPageAlert(message) {

        const alert =
            document.getElementById("pageAlert");

        alert.textContent = message;
        alert.classList.remove("d-none");
    }

    function hidePageAlert() {

        const alert =
            document.getElementById("pageAlert");

        alert.textContent = "";
        alert.classList.add("d-none");
    }

    function html(value) {

        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }
</script>