        function validateGenerateStep(step) {
            clearGenerateErrors();

            if (step === 1) {
                const period =
                    document.getElementById(
                        "generateEvaluationPeriod"
                    ).value;

                const supplier =
                    document.getElementById(
                        "generateSupplier"
                    ).value;

                const allSuppliers =
                    document.getElementById(
                        "generateAllSuppliers"
                    ).checked;

                if (!period) {
                    showGenerateError(
                        "generateSetupError",
                        "Evaluation period is required."
                    );

                    return false;
                }

                if (!supplier && !allSuppliers) {
                    showGenerateError(
                        "generateSetupError",
                        "Select a supplier or choose Generate for all suppliers."
                    );

                    return false;
                }
            }

            if (step === 2) {
                       if (step === 2 && !generatedMetrics) {
            showGenerateError(
                "generatePreviewError",
                "Evaluation metrics have not been loaded."
            );

            return false;
        }
            }

            if (step === 3) {
                const coa =
                    Number(document.getElementById(
                        "generateCoaScore"
                    ).value);

                const terms =
                    Number(document.getElementById(
                        "generateTermsScore"
                    ).value);

                const afterSales =
                    Number(document.getElementById(
                        "generateAfterSalesScore"
                    ).value);

                if (coa < 0 || coa > 5) {
                    showGenerateError(
                        "generateReliabilityError",
                        "COA score must be between 0 and 5."
                    );

                    return false;
                }

                if (terms < 0 || terms > 3) {
                    showGenerateError(
                        "generateReliabilityError",
                        "Terms score must be between 0 and 3."
                    );

                    return false;
                }

                if (afterSales < 0 || afterSales > 2) {
                    showGenerateError(
                        "generateReliabilityError",
                        "After-sales score must be between 0 and 2."
                    );

                    return false;
                }
            }

            return true;
        }

