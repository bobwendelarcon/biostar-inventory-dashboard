        function formatMonthValue(value) {
            if (!value) {
                return "—";
            }

            const parts =
                value.split("-");

            const year =
                Number(parts[0]);

            const month =
                Number(parts[1]);

            const date =
                new Date(year, month - 1, 1);

            return date.toLocaleDateString(
                "en-PH",
                {
                    year: "numeric",
                    month: "long"
                }
            );
        }
