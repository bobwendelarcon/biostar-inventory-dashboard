                      async function loadSuppliers() {
            try {
                const response = await fetch(
                    "/purchasing/supplier-evaluation/suppliers"
                );

                const text = await response.text();

                let result;

                try {
                    result = text ? JSON.parse(text) : [];
                }
                catch {
                    throw new Error(
                        "Supplier API returned invalid JSON: " + text
                    );
                }

                console.log("Supplier API result:", result);

                if (!response.ok) {
                    throw new Error(
                        result.message ?? "Unable to load suppliers."
                    );
                }

                const suppliers =
                    Array.isArray(result)
                        ? result
                        : result.data ??
                          result.suppliers ??
                          [];

                const generateSelect =
                    document.getElementById("generateSupplier");

                const filterSelect =
                    document.getElementById("filterSupplier");

                generateSelect.innerHTML =
                    '<option value="">-- Select Supplier --</option>';

                filterSelect.innerHTML =
                    '<option value="">-- All Suppliers --</option>';

                suppliers.forEach(function (supplier) {
                    console.log("Supplier row:", supplier);

                    const supplierId =
                        supplier.supplierId ??
                        supplier.SupplierId ??
                        supplier.id ??
                        supplier.Id;

                    const supplierCode =
                        supplier.supplierCode ??
                        supplier.SupplierCode ??
                        "";

                    const supplierName =
                        supplier.supplierName ??
                        supplier.SupplierName ??
                        supplier.name ??
                        supplier.Name ??
                        "";

                    if (
                        supplierId === null ||
                        supplierId === undefined ||
                        supplierId === ""
                    ) {
                        console.warn(
                            "Supplier has no ID:",
                            supplier
                        );

                        return;
                    }

                    const label = supplierCode
                        ? `${supplierCode} - ${supplierName}`
                        : supplierName;

                    const modalOption =
                        document.createElement("option");

                    modalOption.value = String(supplierId);
                    modalOption.textContent = label;

                    generateSelect.appendChild(modalOption);

                    const filterOption =
                        document.createElement("option");

                    filterOption.value = String(supplierId);
                    filterOption.textContent = label;

                    filterSelect.appendChild(filterOption);
                });
            }
            catch (error) {
                console.error("loadSuppliers error:", error);

                alert(
                    error.message ??
                    "Unable to load suppliers."
                );
            }
        }
