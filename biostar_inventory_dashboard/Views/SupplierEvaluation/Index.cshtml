               function getEvaluationStatusBadge(status) {
            const normalizedStatus =
                String(status ?? "").trim().toUpperCase();

            if (normalizedStatus === "FINALIZED") {
                return `
                    <span class="badge bg-success">
                        Finalized
                    </span>
                `;
            }

            if (normalizedStatus === "GENERATED") {
                return `
                    <span class="badge bg-primary">
                        Generated
                    </span>
                `;
            }

            return `
                <span class="badge bg-secondary">
                    ${escapeHtml(normalizedStatus || "Unknown")}
                </span>
            `;
        }

                      function getEvaluationRatingBadge(rating) {
            const normalized =
                String(rating ?? "")
                    .trim()
                    .toUpperCase();

            switch (normalized) {
                case "EXCELLENT":
                    return `
                        <span class="rating-badge rating-excellent">
                            Excellent
                        </span>
                    `;

                case "VERY GOOD":
                    return `
                        <span class="rating-badge rating-very-good">
                            Very Good
                        </span>
                    `;

                case "GOOD":
                    return `
                        <span class="rating-badge rating-satisfactory">
                            Good
                        </span>
                    `;

                case "NEEDS IMPROVEMENT":
                    return `
                        <span class="rating-badge rating-review">
                            Needs Improvement
                        </span>
                    `;

                default:
                    return `
                        <span class="rating-badge rating-review">
                            Poor
                        </span>
                    `;
            }
        }
        function formatScore(value) {
            return Number(value ?? 0).toLocaleString("en-PH", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function formatNumber(value) {
            return Number(value ?? 0).toLocaleString("en-PH", {
                maximumFractionDigits: 4
            });
        }

        function formatMoney(value) {
            return Number(value ?? 0).toLocaleString("en-PH", {
                style: "currency",
                currency: "PHP",
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

                let monthlyEvaluationRecords = [];

        async function loadMonthlySummary() {
            const periodInput =
                document.getElementById("filterEvaluationPeriod");

            const body =
                document.getElementById("evaluationSummaryBody");

            if (!periodInput || !body) {
                return;
            }

            const period = periodInput.value;

            if (!period) {
                body.innerHTML = `
                    <tr>
                        <td colspan="11"
                            class="text-center text-muted py-4">
                            Select an evaluation period.
                        </td>
                    </tr>
                `;

                return;
            }

            const year = Number(period.substring(0, 4));
            const month = Number(period.substring(5, 7));

            body.innerHTML = `
                <tr>
                    <td colspan="11"
                        class="text-center text-muted py-4">
                        <div class="spinner-border spinner-border-sm me-2"></div>
                        Loading evaluations...
                    </td>
                </tr>
            `;

            try {
                const response = await fetch(
                    `/purchasing/supplier-evaluation/monthly-summary` +
                    `?year=${year}&month=${month}`
                );

                const text = await response.text();

                let result;

                try {
                    result = text ? JSON.parse(text) : {};
                }
                catch {
                    throw new Error(
                        "Monthly summary returned invalid JSON."
                    );
                }

                if (!response.ok) {
                    throw new Error(
                        result.message ??
                        "Unable to load the monthly evaluation summary."
                    );
                }

                const summary = result.data ?? result;

                monthlyEvaluationRecords =
                    summary.evaluations ??
                    summary.items ??
                    summary.records ??
                    summary.suppliers ??
                    [];

                updateMonthlySummaryCards(summary);
                applyMonthlyEvaluationFilters();
            }
            catch (error) {
                console.error(
                    "Monthly evaluation summary error:",
                    error
                );

                monthlyEvaluationRecords = [];

                body.innerHTML = `
                    <tr>
                        <td colspan="11"
                            class="text-center text-danger py-4">
                            ${escapeHtml(
                                error.message ??
                                "Unable to load evaluations."
                            )}
                        </td>
                    </tr>
                `;

                updateMonthlySummaryCards({});
            }
        }

              function updateMonthlySummaryCards(summary) {
            const evaluations =
                Array.isArray(summary.evaluations)
                    ? summary.evaluations
                    : [];

            document.getElementById(
                "summaryTotalEvaluations"
            ).textContent =
                Number(summary.totalEvaluations ?? evaluations.length);

            document.getElementById(
                "summaryAverageScore"
            ).textContent =
                `${formatScore(
                    summary.averageTotalScore ?? 0
                )}%`;

            document.getElementById(
                "summaryExcellentCount"
            ).textContent =
                Number(summary.excellentCount ?? 0);

            document.getElementById(
                "summaryGeneratedCount"
            ).textContent =
                Number(summary.generatedCount ?? 0);
        }

        function applyMonthlyEvaluationFilters() {
            const supplierValue =
                document.getElementById("filterSupplier")?.value ?? "";

            const ratingValue =
                document.getElementById("filterRating")?.value ?? "";

            const statusValue =
                document.getElementById("filterStatus")?.value ?? "";

            const filteredRecords =
                monthlyEvaluationRecords.filter(function (evaluation) {
                    const supplierId = String(
                        evaluation.supplierId ??
                        evaluation.SupplierId ??
                        ""
                    );

                    const rating =
                        getEvaluationRating(evaluation);

                    const status =
                        getEvaluationStatus(evaluation);

                    const supplierMatches =
                        !supplierValue ||
                        supplierId === String(supplierValue);

                    const ratingMatches =
                        !ratingValue ||
                        rating.toUpperCase() ===
                            ratingValue.toUpperCase();

                    const statusMatches =
                        !statusValue ||
                        status === statusValue.toUpperCase();

                    return supplierMatches &&
                        ratingMatches &&
                        statusMatches;
                });

            renderMonthlyEvaluationTable(filteredRecords);
        }

        function renderMonthlyEvaluationTable(evaluations) {
            const body =
                document.getElementById("evaluationSummaryBody");

            const countBadge =
                document.getElementById("summarySupplierCount");

            body.innerHTML = "";

            const records =
                Array.isArray(evaluations)
                    ? evaluations
                    : [];

            if (countBadge) {
                countBadge.textContent =
                    `${records.length} ` +
                    `${records.length === 1
                        ? "supplier"
                        : "suppliers"}`;
            }

            if (records.length === 0) {
                body.innerHTML = `
                    <tr>
                        <td colspan="11"
                            class="text-center text-muted py-4">
                            No supplier evaluations were found for
                            the selected period.
                        </td>
                    </tr>
                `;

                return;
            }

            records.forEach(function (evaluation) {
                const evaluationId =
                    Number(evaluation.evaluationId ?? 0);

                const supplierName =
                    evaluation.supplierName || "Unknown Supplier";

                const supplierCode =
                    evaluation.supplierCode || "-";

                const year =
                    Number(evaluation.evaluationYear ?? 0);

                const month =
                    Number(evaluation.evaluationMonth ?? 0);

                const qualityRaw =
                    Number(evaluation.qualityScore ?? 0);

                const deliveryRaw =
                    Number(evaluation.onTimeDeliveryScore ?? 0);

                const costRaw =
                    Number(evaluation.costCompetitivenessScore ?? 0);

                const reliabilityRaw =
                    Number(evaluation.reliabilityScore ?? 0);

                const totalScore =
                    Number(evaluation.totalScore ?? 0);

                /*
                 * DTO currently sends raw 0–100 scores.
                 * Convert them to their weighted values for the table.
                 */
                const qualityWeighted =
                    roundFrontendScore(qualityRaw * 0.40);

                const deliveryWeighted =
                    roundFrontendScore(deliveryRaw * 0.30);

                const costWeighted =
                    roundFrontendScore(costRaw * 0.20);

                const reliabilityWeighted =
                    roundFrontendScore(reliabilityRaw * 0.10);

                const rating =
                    String(
                        evaluation.performanceRating ?? "POOR"
                    );

                const status =
                    String(
                        evaluation.status ?? ""
                    );

                const periodText =
                    formatEvaluationPeriod(year, month);

                const row =
                    document.createElement("tr");

                row.innerHTML = `
                    <td>
                        <div class="fw-semibold">
                            ${escapeHtml(supplierName)}
                        </div>

                        <div class="table-subtext">
                            Supplier Code:
                            ${escapeHtml(supplierCode)}
                        </div>
                    </td>

                    <td>
                        ${escapeHtml(periodText)}
                    </td>

                    <td class="text-center">
                        <span class="badge bg-light text-dark border">
                            1
                        </span>
                    </td>

                    <td class="text-center score-number">
                        ${formatScore(qualityWeighted)}
                    </td>

                    <td class="text-center score-number">
                        ${formatScore(deliveryWeighted)}
                    </td>

                    <td class="text-center score-number">
                        ${formatScore(costWeighted)}
                    </td>

                    <td class="text-center score-number">
                        ${formatScore(reliabilityWeighted)}
                    </td>

                    <td class="text-center">
                        <span class="fw-bold fs-6">
                            ${formatScore(totalScore)}%
                        </span>
                    </td>

                    <td>
                        ${getEvaluationRatingBadge(rating)}
                    </td>

                    <td>
                        ${getEvaluationStatusBadge(status)}
                    </td>

                    <td class="text-center">
                        <a
                            href="/purchasing/supplier-evaluation/details/${evaluationId}"
                            class="btn btn-sm btn-outline-primary">
                            View Details
                        </a>
                    </td>
                `;

                body.appendChild(row);
            });
        }

        function getEvaluationRating(evaluation) {
            return String(
                evaluation.performanceRating ??
                evaluation.rating ??
                evaluation.PerformanceRating ??
                "Poor"
            ).trim();
        }

        function getEvaluationStatus(evaluation) {
            return String(
                evaluation.status ??
                evaluation.Status ??
                ""
            ).trim().toUpperCase();
        }

        function calculateAverageScore(evaluations) {
            if (!evaluations.length) {
                return 0;
            }

            const total = evaluations.reduce(
                function (sum, evaluation) {
                    return sum + Number(
                        evaluation.totalScore ??
                        evaluation.overallScore ??
                        0
                    );
                },
                0
            );

            return total / evaluations.length;
        }

        function formatEvaluationPeriod(year, month) {
            const numericYear = Number(year);
            const numericMonth = Number(month);

            if (!numericYear ||
                numericMonth < 1 ||
                numericMonth > 12) {
                return "-";
            }

            return new Date(
                numericYear,
                numericMonth - 1,
                1
            ).toLocaleDateString("en-US", {
                month: "long",
                year: "numeric"
            });
        }



