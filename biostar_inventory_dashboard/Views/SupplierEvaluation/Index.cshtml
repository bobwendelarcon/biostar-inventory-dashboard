        function moveGenerateEvaluationStep(direction) {
            if (direction > 0 &&
                !validateGenerateStep(generateEvaluationStep)) {
                return;
            }

            generateEvaluationStep += direction;

            if (generateEvaluationStep < 1) {
                generateEvaluationStep = 1;
            }

            if (generateEvaluationStep > 4) {
                generateEvaluationStep = 4;
            }

            if (generateEvaluationStep === 2) {
                loadGeneratePreviewRecords();
            }

            if (generateEvaluationStep === 4) {
                calculateGenerateScorePreview();
            }

            renderGenerateEvaluationStep();
        }

        function renderGenerateEvaluationStep() {
            for (let step = 1; step <= 4; step++) {
                document.getElementById(
                    `generateStep${step}`
                ).classList.toggle(
                    "d-none",
                    step !== generateEvaluationStep
                );

                const badge =
                    document.getElementById(
                        `generateStepBadge${step}`
                    );

                badge.className =
                    step === generateEvaluationStep
                        ? "badge bg-primary px-3 py-2"
                        : "badge bg-light text-dark border px-3 py-2";
            }

            document.getElementById("btnGeneratePrevious")
                .classList.toggle(
                    "d-none",
                    generateEvaluationStep === 1
                );

            document.getElementById("btnGenerateNext")
                .classList.toggle(
                    "d-none",
                    generateEvaluationStep === 4
                );

