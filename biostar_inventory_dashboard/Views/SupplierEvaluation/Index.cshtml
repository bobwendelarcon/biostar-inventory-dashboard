        function updateReliabilityTotal() {
            const total =
                Number(document.getElementById(
                    "generateCoaScore"
                ).value || 0) +
                Number(document.getElementById(
                    "generateTermsScore"
                ).value || 0) +
                Number(document.getElementById(
