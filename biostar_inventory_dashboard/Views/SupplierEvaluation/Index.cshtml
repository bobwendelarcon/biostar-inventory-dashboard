<!-- Generate Evaluation Modal -->
<div class="modal fade"
     id="generateEvaluationModal"
     tabindex="-1"
     aria-labelledby="generateEvaluationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title"
                        id="generateEvaluationModalLabel">
                        Generate Supplier Evaluation
                    </h5>

                    <small class="text-muted">
                        Select the evaluation period and preview the transactions to include.
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <!-- Steps -->
                <div class="d-flex flex-wrap gap-2 mb-4">

                    <span id="generateStepBadge1"
                          class="badge bg-primary px-3 py-2">
                        1. Evaluation Setup
                    </span>

                    <span id="generateStepBadge2"
                          class="badge bg-light text-dark border px-3 py-2">
                        2. Metrics Preview
                    </span>

                    <span id="generateStepBadge3"
                          class="badge bg-light text-dark border px-3 py-2">
                        3. Reliability
                    </span>

                    <span id="generateStepBadge4"
                          class="badge bg-light text-dark border px-3 py-2">
                        4. Score Preview
                    </span>

                </div>

                <!-- Step 1 -->
                <div id="generateStep1">

                    <div class="card border-0 bg-light mb-3">
                        <div class="card-body">

                            <h6 class="mb-3">
                                Evaluation Setup
                            </h6>

                            <div class="row g-3">

                                <div class="col-md-4">

                                    <label for="generateEvaluationPeriod"
                                           class="form-label fw-semibold">
                                        Evaluation Period
                                    </label>

                                    <input type="month"
                                           id="generateEvaluationPeriod"
                                           class="form-control">

                                </div>

                                <div class="col-md-5">

                                    <label for="generateSupplier"
                                           class="form-label fw-semibold">
                                        Supplier
                                    </label>

                                    <select id="generateSupplier"
                                            class="form-select">
                                        <option value="">
                                            -- Select Supplier --
                                        </option>
                                    </select>

                                </div>

                                <div class="col-md-3 d-flex align-items-end">

                                    <div class="form-check mb-2">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="generateAllSuppliers">

                                        <label class="form-check-label"
                                               for="generateAllSuppliers">
                                            Generate for all suppliers
                                        </label>

                                    </div>

                                </div>

                                <div class="col-12">

                                    <label for="generateEvaluationRemarks"
                                           class="form-label fw-semibold">
                                        Evaluation Remarks
                                    </label>

                                    <textarea id="generateEvaluationRemarks"
                                              class="form-control"
                                              rows="3"
                                              placeholder="Optional remarks for this evaluation period"></textarea>

                                </div>

                            </div>

                        </div>
                    </div>

                    <div id="generateSetupError"
                         class="alert alert-danger d-none">
                    </div>

                </div>

                <!-- Step 2 -->
                <div id="generateStep2" class="d-none">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="mb-0">Calculated Evaluation Metrics</h6>
                            <small class="text-muted">
                                Review the automatic monthly calculations before continuing.
                            </small>
                        </div>
                    </div>

                    <div id="generatePreviewLoading"
                         class="text-center text-muted py-5">
                        <div class="spinner-border spinner-border-sm me-2"></div>
                        Calculating supplier metrics...
                    </div>

                    <div id="generateMetricsContainer"
                         class="row g-3 d-none">

                        <div class="col-xl-4">
                            <div class="card h-100 border-danger">
                                <div class="card-body">
                                    <h6>Quality</h6>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Receiving Reports</span>
                                        <strong id="previewReceivingReports">0</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>QC Inspections</span>
                                        <strong id="previewQcInspections">0</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Received Qty</span>
                                        <strong id="previewReceivedQty">0.00</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Accepted Qty</span>
                                        <strong id="previewAcceptedQty">0.00</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Rejected Qty</span>
                                        <strong id="previewRejectedQty">0.00</strong>
                                    </div>

                                    <hr>

                                    <div class="d-flex justify-content-between">
                                        <span>Quality Score</span>
                                        <strong id="previewQualityScore">0.00%</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4">
                            <div class="card h-100 border-warning">
                                <div class="card-body">
                                    <h6>Delivery</h6>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Scheduled Deliveries</span>
                                        <strong id="previewScheduledDeliveries">0</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Completed</span>
                                        <strong id="previewCompletedDeliveries">0</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>On Time</span>
                                        <strong id="previewOnTimeDeliveries">0</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Late</span>
                                        <strong id="previewLateDeliveries">0</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Average Delay</span>
                                        <strong id="previewAverageDelay">0.00 days</strong>
                                    </div>

                                    <hr>

                                    <div class="d-flex justify-content-between">
                                        <span>Delivery Score</span>
                                        <strong id="previewDeliveryScore">0.00%</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4">
                            <div class="card h-100 border-success">
                                <div class="card-body">
                                    <h6>Cost</h6>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Purchase Orders</span>
                                        <strong id="previewPoCount">0</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>PO Lines</span>
                                        <strong id="previewPoLineCount">0</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Supplier Avg. Price</span>
                                        <strong id="previewSupplierAvgPrice">₱0.00</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Comparison Avg. Price</span>
                                        <strong id="previewComparisonAvgPrice">₱0.00</strong>
                                    </div>

                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Price Variance</span>
                                        <strong id="previewPriceVariance">0.00%</strong>
                                    </div>

                                    <hr>

                                    <div class="d-flex justify-content-between">
                                        <span>Cost Score</span>
                                        <strong id="previewCostScore">0.00%</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div id="generatePreviewError"
                         class="alert alert-danger mt-3 d-none">
                    </div>

                </div>

                <!-- Step 3 -->
                <div id="generateStep3"
                     class="d-none">

                    <div class="card border-0 bg-light">

                        <div class="card-body">

                            <h6 class="mb-1">
                                Reliability / After-Sales Assessment
                            </h6>

                            <small class="text-muted">
                                This section is manually entered by Purchasing.
                            </small>

                            <div class="row g-3 mt-2">

                                <div class="col-md-4">

                                    <label for="generateCoaScore"
                                           class="form-label fw-semibold">
                                        Documentation / COA
                                    </label>

                                    <div class="input-group">

                                        <input type="number"
                                               id="generateCoaScore"
                                               class="form-control reliability-score"
                                               value="5"
                                               min="0"
                                               max="5"
                                               step="0.5">

                                        <span class="input-group-text">
                                            / 5
                                        </span>

                                    </div>

                                </div>

                                <div class="col-md-4">

