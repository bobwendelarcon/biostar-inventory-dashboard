                function calculateGenerateScorePreview() {
            if (!generatedMetrics) {
                showGenerateError(
                    "generatePreviewError",
                    "Evaluation metrics have not been loaded."
                );

                return;
            }

            const quality =
                generatedMetrics.quality ?? {};

            const delivery =
                generatedMetrics.delivery ?? {};

            const cost =
                generatedMetrics.cost ?? {};

            /*
             * Backend raw scores are from 0 to 100.
             */
            const qualityRawScore =
                normalizeFrontendScore(
                    Number(quality.qualityScore ?? 0)
                );

            const deliveryRawScore =
                normalizeFrontendScore(
                    Number(delivery.deliveryScore ?? 0)
                );

            const costRawScore =
                normalizeFrontendScore(
                    Number(cost.costScore ?? 0)
                );

            /*
             * Current reliability UI totals 10 points:
             * Documentation = 5
             * Terms = 3
             * After Sales = 2
             *
             * Convert the 0–10 UI score into a 0–100 raw score
             * before applying the backend's 10% weight.
             */
            const documentationScore =
                Number(
                    document.getElementById(
                        "generateCoaScore"
                    ).value || 0
                );

            const termsScore =
                Number(
                    document.getElementById(
                        "generateTermsScore"
                    ).value || 0
                );

            const afterSalesScore =
                Number(
                    document.getElementById(
                        "generateAfterSalesScore"
                    ).value || 0
                );

            const reliabilityPointTotal =
                documentationScore +
                termsScore +
                afterSalesScore;

            const reliabilityRawScore =
                normalizeFrontendScore(
                    reliabilityPointTotal * 10
                );

            /*
             * Match SupplierEvaluationScoringService:
             *
             * Quality     = raw × 0.40
             * Delivery    = raw × 0.30
             * Cost        = raw × 0.20
             * Reliability = raw × 0.10
             */
            const qualityWeighted =
                roundFrontendScore(
                    qualityRawScore * 0.40
                );

            const deliveryWeighted =
                roundFrontendScore(
                    deliveryRawScore * 0.30
                );

            const costWeighted =
                roundFrontendScore(
                    costRawScore * 0.20
                );

            const reliabilityWeighted =
                roundFrontendScore(
                    reliabilityRawScore * 0.10
                );

            const overallScore =
                roundFrontendScore(
                    qualityWeighted +
                    deliveryWeighted +
                    costWeighted +
                    reliabilityWeighted
                );

            const supplierSelect =
                document.getElementById(
                    "generateSupplier"
                );

            const supplierName =
                supplierSelect.options[
                    supplierSelect.selectedIndex
                ]?.text || "—";

            const period =
                document.getElementById(
                    "generateEvaluationPeriod"
                ).value;

            document.getElementById(
                "generateQualityPreview"
            ).textContent =
                `${formatScore(qualityWeighted)} / 40`;

            document.getElementById(
                "generateDeliveryPreview"
            ).textContent =
                `${formatScore(deliveryWeighted)} / 30`;

            document.getElementById(
                "generateCostPreview"
            ).textContent =
                `${formatScore(costWeighted)} / 20`;

            document.getElementById(
                "generateReliabilityPreview"
            ).textContent =
                `${formatScore(reliabilityWeighted)} / 10`;

            document.getElementById(
                "generateOverallPreview"
            ).textContent =
                `${formatScore(overallScore)}%`;

            document.getElementById(
                "generateSupplierPreview"
            ).textContent =
                supplierName;

            document.getElementById(
                "generatePeriodPreview"
            ).textContent =
                formatMonthValue(period);

            document.getElementById(
                "generateRatingPreview"
            ).innerHTML =
                getEvaluationRatingBadge(
                    getRatingFromScore(overallScore)
                );
        }

                function normalizeFrontendScore(score) {
            const numericScore =
                Number(score ?? 0);

            if (!Number.isFinite(numericScore)) {
                return 0;
            }

            return Math.min(
                100,
                Math.max(0, numericScore)
            );
        }

        function roundFrontendScore(score) {
            return Math.round(
                (Number(score ?? 0) + Number.EPSILON) * 100
            ) / 100;
        }

               function getRatingFromScore(score) {
            const normalized =
                normalizeFrontendScore(score);

            if (normalized >= 90) {
                return "Excellent";
            }

            if (normalized >= 80) {
                return "Very Good";
            }

            if (normalized >= 70) {
                return "Good";
            }

            if (normalized >= 60) {
                return "Needs Improvement";
            }

            return "Poor";
        }

              async function generateEvaluation() {

            const supplierId =
                Number(document.getElementById("generateSupplier").value);

            const period =
                document.getElementById("generateEvaluationPeriod").value;

            if (!supplierId || !period) {

                Swal.fire(
                    "Validation",
                    "Supplier and evaluation period are required.",
                    "warning");

                return;
            }

                    const reliabilityPoints =
            Number(
                document.getElementById(
                    "generateCoaScore"
                ).value || 0
            ) +
            Number(
                document.getElementById(
                    "generateTermsScore"
                ).value || 0
            ) +
            Number(
                document.getElementById(
                    "generateAfterSalesScore"
                ).value || 0
            );

        const reliabilityScore =
            Math.min(
                100,
                Math.max(0, reliabilityPoints * 10)
            );

            const year =
                Number(period.substring(0,4));

            const month =
                Number(period.substring(5,7));

            const response =
                await fetch(
                    "/purchasing/supplier-evaluation/generate",
                    {
                        method:"POST",
                        headers:{
                            "Content-Type":"application/json"
                        },
                               body: JSON.stringify({
            supplierId,
            evaluationYear: year,
            evaluationMonth: month,

            reliabilityScore,

            reliabilityRemarks:
                document
                    .getElementById(
                        "generateReliabilityRemarks"
                    )
                    .value
                    .trim(),

            remarks:
                document
                    .getElementById(
                        "generateEvaluationRemarks"
                    )
                    .value
                    .trim()
        })
                    });

                   const result = await response.json();

        if (response.ok && result.success) {

            alert(
                result.message ??
                "Supplier evaluation generated successfully."
            );

            window.location.href =
                "/purchasing/supplier-evaluation/details/" +
                result.evaluationId;

            return;
        }

        alert(
            result.message ??
            "Unable to generate supplier evaluation."
        );

        }

