@{
    ViewData["Title"] = "Supplier Performance Evaluation";
}

<style>
    .supplier-evaluation-page {
        padding-bottom: 40px;
    }

    .evaluation-card,
    .filter-card,
    .table-card {
        border: 0;
        border-radius: 12px;
    }

    .summary-label {
        color: #6c757d;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .summary-value {
        margin-top: 6px;
        font-size: 1.8rem;
        font-weight: 700;
    }

    .section-title {
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #495057;
    }

    .score-box {
        border-radius: 10px;
        padding: 14px;
        height: 100%;
    }

    .score-quality {
        background: #fde2e2;
    }

    .score-delivery {
        background: #fff3cd;
    }

    .score-cost {
        background: #dfeedd;
    }

    .score-reliability {
        background: #e7e0f4;
    }

    .criteria-title {
        font-weight: 700;
        font-size: .9rem;
    }

    .criteria-weight {
        color: #6c757d;
        font-size: .78rem;
    }

    .criteria-score {
        margin-top: 8px;
        font-size: 1.45rem;
        font-weight: 700;
    }

    .evaluation-table {
        white-space: nowrap;
        margin-bottom: 0;
    }

        .evaluation-table thead th {
            background: #f8f9fa;
            font-size: .75rem;
            text-transform: uppercase;
            vertical-align: middle;
            padding: 10px 8px;
        }

        .evaluation-table tbody td {
            font-size: .82rem;
            vertical-align: middle;
            padding: 9px 8px;
        }

    .rating-badge {
        display: inline-block;
        min-width: 95px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
        text-align: center;
    }

    .rating-excellent {
        background: #d1e7dd;
        color: #0f5132;
    }

    .rating-very-good {
        background: #cff4fc;
        color: #055160;
    }

    .rating-satisfactory {
        background: #fff3cd;
        color: #664d03;
    }

    .rating-review {
        background: #f8d7da;
        color: #842029;
    }

    .score-number {
        font-weight: 700;
    }

    .table-subtext {
        font-size: .72rem;
        color: #6c757d;
    }

    .evaluation-header {
        border-left: 4px solid #0d6efd;
        padding-left: 12px;
    }
</style>

<div class="container-fluid supplier-evaluation-page">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="evaluation-header">
            <h3 class="mb-0">Supplier Performance Evaluation</h3>
            <small class="text-muted">
                Monthly evaluation of supplier quality, delivery, cost, and reliability.
            </small>
        </div>

        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-outline-secondary">
                <i class="bi bi-printer me-1"></i>
                Print
            </button>

            <button type="button"
                    id="btnGenerateEvaluation"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#generateEvaluationModal">
                <i class="bi bi-plus-circle me-1"></i>
                Generate Evaluation
            </button>
        </div>
    </div>

    <!-- Summary -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="card evaluation-card shadow-sm">
                <div class="card-body">
                    <div class="summary-label">Total Evaluations</div>
                    <div id="summaryTotalEvaluations"
                         class="summary-value">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card evaluation-card shadow-sm">
                <div class="card-body">
                    <div class="summary-label">Average Score</div>
                    <div id="summaryAverageScore"
                         class="summary-value">
                        0.00%
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card evaluation-card shadow-sm">
                <div class="card-body">
                    <div class="summary-label">Excellent Suppliers</div>
                    <div id="summaryExcellentCount"
                         class="summary-value">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card evaluation-card shadow-sm">
                <div class="card-body">
                    <div class="summary-label">Generated</div>
                    <div id="summaryGeneratedCount"
                         class="summary-value">
                        0
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Filters -->
    <div class="card filter-card shadow-sm mb-4">
        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-xl-3 col-md-6">
                    <label class="form-label small fw-semibold">
                        Evaluation Period
                    </label>

                    <input type="month"
                           id="filterEvaluationPeriod"
                           class="form-control">
                </div>

                <div class="col-xl-3 col-md-6">
                    <label class="form-label small fw-semibold">
                        Supplier
                    </label>

                    <select id="filterSupplier" class="form-select">
                        <option value="">-- All Suppliers --</option>
                    </select>
                </div>

                <div class="col-xl-2 col-md-6">
                    <label class="form-label small fw-semibold">
                        Rating
                    </label>

                    <select id="filterRating" class="form-select">
                        <option value="">All Ratings</option>
                        <option value="Excellent">Excellent</option>
                        <option value="Very Good">Very Good</option>
                        <option value="Good">Good</option>
                        <option value="Needs Improvement">Needs Improvement</option>
                        <option value="Poor">Poor</option>
                    </select>
                </div>

                <div class="col-xl-2 col-md-6">
                    <label class="form-label small fw-semibold">
                        Status
                    </label>

                    <select id="filterStatus" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="GENERATED">Generated</option>
                        <option value="FINALIZED">Finalized</option>
                    </select>
                </div>

                <div class="col-xl-auto col-md-6">
                    <button type="button"
                            id="btnSearchEvaluations"
                            class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>
                </div>

                <div class="col-xl-auto col-md-6">
                    <button type="button"
                            id="btnClearEvaluationFilters"
                            class="btn btn-outline-secondary w-100">
                        Clear
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- Weighting cards -->
    <div class="card evaluation-card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0">Evaluation Criteria</h5>
                    <small class="text-muted">
                        Current supplier scoring weights
                    </small>
                </div>

                <span class="badge bg-dark">
                    Total Weight: 100%
                </span>
            </div>

            <div class="row g-3">

                <div class="col-xl-3 col-md-6">
                    <div class="score-box score-quality">
                        <div class="criteria-title">Quality</div>
                        <div class="criteria-weight">Maximum Weight</div>
                        <div class="criteria-score">40%</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="score-box score-delivery">
                        <div class="criteria-title">On-Time Delivery</div>
                        <div class="criteria-weight">Maximum Weight</div>
                        <div class="criteria-score">30%</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="score-box score-cost">
                        <div class="criteria-title">Cost Competitiveness</div>
                        <div class="criteria-weight">Maximum Weight</div>
                        <div class="criteria-score">20%</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="score-box score-reliability">
                        <div class="criteria-title">Reliability / After Sales</div>
                        <div class="criteria-weight">Maximum Weight</div>
                        <div class="criteria-score">10%</div>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Evaluation list -->
    <!-- Monthly supplier summary -->
    <div class="card table-card shadow-sm">

        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                <div>
                    <h5 class="mb-0">Monthly Supplier Evaluation Summary</h5>

                    <small class="text-muted">
                        One consolidated evaluation per supplier for the selected period.
                    </small>
                </div>

                <span id="summarySupplierCount"
                      class="badge bg-light text-dark border">
                    0 suppliers
                </span>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-hover evaluation-table">

                <thead>
                    <tr>
                        <th>Supplier</th>
                        <th>Evaluation Period</th>
                        <th class="text-center">Evaluated Transactions</th>
                        <th class="text-center">Quality<br>40%</th>
                        <th class="text-center">Delivery<br>30%</th>
                        <th class="text-center">Cost<br>20%</th>
                        <th class="text-center">Reliability<br>10%</th>
                        <th class="text-center">Overall Score</th>
                        <th>Rating</th>
                        <th>Status</th>
