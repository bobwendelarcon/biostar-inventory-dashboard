@{
    ViewData["Title"] = "Supplier Performance Evaluation";
}

<style>
    .supplier-evaluation-page {
        padding-bottom: 40px;
    }

    .evaluation-header {
        border-left: 4px solid #0d6efd;
        padding-left: 12px;
    }

    .evaluation-card,
    .filter-card,
    .table-card {
        border: 0;
        border-radius: 12px;
    }

    .summary-label {
        color: #6c757d;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .summary-value {
        margin-top: 6px;
        font-size: 1.8rem;
        font-weight: 700;
    }

    .score-box {
        border-radius: 10px;
        padding: 14px;
        height: 100%;
    }

    .score-quality {
        background: #fde2e2;
    }

    .score-delivery {
        background: #fff3cd;
    }

    .score-cost {
        background: #dfeedd;
    }

    .score-reliability {
        background: #e7e0f4;
    }

    .criteria-title {
        font-weight: 700;
        font-size: .9rem;
    }

    .criteria-weight {
        color: #6c757d;
        font-size: .78rem;
    }

    .criteria-score {
        margin-top: 8px;
        font-size: 1.45rem;
        font-weight: 700;
    }

    .evaluation-table {
        white-space: nowrap;
        margin-bottom: 0;
    }

        .evaluation-table thead th {
            background: #f8f9fa;
            font-size: .72rem;
            text-transform: uppercase;
            vertical-align: middle;
            padding: 10px 8px;
        }

        .evaluation-table tbody td {
            font-size: .82rem;
            vertical-align: middle;
            padding: 9px 8px;
        }

    .table-subtext {
        font-size: .72rem;
        color: #6c757d;
    }

    .score-number {
        font-weight: 700;
    }

    .rating-badge {
        display: inline-block;
        min-width: 105px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 700;
        text-align: center;
    }

    .rating-excellent {
        background: #d1e7dd;
        color: #0f5132;
    }

    .rating-very-good {
        background: #cff4fc;
        color: #055160;
    }

    .rating-good {
        background: #fff3cd;
        color: #664d03;
    }

    .rating-poor {
        background: #f8d7da;
        color: #842029;
    }
</style>


<div class="container-fluid supplier-evaluation-page">

    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

        <div class="evaluation-header">

            <h3 class="mb-0">
                Supplier Performance Evaluation
            </h3>

            <small class="text-muted">
                Supplier evaluations automatically generated from committed QA/QC deliveries.
            </small>

        </div>

        <div>
            <button type="button"
                    id="btnRefreshEvaluations"
                    class="btn btn-outline-primary">

                <i class="bi bi-arrow-clockwise me-1"></i>
                Refresh

            </button>
        </div>

    </div>


    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="card evaluation-card shadow-sm">
                <div class="card-body">

                    <div class="summary-label">
                        Total Evaluations
                    </div>

                    <div id="summaryTotalEvaluations"
                         class="summary-value">
                        0
                    </div>

                </div>
            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card evaluation-card shadow-sm">
                <div class="card-body">

                    <div class="summary-label">
                        Average Score
                    </div>

                    <div id="summaryAverageScore"
                         class="summary-value">
                        0.00%
                    </div>

                </div>
            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card evaluation-card shadow-sm">
                <div class="card-body">

                    <div class="summary-label">
                        Pending Purchasing
                    </div>

                    <div id="summaryPendingCount"
                         class="summary-value">
                        0
                    </div>

                </div>
            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card evaluation-card shadow-sm">
                <div class="card-body">

                    <div class="summary-label">
                        Finalized
                    </div>

                    <div id="summaryFinalizedCount"
                         class="summary-value">
                        0
                    </div>

                </div>
            </div>

        </div>

    </div>


    <!-- FILTERS -->
    <div class="card filter-card shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-xl-3 col-md-6">

                    <label class="form-label small fw-semibold">
                        Evaluation Period
                    </label>

                    <input type="month"
                           id="filterEvaluationPeriod"
                           class="form-control">

                </div>


                <div class="col-xl-3 col-md-6">

                    <label class="form-label small fw-semibold">
                        Supplier
                    </label>

                    <select id="filterSupplier"
                            class="form-select">

                        <option value="">
                            -- All Suppliers --
                        </option>

                    </select>

                </div>


                <div class="col-xl-2 col-md-6">

                    <label class="form-label small fw-semibold">
                        Rating
                    </label>

                    <select id="filterRating"
                            class="form-select">

                        <option value="">
                            All Ratings
                        </option>

                        <option value="EXCELLENT">
                            Excellent
                        </option>

                        <option value="VERY GOOD">
                            Very Good
                        </option>

                        <option value="GOOD">
                            Good
                        </option>

                        <option value="NEEDS IMPROVEMENT">
                            Needs Improvement
                        </option>

                        <option value="POOR">
                            Poor
                        </option>

                    </select>

                </div>


                <div class="col-xl-2 col-md-6">

                    <label class="form-label small fw-semibold">
                        Status
                    </label>

                    <select id="filterStatus"
                            class="form-select">

                        <option value="">
                            All Statuses
                        </option>

                        <option value="PENDING_PURCHASING">
                            Pending Purchasing
                        </option>

                        <option value="FINALIZED">
                            Finalized
                        </option>

                    </select>

                </div>


                <div class="col-xl-auto col-md-6">

                    <button type="button"
                            id="btnSearchEvaluations"
                            class="btn btn-primary w-100">

                        <i class="bi bi-search me-1"></i>
                        Search

                    </button>

                </div>


                <div class="col-xl-auto col-md-6">

                    <button type="button"
                            id="btnClearEvaluationFilters"
                            class="btn btn-outline-secondary w-100">

                        Clear

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- CRITERIA -->
    <div class="card evaluation-card shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>

                    <h5 class="mb-0">
                        Evaluation Criteria
                    </h5>

                    <small class="text-muted">
                        Current supplier performance scoring weights
                    </small>

                </div>

                <span class="badge bg-dark">
                    Total Weight: 100%
                </span>

            </div>


            <div class="row g-3">

                <div class="col-xl-3 col-md-6">

                    <div class="score-box score-quality">

                        <div class="criteria-title">
                            Quality
                        </div>

                        <div class="criteria-weight">
                            Maximum Weight
                        </div>

                        <div class="criteria-score">
                            40%
                        </div>

                    </div>

                </div>


                <div class="col-xl-3 col-md-6">

                    <div class="score-box score-delivery">

                        <div class="criteria-title">
                            Delivery
                        </div>

                        <div class="criteria-weight">
                            On-Time + In-Full
                        </div>

                        <div class="criteria-score">
                            30%
                        </div>

                    </div>

                </div>


                <div class="col-xl-3 col-md-6">

                    <div class="score-box score-cost">

                        <div class="criteria-title">
                            Cost Competitiveness
                        </div>

                        <div class="criteria-weight">
                            New Price vs Previous Price
                        </div>

                        <div class="criteria-score">
                            20%
                        </div>

                    </div>

                </div>


                <div class="col-xl-3 col-md-6">

                    <div class="score-box score-reliability">

                        <div class="criteria-title">
                            Reliability / After Sales
                        </div>

                        <div class="criteria-weight">
                            Purchasing Assessment
                        </div>

                        <div class="criteria-score">
                            10%
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- LIST -->
    <div class="card table-card shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                <div>

                    <h5 class="mb-0">
                        Supplier Evaluations
                    </h5>

                    <small class="text-muted">
                        Each record represents one committed delivery / QC evaluation.
                    </small>

                </div>

                <span id="evaluationRecordCount"
                      class="badge bg-light text-dark border">

                    0 records

                </span>

            </div>

        </div>


        <div class="table-responsive">

            <table class="table table-hover evaluation-table">

                <thead>

                    <tr>

                        <th>
                            Evaluation
                        </th>

                        <th>
                            Supplier
                        </th>

                        <th>
                            PO / RR / QC
                        </th>

                        <th>
                            Delivery Date
                        </th>

                        <th class="text-center">
                            Quality
                            <br>
                            40%
                        </th>

                        <th class="text-center">
                            Delivery
                            <br>
                            30%
                        </th>

                        <th class="text-center">
                            Cost
                            <br>
                            20%
                        </th>

                        <th class="text-center">
                            Reliability
                            <br>
                            10%
                        </th>

                        <th class="text-center">
                            Overall
                        </th>

                        <th>
                            Rating
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-center">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody id="evaluationBody">

                    <tr>

                        <td colspan="12"
                            class="text-center text-muted py-4">

                            Loading supplier evaluations...

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        let evaluationRecords = [];


        document.addEventListener(
            "DOMContentLoaded",
            async function () {

                setDefaultPeriod();

                await loadSuppliers();

                await loadPageData();


                document
                    .getElementById("btnSearchEvaluations")
                    .addEventListener(
                        "click",
                        loadPageData
                    );


                document
                    .getElementById(
                        "btnRefreshEvaluations"
                    )
                    .addEventListener(
                        "click",
                        loadPageData
                    );


                document
                    .getElementById(
                        "btnClearEvaluationFilters"
                    )
                    .addEventListener(
                        "click",
                        clearFilters
                    );


                document
                    .getElementById("filterRating")
                    .addEventListener(
                        "change",
                        applyClientFilters
                    );
            }
        );


        function setDefaultPeriod() {

            const now =
                new Date();

            const year =
                now.getFullYear();

            const month =
                String(
                    now.getMonth() + 1
                ).padStart(2, "0");

            document
                .getElementById(
                    "filterEvaluationPeriod"
                )
                .value =
                    `${year}-${month}`;
        }


        async function loadPageData() {

            await Promise.all([
                loadEvaluations(),
                loadSummary()
            ]);
        }


        async function loadSuppliers() {

            const supplierSelect =
                document.getElementById(
                    "filterSupplier"
                );

            try {

                const response =
                    await fetch(
                        "/purchasing/supplier-evaluation/suppliers"
                    );

                const result =
                    await readResponse(response);

                if (!response.ok) {

                    throw new Error(
                        result.message ??
                        "Unable to load suppliers."
                    );
                }


                const suppliers =
                    Array.isArray(result)
                        ? result
                        : result.data ??
                          result.items ??
                          result.suppliers ??
                          [];


                suppliers
                    .filter(x =>
                        x.isDeleted !== true &&
                        x.isActive !== false
                    )
                    .sort((a, b) =>
                        String(
                            a.supplierName ?? ""
                        )
                        .localeCompare(
                            String(
                                b.supplierName ?? ""
                            )
                        )
                    )
                    .forEach(supplier => {

                        const option =
                            document.createElement(
                                "option"
                            );

                        option.value =
                            supplier.supplierId;

                        option.textContent =
                            supplier.supplierName +
                            (
                                supplier.supplierCode
                                    ? ` (${supplier.supplierCode})`
                                    : ""
                            );

                        supplierSelect
                            .appendChild(option);
                    });

            }
            catch (error) {

                console.error(
                    "Supplier loading error:",
                    error
                );
            }
        }


        async function loadEvaluations() {

            const body =
                document.getElementById(
                    "evaluationBody"
                );

            body.innerHTML = `
                <tr>
                    <td colspan="12"
                        class="text-center text-muted py-4">

                        <div class="spinner-border spinner-border-sm me-2"></div>
                        Loading supplier evaluations...

                    </td>
                </tr>
            `;


            try {

                const url =
                    buildEvaluationListUrl();

                const response =
                    await fetch(url);

                const result =
                    await readResponse(response);

                if (!response.ok) {

                    throw new Error(
                        result.message ??
                        "Unable to load supplier evaluations."
                    );
                }


                evaluationRecords =
                    Array.isArray(result)
                        ? result
                        : result.data ??
                          result.items ??
                          [];


                applyClientFilters();

            }
            catch (error) {

                evaluationRecords = [];

                body.innerHTML = `
                    <tr>
                        <td colspan="12"
                            class="text-center text-danger py-4">

                            ${escapeHtml(
                                error.message ??
                                "Unable to load supplier evaluations."
                            )}

                        </td>
                    </tr>
                `;

                updateRecordCount(0);
            }
        }


        function buildEvaluationListUrl() {

            const params =
                new URLSearchParams();


            const period =
                document
                    .getElementById(
                        "filterEvaluationPeriod"
                    )
                    .value;


            if (period) {

                const parts =
                    period.split("-");

                params.set(
                    "year",
                    parts[0]
                );

                params.set(
                    "month",
                    Number(parts[1])
                );
            }


            const supplierId =
                document
                    .getElementById(
                        "filterSupplier"
                    )
                    .value;


            if (supplierId) {

                params.set(
                    "supplierId",
                    supplierId
                );
            }


            const status =
                document
                    .getElementById(
                        "filterStatus"
                    )
                    .value;


            if (status) {

                params.set(
                    "status",
                    status
                );
            }


            const query =
                params.toString();


            return query
                ? `/purchasing/supplier-evaluation/list?${query}`
                : "/purchasing/supplier-evaluation/list";
        }


        function applyClientFilters() {

            const ratingFilter =
                String(
                    document
                        .getElementById(
                            "filterRating"
                        )
                        .value ?? ""
                )
                .trim()
                .toUpperCase();


            let records =
                [...evaluationRecords];


            if (ratingFilter) {

                records =
                    records.filter(x =>

                        normalizeRating(
                            x.performanceRating
                        ) === ratingFilter
                    );
            }


            renderEvaluations(records);
        }


        function renderEvaluations(records) {

            const body =
                document.getElementById(
                    "evaluationBody"
                );

            body.innerHTML = "";

            updateRecordCount(
                records.length
            );


            if (records.length === 0) {

                body.innerHTML = `
                    <tr>
                        <td colspan="12"
                            class="text-center text-muted py-4">

                            No supplier evaluations found.

                        </td>
                    </tr>
                `;

                return;
            }


            records.forEach(evaluation => {

                const row =
                    document.createElement(
                        "tr"
                    );


                const evaluationId =
                    Number(
                        evaluation.evaluationId ?? 0
                    );


                const qualityWeighted =
                    roundScore(
                        Number(
                            evaluation.qualityScore ?? 0
                        ) * 0.40
                    );


                const deliveryWeighted =
                    roundScore(
                        Number(
                            evaluation.onTimeDeliveryScore ?? 0
                        ) * 0.30
                    );


                /*
                 * Cost raw score is 0-100.
                 * Convert to maximum 20 points.
                 */
                const costWeighted =
                    roundScore(
                        Number(
                            evaluation.costCompetitivenessScore ?? 0
                        ) * 0.20
                    );


                const reliabilityWeighted =
                    roundScore(
                        Number(
                            evaluation.reliabilityScore ?? 0
                        ) * 0.10
                    );


                const totalScore =
                    Number(
                        evaluation.totalScore ?? 0
                    );


                const rating =
                    normalizeRating(
                        evaluation.performanceRating
                    );


                const status =
                    normalizeStatus(
                        evaluation.status
                    );


                row.innerHTML = `

                    <td>

                        <div class="fw-semibold">
                            ${escapeHtml(
                                evaluation.evaluationNo ?? "-"
                            )}
                        </div>

                        <div class="table-subtext">
                            ${formatDate(
                                evaluation.evaluationDate
                            )}
                        </div>

                    </td>


                    <td>

                        <div class="fw-semibold">
                            ${escapeHtml(
                                evaluation.supplierName ??
                                "Unknown Supplier"
                            )}
                        </div>

                        <div class="table-subtext">

                            Supplier Code:
                            ${escapeHtml(
                                evaluation.supplierCode ?? "-"
                            )}

                        </div>

                    </td>


                    <td>

                        <div>
                            PO:
                            <strong>
                                ${escapeHtml(
                                    evaluation.poNo ?? "-"
                                )}
                            </strong>
                        </div>

                        <div class="table-subtext">
                            RR:
                            ${escapeHtml(
                                evaluation.rrNo ?? "-"
                            )}
                        </div>

                        <div class="table-subtext">
                            QC:
                            ${escapeHtml(
                                evaluation.qcNo ?? "-"
                            )}
                        </div>

                    </td>


                    <td>
                        ${formatDate(
                            evaluation.deliveryDate
                        )}
                    </td>


                    <td class="text-center score-number">
                        ${formatScore(
                            qualityWeighted
                        )}
                    </td>


                    <td class="text-center score-number">
                        ${formatScore(
                            deliveryWeighted
                        )}
                    </td>


                    <td class="text-center score-number">
                        ${formatScore(
                            costWeighted
                        )}
                    </td>


                    <td class="text-center score-number">
                        ${formatScore(
                            reliabilityWeighted
                        )}
                    </td>


                    <td class="text-center">

                        <span class="fw-bold fs-6">
                            ${formatScore(totalScore)}%
                        </span>

                    </td>


                    <td>
                        ${ratingBadge(rating)}
                    </td>


                    <td>
                        ${statusBadge(status)}
                    </td>


                    <td class="text-center">

                        <a class="btn btn-sm btn-outline-primary"
                           href="/purchasing/supplier-evaluation/details/${evaluationId}">

                            View Details

                        </a>

                    </td>
                `;


                body.appendChild(row);

            });
        }


        async function loadSummary() {

            const period =
                document
                    .getElementById(
                        "filterEvaluationPeriod"
                    )
                    .value;


            if (!period) {

                resetSummary();

                return;
            }


            const parts =
                period.split("-");

            const year =
                Number(parts[0]);

            const month =
                Number(parts[1]);


            try {

                const response =
                    await fetch(
                        `/purchasing/supplier-evaluation/monthly-summary` +
                        `?year=${year}&month=${month}`
                    );


                const result =
                    await readResponse(response);


                if (!response.ok) {

                    throw new Error(
                        result.message ??
                        "Unable to load evaluation summary."
                    );
                }


                const summary =
                    result.data ?? result;


                document
                    .getElementById(
                        "summaryTotalEvaluations"
                    )
                    .textContent =
                        Number(
                            summary.totalEvaluations ?? 0
                        );


                document
                    .getElementById(
                        "summaryAverageScore"
                    )
                    .textContent =
                        `${formatScore(
                            summary.averageTotalScore ?? 0
                        )}%`;


                document
                    .getElementById(
                        "summaryPendingCount"
                    )
                    .textContent =
                        Number(
                            summary.generatedCount ?? 0
                        );


                document
                    .getElementById(
                        "summaryFinalizedCount"
                    )
                    .textContent =
                        Number(
                            summary.finalizedCount ?? 0
                        );

            }
            catch (error) {

                console.error(
                    "Summary loading error:",
                    error
                );

                resetSummary();
            }
        }


        function clearFilters() {

            setDefaultPeriod();

            document
                .getElementById(
                    "filterSupplier"
                )
                .value = "";


            document
                .getElementById(
                    "filterRating"
                )
                .value = "";


            document
                .getElementById(
                    "filterStatus"
                )
                .value = "";


            loadPageData();
        }


        function resetSummary() {

            document
                .getElementById(
                    "summaryTotalEvaluations"
                )
                .textContent = "0";


            document
                .getElementById(
                    "summaryAverageScore"
                )
                .textContent = "0.00%";


            document
                .getElementById(
                    "summaryPendingCount"
                )
                .textContent = "0";


            document
                .getElementById(
                    "summaryFinalizedCount"
                )
                .textContent = "0";
        }


        function updateRecordCount(count) {

            document
                .getElementById(
                    "evaluationRecordCount"
                )
                .textContent =
                    `${count} record${count === 1 ? "" : "s"}`;
        }


        function statusBadge(status) {

            switch (status) {

                case "PENDING_PURCHASING":

                    return `
                        <span class="badge bg-warning text-dark">
                            Pending Purchasing
                        </span>
                    `;


                case "FINALIZED":

                    return `
                        <span class="badge bg-success">
                            Finalized
                        </span>
                    `;


                default:

                    return `
                        <span class="badge bg-secondary">
                            ${escapeHtml(
                                formatStatus(status)
                            )}
                        </span>
                    `;
            }
        }


        function ratingBadge(rating) {

            switch (rating) {

                case "EXCELLENT":

                    return `
                        <span class="rating-badge rating-excellent">
                            Excellent
                        </span>
                    `;


                case "VERY GOOD":

                    return `
                        <span class="rating-badge rating-very-good">
                            Very Good
                        </span>
                    `;


                case "GOOD":

                    return `
                        <span class="rating-badge rating-good">
                            Good
                        </span>
                    `;


                case "NEEDS IMPROVEMENT":

                    return `
                        <span class="rating-badge rating-poor">
                            Needs Improvement
                        </span>
                    `;


                case "POOR":

                    return `
                        <span class="rating-badge rating-poor">
                            Poor
                        </span>
                    `;


                default:

                    return `
                        <span class="badge bg-light text-dark border">
                            Pending
                        </span>
                    `;
            }
        }


        function normalizeStatus(value) {

            return String(
                value ?? ""
            )
            .trim()
            .toUpperCase();
        }


        function normalizeRating(value) {

            return String(
                value ?? ""
            )
            .trim()
            .replaceAll("_", " ")
            .toUpperCase();
        }


        function formatStatus(value) {

            return String(
                value ?? ""
            )
            .replaceAll("_", " ")
            .toLowerCase()
            .replace(
                /\b\w/g,
                char => char.toUpperCase()
            );
        }


        function formatDate(value) {

            if (!value)
                return "-";


            const date =
                new Date(value);


            if (Number.isNaN(
                date.getTime()
            )) {
                return "-";
            }


            return date.toLocaleDateString(
                "en-PH",
                {
                    year: "numeric",
                    month: "short",
                    day: "2-digit"
                }
            );
        }


        function formatScore(value) {

            return Number(
                value ?? 0
            )
            .toLocaleString(
                "en-PH",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );
        }


        function roundScore(value) {

            return Math.round(
                (
                    Number(value ?? 0) +
                    Number.EPSILON
                ) * 100
            ) / 100;
        }


        async function readResponse(
            response
        ) {

            const text =
                await response.text();


            if (!text)
                return {};


            try {

                return JSON.parse(text);

            }
            catch {

                throw new Error(
                    "Server returned invalid JSON."
                );
            }
        }


        function escapeHtml(value) {

            return String(
                value ?? ""
            )
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
        }

    </script>

}