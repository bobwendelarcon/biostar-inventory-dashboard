        });

    document.getElementById("btnApplyFilters")
    .addEventListener("click", function () {
        loadInventory(1);
    });

        document.getElementById("btnResetFilters")
            .addEventListener("click", resetFilters);

        document.getElementById("needsVerificationOnly")
            .addEventListener("change", applyFilters);

       document.getElementById("btnRefreshGrid")
    .addEventListener("click", function () {
        loadInventory(currentPage);
    });

        searchInput.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
               loadInventory(1);
            }
        });

        loadWarehouseOptions();
    loadInventory(1);
    });
        function normalizeDate(value) {
        if (!value) {
            return null;
        }

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return null;
        }

        return date.toISOString().slice(0, 10);
    }

    function getApiExpiryFilter() {
        const selectedStatus = statusFilter.value;

        if (selectedStatus === "EXPIRED") {
            return "expired";
        }

        if (selectedStatus === "NEAR_EXPIRY") {
            return "near";
        }

        return "";
    }

        function calculateExpiryDays(expirationDate) {
        if (!expirationDate) {
            return Number.MAX_SAFE_INTEGER;
        }

        const expiry = new Date(expirationDate);

        if (Number.isNaN(expiry.getTime())) {
            return Number.MAX_SAFE_INTEGER;
        }

        const today = new Date();

        today.setHours(0, 0, 0, 0);
        expiry.setHours(0, 0, 0, 0);

        const millisecondsPerDay =
            1000 * 60 * 60 * 24;

        return Math.ceil(
            (expiry.getTime() - today.getTime()) /
            millisecondsPerDay
        );
    }

      function determineAgingStatus(
        daysInInventory,
        expirationDate
    ) {
        const expiryDays =
            calculateExpiryDays(expirationDate);

        if (expiryDays < 0) {
            return "EXPIRED";
        }

        if (expiryDays <= 60) {
            return "NEAR_EXPIRY";
        }

        if (daysInInventory > 14) {
            return "CLEANUP_NEEDED";
        }

        if (daysInInventory > 7) {
            return "AGING";
        }

        return "HEALTHY";
    }
</script>