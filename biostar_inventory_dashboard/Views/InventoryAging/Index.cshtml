            function renderPagination() {
        const paginationInfo =
            document.getElementById("paginationInfo");

        const previousButton =
            document.getElementById("previousPageButton");

        const nextButton =
            document.getElementById("nextPageButton");

        const startRecord =
            totalRecords === 0
                ? 0
                : ((currentPage - 1) * pageSize) + 1;

        const endRecord = Math.min(
            currentPage * pageSize,
            totalRecords
        );

        paginationInfo.textContent =
            `Showing ${startRecord}-${endRecord} ` +
            `of ${totalRecords.toLocaleString()} record(s) ` +
            `| Page ${currentPage} of ${totalPages}`;

        previousButton.disabled =
            currentPage <= 1;

        nextButton.disabled =
            currentPage >= totalPages || totalRecords === 0;
    }

        function applyFilters() {
            const searchText = searchInput.value.trim().toLowerCase();
            const selectedWarehouse = warehouseFilter.value;
            const selectedStatus = statusFilter.value;

            const minimumDays = minimumDaysFilter.value === ""
                ? null
                : Number(minimumDaysFilter.value);

            const maximumDays = maximumDaysFilter.value === ""
                ? null
                : Number(maximumDaysFilter.value);

            filteredRows = inventoryRows.filter(row => {
                const days = calculateDays(row.dateIn);

                const matchesSearch =
                    searchText === "" ||
                    row.productName.toLowerCase().includes(searchText) ||
                    row.lotNo.toLowerCase().includes(searchText) ||
                    (row.description || "").toLowerCase().includes(searchText);

                const matchesWarehouse =
                    selectedWarehouse === "" ||
                    row.warehouse === selectedWarehouse;

                const matchesStatus =
                    selectedStatus === "" ||
                    row.status === selectedStatus;

                const matchesMinimumDays =
                    minimumDays === null ||
                    days >= minimumDays;

                const matchesMaximumDays =
                    maximumDays === null ||
                    days <= maximumDays;

                const matchesVerification =
                    !needsVerificationOnly.checked ||
                    (
                        !row.verified &&
                        (
                            row.status === "CLEANUP_NEEDED" ||
                            row.status === "GHOST_INVENTORY" ||
                            row.status === "EXPIRED" ||
                            row.status === "NEAR_EXPIRY"
                        )
                    );

                return matchesSearch &&
                    matchesWarehouse &&
                    matchesStatus &&
                    matchesMinimumDays &&
                    matchesMaximumDays &&
                    matchesVerification;
            });

            renderGrid();
        }

           function resetFilters() {
        searchInput.value = "";
        warehouseFilter.value = "";
        statusFilter.value = "";
        minimumDaysFilter.value = "";
        maximumDaysFilter.value = "";
        needsVerificationOnly.checked = false;

        loadInventory(1);
    }

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

            window.openVerificationFromButton = function (button) {
        const inventoryKey = decodeURIComponent(
            button.dataset.inventoryKey
        );

        openVerification(inventoryKey);
    };

          window.openVerification = function (inventoryId) {
        const row = inventoryRows.find(
            item => item.inventoryId === inventoryId
        );

        if (!row) {
            return;
        }

        document.getElementById("verifyInventoryId").value =
            row.inventoryId;

        document.getElementById("verifyProductName").textContent =
            row.productName;

        document.getElementById("verifyLotNo").textContent =
            row.lotNo;

        document.getElementById("verifyWarehouse").textContent =
            row.warehouse;

        document.getElementById("verifySystemQty").value =
            row.systemQty;

        document.getElementById("verifyPhysicalQty").value = "";
        document.getElementById("verifyVariance").value = "0";
        document.getElementById("verifyReason").value = "";
        document.getElementById("verifyRemarks").value = "";

        document.getElementById("verifySystemUom").textContent =
            row.uom;

        document.getElementById("verifyPhysicalUom").textContent =
            row.uom;

        document.getElementById("verifyVarianceUom").textContent =
            row.uom;

        document.getElementById("verifyPhysicalQty")
            .classList.remove("is-invalid");

        document.getElementById("verifyReason")
            .classList.remove("is-invalid");

        updateVarianceDisplay();

        verifyModal.show();

        setTimeout(() => {
            document.getElementById("verifyPhysicalQty").focus();
        }, 300);
    };

        window.viewVerification = function (inventoryId) {
            const row = inventoryRows.find(
                item => item.inventoryId === inventoryId
            );

            if (!row || !row.verification) {
                return;
            }

            const verification = row.verification;

            document.getElementById("viewProduct").textContent =
                row.productName;

            document.getElementById("viewLot").textContent =
                row.lotNo;

            document.getElementById("viewWarehouse").textContent =
                row.warehouse;

            document.getElementById("viewSystemQty").textContent =
                `${formatNumber(verification.systemQty)} ${row.uom}`;

            document.getElementById("viewPhysicalQty").textContent =
                `${formatNumber(verification.physicalQty)} ${row.uom}`;

            document.getElementById("viewVariance").textContent =
                `${formatNumber(verification.variance)} ${row.uom}`;

            document.getElementById("viewReason").textContent =
                verification.reasonLabel;

            document.getElementById("viewVerifiedBy").textContent =
                verification.verifiedBy;

            document.getElementById("viewVerifiedDate").textContent =
                new Date(verification.verifiedDate).toLocaleString(
                    "en-PH",
                    {
                        dateStyle: "medium",
                        timeStyle: "short"
                    }
                );

            document.getElementById("viewRemarks").textContent =
                verification.remarks || "-";

            viewModal.show();
        };

        function updateVarianceDisplay() {
            const systemQty =
                Number(document.getElementById("verifySystemQty").value || 0);

            const physicalValue =
                document.getElementById("verifyPhysicalQty").value;

            const physicalQty =
                physicalValue === "" ? systemQty : Number(physicalValue);

            const variance = physicalQty - systemQty;

            const varianceInput =
                document.getElementById("verifyVariance");

            varianceInput.value = formatNumber(variance);

            varianceInput.classList.remove(
                "variance-negative",
                "variance-positive",
                "variance-zero"
            );

            if (variance < 0) {
                varianceInput.classList.add("variance-negative");
            } else if (variance > 0) {
                varianceInput.classList.add("variance-positive");
            } else {
                varianceInput.classList.add("variance-zero");
            }
        }

        document.getElementById("verifyPhysicalQty")
            .addEventListener("input", updateVarianceDisplay);

    document.getElementById("btnSaveVerification")
     .addEventListener("click", async function () {

         const saveButton = this;

         const inventoryId =
             document.getElementById("verifyInventoryId").value;

         const physicalQtyInput =
             document.getElementById("verifyPhysicalQty");

         const reasonInput =
             document.getElementById("verifyReason");

         physicalQtyInput.classList.remove("is-invalid");
         reasonInput.classList.remove("is-invalid");

         let isValid = true;

         if (
             physicalQtyInput.value === "" ||
             Number(physicalQtyInput.value) < 0
         ) {
             physicalQtyInput.classList.add("is-invalid");
             isValid = false;
         }

         if (!reasonInput.value) {
             reasonInput.classList.add("is-invalid");
             isValid = false;
         }

         if (!isValid) {
             return;
         }

         const row = inventoryRows.find(
             item => item.inventoryId === inventoryId
         );

         if (!row) {
             alert("Inventory lot was not found.");
             return;
         }

         const systemQty = Number(row.systemQty);
         const physicalQty = Number(physicalQtyInput.value);

         if (systemQty === physicalQty) {
             alert(
                 "Physical quantity matches the system quantity. " +
                 "No inventory adjustment is required."
             );

             return;
         }

         const confirmed = confirm(
             `Confirm inventory cleanup?\n\n` +
             `Product: ${row.productName}\n` +
             `Lot: ${row.lotNo}\n` +
             `System Qty: ${formatNumber(systemQty)} ${row.uom}\n` +
             `Physical Qty: ${formatNumber(physicalQty)} ${row.uom}\n` +
             `Variance: ${formatNumber(physicalQty - systemQty)} ${row.uom}`
         );

         if (!confirmed) {
             return;
         }

         try {
             saveButton.disabled = true;

             saveButton.innerHTML = `
                 <span class="spinner-border spinner-border-sm me-1"></span>
                 Saving...
             `;

             const payload = {
                 productId: row.productId,
                 branchId: row.branchId,
                 lotNo: row.lotNo,

                 systemQty: systemQty,
                 physicalQty: physicalQty,

                 reason: reasonInput.options[
                     reasonInput.selectedIndex
                 ].text.trim(),

                 remarks:
                     document.getElementById("verifyRemarks")
                         .value.trim()
             };

             const response = await fetch(
                 "/InventoryAging/Verify",
                 {
                     method: "POST",
                     headers: {
                         "Content-Type": "application/json"
                     },
                     body: JSON.stringify(payload)
                 }
             );

             const responseText = await response.text();

             let result;

             try {
                 result = JSON.parse(responseText);
             }
             catch {
                 result = {
                     success: response.ok,
                     message: responseText
                 };
             }

             if (!response.ok || result.success === false) {
                 throw new Error(
                     result.message ||
                     "Failed to save inventory verification."
                 );
             }

             verifyModal.hide();

             alert(
                 result.message ||
                 "Inventory cleanup saved successfully."
             );

             await loadInventory(currentPage);
         }
         catch (error) {
             console.error(error);

             alert(
                 error.message ||
                 "Failed to save inventory cleanup."
             );
         }
         finally {
             saveButton.disabled = false;

             saveButton.innerHTML = `
                 <i class="bi bi-check-lg me-1"></i>
                 Save Verification
             `;
         }
     });


         document.getElementById("previousPageButton")
        .addEventListener("click", function () {
            if (currentPage > 1) {
                loadInventory(currentPage - 1);
            }
        });

    document.getElementById("nextPageButton")
        .addEventListener("click", function () {
            if (currentPage < totalPages) {
                loadInventory(currentPage + 1);
