                        @if (HasAccess("MFG_MATERIAL_CATEGORIES"))
                        {
                            <li><a class="nav-link @(currentPath == "/manufacturing/materials/categories" ? "active fw-bold" : "")" href="/manufacturing/materials/categories"><span>Material Categories</span></a></li>
                        }
                        @if (HasAccess("MFG_MATERIALS"))
                        {
                            <li><a class="nav-link @(currentPath == "/manufacturing/materials" ? "active fw-bold" : "")" href="/manufacturing/materials"><span>Materials</span></a></li>
                        }
                        @if (HasAccess("MFG_SUPPLIERS"))
                        {
