@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";

    var userRole = (
        User.FindFirst(ClaimTypes.Role)?.Value
        ?? User.FindFirst("role_name")?.Value
        ?? User.FindFirst("role")?.Value
        ?? ""
    ).Trim().ToUpperInvariant();

    var accessPoints = User
        .FindAll("access_point")
        .Select(x => x.Value)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    bool HasAccess(string code) =>
        userRole == "ADMIN" || accessPoints.Contains(code);


    // =========================================================
    // FINISHED GOODS / LEGACY MODULE ACCESS
    // =========================================================

    var canDashboard =
    HasAccess("DASHBOARD_VIEW");

    var canReceiving =
        HasAccess("RCV_TRANSMITTAL_REPORT");

    var canPlanning =
        HasAccess("PLN_DAILY_ORDERS");

    var canDispatch =
        HasAccess("DSP_DELIVERY_CHECKLIST");

    var canProduction =
        HasAccess("PRD_PRODUCT_TO_PRODUCE");

    var canFinishedGoodsInventory =
        HasAccess("FG_STOCK_OVERVIEW") ||
        HasAccess("FG_INVENTORY_LIST") ||
        HasAccess("FG_INVENTORY_AGING") ||
        HasAccess("FG_TRANSACTION_HISTORY");

    var canReturnProduct =
        HasAccess("RET_RETURNS");

    var canGeneralReports =
        HasAccess("RPT_GENERAL_REPORTS");

    var canMasterData =
        HasAccess("MST_FINISHED_PRODUCT_CATEGORIES") ||
        HasAccess("MST_FINISHED_PRODUCTS") ||
        HasAccess("MST_BRANCHES") ||
        HasAccess("MST_USERS") ||
        HasAccess("MST_PARTNERS");


    var canManufacturing =
        HasAccess("MFG_MATERIAL_CATEGORIES") ||
        HasAccess("MFG_MATERIALS") ||
        HasAccess("MFG_SUPPLIERS");

    var canPurchasing =
        HasAccess("PUR_MPRF_REQUESTS") ||
        HasAccess("PUR_MPRF_REVIEW") ||
        HasAccess("PUR_CANVASSING") ||
        HasAccess("PUR_PURCHASE_ORDERS") ||
        HasAccess("PUR_RECEIVING_CALENDAR") ||
        HasAccess("PUR_RECEIVING_REPORTS") ||
        HasAccess("PUR_SUPPLIER_EVALUATION");

    var canRawMaterialInventory =
        HasAccess("INV_RAW_MATERIAL_SUMMARY") ||
        HasAccess("INV_RAW_MATERIAL_LOTS") ||
        HasAccess("INV_RAW_MATERIAL_PROCESSING") ||
        HasAccess("INV_MATERIAL_REQUISITION") ||
        HasAccess("INV_TRANSACTIONS");

    var canAccessReports =
        HasAccess("RPT_TIME_IN_MOTION") ||
        HasAccess("RPT_PURCHASING_LEAD_TIME");

    var canQualityControl = HasAccess("QC_INSPECTIONS");

    var isReceivingOpen = currentController == "ManualStockIn";
    var isPlanningOpen = currentController == "DailyOrder";
    var isDispatchOpen = currentController == "DeliveryChecklist";
    var isProductionOpen = currentController == "ProductToProduce";
    var isInventoryOpen =
        currentController == "StockOverview" ||
        currentController == "Inventory" ||
        currentController == "InventoryAging" ||
        currentController == "Transactions" ||
        currentPath.StartsWith("/inventory/");
    var isReturnOpen = currentController == "Returns";
    var isReportOpen = currentPath.StartsWith("/reports");
    var isMasterDataOpen =
        currentController == "Categories" ||
        currentController == "Product" ||
        currentController == "Branch" ||
        currentController == "User" ||
        currentController == "Partner";
    var isManufacturingOpen = currentPath.StartsWith("/manufacturing") || currentPath == "/purchasing/suppliers";
    var isPurchasingOpen = currentPath.StartsWith("/purchasing");
    var isRawMaterialInventoryOpen = currentPath.StartsWith("/inventory/raw-material") || currentPath.StartsWith("/inventory/material-requisitions");
    var isQualityOpen = currentPath.StartsWith("/quality");
    var isReceivingCalendar = currentPath == "/purchasing/receiving-reports/calendar";
    var isReceivingReports = currentPath == "/purchasing/receiving-reports";
}

