                <a class="nav-link @(currentController == "ProductToProduce" ? "active fw-bold" : "")"
                   asp-controller="ProductToProduce" asp-action="Index">
                    <i class="bi bi-gear me-2"></i><span>Production</span>
                </a>
            </li>

            <li class="nav-item mb-2">
                <a class="nav-link d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#receivingMenu">
                    <div><i class="bi bi-box-arrow-in-down me-2"></i><span>Receiving</span></div>
                    <span class="menu-arrow">▾</span>
                </a>
                <div class="collapse @(isReceivingOpen ? "show" : "")" id="receivingMenu">
                    <ul class="nav flex-column ms-3 mt-1">
                        <li>
                            <a class="nav-link @(currentController == "ManualStockIn" ? "active fw-bold" : "")"
                               asp-controller="ManualStockIn" asp-action="Index">
                                <span>Transmittal Report</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            <li class="nav-item mb-2">
                <a class="nav-link d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#finishedInventoryMenu">
                    <div><i class="bi bi-box-seam me-2"></i><span>Inventory</span></div>
                    <span class="menu-arrow">▾</span>
                </a>
                <div class="collapse @(isInventoryOpen ? "show" : "")" id="finishedInventoryMenu">
                    <ul class="nav flex-column ms-3 mt-1">
                        <li><a class="nav-link @(currentController == "Inventory" ? "active fw-bold" : "")" href="/Inventory"><span>Inventory List</span></a></li>
                        <li><a class="nav-link @(currentController == "InventoryAging" ? "active fw-bold" : "")" asp-controller="InventoryAging" asp-action="Index"><span>Inventory Aging &amp; Cleanup</span></a></li>
                        <li><a class="nav-link @(currentController == "Transactions" ? "active fw-bold" : "")" href="/Transactions"><span>Transaction History</span></a></li>
                    </ul>
                </div>
            </li>
        }
