                        @if (HasAccess("INV_RAW_MATERIAL_SUMMARY"))
                        {
                            <li><a class="nav-link @(currentController == "RawMaterialSummary" ? "active fw-bold" : "")" href="/inventory/raw-material-summary"><span>Raw Material Inventory</span></a></li>
                        }
                        @if (HasAccess("INV_RAW_MATERIAL_LOTS"))
                        {
                            <li><a class="nav-link @(currentController == "RawMaterialInventory" ? "active fw-bold" : "")" href="/inventory/raw-materials"><span>Raw Material Inventory Lot</span></a></li>
                        }
                        @if (HasAccess("INV_RAW_MATERIAL_PROCESSING"))
                        {
                            <li><a class="nav-link @(currentController == "RawMaterialProcessing" ? "active fw-bold" : "")" href="/inventory/raw-material-processing"><span>Raw Material Processing</span></a></li>
                        }
                        @if (HasAccess("INV_MATERIAL_REQUISITION"))
