                        }
                        @if (HasAccess("PUR_MPRF_REVIEW"))
                        {
                            <li><a class="nav-link @(currentPath == "/purchasing/mprf/review" ? "active fw-bold" : "")" href="/purchasing/mprf/review"><span>MPRF Review</span></a></li>
                        }
                        @if (HasAccess("PUR_CANVASSING"))
                        {
                            <li><a class="nav-link @(currentPath.StartsWith("/purchasing/canvassing") ? "active fw-bold" : "")" href="/purchasing/canvassing"><span>Supplier Canvassing</span></a></li>
                        }
                        @if (HasAccess("PUR_PURCHASE_ORDERS"))
                        {
                            <li><a class="nav-link @(currentPath.Contains("/purchasing/purchase-orders") ? "active fw-bold" : "")" href="/purchasing/purchase-orders"><span>Purchase Orders</span></a></li>
                        }
                        @if (HasAccess("PUR_RECEIVING_CALENDAR"))
                        {
                            <li><a class="nav-link @(isReceivingCalendar ? "active fw-bold" : "")" href="/purchasing/receiving-reports/calendar"><span>Receiving Calendar</span></a></li>
                        }
                        @if (HasAccess("PUR_RECEIVING_REPORTS"))
                        {
                            <li><a class="nav-link @(isReceivingReports ? "active fw-bold" : "")" href="/purchasing/receiving-reports"><span>Receiving Reports</span></a></li>
                        }
                        @if (HasAccess("PUR_SUPPLIER_EVALUATION"))
                        {
                            <li><a class="nav-link @(currentPath.StartsWith("/purchasing/supplier-evaluation") ? "active fw-bold" : "")" href="/purchasing/supplier-evaluation"><span>Supplier Evaluation</span></a></li>
                        }
                    </ul>
                </div>
            </li>
        }

        @if (canRawMaterialInventory)
        {
            <li class="nav-item mb-2">
                <a class="nav-link d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#rawMaterialInventoryMenu">
                    <div><i class="bi bi-box-seam me-2"></i><span>Raw Material Inventory</span></div><span class="menu-arrow">▾</span>
                </a>
                <div class="collapse @(isRawMaterialInventoryOpen ? "show" : "")" id="rawMaterialInventoryMenu">
