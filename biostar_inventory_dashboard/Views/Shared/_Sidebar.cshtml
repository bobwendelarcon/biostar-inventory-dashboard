                        <li><a class="nav-link @(currentController == "Inventory" ? "active fw-bold" : "")" href="/Inventory"><span>Inventory List</span></a></li>
                        <li><a class="nav-link @(currentController == "InventoryAging" ? "active fw-bold" : "")" asp-controller="InventoryAging" asp-action="Index"><span>Inventory Aging &amp; Cleanup</span></a></li>
                        <li><a class="nav-link @(currentController == "Transactions" ? "active fw-bold" : "")" href="/Transactions"><span>Transaction History</span></a></li>
