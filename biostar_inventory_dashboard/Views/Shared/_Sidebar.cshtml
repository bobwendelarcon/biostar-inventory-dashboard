                        @if (userRole == "ADMIN")
                        {
                            <li><a class="nav-link @(currentController == "User" ? "active fw-bold" : "")" href="/User"><span>Users</span></a></li>
                        }
                        <li><a class="nav-link @(currentController == "Partner" ? "active fw-bold" : "")" href="/Partner"><span>Partners</span></a></li>
                    </ul>
                </div>
            </li>
        }

        @* =========================================================
           ACCESS-CONTROLLED MODULES
           These render for ANY role only when the account has access.
           ADMIN is automatically allowed by HasAccess().
           ========================================================= *@

