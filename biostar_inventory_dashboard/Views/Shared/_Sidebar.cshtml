                </a>
            </li>

            <li class="nav-item mb-2">
                <a class="nav-link d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#receivingMenu">
                    <div><i class="bi bi-box-arrow-in-down me-2"></i><span>Receiving</span></div><span class="menu-arrow">▾</span>
                </a>
                <div class="collapse @(isReceivingOpen ? "show" : "")" id="receivingMenu">
                    <ul class="nav flex-column ms-3 mt-1">
                        <li><a class="nav-link @(currentController == "ManualStockIn" ? "active fw-bold" : "")" asp-controller="ManualStockIn" asp-action="Index"><span>Transmittal Report</span></a></li>
                    </ul>
