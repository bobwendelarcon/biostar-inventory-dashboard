<script>
    document.addEventListener("DOMContentLoaded", function () {

        const sidebar =
            document.getElementById("desktopSidebar");

        const toggleBtn =
            document.getElementById("sidebarToggleBtn");

        const mainContent =
            document.querySelector(".main-content");

        if (!sidebar || !toggleBtn || !mainContent)
            return;


        // ==========================================
        // RESTORE SIDEBAR STATE
        // ==========================================

        const savedState =
            localStorage.getItem("sidebarState");

        const activeMenu =
            localStorage.getItem("activeMenu");

        const savedScroll =
            localStorage.getItem("sidebarScrollTop");


        if (savedState === "collapsed") {

            sidebar.classList.add("collapsed");

            mainContent.classList.add(
                "sidebar-collapsed"
            );

        }
        else {

            sidebar.classList.remove("collapsed");

            mainContent.classList.remove(
                "sidebar-collapsed"
            );
        }


        // ==========================================
        // RESTORE OPEN MENU
        // ==========================================

        if (activeMenu) {

            const menu =
                document.querySelector(activeMenu);

            if (menu) {
                menu.classList.add("show");
            }
        }


        // ==========================================
        // RESTORE SCROLL POSITION
        // ==========================================

        if (savedScroll !== null) {

            setTimeout(() => {

                sidebar.scrollTop =
                    parseInt(savedScroll, 10) || 0;

            }, 50);
        }


        // ==========================================
        // SIDEBAR COLLAPSE / EXPAND BUTTON
        // ==========================================

        toggleBtn.addEventListener(
            "click",
            function (e) {

                e.preventDefault();
                e.stopPropagation();

                const isCollapsed =
                    sidebar.classList.toggle(
                        "collapsed"
                    );

                mainContent.classList.toggle(
                    "sidebar-collapsed",
                    isCollapsed
                );

                localStorage.setItem(
                    "sidebarState",
                    isCollapsed
                        ? "collapsed"
                        : "expanded"
                );
            }
        );


        // ==========================================
        // COLLAPSIBLE MENUS
        // ==========================================

        document.querySelectorAll(
            '.sidebar .nav-link[data-bs-toggle="collapse"]'
        ).forEach(link => {

            link.addEventListener(
                "click",
                function (e) {

                    const target =
                        this.getAttribute("href");

                    if (!target)
                        return;

                    localStorage.setItem(
                        "activeMenu",
                        target
                    );

                    localStorage.setItem(
                        "sidebarScrollTop",
                        sidebar.scrollTop
                    );


                    // If sidebar is minimized,
                    // expand sidebar first.
                    if (
                        sidebar.classList.contains(
                            "collapsed"
                        )
                    ) {

                        e.preventDefault();

                        sidebar.classList.remove(
                            "collapsed"
                        );

                        mainContent.classList.remove(
                            "sidebar-collapsed"
                        );

                        localStorage.setItem(
                            "sidebarState",
                            "expanded"
                        );

                        setTimeout(() => {

                            const menu =
                                document.querySelector(
                                    target
                                );

                            if (menu) {

                                new bootstrap.Collapse(
                                    menu,
                                    {
                                        toggle: true
                                    }
                                );
                            }

                        }, 200);
                    }
                }
            );
        });


        // ==========================================
        // REMEMBER SCROLL WHEN OPENING PAGE
        // ==========================================

        document.querySelectorAll(
            '.sidebar a[href]:not([data-bs-toggle="collapse"])'
        ).forEach(link => {

            link.addEventListener(
                "click",
                function () {

                    localStorage.setItem(
                        "sidebarScrollTop",
                        sidebar.scrollTop
                    );
                }
            );
        });

    });
</script>
