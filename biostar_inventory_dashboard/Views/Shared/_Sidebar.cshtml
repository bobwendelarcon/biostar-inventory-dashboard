@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var userRole = (
     User.FindFirst(ClaimTypes.Role)?.Value
     ?? User.FindFirst("role_name")?.Value
     ?? ""
 ).ToUpper();

    var currentPath = Context.Request.Path.ToString().ToLower();
    var isManufacturingOpen = currentPath.StartsWith("/manufacturing");
    var isPurchasingOpen = currentPath.StartsWith("/purchasing");
    var isReceivingCalendar =
    currentPath == "/purchasing/receiving-reports/calendar";

    var isReceivingReports =
        currentPath == "/purchasing/receiving-reports";



    var isReceivingOpen =
    currentController == "ManualStockIn";
    var isPlanningOpen = currentController == "DailyOrder";
    var isProductionOpen =
        currentController == "ProductToProduce" ||
        currentController == "RawMaterialRequest" ||
        currentController == "ReceiveTransmittal";

    var isDispatchOpen = currentController == "DeliveryChecklist";


    var isInventoryOpen =
    currentController == "Inventory" ||
    currentController == "Transactions" ||
    currentController == "StockOverview" ||
    currentController == "InventoryAging" ||
    currentController == "RawMaterialSummary" ||
    currentController == "RawMaterialInventory" ||
    currentController == "RawMaterialTransactions" ||
    currentController == "MaterialRequisition" ||
    currentController == "RawMaterialProcessing";


    var isLogisticsOpen = currentController == "Logistics";
    var isReturnOpen = currentController == "Returns";
    var isReportOpen =
    currentController == "Reports" ||
    currentController == "TimeInMotion" ||
    currentController == "PurchasingLeadTime";

    var isMasterDataOpen =
        currentController == "Product" ||
        currentController == "Categories" ||
        currentController == "Branch" ||
        currentController == "User" ||
        currentController == "Partner";

   


}

