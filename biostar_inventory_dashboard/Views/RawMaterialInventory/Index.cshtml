        function setTransactionLoading(isLoading) {
            const loading =
                document.getElementById(
                    "transactionLoading"
                );

            const tableContainer =
                document.getElementById(
                    "transactionTableContainer"
                );

            const emptyContainer =
                document.getElementById(
