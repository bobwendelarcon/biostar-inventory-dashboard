                    </div>

                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        let inventoryItems = [];
        let filterOptionsInitialized = false;

        document.addEventListener("DOMContentLoaded", function () {
            bindEvents();
            loadInventory(true);
        });

        function bindEvents() {
            document.getElementById("btnSearch")
                .addEventListener("click", function () {
                    loadInventory(false);
                });

            document.getElementById("btnRefresh")
                .addEventListener("click", function () {
                    loadInventory(!filterOptionsInitialized);
                });

            document.getElementById("btnClear")
                .addEventListener("click", clearFilters);

            document.getElementById("filterSearch")
                .addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();
                        loadInventory(false);
                    }
                });
        }

        async function loadInventory(loadFilterOptions) {
            setLoading(true);

            try {
                let url = "/inventory/raw-materials/data";

                const query = new URLSearchParams();

                const search =
                    document.getElementById("filterSearch").value.trim();

                const branchId =
                    document.getElementById("filterBranch").value;

                const categoryId =
                    document.getElementById("filterCategory").value;

                const stockStatus =
                    document.getElementById("filterStockStatus").value;

                const expiryStatus =
                    document.getElementById("filterExpiryStatus").value;

                const fromDate =
                    document.getElementById("filterFromDate").value;

                const toDate =
                    document.getElementById("filterToDate").value;

                if (search) {
                    query.append("search", search);
                }

                if (branchId) {
                    query.append("branchId", branchId);
                }

                if (categoryId) {
                    query.append("categoryId", categoryId);
                }

                if (stockStatus) {
                    query.append("stockStatus", stockStatus);
                }

                if (expiryStatus) {
                    query.append("expiryStatus", expiryStatus);
                }

                if (fromDate) {
                    query.append("fromDate", fromDate);
                }

                if (toDate) {
                    query.append("toDate", toDate);
                }

                const queryString = query.toString();

                if (queryString) {
                    url += "?" + queryString;
                }

                const response = await fetch(url, {
                    method: "GET",
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (!response.ok) {
                    const errorContent = await response.text();

                    throw new Error(
                        errorContent ||
                        "Unable to load raw material inventory."
                    );
                }

                const data = await response.json();

                inventoryItems = Array.isArray(data.items)
                    ? data.items
                    : [];

                updateSummary(data.summary);
                renderInventoryTable(inventoryItems);

                if (loadFilterOptions || !filterOptionsInitialized) {
                    populateFilterOptions(inventoryItems);
                    filterOptionsInitialized = true;
                }
            }
            catch (error) {
                console.error(error);

                inventoryItems = [];

                updateSummary(null);
                renderInventoryTable([]);

                alert(
                    "Unable to load raw material inventory.\n\n" +
                    getErrorMessage(error)
                );
            }
            finally {
                setLoading(false);
            }
        }

        function updateSummary(summary) {
            document.getElementById("totalMaterials").textContent =
                formatNumber(summary?.totalMaterials ?? 0);

            document.getElementById("inventoryLots").textContent =
                formatNumber(summary?.inventoryLots ?? 0);

            document.getElementById("lowStock").textContent =
                formatNumber(summary?.lowStock ?? 0);

            document.getElementById("nearExpiry").textContent =
                formatNumber(summary?.nearExpiry ?? 0);

            document.getElementById("expired").textContent =
                formatNumber(summary?.expired ?? 0);
        }

        function renderInventoryTable(items) {
            const tableBody =
                document.getElementById("inventoryTableBody");

            const tableContainer =
                document.getElementById("tableContainer");

            const emptyContainer =
                document.getElementById("emptyContainer");

            tableBody.innerHTML = "";

            document.getElementById("tableCount").textContent =
                `${formatNumber(items.length)} inventory record${items.length === 1 ? "" : "s"}`;

            if (items.length === 0) {
                tableContainer.classList.add("d-none");
                emptyContainer.classList.remove("d-none");
                return;
            }

            tableContainer.classList.remove("d-none");
            emptyContainer.classList.add("d-none");

            items.forEach(function (item, index) {
                const row = document.createElement("tr");

                row.innerHTML = `
                    <td>
                        <div class="material-name">
                            ${escapeHtml(item.materialName)}
                        </div>

                        <div class="material-code">
                            ${escapeHtml(item.materialCode)}
                        </div>
                    </td>

                    <td>
                        ${escapeHtml(item.categoryName || "Uncategorized")}
                    </td>

                    <td>
                        <div>${escapeHtml(item.branchName || item.branchId)}</div>
                        <div class="material-code">
                            ${escapeHtml(item.branchId)}
                        </div>
                    </td>

                    <td>
                        ${escapeHtml(item.lotDisplay || item.lotNo)}
                    </td>

                    <td class="quantity-value">
                        ${formatQuantity(item.quantity)}
                    </td>

                    <td>
                        ${escapeHtml(item.uom)}
                    </td>

                    <td>
                        ${escapeHtml(item.supplierName || "Not Specified")}
                    </td>

                    <td>
                        ${formatDate(item.expirationDate)}
                    </td>

                    <td>
                        ${getStockBadge(item.stockStatus)}
                    </td>

                    <td>
                        ${getExpiryBadge(item.expiryStatus)}
                    </td>

                    <td class="text-center">
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                onclick="showInventoryDetails(${index})">
                            View
                        </button>
                    </td>
                `;

                tableBody.appendChild(row);
            });
        }

        function populateFilterOptions(items) {
            const branchSelect =
                document.getElementById("filterBranch");

            const categorySelect =
                document.getElementById("filterCategory");

            const branches = new Map();
            const categories = new Map();

            items.forEach(function (item) {
                if (item.branchId) {
                    branches.set(
                        item.branchId,
                        item.branchName || item.branchId
                    );
                }

                if (item.categoryId !== null &&
                    item.categoryId !== undefined) {

                    categories.set(
                        item.categoryId,
                        item.categoryName || "Uncategorized"
                    );
                }
            });

            const selectedBranch = branchSelect.value;
            const selectedCategory = categorySelect.value;

            branchSelect.innerHTML =
                '<option value="">All Branches</option>';

            [...branches.entries()]
                .sort(function (a, b) {
                    return String(a[1]).localeCompare(String(b[1]));
                })
                .forEach(function ([id, name]) {
                    branchSelect.insertAdjacentHTML(
                        "beforeend",
                        `<option value="${escapeAttribute(id)}">
                            ${escapeHtml(name)}
                        </option>`
                    );
                });

            categorySelect.innerHTML =
                '<option value="">All Categories</option>';

            [...categories.entries()]
                .sort(function (a, b) {
                    return String(a[1]).localeCompare(String(b[1]));
                })
                .forEach(function ([id, name]) {
                    categorySelect.insertAdjacentHTML(
                        "beforeend",
                        `<option value="${escapeAttribute(id)}">
                            ${escapeHtml(name)}
                        </option>`
                    );
                });

            branchSelect.value = selectedBranch;
            categorySelect.value = selectedCategory;
        }

                async function showInventoryDetails(index) {
            const item = inventoryItems[index];

            if (!item) {
                return;
            }

            document.getElementById("modalMaterialCode").textContent =
                item.materialCode || "";

            document.getElementById("modalMaterialName").textContent =
                item.materialName || "-";

            document.getElementById("modalCategory").textContent =
                item.categoryName || "Uncategorized";

            document.getElementById("modalBranch").textContent =
                item.branchName || item.branchId || "-";

            document.getElementById("modalSupplier").textContent =
                item.supplierName || "Not Specified";

            document.getElementById("modalUom").textContent =
                item.uom || "-";

            document.getElementById("modalQuantity").textContent =
                `${formatQuantity(item.quantity)} ${item.uom || ""}`;

            document.getElementById("modalMinimumStock").textContent =
                `${formatQuantity(item.minimumStock)} ${item.uom || ""}`;

            document.getElementById("modalStockStatus").innerHTML =
                getStockBadge(item.stockStatus);

            document.getElementById("modalLotNo").textContent =
                item.lotDisplay || item.lotNo || "-";

            document.getElementById("modalLotTracking").textContent =
                item.isLotTracked
                    ? "Lot Tracked"
                    : "Not Lot Tracked";

            document.getElementById("modalManufacturingDate").textContent =
                formatDate(item.manufacturingDate);

            document.getElementById("modalExpirationDate").textContent =
                formatDate(item.expirationDate);

            document.getElementById("modalExpiryStatus").innerHTML =
                getExpiryBadge(item.expiryStatus);

            document.getElementById("modalInventoryAge").textContent =
                `${formatNumber(item.inventoryAgeDays ?? 0)} day${
                    Number(item.inventoryAgeDays ?? 0) === 1 ? "" : "s"
                }`;

            document.getElementById("modalDaysUntilExpiration").textContent =
                formatDaysUntilExpiration(
                    item.daysUntilExpiration,
                    item.expiryStatus
                );

            document.getElementById("modalRemarks").textContent =
                item.remarks || "No remarks.";

            resetTransactionTable();

            const generalTab =
                document.getElementById("general-tab");

            bootstrap.Tab.getOrCreateInstance(generalTab).show();

            const modalElement =
                document.getElementById("inventoryDetailsModal");

            const modal =
                bootstrap.Modal.getOrCreateInstance(modalElement);

            modal.show();

            await loadInventoryTransactions(
                item.materialLotId
            );
        }


                async function loadInventoryTransactions(materialLotId) {
            setTransactionLoading(true);

            try {
                const response = await fetch(
                    `/inventory/raw-materials/${materialLotId}/transactions`,
                    {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        await response.text()
                    );
                }

                const transactions =
                    await response.json();

                renderTransactionTable(
                    Array.isArray(transactions)
                        ? transactions
                        : []
                );
            }
            catch (error) {
                console.error(error);

                renderTransactionTable([]);

                document.getElementById(
                    "transactionEmpty"
                ).innerHTML = `
                    <div class="text-danger">
                        Unable to load transaction history.
                    </div>

                    <div class="small mt-1">
                        ${escapeHtml(getErrorMessage(error))}
                    </div>
                `;
            }
            finally {
                setTransactionLoading(false);
            }
        }

        function renderTransactionTable(transactions) {
            const tableBody =
                document.getElementById(
                    "transactionTableBody"
                );

            const tableContainer =
                document.getElementById(
                    "transactionTableContainer"
                );

            const emptyContainer =
                document.getElementById(
                    "transactionEmpty"
                );

            tableBody.innerHTML = "";

            if (transactions.length === 0) {
                tableContainer.classList.add("d-none");
                emptyContainer.classList.remove("d-none");
                return;
            }

            tableContainer.classList.remove("d-none");
            emptyContainer.classList.add("d-none");

            transactions.forEach(function (transaction) {
                const row =
                    document.createElement("tr");

                row.innerHTML = `
                    <td>
                        ${formatDateTime(
                            transaction.transactionDate
                        )}
                    </td>

                    <td>
                        ${getTransactionTypeBadge(
                            transaction.transactionType
                        )}
                    </td>

                    <td>
                        <div>
                            ${escapeHtml(
                                transaction.referenceNo || "—"
                            )}
                        </div>

                        <div class="material-code">
                            ${escapeHtml(
                                transaction.referenceType || ""
                            )}
                        </div>
                    </td>

                    <td class="text-end text-success fw-semibold">
                        ${
                            Number(transaction.quantityIn || 0) > 0
                                ? formatQuantity(
                                    transaction.quantityIn
                                  )
                                : "—"
                        }
                    </td>

                    <td class="text-end text-danger fw-semibold">
                        ${
                            Number(transaction.quantityOut || 0) > 0
                                ? formatQuantity(
                                    transaction.quantityOut
                                  )
                                : "—"
                        }
                    </td>

                    <td class="text-end fw-bold">
                        ${formatQuantity(
                            transaction.runningBalance
                        )}
                    </td>

                    <td>
                        ${escapeHtml(transaction.uom)}
                    </td>

                    <td>
                        ${escapeHtml(
                            transaction.encodedBy || "—"
                        )}
                    </td>
                `;

                tableBody.appendChild(row);
            });
        }

        function resetTransactionTable() {
            document.getElementById(
                "transactionTableBody"
            ).innerHTML = "";

            document.getElementById(
                "transactionEmpty"
            ).classList.add("d-none");

            document.getElementById(
                "transactionTableContainer"
            ).classList.add("d-none");
        }

        function setTransactionLoading(isLoading) {
            const loading =
                document.getElementById(
                    "transactionLoading"
                );

            const tableContainer =
                document.getElementById(
                    "transactionTableContainer"
                );

            const emptyContainer =
                document.getElementById(
                    "transactionEmpty"
                );

            if (isLoading) {
                loading.classList.remove("d-none");
                tableContainer.classList.add("d-none");
                emptyContainer.classList.add("d-none");
            }
            else {
                loading.classList.add("d-none");
            }
        }

        function getTransactionTypeBadge(type) {
            const transactionType =
                String(type || "").toUpperCase();

            const isOutbound =
                transactionType.includes("ISSUE") ||
                transactionType.includes("OUT") ||
                transactionType.includes("RELEASE") ||
                transactionType.includes("CONSUME");

            const badgeClass =
                isOutbound
                    ? "bg-danger-subtle text-danger"
                    : "bg-success-subtle text-success";

            return `
                <span class="badge ${badgeClass}">
                    ${escapeHtml(
                        formatStatusText(transactionType)
                    )}
                </span>
            `;
        }

        function formatStatusText(value) {
            return String(value || "")
                .replaceAll("_", " ")
                .toLowerCase()
                .replace(/\b\w/g, function (character) {
                    return character.toUpperCase();
                });
        }

        function formatDateTime(value) {
            if (!value) {
                return "—";
            }

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) {
                return "—";
            }

            return date.toLocaleString("en-PH", {
                year: "numeric",
                month: "short",
                day: "2-digit",
                hour: "2-digit",
                minute: "2-digit"
            });
        }

        function formatDaysUntilExpiration(days, expiryStatus) {
            if (String(expiryStatus).toUpperCase() ===
                "NO_EXPIRATION") {
                return "No expiration date";
            }

            if (days === null ||
                days === undefined) {
                return "—";
            }

            const numberOfDays = Number(days);

            if (numberOfDays < 0) {
                const expiredDays =
                    Math.abs(numberOfDays);

                return `Expired ${formatNumber(expiredDays)} day${
                    expiredDays === 1 ? "" : "s"
                } ago`;
            }

            if (numberOfDays === 0) {
                return "Expires today";
            }

            return `${formatNumber(numberOfDays)} day${
                numberOfDays === 1 ? "" : "s"
            } remaining`;
        }

        function clearFilters() {
            document.getElementById("filterSearch").value = "";
            document.getElementById("filterBranch").value = "";
            document.getElementById("filterCategory").value = "";
            document.getElementById("filterStockStatus").value = "";
            document.getElementById("filterExpiryStatus").value = "";
            document.getElementById("filterFromDate").value = "";
            document.getElementById("filterToDate").value = "";

            loadInventory(false);
        }

        function setLoading(isLoading) {
            const loadingContainer =
                document.getElementById("loadingContainer");

            const tableContainer =
                document.getElementById("tableContainer");

            const emptyContainer =
                document.getElementById("emptyContainer");

            const buttons = [
                document.getElementById("btnSearch"),
                document.getElementById("btnRefresh"),
                document.getElementById("btnClear")
            ];

            buttons.forEach(function (button) {
                if (button) {
                    button.disabled = isLoading;
                }
            });

            if (isLoading) {
                loadingContainer.classList.remove("d-none");
                tableContainer.classList.add("d-none");
                emptyContainer.classList.add("d-none");
            }
            else {
                loadingContainer.classList.add("d-none");

                if (inventoryItems.length > 0) {
                    tableContainer.classList.remove("d-none");
                }
                else {
                    emptyContainer.classList.remove("d-none");
                }
            }
        }

        function getStockBadge(status) {
            switch (String(status || "").toUpperCase()) {
                case "IN_STOCK":
                    return `
                        <span class="status-badge badge-in-stock">
                            In Stock
                        </span>`;

                case "LOW_STOCK":
                    return `
                        <span class="status-badge badge-low-stock">
                            Low Stock
                        </span>`;

                case "OUT_OF_STOCK":
                    return `
                        <span class="status-badge badge-out-of-stock">
                            Out of Stock
                        </span>`;

                default:
                    return `
                        <span class="status-badge badge-no-expiration">
                            Unknown
                        </span>`;
            }
        }

        function getExpiryBadge(status) {
            switch (String(status || "").toUpperCase()) {
                case "GOOD":
                    return `
                        <span class="status-badge badge-good">
                            Good
                        </span>`;

                case "NEAR_EXPIRY":
                    return `
                        <span class="status-badge badge-near-expiry">
                            Near Expiry
                        </span>`;

                case "EXPIRED":
                    return `
                        <span class="status-badge badge-expired">
                            Expired
                        </span>`;

                case "NO_EXPIRATION":
                    return `
                        <span class="status-badge badge-no-expiration">
                            No Expiration
                        </span>`;

                default:
                    return `
                        <span class="status-badge badge-no-expiration">
                            Unknown
                        </span>`;
            }
        }

        function formatDate(value) {
            if (!value) {
                return "—";
            }

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) {
                return "—";
            }

            return date.toLocaleDateString("en-PH", {
                year: "numeric",
                month: "short",
                day: "2-digit"
            });
        }

        function formatQuantity(value) {
            const numberValue = Number(value ?? 0);

            return numberValue.toLocaleString("en-PH", {
                minimumFractionDigits: 0,
                maximumFractionDigits: 4
            });
        }

        function formatNumber(value) {
            return Number(value ?? 0).toLocaleString("en-PH");
        }

        function getErrorMessage(error) {
            if (!error) {
                return "Unknown error.";
            }

            if (typeof error === "string") {
                return error;
            }

            return error.message || "Unknown error.";
        }

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function escapeAttribute(value) {
            return escapeHtml(value);
        }
    </script>
}