        async function loadInventory(loadFilterOptions) {
            setLoading(true);

            try {
                let url = "/inventory/raw-materials/data";

                const query = new URLSearchParams();

                const search =
                    document.getElementById("filterSearch").value.trim();

                const branchId =
                    document.getElementById("filterBranch").value;

                const categoryId =
                    document.getElementById("filterCategory").value;

                const stockStatus =
                    document.getElementById("filterStockStatus").value;

                const expiryStatus =
                    document.getElementById("filterExpiryStatus").value;

                const fromDate =
                    document.getElementById("filterFromDate").value;

                const toDate =
                    document.getElementById("filterToDate").value;

                if (search) {
                    query.append("search", search);
                }

                if (branchId) {
                    query.append("branchId", branchId);
                }

                if (categoryId) {
                    query.append("categoryId", categoryId);
                }

                if (stockStatus) {
                    query.append("stockStatus", stockStatus);
                }

                if (expiryStatus) {
                    query.append("expiryStatus", expiryStatus);
                }

                if (fromDate) {
                    query.append("fromDate", fromDate);
                }

                if (toDate) {
                    query.append("toDate", toDate);
                }

                const queryString = query.toString();

                if (queryString) {
                    url += "?" + queryString;
                }

                const response = await fetch(url, {
                    method: "GET",
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (!response.ok) {
                    const errorContent = await response.text();

                    throw new Error(
                        errorContent ||
                        "Unable to load raw material inventory."
                    );
                }

                const data = await response.json();

                inventoryItems = Array.isArray(data.items)
                    ? data.items
                    : [];

                updateSummary(data.summary);
                renderInventoryTable(inventoryItems);

                if (loadFilterOptions || !filterOptionsInitialized) {
                    populateFilterOptions(inventoryItems);
                    filterOptionsInitialized = true;
                }
            }
            catch (error) {
                console.error(error);

                inventoryItems = [];

                updateSummary(null);
                renderInventoryTable([]);

                alert(
                    "Unable to load raw material inventory.\n\n" +
                    getErrorMessage(error)
                );
            }
            finally {
                setLoading(false);
            }
        }

