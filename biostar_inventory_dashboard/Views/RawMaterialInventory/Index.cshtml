                      async function loadStockInMaterials() {

            const response = await fetch(
                "/manufacturing/materials/list",
                {
                    method: "GET",
                    headers: {
                        "Accept": "application/json"
                    }
                }
            );

            if (!response.ok) {
                throw new Error(
                    await response.text() ||
                    "Unable to load materials."
                );
            }

            const result = await response.json();

            stockInMaterials =
                result.data ??
                result.items ??
                result.materials ??
                result;

            if (!Array.isArray(stockInMaterials)) {
                stockInMaterials = [];
            }

            stockInMaterials =
                stockInMaterials.filter(function (material) {
                    return material.is_active !== false;
                });

            populateStockInCategories();
            renderStockInMaterials();
        }




                function populateStockInCategories() {

