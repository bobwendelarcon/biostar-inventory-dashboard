@model biostar_inventory_dashboard.Models.Inventory.RawMaterialInventoryViewModel

@{
    ViewData["Title"] = "Raw Material Inventory";
}

<style>
    .raw-material-page {
        padding-bottom: 40px;
    }

    .summary-card {
        border: 0;
        border-radius: 12px;
        height: 100%;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .summary-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .10) !important;
    }

    .summary-label {
        color: #6c757d;
        font-size: 0.82rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .summary-value {
        margin: 7px 0 0;
        font-size: 1.9rem;
        font-weight: 700;
        color: #212529;
    }

    .filter-card,
    .inventory-card {
        border: 0;
        border-radius: 12px;
    }

    .filter-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 5px;
    }

    .inventory-table {
        margin-bottom: 0;
        white-space: nowrap;
    }

    .inventory-table thead th {
        background: #f8f9fa;
        color: #495057;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        border-bottom: 1px solid #dee2e6;
        padding: 12px 10px;
        vertical-align: middle;
    }

    .inventory-table tbody td {
        padding: 11px 10px;
        vertical-align: middle;
        font-size: 0.88rem;
    }

    .material-name {
        font-weight: 600;
        color: #212529;
    }

    .material-code {
        font-size: 0.78rem;
        color: #6c757d;
    }

    .quantity-value {
        font-weight: 700;
        text-align: right;
    }

    .status-badge {
        min-width: 88px;
        display: inline-block;
        padding: 6px 8px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        text-align: center;
    }

    .badge-in-stock {
        background: #d1e7dd;
        color: #0f5132;
    }

    .badge-low-stock {
        background: #fff3cd;
        color: #664d03;
    }

    .badge-out-of-stock {
        background: #f8d7da;
        color: #842029;
    }

    .badge-good {
        background: #d1e7dd;
        color: #0f5132;
    }

    .badge-near-expiry {
        background: #fff3cd;
        color: #664d03;
    }

    .badge-expired {
        background: #f8d7da;
        color: #842029;
    }

    .badge-no-expiration {
        background: #e2e3e5;
        color: #41464b;
    }

    .loading-container,
    .empty-container {
        padding: 55px 20px;
        text-align: center;
        color: #6c757d;
    }

    .table-count {
        color: #6c757d;
        font-size: 0.82rem;
    }

    .detail-label {
        color: #6c757d;
        font-size: 0.76rem;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    .detail-value {
        font-weight: 500;
        color: #212529;
        min-height: 24px;
    }

    @@media (max-width: 991.98px) {
        .summary-value {
            font-size: 1.55rem;
        }
    }
</style>

<div class="container-fluid raw-material-page">

    <!-- Page heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="mb-0">Raw Material Inventory</h3>
            <small class="text-muted">
                View available raw materials by lot and branch.
            </small>
        </div>

        <div class="d-flex gap-2">

            <button type="button"
                    id="btnManualStockIn"
                    class="btn btn-primary">
                <i class="bi bi-box-arrow-in-down me-1"></i>
                Manual Stock In
            </button>

            <button type="button"
                    id="btnRefresh"
                    class="btn btn-outline-primary">
                <i class="bi bi-arrow-clockwise me-1"></i>
                Refresh
            </button>

        </div>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">

        <div class="col-xl col-lg-4 col-md-6">
            <div class="card summary-card shadow-sm">
                <div class="card-body text-center">
                    <div class="summary-label">Total Materials</div>
                    <div id="totalMaterials" class="summary-value">0</div>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-4 col-md-6">
            <div class="card summary-card shadow-sm">
                <div class="card-body text-center">
                    <div class="summary-label">Inventory Lots</div>
                    <div id="inventoryLots" class="summary-value">0</div>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-4 col-md-6">
            <div class="card summary-card shadow-sm">
                <div class="card-body text-center">
                    <div class="summary-label">Low Stock</div>
                    <div id="lowStock" class="summary-value">0</div>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-4 col-md-6">
            <div class="card summary-card shadow-sm">
                <div class="card-body text-center">
                    <div class="summary-label">Near Expiry</div>
                    <div id="nearExpiry" class="summary-value">0</div>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-4 col-md-6">
            <div class="card summary-card shadow-sm">
                <div class="card-body text-center">
                    <div class="summary-label">Expired</div>
                    <div id="expired" class="summary-value">0</div>
                </div>
            </div>
        </div>

    </div>

    <!-- Filters -->
    <div class="card filter-card shadow-sm mb-4">
        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-xl-3 col-lg-4 col-md-6">
                    <label for="filterSearch" class="filter-label">
                        Search
                    </label>

                    <input type="text"
                           id="filterSearch"
                           class="form-control"
                           placeholder="Material code, name, lot or supplier">
                </div>

                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="filterBranch" class="filter-label">
                        Branch
                    </label>

                    <select id="filterBranch" class="form-select">
                        <option value="">All Branches</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="filterCategory" class="filter-label">
                        Category
                    </label>

                    <select id="filterCategory" class="form-select">
                        <option value="">All Categories</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="filterStockStatus" class="filter-label">
                        Stock Status
                    </label>

                    <select id="filterStockStatus" class="form-select">
                        <option value="">All Stock Statuses</option>
                        <option value="IN_STOCK">In Stock</option>
                        <option value="LOW_STOCK">Low Stock</option>
                        <option value="OUT_OF_STOCK">Out of Stock</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="filterExpiryStatus" class="filter-label">
                        Expiry Status
                    </label>

                    <select id="filterExpiryStatus" class="form-select">
                        <option value="">All Expiry Statuses</option>
                        <option value="GOOD">Good</option>
                        <option value="NEAR_EXPIRY">Near Expiry</option>
                        <option value="EXPIRED">Expired</option>
                        <option value="NO_EXPIRATION">No Expiration</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="filterFromDate" class="filter-label">
                        From Date
                    </label>

                    <input type="date"
                           id="filterFromDate"
                           class="form-control">
                </div>

                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="filterToDate" class="filter-label">
                        To Date
                    </label>

                    <input type="date"
                           id="filterToDate"
                           class="form-control">
                </div>

                <div class="col-xl-auto col-lg-4 col-md-6">
                    <button type="button"
                            id="btnSearch"
                            class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>
                </div>

                <div class="col-xl-auto col-lg-4 col-md-6">
                    <button type="button"
                            id="btnClear"
                            class="btn btn-outline-secondary w-100">
                        Clear
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- Inventory table -->
    <div class="card inventory-card shadow-sm">

        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">Inventory List</h5>
                    <div id="tableCount" class="table-count">
                        0 inventory records
                    </div>
                </div>
            </div>
        </div>

        <div id="loadingContainer" class="loading-container d-none">
            <div class="spinner-border text-primary mb-3"
                 role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <div>Loading raw material inventory...</div>
        </div>

        <div id="emptyContainer" class="empty-container d-none">
            <div class="fs-1 mb-2">
                <i class="bi bi-inboxes"></i>
            </div>

            <h6>No inventory records found</h6>

            <div>
                Try changing or clearing the selected filters.
            </div>
        </div>

        <div id="tableContainer" class="table-responsive">
            <table class="table table-hover inventory-table">
                <thead>
                    <tr>
                        <th>Material</th>
                        <th>Category</th>
                        <th>Branch</th>
                        <th>Lot No.</th>
                        <th class="text-end">On Hand</th>
                        <th>UOM</th>
                        <th>Supplier</th>
                        <th>Expiration</th>
                        <th>Stock</th>
                        <th>Expiry</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>

                <tbody id="inventoryTableBody">
                </tbody>
            </table>
        </div>

    </div>

</div>

<!-- Manual Stock In Modal -->
<div class="modal fade"
     id="manualStockInModal"
     tabindex="-1"
     aria-labelledby="manualStockInModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title"
                        id="manualStockInModalLabel">
                        Manual Stock In
                    </h5>

                    <small class="text-muted">
                        Add raw material inventory manually.
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <div id="manualStockInAlert"
                     class="alert d-none">
                </div>

                <div class="row g-3">

                    <!-- Category -->
                    <div class="col-md-4">

                        <label for="stockInCategory"
                               class="form-label fw-semibold">
                            Category
                        </label>

                        <select id="stockInCategory"
                                class="form-select">
                            <option value="">
                                All Categories
                            </option>
                        </select>

                    </div>

                    <!-- Material -->
                    <div class="col-md-5">

                        <label for="stockInMaterial"
                               class="form-label fw-semibold">
                            Material
                            <span class="text-danger">*</span>
                        </label>

                        <select id="stockInMaterial"
                                class="form-select">
                            <option value="">
                                Select Material
                            </option>
                        </select>

                        <div id="stockInMaterialInfo"
                             class="small text-muted mt-1">
                        </div>

                    </div>

                    <!-- Branch -->
                    <div class="col-md-3">

                        <label for="stockInBranch"
                               class="form-label fw-semibold">
                            Branch
                            <span class="text-danger">*</span>
                        </label>

                        <select id="stockInBranch"
                                class="form-select">
                            <option value="">
                                Select Branch
                            </option>
                        </select>

                    </div>

                    <!-- Quantity -->
                    <div class="col-md-6">

                        <label for="stockInQuantity"
                               class="form-label fw-semibold">
                            Quantity
                            <span class="text-danger">*</span>
                        </label>

                        <div class="input-group">

                            <input type="number"
                                   id="stockInQuantity"
                                   class="form-control"
                                   min="0.0001"
                                   step="0.0001"
                                   placeholder="0">

                            <span id="stockInUom"
                                  class="input-group-text">
                                UOM
                            </span>

                        </div>

                    </div>


                    <!-- Supplier -->
                    <div class="col-md-6">

                        <label for="stockInSupplier"
                               class="form-label fw-semibold">
                            Supplier
                        </label>

                        <select id="stockInSupplier"
                                class="form-select">
                            <option value="">
                                Not Specified
                            </option>
                        </select>

                        <div class="form-text">
                            Optional for manual stock in.
                        </div>

                    </div>

                    <!-- Lot Number -->
                    <div class="col-md-6"
                         id="stockInLotContainer">

                        <label for="stockInLotNo"
                               class="form-label fw-semibold">
                            Lot Number
                            <span id="stockInLotRequired"
                                  class="text-danger">
                                *
                            </span>
                        </label>

                        <input type="text"
                               id="stockInLotNo"
                               class="form-control"
                               placeholder="Enter lot number">

                    </div>

                    <!-- Manufacturing Date -->
                    <div class="col-md-6"
                         id="stockInManufacturingDateContainer">

                        <label for="stockInManufacturingDate"
                               class="form-label fw-semibold">
                            Manufacturing Date
                        </label>

                        <input type="date"
                               id="stockInManufacturingDate"
                               class="form-control">

                    </div>

                    <!-- Expiration Date -->
                    <div class="col-md-6"
                         id="stockInExpirationDateContainer">

                        <label for="stockInExpirationDate"
                               class="form-label fw-semibold">
                            Expiration Date
                        </label>

                        <input type="date"
                               id="stockInExpirationDate"
                               class="form-control">

                    </div>

                    <!-- Remarks -->
                    <div class="col-12">

                        <label for="stockInRemarks"
                               class="form-label fw-semibold">
                            Remarks
                        </label>

                        <textarea id="stockInRemarks"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Reason or notes for manual stock in"></textarea>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="btnSaveManualStockIn"
                        class="btn btn-primary">

                    <span id="stockInSaveSpinner"
                          class="spinner-border spinner-border-sm me-1 d-none">
                    </span>

                    <i id="stockInSaveIcon"
                       class="bi bi-check-circle me-1"></i>

                    Save Stock In
                </button>

            </div>

        </div>

    </div>
</div>


<!-- Details modal -->
<div class="modal fade"
     id="inventoryDetailsModal"
     tabindex="-1"
     aria-labelledby="inventoryDetailsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title"
                        id="inventoryDetailsModalLabel">
                        Raw Material Details
                    </h5>

                    <small id="modalMaterialCode"
                           class="text-muted">
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <ul class="nav nav-tabs mb-3"
                    id="rawMaterialDetailsTabs"
                    role="tablist">

                    <li class="nav-item" role="presentation">
                        <button class="nav-link active"
                                id="general-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#generalTabPane"
                                type="button"
                                role="tab">
                            General
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link"
                                id="lot-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#lotTabPane"
                                type="button"
                                role="tab">
                            Lot Information
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link"
                                id="transactions-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#transactionsTabPane"
                                type="button"
                                role="tab">
                            Transactions
                        </button>
                    </li>

                </ul>

                <div class="tab-content">

                    <!-- General tab -->
                    <div class="tab-pane fade show active"
                         id="generalTabPane"
                         role="tabpanel">

                        <div class="row g-3">

                            <div class="col-md-8">
                                <div class="detail-label">
                                    Material Name
                                </div>

                                <div id="modalMaterialName"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    Category
                                </div>

                                <div id="modalCategory"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    Branch
                                </div>

                                <div id="modalBranch"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    Supplier
                                </div>

                                <div id="modalSupplier"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    UOM
                                </div>

                                <div id="modalUom"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    On Hand
                                </div>

                                <div id="modalQuantity"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    Minimum Stock
                                </div>

                                <div id="modalMinimumStock"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    Stock Status
                                </div>

                                <div id="modalStockStatus"
                                     class="detail-value">
                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- Lot tab -->
                    <div class="tab-pane fade"
                         id="lotTabPane"
                         role="tabpanel">

                        <div class="row g-3">

                            <div class="col-md-6">
                                <div class="detail-label">
                                    Lot Number
                                </div>

                                <div id="modalLotNo"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="detail-label">
                                    Lot Tracking
                                </div>

                                <div id="modalLotTracking"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    Manufacturing Date
                                </div>

                                <div id="modalManufacturingDate"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    Expiration Date
                                </div>

                                <div id="modalExpirationDate"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    Expiry Status
                                </div>

                                <div id="modalExpiryStatus"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    Inventory Age
                                </div>

                                <div id="modalInventoryAge"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="detail-label">
                                    Days Until Expiration
                                </div>

                                <div id="modalDaysUntilExpiration"
                                     class="detail-value">
                                </div>
                            </div>

                            <div class="col-12">
                                <hr>
                            </div>

                            <div class="col-12">
                                <div class="detail-label">
                                    Remarks
                                </div>

                                <div id="modalRemarks"
                                     class="detail-value">
                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- Transactions tab -->
                    <div class="tab-pane fade"
                         id="transactionsTabPane"
                         role="tabpanel">

                        <div id="transactionLoading"
                             class="text-center py-5 d-none">

                            <div class="spinner-border text-primary mb-2"
                                 role="status">
                                <span class="visually-hidden">
                                    Loading...
                                </span>
                            </div>

                            <div class="text-muted">
                                Loading transaction history...
                            </div>
                        </div>

                        <div id="transactionEmpty"
                             class="text-center text-muted py-5 d-none">

                            <i class="bi bi-clock-history fs-1"></i>

                            <div class="mt-2">
                                No transactions were found for this inventory lot.
                            </div>
                        </div>

                        <div id="transactionTableContainer"
                             class="table-responsive">

                            <table class="table table-sm table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Reference</th>
                                        <th class="text-end">Qty In</th>
                                        <th class="text-end">Qty Out</th>
                                        <th class="text-end">Balance</th>
                                        <th>UOM</th>
                                        <th>Encoded By</th>
                                    </tr>
                                </thead>

                                <tbody id="transactionTableBody">
                                </tbody>
                            </table>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
                let inventoryItems = [];
        let filterOptionsInitialized = false;

        let stockInMaterials = [];
        let manualStockInModal = null;

               document.addEventListener("DOMContentLoaded", async function () {

            manualStockInModal =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("manualStockInModal")
                );

            bindEvents();

            await loadInventory(true);
        });

        function bindEvents() {
            document.getElementById("btnSearch")
                .addEventListener("click", function () {
                    loadInventory(false);
                });

            document.getElementById("btnRefresh")
                .addEventListener("click", function () {
                    loadInventory(!filterOptionsInitialized);
                });

            document.getElementById("btnClear")
                .addEventListener("click", clearFilters);

            document.getElementById("filterSearch")
                .addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();
                        loadInventory(false);
                    }
                });

        document.getElementById("btnManualStockIn")
            .addEventListener("click", openManualStockIn);

                document.getElementById("stockInCategory")
        .addEventListener(
            "change",
            filterStockInMaterials
