                async function saveManualStockIn() {

            hideManualStockInAlert();

            const materialId =
                Number(
                    document.getElementById(
                        "stockInMaterial"
                    ).value
                );

            const branchId =
                document.getElementById(
                    "stockInBranch"
                ).value.trim();

            const quantity =
                Number(
                    document.getElementById(
                        "stockInQuantity"
                    ).value
                );

            const material =
                stockInMaterials.find(
                    x =>
                        Number(x.material_id) ===
                        materialId
                );

            if (!materialId) {

                showManualStockInAlert(
                    "Please select a material.",
                    "danger"
                );

                return;
            }

            if (!branchId) {

                showManualStockInAlert(
                    "Please select a branch.",
                    "danger"
                );

                return;
            }

            if (!quantity ||
                quantity <= 0) {

                showManualStockInAlert(
                    "Quantity must be greater than zero.",
                    "danger"
                );

                return;
            }

            const lotNo =
                document.getElementById(
                    "stockInLotNo"
                ).value.trim();

            if (material?.is_lot_tracked &&
                !lotNo) {

                showManualStockInAlert(
                    "Lot number is required for this material.",
                    "danger"
                );

                return;
            }

            const manufacturingDate =
                document.getElementById(
                    "stockInManufacturingDate"
                ).value;

            const expirationDate =
                document.getElementById(
                    "stockInExpirationDate"
                ).value;

            if (manufacturingDate &&
                expirationDate &&
                expirationDate <
                manufacturingDate) {

                showManualStockInAlert(
                    "Expiration date cannot be earlier than manufacturing date.",
                    "danger"
                );

                return;
            }

            const dto = {

                materialId:
                    materialId,

                branchId:
                    branchId,

                quantity:
                    quantity,

                lotNo:
                    material?.is_lot_tracked
                        ? lotNo
                        : null,

                manufacturingDate:
                    material?.is_lot_tracked &&
                    manufacturingDate
                        ? manufacturingDate
                        : null,

                expirationDate:
                    material?.is_lot_tracked &&
                    expirationDate
                        ? expirationDate
                        : null,

                    supplierId:
        document.getElementById(
            "stockInSupplier"
        ).value
            ? Number(
                document.getElementById(
                    "stockInSupplier"
                ).value
            )
            : null,

                remarks:
                    document.getElementById(
                        "stockInRemarks"
                    ).value.trim(),

                encodedBy:
                    ""
            };

            setManualStockInSaving(true);

            try {

                const response = await fetch(
                    "/inventory/raw-materials/manual-stock-in",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json",

                            "Accept":
                                "application/json"
                        },

                        body:
                            JSON.stringify(dto)
                    }
                );

                if (!response.ok) {

                    const error =
                        await response.text();

                    throw new Error(
                        error ||
                        "Unable to save manual stock in."
                    );
                }

                manualStockInModal.hide();

                await loadInventory(true);

                alert(
                    "Manual stock in saved successfully."
                );
            }
            catch (error) {

                console.error(error);

                showManualStockInAlert(
                    getErrorMessage(error),
                    "danger"
                );
            }
            finally {

                setManualStockInSaving(false);
            }
        }

