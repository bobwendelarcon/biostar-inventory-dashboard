@{
    ViewData["Title"] = "Material Categories";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Material Categories</h4>
            <small class="text-muted">
                Manage categories and their optional sub categories.
            </small>
        </div>

        <button class="btn btn-primary" onclick="openAddModal()">
            + Add Category
        </button>
    </div>

    <div class="row g-3">
        <!-- LEFT PANEL: CATEGORIES -->
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Categories</strong>
                </div>

                <div class="card-body table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th style="width:150px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="categoryTableBody">
                            <tr>
                                <td colspan="4" class="text-center">Loading...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: SUB CATEGORIES -->
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Sub Categories</strong>
                        <div class="small text-muted" id="selectedCategoryLabel">
                            Select a category to view sub categories.
                        </div>
                    </div>

                    <button id="btnAddSubCategory"
                            class="btn btn-sm btn-primary"
                            onclick="openAddSubCategoryModal()"
                            disabled>
                        + Add Sub Category
                    </button>
                </div>

                <div class="card-body table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Sub Category Name</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th style="width:150px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="subCategoryTableBody">
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    No category selected.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CATEGORY MODAL -->
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="modalTitle" class="modal-title">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="material_category_id" />

                <div class="mb-3">
                    <label class="form-label">Category Name</label>
                    <input type="text" id="category_name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea id="description" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" onclick="saveCategory()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- SUB CATEGORY MODAL -->
<div class="modal fade" id="subCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="subCategoryModalTitle" class="modal-title">Add Sub Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="material_subcategory_id" />

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <input type="text" id="subCategoryCategoryName" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Sub Category Name</label>
                    <input type="text" id="subcategory_name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea id="subcategory_description" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" onclick="saveSubCategory()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.apiBaseUrl = '@ViewBag.ApiBaseUrl';
        console.log("API BASE URL:", window.apiBaseUrl);
    </script>

    <script src="~/js/manufacturing/materials/material-categories.js"></script>
}