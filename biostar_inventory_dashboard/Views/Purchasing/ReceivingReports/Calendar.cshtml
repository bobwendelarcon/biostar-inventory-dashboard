        function addRescheduleGroup(assignAllRemaining = false) {
        if (!selectedScheduleDetailsData)
            return;

        const groupId = nextRescheduleGroupId++;

        const lines = (selectedScheduleDetailsData.lines ?? [])
            .filter(line => Number(line.remainingQty) > 0)
            .map(line => ({
                scheduleLineId: Number(line.scheduleLineId),
                materialCode: line.materialCode ?? "",
                materialName: line.materialName ?? "",
                uom: line.uom ?? "",
                remainingQty: Number(line.remainingQty),
                quantity: assignAllRemaining
                    ? Number(line.remainingQty)
                    : 0
            }));

        rescheduleGroups.push({
            id: groupId,
            scheduledDate: "",
            remarks: "",
            lines: lines
        });

        renderRescheduleGroups();
    }

        function removeRescheduleGroup(groupId) {
        if (rescheduleGroups.length <= 1) {
            alert("At least one delivery schedule is required.");
            return;
        }

        rescheduleGroups =
            rescheduleGroups.filter(x => x.id !== groupId);

        renderRescheduleGroups();
    }

