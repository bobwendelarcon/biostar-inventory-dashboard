                .getElementById(
                    "modalPrintedPoNo"
                )
                .value =
                    scheduleData.printedPoNo ?? "";


            document
                .getElementById(
                    "modalSupplierName"
                )
                .value =
                    scheduleData.supplierName ?? "";


            document
                .getElementById(
