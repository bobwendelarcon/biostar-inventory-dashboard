         async function saveIncomingReceiving() {

        if (!modalReceivingData) {
            alert("Delivery schedule data not loaded.");
            return;
        }


        // ============================================================
        // HEADER
        // ============================================================

        const branchId =
            document
                .getElementById("modalBranchId")
                .value
                .trim();

        if (!branchId) {
            alert("Receiving Branch is required.");
            return;
        }


        const deliveryDate =
            document
                .getElementById("modalDeliveryDate")
                .value;

        if (!deliveryDate) {
            alert("Delivery Date is required.");
            return;
        }


        const verifiedBy =
            document
                .getElementById("modalVerifiedBy")
                .value
                .trim();


        // ============================================================
        // MAKE SURE ACTIVE LOT EDITS ARE SAVED
        // ============================================================

        if (activeReceivingPoLineId) {
            syncReceivingLotInputs();
        }


        // ============================================================
        // RECEIVING LINES
        // ============================================================

        const rows =
            document.querySelectorAll(
                "#modalRrLineBody tr[data-po-line-id]"
            );

        const lines = [];


        for (const row of rows) {

            const poLineId =
                Number(row.dataset.poLineId);


                    const materialId =
        Number(row.dataset.materialId);

    const supplierId =
        Number(
            modalReceivingData?.supplierId ?? 0
        );

            const remaining =
                Number(
                    row.dataset.remainingQty || 0
                );

            const deliveredQty =
                Number(
                    row.querySelector(
                        ".modal-delivered-qty"
                    )?.value || 0
                );

            const tareWeightValue =
                row.querySelector(
                    ".modal-tare-weight"
                )?.value ?? "";

            const tareWeight =
                tareWeightValue === ""
                    ? null
                    : Number(tareWeightValue);

            const lineRemarks =
                row.querySelector(
                    ".modal-line-remarks"
                )?.value.trim() ?? "";


            // --------------------------------------------------------
            // Skip lines with no delivery
            // --------------------------------------------------------

            if (deliveredQty <= 0) {
                continue;
            }


            // --------------------------------------------------------
            // Basic validation
            // --------------------------------------------------------

            if (tareWeight !== null && tareWeight < 0) {
                alert(
                    "Tare Weight cannot be negative."
                );
                return;
            }


            // --------------------------------------------------------
            // Over-delivery validation
            // --------------------------------------------------------

            if (deliveredQty > remaining) {

                const excessQty =
                    deliveredQty - remaining;

                if (!lineRemarks) {

                    alert(
                        `Over-delivery detected.\n\n` +
                        `Scheduled balance: ${formatQty(remaining)}\n` +
                        `Delivered today: ${formatQty(deliveredQty)}\n` +
                        `Excess quantity: ${formatQty(excessQty)}\n\n` +
                        `Please enter a line remark explaining the excess delivery.`
                    );

                    return;
                }

                const continueOverDelivery =
                    confirm(
                        `This delivery exceeds the scheduled balance.\n\n` +
                        `Scheduled balance: ${formatQty(remaining)}\n` +
                        `Delivered today: ${formatQty(deliveredQty)}\n` +
                        `Excess: ${formatQty(excessQty)}\n\n` +
                        `Continue and record this as an over-delivery?`
                    );

                if (!continueOverDelivery) {
                    return;
                }
            }


            // ========================================================
            // LOT / MATERIAL RECEIVING DETAILS
            // ========================================================

            const sourceLots =
                receivingLotsByPoLine[poLineId] ?? [];

            const lots =
                sourceLots.map(lot => ({

                    manufacturerId:
                        lot.manufacturerId
                            ? Number(lot.manufacturerId)
                            : null,

                    lotNo:
                        lot.lotNo?.trim() || null,

                    manufacturingDate:
                        lot.manufacturingDate || null,

                    expirationDate:
                        lot.expirationDate || null,

                    itemCount:
                        lot.itemCount === null ||
                        lot.itemCount === ""
                            ? null
                            : Number(lot.itemCount),

                    weight:
                        lot.weight === null ||
                        lot.weight === ""
                            ? null
                            : Number(lot.weight),

                    remarks:
                        lot.remarks?.trim() || null
                }));


            // --------------------------------------------------------
            // Validate lot rows
            // --------------------------------------------------------

            for (const lot of lots) {

                if (
                    lot.itemCount !== null &&
                    lot.itemCount < 0
                ) {
                    alert(
                        "No. of Item cannot be negative."
                    );
                    return;
                }

                if (
                    lot.weight !== null &&
                    lot.weight < 0
                ) {
                    alert(
                        "Receiving Weight cannot be negative."
                    );
                    return;
                }

                if (
                    lot.manufacturingDate &&
                    lot.expirationDate &&
                    lot.expirationDate <
                        lot.manufacturingDate
                ) {
                    alert(
                        "Expiration Date cannot be earlier than Manufacturing Date."
                    );
                    return;
                }
            }


            lines.push({

                poLineId:
                    poLineId,

                deliveredQty:
                    deliveredQty,

                tareWeight:
                    tareWeight,

                remarks:
                    lineRemarks || null,

                lots:
                    lots
            });
        }


        if (lines.length === 0) {

            alert(
                "Please enter at least one Delivered Qty."
            );

            return;
        }


        // ============================================================
        // WAREHOUSE / MATERIAL RECEIVING CHECKLIST
        // ============================================================

        const inspection = {

            // PO / Supplier
            poMatched:
                document.getElementById(
                    "chkPoMatched"
                ).checked,

            deliveryScheduled:
                document.getElementById(
                    "chkDeliveryScheduled"
                ).checked,

            approvedSupplier:
                document.getElementById(
                    "chkApprovedSupplier"
                ).checked,


            // Documents
            salesInvoiceAvailable:
                document.getElementById(
                    "chkSalesInvoice"
                ).checked,

            deliveryReceiptAvailable:
                document.getElementById(
                    "chkDeliveryReceipt"
                ).checked,

            coaAvailable:
                document.getElementById(
                    "chkCoa"
                ).checked,


            // Material Receiving Form
            correctQuantityDelivered:
                document.getElementById(
                    "chkCorrectQuantityDelivered"
                ).checked,

            truckDoorLockInPlace:
                document.getElementById(
                    "chkTruckDoorLock"
                ).checked,

            vehicleClean:
                document.getElementById(
                    "chkVehicleClean"
                ).checked,

            containersCleanAndSealed:
                document.getElementById(
                    "chkContainersCleanSealed"
                ).checked,

            noVisibleContaminationOrSpoilage:
                document.getElementById(
                    "chkNoVisibleContamination"
                ).checked,

            labelsPresentAndLegible:
                document.getElementById(
                    "chkLabelsPresent"
                ).checked,

            driverIdentityVerified:
                document.getElementById(
                    "chkDriverVerified"
                ).checked,

            noUnauthorizedAccessDuringUnloading:
                document.getElementById(
                    "chkNoUnauthorizedAccess"
                ).checked,

            hiddenCompartmentChecked:
                document.getElementById(
                    "chkHiddenCompartment"
                ).checked,

            receivedInAuthorizedZone:
                document.getElementById(
                    "chkAuthorizedZone"
                ).checked,

            remarks:
                document.getElementById(
                    "modalInspectionRemarks"
                ).value.trim() || null
        };


        // ============================================================
        // PAYLOAD
        // ============================================================

        const payload = {

            scheduleId:
                selectedReceivingScheduleId,

            branchId:
                branchId,

            deliveryDate:
                deliveryDate,

            siDrNo:
                document
                    .getElementById("modalSiDrNo")
                    .value
                    .trim() || null,

            remarks:
                document
                    .getElementById("modalRemarks")
                    .value
                    .trim() || null,

            verifiedBy:
                verifiedBy || null,

            lines:
                lines,

            inspection:
                inspection
        };


        console.log(
            "Incoming Receiving Payload:",
            payload
        );


        // ============================================================
        // SAVE
        // ============================================================

        const btn =
            document.getElementById(
                "btnModalSaveIncoming"
            );

        btn.disabled = true;
        btn.innerHTML = "Processing...";


        try {

            const response =
                await fetch(
                    "/purchasing/incoming-receiving",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify(payload)
                    }
                );


            const result =
                await readJsonResponse(
                    response,
                    "Failed to record incoming delivery."
                );


            alert(
                result.message ??
                "Incoming delivery recorded successfully."
            );


            createReceivingModal.hide();

            calendar.refetchEvents();
        }
        catch (ex) {

            console.error(ex);

            alert(
                ex.message ??
                "Unable to save incoming delivery."
            );
        }
        finally {

            btn.disabled = false;

            btn.innerHTML =
                "Complete Warehouse Check";
        }
    }

        function getLocalToday() {
        const date = new Date();

        const year = date.getFullYear();

        const month = String(
            date.getMonth() + 1
        ).padStart(2, "0");

        const day = String(
            date.getDate()
        ).padStart(2, "0");

        return `${year}-${month}-${day}`;
    }

        function formatQty(value) {
        return Number(value ?? 0).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 4
        });
    }

    function updateCalendarSummary(data) {

           const approvedCount = data.filter(
        item => item.status === "OPEN"
    ).length;

        const partialCount = data.filter(
            item => item.status === "PARTIALLY_RECEIVED"
        ).length;

        document.getElementById("scheduledCount").textContent =
            data.length;

        document.getElementById("approvedCount").textContent =
            approvedCount;

        document.getElementById("partialCount").textContent =
            partialCount;
    }


 


    function getDateOnly(value) {

        if (!value) {
            return null;
        }

        return value.toString().substring(0, 10);
    }


    function formatDate(value) {

        if (!value) {
            return "";
        }

        const dateOnly =
            value.toString().substring(0, 10);

        const parts = dateOnly.split("-");

        if (parts.length !== 3) {
            return value;
        }

        return `${parts[1]}/${parts[2]}/${parts[0]}`;
    }





    function formatMoney(value) {

        return Number(value ?? 0).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

        function escapeHtml(value) {
        if (value === null || value === undefined)
            return "";

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }
</script>