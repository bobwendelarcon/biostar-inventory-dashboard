        function updateRescheduleGroupDate(groupId, value) {
        const group =
            rescheduleGroups.find(x => x.id === groupId);

        if (group)
            group.scheduledDate = value;
    }

        function updateRescheduleGroupRemarks(groupId, value) {
        const group =
            rescheduleGroups.find(x => x.id === groupId);

        if (group)
            group.remarks = value;
    }

        function updateRescheduleGroupQty(
        groupId,
        scheduleLineId,
        value)
    {
        const group =
            rescheduleGroups.find(x => x.id === groupId);

        if (!group)
            return;

        const line =
            group.lines.find(x =>
                x.scheduleLineId === scheduleLineId);

        if (!line)
            return;

        line.quantity = Number(value || 0);

        updateRescheduleTotals();
    }

        function getRescheduleAssignments() {
        const assignments = new Map();

        rescheduleGroups.forEach(group => {
            group.lines.forEach(line => {
                const current =
                    assignments.get(line.scheduleLineId) ?? 0;

                assignments.set(
                    line.scheduleLineId,
                    current + Number(line.quantity || 0)
                );
            });
        });

        return assignments;
    }

        function updateRescheduleTotals() {
        if (!selectedScheduleDetailsData)
            return;

        const requiredTotal =
            Number(
                selectedScheduleDetailsData.totalRemainingQty ?? 0
            );

        const assignedTotal =
            rescheduleGroups.reduce(
                (scheduleTotal, group) =>
                    scheduleTotal +
                    group.lines.reduce(
                        (lineTotal, line) =>
                            lineTotal +
                            Number(line.quantity || 0),
                        0
                    ),
                0
            );

        const unassigned =
            requiredTotal - assignedTotal;

        document.getElementById(
            "rescheduleRequiredTotal"
        ).textContent = formatQty(requiredTotal);

        document.getElementById(
            "rescheduleAssignedTotal"
        ).textContent = formatQty(assignedTotal);

        document.getElementById(
            "rescheduleUnassignedTotal"
        ).textContent = formatQty(unassigned);
    }

           async function saveRescheduleRemaining() {
        if (!selectedScheduleDetailsData) {
            alert("Schedule details are not loaded.");
            return;
        }

        for (const group of rescheduleGroups) {
            if (!group.scheduledDate) {
                alert("Each new schedule must have a delivery date.");
                return;
            }

            const hasQty =
                group.lines.some(line =>
                    Number(line.quantity) > 0);

            if (!hasQty) {
                alert(
                    "Each new schedule must contain at least one quantity."
                );
                return;
            }
        }

        const assignments = getRescheduleAssignments();

        for (const sourceLine of selectedScheduleDetailsData.lines) {
            const remainingQty =
                Number(sourceLine.remainingQty || 0);

            if (remainingQty <= 0)
                continue;

            const assignedQty =
                assignments.get(
                    Number(sourceLine.scheduleLineId)
                ) ?? 0;

            if (Math.abs(assignedQty - remainingQty) > 0.0001) {
                alert(
                    `${sourceLine.materialCode} must assign exactly ` +
                    `${formatQty(remainingQty)} ${sourceLine.uom}. ` +
                    `Currently assigned: ${formatQty(assignedQty)}.`
                );

                return;
            }
        }

        const payload = {
            reason:
                document.getElementById(
                    "rescheduleReason"
                ).value,

            schedules: rescheduleGroups.map(group => ({
                scheduledDate: group.scheduledDate,
                remarks: group.remarks,

                lines: group.lines
                    .filter(line =>
                        Number(line.quantity) > 0)
                    .map(line => ({
                        scheduleLineId:
                            line.scheduleLineId,

                        rescheduleQty:
                            Number(line.quantity)
                    }))
            }))
        };

        const confirmed = confirm(
            `Create ${payload.schedules.length} new delivery schedule(s)?`
        );

        if (!confirmed)
            return;

        const button =
            document.getElementById("btnSaveReschedule");

        button.disabled = true;
        button.textContent = "Creating...";

        try {
            const response = await fetch(
                `/purchasing/receiving-reports/schedules/` +
                `${selectedScheduleDetailsId}/reschedule-remaining`,
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(payload)
                }
            );

            const responseText = await response.text();

            let result = {};

            if (responseText) {
                result = JSON.parse(responseText);
            }

            if (!response.ok) {
                throw new Error(
                    result.message ??
                    "Unable to reschedule remaining delivery."
                );
            }

            alert(
                result.message ??
                "Remaining delivery rescheduled successfully."
            );

            rescheduleRemainingModal.hide();

            calendar.refetchEvents();
        }
        catch (error) {
            alert(error.message);
        }
        finally {
            button.disabled = false;
            button.textContent = "Create New Schedule";
        }
    }

        function formatStatus(value) {
        if (!value)
            return "";

        return String(value)
            .replaceAll("_", " ")
            .toLowerCase()
            .replace(/\b\w/g, letter => letter.toUpperCase());
    }

