          async function saveReceivingReport() {

        if (!modalReceivingData) {
            alert("Purchase Order data not loaded.");
            return;
        }

            const branchId =
        document.getElementById("modalBranchId").value.trim();

    if (!branchId) {
        alert("Receiving Branch is required.");
        document.getElementById("modalBranchId").focus();
        return;
    }

        const deliveryDate =
            document.getElementById("modalDeliveryDate").value;

        if (!deliveryDate) {
            alert("Delivery Date is required.");
            return;
        }

        const rows = document.querySelectorAll(
            "#modalRrLineBody tr[data-po-line-id]"
        );

        const lines = [];
        let hasOverReceived = false;

        for (const row of rows) {

            const poLineId =
                Number(row.dataset.poLineId);

            const balance =
                Number(row.dataset.balanceQty || 0);

            const receiveQty =
                Number(
                    row.querySelector(".modal-receive-qty").value || 0
                );

            if (receiveQty > balance) {
                hasOverReceived = true;
            }

            if (receiveQty > 0) {

                lines.push({

                    poLineId: poLineId,

                    receiveQty: receiveQty,

                    remarks:
                        row.querySelector(".modal-line-remarks").value

                });

            }
        }

        if (lines.length === 0) {
            alert("Please enter at least one Receive Qty.");
            return;
        }

        if (hasOverReceived) {

            const proceed = confirm(
                "One or more items exceed the remaining PO quantity.\n\nContinue as OVER RECEIVING?"
            );

            if (!proceed)
                return;
        }

           const payload = {
        scheduleId: selectedReceivingScheduleId,

        branchId: branchId,

        deliveryDate: deliveryDate,

        siDrNo:
            document.getElementById("modalSiDrNo").value,

        remarks:
            document.getElementById("modalRemarks").value,

        lines: lines
    };

        const btn =
            document.getElementById("btnModalSaveRr");

        btn.disabled = true;
        btn.innerHTML = "Saving...";

        try {

            const response = await fetch(
                "/purchasing/receiving-reports/create",
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(payload)
                });

            const result = await response.json();

            if (!response.ok) {

                alert(
                    result.message ??
                    "Failed to create Receiving Report."
                );

                return;
            }

            alert(
                result.message ??
                "Receiving Report created successfully."
            );

            createReceivingModal.hide();

            calendar.refetchEvents();

        }
        catch (ex) {

            alert(ex.message);

        }
        finally {

            btn.disabled = false;
            btn.innerHTML = "Save Receiving Report";

        }
    }

        function getLocalToday() {
        const date = new Date();

        const year = date.getFullYear();

        const month = String(
            date.getMonth() + 1
        ).padStart(2, "0");

        const day = String(
            date.getDate()
        ).padStart(2, "0");

        return `${year}-${month}-${day}`;
    }

        function formatQty(value) {
        return Number(value ?? 0).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 4
        });
    }

