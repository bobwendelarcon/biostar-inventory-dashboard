<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<script>
        let calendar;
    let createReceivingModal;

       let scheduleDetailsModal;
    let rescheduleRemainingModal;

    let selectedScheduleDetailsId = 0;
    let selectedScheduleDetailsData = null;

        let rescheduleGroups = [];
    let nextRescheduleGroupId = 1;

    document.addEventListener("DOMContentLoaded", function () {





        document
    .getElementById("btnAddRescheduleGroup")
    .addEventListener("click", function () {
        addRescheduleGroup();
    });



            scheduleDetailsModal = new bootstrap.Modal(
        document.getElementById("scheduleDetailsModal")
    );

    rescheduleRemainingModal = new bootstrap.Modal(
        document.getElementById("rescheduleRemainingModal")
    );

    document
        .getElementById("btnOpenRescheduleModal")
        .addEventListener("click", openRescheduleRemainingModal);

    document
        .getElementById("btnSaveReschedule")
        .addEventListener("click", saveRescheduleRemaining);



          const modalElement =
        document.getElementById("createReceivingModal");

    createReceivingModal =
        new bootstrap.Modal(modalElement);

        const calendarElement =
            document.getElementById("receivingCalendar");

        calendar = new FullCalendar.Calendar(calendarElement, {

            initialView: "dayGridMonth",

            height: "auto",

            firstDay: 0,

            headerToolbar: {
                left: "prev,next today",
                center: "title",
                right: "dayGridMonth,listMonth"
            },

            buttonText: {
                today: "Today",
                month: "Month",
                list: "List"
            },

            noEventsContent: "No scheduled receiving for this period.",

            dayMaxEvents: 4,

            eventDisplay: "block",

            events: async function (
                fetchInfo,
                successCallback,
                failureCallback
            ) {
                try {
                    const start =
                        fetchInfo.startStr.substring(0, 10);

                    const end =
                        fetchInfo.endStr.substring(0, 10);

                    const response = await fetch(
                        `/purchasing/receiving-reports/calendar-list` +
                        `?start=${encodeURIComponent(start)}` +
                        `&end=${encodeURIComponent(end)}`
                    );

                    if (!response.ok) {
                        let message =
                            "Failed to load receiving calendar.";

                        try {
                            const errorResult =
                                await response.json();

                            message =
                                errorResult.message ?? message;
                        }
                        catch {
                        }

                        throw new Error(message);
                    }

                    const data = await response.json();

                    updateCalendarSummary(data);

                      const events = data.map(item => {


        let eventClass = "receiving-approved";

    switch ((item.status ?? "").toUpperCase()) {

        case "OPEN":
            eventClass = "receiving-approved";
            break;

        case "PARTIALLY_RECEIVED":
            eventClass = "receiving-partial";
            break;

        case "WAITING_FOR_QC":
        case "FOR_QC":
            eventClass = "receiving-qc";
            break;

        case "QC_COMPLETED":
            eventClass = "receiving-no-confirmation";
            break;

        case "RMW_PROCESSING":
            eventClass = "receiving-rmw";
            break;

        case "READY_FOR_FINAL_RR":
            eventClass = "receiving-final-rr";
            break;

        case "RECEIVED":
        case "COMPLETED":
            eventClass = "receiving-completed";
            break;

        case "NO_CONFIRMATION":
            eventClass = "receiving-no-confirmation";
            break;

        case "RESCHEDULED":
            eventClass = "receiving-rescheduled";
            break;

        case "CANCELLED":
            eventClass = "receiving-cancelled";
            break;

        default:
            eventClass = "receiving-approved";
            break;
    }

    const displayPoNo =
    item.printedPoNo?.trim() || item.poNo;

        return {
            id: item.scheduleId.toString(),

             title:
        `${displayPoNo} - ${item.supplierName} (Schedule ${item.scheduleNo})`,

            start:
                getDateOnly(item.deliveryDate),

            allDay: true,

            classNames: [
                eventClass
            ],

            extendedProps: {
                scheduleId: item.scheduleId,
                scheduleNo: item.scheduleNo,
                poId: item.poId,
                printedPoNo: item.printedPoNo,
                poNo: item.poNo,
                supplierId: item.supplierId,
                supplierName: item.supplierName,
                deliveryDate: item.deliveryDate,
                status: item.status,
                totalAmount: item.totalAmount,
                materialCount: item.materialCount,
                totalPoQty: item.totalPoQty,
                totalReceivedQty: item.totalReceivedQty,
                totalBalanceQty: item.totalBalanceQty
            }
        };
    });

                    successCallback(events);
                }
                catch (error) {
                    console.error(error);

                    updateCalendarSummary([]);

                    failureCallback(error);
                }
            },

               eventClick: function (info) {

        info.jsEvent.preventDefault();

        const scheduleId =
            Number(
                info.event.extendedProps.scheduleId
            );

        const status =
            String(
                info.event.extendedProps.status ?? ""
            ).toUpperCase();

        const remainingQty =
            Number(
                info.event.extendedProps.totalBalanceQty ?? 0
            );


        // ============================================================
        // OPEN WAREHOUSE RECEIVING
        // Schedule still has physical quantity to receive
        // ============================================================

        if (
            status === "OPEN" &&
            remainingQty > 0
        ) {
            openReceivingModal(scheduleId);
            return;
        }


        // ============================================================
        // OTHERWISE SHOW TRACKING / DETAILS
        // ============================================================

        openScheduleDetailsModal(scheduleId);
    }
        });

        calendar.render();

     document
    .getElementById("btnModalSaveIncoming")
    .addEventListener(
        "click",
        saveIncomingReceiving
    );


    });



    let selectedReceivingScheduleId = 0;
    let modalReceivingData = null;
        let receivingLotsByPoLine = {};
    let activeReceivingPoLineId = null;
    let activeReceivingIsLotTracked = false;

    let receivingManufacturersByPoLine = {};


    async function loadReceivingBranches() {
        const branchSelect =
            document.getElementById("modalBranchId");

        branchSelect.innerHTML =
            `<option value="">Loading branches...</option>`;

        branchSelect.disabled = true;

        try {
            const response = await fetch("/Branch/GetBranches");

            const result = await readJsonResponse(
                response,
                "Unable to load branches."
            );

            const activeBranches = (result ?? [])
                .filter(branch => !branch.is_deleted);

            branchSelect.innerHTML =
                `<option value="">Select receiving branch</option>`;

            activeBranches.forEach(branch => {
                const option = document.createElement("option");

                option.value = branch.branch_id;

                option.textContent = branch.branch_loc
                    ? `${branch.branch_name} - ${branch.branch_loc}`
                    : branch.branch_name;

                branchSelect.appendChild(option);
            });

            if (activeBranches.length === 1) {
                branchSelect.value =
                    activeBranches[0].branch_id;
            }
        }
        catch (error) {
            console.error(error);

            branchSelect.innerHTML =
                `<option value="">Failed to load branches</option>`;

            throw error;
        }
        finally {
            branchSelect.disabled = false;
        }
    }

         async function openReceivingDetails(button) {

        const row =
            button.closest(
                "tr[data-po-line-id]"
            );

        if (!row)
            return;

        const poLineId =
            Number(row.dataset.poLineId);

        const materialId =
            Number(row.dataset.materialId);

        const supplierId =
            Number(
                modalReceivingData?.supplierId ?? 0
            );

        activeReceivingPoLineId =
            poLineId;

        document.getElementById(
            "receivingLotPoLineId"
        ).value =
            poLineId;

        document.getElementById(
            "receivingLotMaterialName"
        ).textContent =
            `${row.dataset.materialCode ?? ""} - ` +
            `${row.dataset.materialName ?? ""}`;

        const section =
            document.getElementById(
                "receivingLotSection"
            );

        section.classList.remove(
            "d-none"
        );

            activeReceivingIsLotTracked =
        row.dataset.isLotTracked === "true";

    document
        .getElementById("receivingLotNoHeader")
        .classList.toggle(
            "d-none",
            !activeReceivingIsLotTracked
        );

    document
        .getElementById("receivingMfgDateHeader")
        .classList.toggle(
            "d-none",
            !activeReceivingIsLotTracked
        );

    document
        .getElementById("receivingExpDateHeader")
        .classList.toggle(
            "d-none",
            !activeReceivingIsLotTracked
        );

    if (
        !receivingLotsByPoLine[poLineId] ||
            receivingLotsByPoLine[poLineId]
                .length === 0
        ) {
            receivingLotsByPoLine[poLineId] = [
                {
                    manufacturerId: null,
                    lotNo: "",
                    manufacturingDate: "",
                    expirationDate: "",
                    itemCount: null,
                    weight: null,
                    remarks: ""
                }
            ];
        }

        if (
            !receivingManufacturersByPoLine[
                poLineId
            ]
        ) {
            const response =
                await fetch(
                    `/purchasing/incoming-receiving/manufacturers` +
                    `?supplierId=${encodeURIComponent(supplierId)}` +
                    `&materialId=${encodeURIComponent(materialId)}`
                );

            const manufacturers =
                await readJsonResponse(
                    response,
                    "Unable to load approved manufacturers."
                );

            receivingManufacturersByPoLine[
                poLineId
            ] =
                manufacturers ?? [];
        }

        renderReceivingLotRows();

        section.scrollIntoView({
            behavior: "smooth",
            block: "nearest"
        });
    }

        function addReceivingLotRow() {

        if (!activeReceivingPoLineId)
            return;


        if (!receivingLotsByPoLine[
            activeReceivingPoLineId
        ]) {
            receivingLotsByPoLine[
                activeReceivingPoLineId
            ] = [];
        }


        receivingLotsByPoLine[
            activeReceivingPoLineId
        ].push({

            manufacturerId: null,

            lotNo: "",

            manufacturingDate: "",

            expirationDate: "",

            itemCount: null,

            weight: null,

            remarks: ""
        });


        renderReceivingLotRows();
    }

        function renderReceivingLotRows() {

        const tbody =
            document.getElementById(
                "receivingLotBody"
            );

        tbody.innerHTML = "";


        if (!activeReceivingPoLineId)
            return;


        const lots =
            receivingLotsByPoLine[
                activeReceivingPoLineId
            ] ?? [];


        if (lots.length === 0) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="8"
                        class="text-center text-muted py-3">
                        No receiving details entered yet.
                    </td>
                </tr>
            `;

            updateReceivingLotCount(
                activeReceivingPoLineId
            );

            return;
        }


        const manufacturers =
    receivingManufacturersByPoLine[
        activeReceivingPoLineId
    ] ?? [];

        lots.forEach((lot, index) => {

            tbody.insertAdjacentHTML(
                "beforeend",
                `
                <tr>

                    <td>
                            <select
        class="form-select form-select-sm lot-manufacturer"
        data-index="${index}">

        <option value="">
            Select manufacturer
        </option>

        ${manufacturers.map(m => `
            <option
                value="${Number(m.manufacturerId)}"
                ${
                    Number(lot.manufacturerId) ===
                    Number(m.manufacturerId)
                        ? "selected"
                        : ""
                }>
                ${escapeHtml(
                    m.manufacturerName ?? ""
                )}
            </option>
        `).join("")}

    </select>
                    </td>

                      <td class="${activeReceivingIsLotTracked ? "" : "d-none"}">
        <input
            type="text"
            class="form-control form-control-sm lot-number"
            data-index="${index}"
            value="${escapeHtml(lot.lotNo ?? "")}"
            placeholder="Lot No.">
    </td>

    <td class="${activeReceivingIsLotTracked ? "" : "d-none"}">
        <input
            type="date"
            class="form-control form-control-sm lot-mfg-date"
            data-index="${index}"
            value="${escapeHtml(lot.manufacturingDate ?? "")}">
    </td>

    <td class="${activeReceivingIsLotTracked ? "" : "d-none"}">
        <input
            type="date"
            class="form-control form-control-sm lot-exp-date"
            data-index="${index}"
            value="${escapeHtml(lot.expirationDate ?? "")}">
    </td>

                    <td>
                        <input
                            type="number"
                            class="form-control form-control-sm text-end lot-item-count"
                            data-index="${index}"
                            min="0"
                            step="0.0001"
                            value="${lot.itemCount ?? ""}"
                            placeholder="0">
                    </td>

                    <td>
                        <input
                            type="number"
                            class="form-control form-control-sm text-end lot-weight"
                            data-index="${index}"
                            min="0"
                            step="0.0001"
                            value="${lot.weight ?? ""}"
                            placeholder="0.0000">
                    </td>

                    <td>
                        <input
                            type="text"
                            class="form-control form-control-sm lot-remarks"
                            data-index="${index}"
                            value="${escapeHtml(lot.remarks ?? "")}"
                            placeholder="Optional">
                    </td>

                    <td>
                        <button
                            type="button"
                            class="btn btn-outline-danger btn-sm"
                            onclick="removeReceivingLotRow(${index})">
                            Remove
                        </button>
                    </td>

                </tr>
                `
            );
        });


        bindReceivingLotInputs();

        updateReceivingLotCount(
            activeReceivingPoLineId
        );
    }

        function bindReceivingLotInputs() {

        const tbody =
            document.getElementById(
                "receivingLotBody"
            );


        tbody.querySelectorAll(
            "input, select"
        ).forEach(element => {

            element.addEventListener(
                "change",
                syncReceivingLotInputs
            );

            element.addEventListener(
                "input",
                syncReceivingLotInputs
            );
        });
    }


    function syncReceivingLotInputs() {

        if (!activeReceivingPoLineId)
            return;


        const lots =
            receivingLotsByPoLine[
                activeReceivingPoLineId
            ];

        if (!lots)
            return;


        document.querySelectorAll(
            "#receivingLotBody tr"
        ).forEach(row => {

            const input =
                row.querySelector(
                    "[data-index]"
                );

            if (!input)
                return;


            const index =
                Number(
                    input.dataset.index
                );

            const lot =
                lots[index];

            if (!lot)
                return;


            lot.manufacturerId =
                Number(
                    row.querySelector(
                        ".lot-manufacturer"
                    )?.value || 0
                ) || null;


            lot.lotNo =
                row.querySelector(
                    ".lot-number"
                )?.value.trim() ?? "";


            lot.manufacturingDate =
                row.querySelector(
                    ".lot-mfg-date"
                )?.value ?? "";


            lot.expirationDate =
                row.querySelector(
                    ".lot-exp-date"
                )?.value ?? "";


            const itemCount =
                row.querySelector(
                    ".lot-item-count"
                )?.value;


            lot.itemCount =
                itemCount === ""
                    ? null
                    : Number(itemCount);


            const weight =
                row.querySelector(
                    ".lot-weight"
                )?.value;


            lot.weight =
                weight === ""
                    ? null
                    : Number(weight);


            lot.remarks =
                row.querySelector(
                    ".lot-remarks"
                )?.value.trim() ?? "";
        });


        updateReceivingLotCount(
            activeReceivingPoLineId
        );
    }

        function removeReceivingLotRow(index) {

        if (!activeReceivingPoLineId)
            return;


        syncReceivingLotInputs();


        const lots =
            receivingLotsByPoLine[
                activeReceivingPoLineId
            ];

        if (!lots)
            return;


        lots.splice(
            index,
            1
        );


        renderReceivingLotRows();
    }
        function updateReceivingLotCount(poLineId) {

        const lots =
            receivingLotsByPoLine[
                poLineId
            ] ?? [];


        const row =
            document.querySelector(
                `#modalRrLineBody tr[data-po-line-id="${poLineId}"]`
            );

        if (!row)
            return;


        const label =
            row.querySelector(
                ".receiving-lot-count"
            );

        if (!label)
            return;


        label.textContent =
            lots.length === 0
                ? "No lot details"
                : lots.length === 1
                    ? "1 receiving row"
                    : `${lots.length} receiving rows`;
    }

        async function readJsonResponse(response, fallbackMessage) {
        const responseText = await response.text();

        let result = {};

        try {
            result = responseText
                ? JSON.parse(responseText)
                : {};
        }
        catch {
            console.error(
                "Non-JSON response:",
                response.status,
                response.url,
                responseText
            );

            throw new Error(
                "The server returned an invalid response."
            );
        }

        if (!response.ok) {
            throw new Error(
                result.message || fallbackMessage
            );
        }

        return result;
    }

     async function openReceivingModal(scheduleId) {

        selectedReceivingScheduleId =
            Number(scheduleId);

        modalReceivingData = null;

        const loading =
