@using System.Security.Claims

@{
    ViewData["Title"] = "Receiving Calendar";

    var loggedInFullName =
        User.FindFirst("full_name")?.Value
        ?? User.Identity?.Name
        ?? "";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <div class="text-muted small mb-1">
                Purchasing &gt; Receiving Reports &gt; Calendar
            </div>

            <h2 class="fw-bold mb-1">
                Receiving Calendar
            </h2>

            <div class="text-muted">
                Scheduled deliveries from approved Purchase Orders.
            </div>
        </div>

        <a href="/purchasing/receiving-reports"
           class="btn btn-outline-secondary">
            View Receiving Reports
        </a>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        Scheduled Deliveries
                    </div>

                    <div id="scheduledCount"
                         class="fs-3 fw-bold">
                        0
                    </div>
                </div>
            </div>
        </div>

     

        <div class="col-md-4">
            <div class="card border-0 shadow-sm summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        Open Delivery Schedules
                    </div>

                    <div id="approvedCount"
                         class="fs-3 fw-bold text-success">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        Partially Received
                    </div>

                    <div id="partialCount"
                         class="fs-3 fw-bold text-warning">
                        0
                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">

            <div class="d-flex flex-wrap align-items-center gap-3">

                <span class="fw-semibold text-secondary">
                    Legend
                </span>

                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-success"></span>
                    <span class="small">Scheduled Receiving</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-warning"></span>
                    <span class="small">Partially Received</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-info"></span>
                    <span class="small">Waiting for QA/QC</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot legend-purple"></span>
                    <span class="small">QC Completed</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot legend-rmw"></span>
                    <span class="small">RMW Processing</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot legend-final-rr"></span>
                    <span class="small">Ready for Final RR</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot legend-orange"></span>
                    <span class="small">Rescheduled</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-danger"></span>
                    <span class="small">Cancelled</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-secondary"></span>
                    <span class="small">Completed</span>
                </div>

            </div>

        </div>
    </div>

    <div class="card border-0 shadow-sm calendar-card">
        <div class="card-body">
            <div id="receivingCalendar"></div>
        </div>
    </div>

</div>

<div class="modal fade"
     id="createReceivingModal"
     tabindex="-1"
     aria-labelledby="createReceivingModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-1"
                        id="createReceivingModalLabel">
                        Incoming Delivery / Warehouse Receiving
                    </h5>

                    <div class="text-muted small">
                        Verify the incoming supplier delivery, documents, vehicle condition,
                        and materials before forwarding to QA/QC.
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <div id="receivingModalLoading"
                     class="text-center text-muted py-5">

                    <div class="spinner-border spinner-border-sm me-2"
                         role="status">
                    </div>

                    Loading receiving information...
                </div>

                <div id="receivingModalError"
                     class="alert alert-danger d-none">
                </div>

                <div id="receivingModalContent"
                     class="d-none">

                    <div class="card border-0 bg-light mb-4">
                        <div class="card-body">

                            <div class="row g-3">

                                <div class="col-lg-2 col-md-4">
                                    <label class="form-label">
                                        Incoming No
                                    </label>

                                    <input id="modalIncomingNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-lg-2 col-md-4">
                                    <label class="form-label">
                                        System PO No
                                    </label>

                                    <input id="modalPoNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-lg-2 col-md-4">
                                    <label class="form-label">
                                        Printed PO No
                                    </label>

                                    <input id="modalPrintedPoNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-lg-2 col-md-6">
                                    <label class="form-label">
                                        Supplier
                                    </label>

                                    <input id="modalSupplierName"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <label class="form-label">
                                        Receiving Branch
                                    </label>

                                    <select id="modalBranchId"
                                            class="form-select">
                                        <option value="">Select receiving branch</option>
                                    </select>
                                </div>

                                <div class="col-lg-2 col-md-6">
                                    <label class="form-label">
                                        Actual Delivery Date
                                    </label>

                                    <input id="modalDeliveryDate"
                                           type="date"
                                           class="form-control">
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">
                                        SI / DR No
                                    </label>

                                    <input id="modalSiDrNo"
                                           class="form-control"
                                           placeholder="Enter SI or DR number">
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">
                                        Remarks
                                    </label>

                                    <input id="modalRemarks"
                                           class="form-control"
                                           placeholder="Optional remarks">
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">
                                        Verified By
                                    </label>

                                    <input id="modalVerifiedBy"
                                           class="form-control"
                                           value="@loggedInFullName"
                                           readonly>
                                </div>

                            </div>

                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h5 class="fw-bold mb-0">
                            Receiving Lines
                        </h5>

                        <div class="text-muted small">
                            Enter only the quantity received today.
                        </div>

                    </div>

                    <div class="table-responsive receiving-lines-wrapper">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Material Code</th>
                                    <th>Material Name</th>

                                    <th class="text-end">
                                        PO Qty
                                    </th>

                                    <th class="text-end">
                                        Scheduled Qty
                                    </th>

                                    <th class="text-end">
                                        Previously Delivered
                                    </th>

                                    <th class="text-end">
                                        Remaining
                                    </th>

                                    <th style="width:120px;">
                                        Delivered Qty
                                    </th>

                                    <th>UOM</th>

                                    <th style="width:110px;">
                                        Tare Weight
                                    </th>

                                    <th style="width:140px;">
                                        Remarks
                                    </th>

                                    <th style="width:110px;">
                                        Details
                                    </th>
                                </tr>
                            </thead>

                            <tbody id="modalRrLineBody">

                                <tr>
                                    <td colspan="8"
                                        class="text-center text-muted py-4">
                                        Waiting for Purchase Order data...
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

           


            <div id="receivingLotSection"
                 class="card border-0 bg-light mt-4 d-none">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">
                                Material Receiving Details
                            </h5>

                            <div id="receivingLotMaterialName"
                                 class="text-muted small">
                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                onclick="addReceivingLotRow()">
                                Add Receiving Row
                        </button>
                    </div>

                    <input type="hidden"
                           id="receivingLotPoLineId">

                    <div class="table-responsive border rounded">
                        <table class="table table-sm align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th style="min-width:180px;">Manufacturer</th>
                                        <th id="receivingLotNoHeader"
                                            style="min-width:130px;">
                                            Lot No.
                                        </th>

                                        <th id="receivingMfgDateHeader"
                                            style="min-width:145px;">
                                            Manufacturing Date
                                        </th>

                                        <th id="receivingExpDateHeader"
                                            style="min-width:145px;">
                                            Expiration Date
                                        </th>
                                    <th style="min-width:120px;">No. of Item</th>
                                    <th style="min-width:120px;">Weight</th>
                                    <th style="min-width:180px;">Remarks</th>
                                    <th style="width:70px;"></th>
                                </tr>
                            </thead>

                            <tbody id="receivingLotBody">
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>



            <div class="card border-0 bg-light mt-4">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">
                                Warehouse Receiving Checklist
                            </h5>

                            <div class="text-muted small">
                                Verify documents, supplier, vehicle and material condition.
                            </div>
                        </div>
                    </div>


                    <!-- PO / Supplier -->
                    <div class="mb-4">

                        <h6 class="fw-bold text-secondary mb-3">
                            PO / Supplier Verification
                        </h6>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <div class="form-check">
                                    <input id="chkPoMatched"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkPoMatched">
                                        Delivery matches Purchase Order
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-check">
                                    <input id="chkDeliveryScheduled"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkDeliveryScheduled">
                                        Delivery is scheduled
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-check">
                                    <input id="chkApprovedSupplier"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkApprovedSupplier">
                                        Supplier is approved
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>


                    <!-- Documents -->
                    <div class="mb-4">

                        <h6 class="fw-bold text-secondary mb-3">
                            Required Documents
                        </h6>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <div class="form-check">
                                    <input id="chkSalesInvoice"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkSalesInvoice">
                                        Sales Invoice
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-check">
                                    <input id="chkDeliveryReceipt"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkDeliveryReceipt">
                                        Delivery Receipt
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-check">
                                    <input id="chkCoa"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkCoa">
                                        Certificate of Analysis (COA)
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Material Receiving Form -->
                    <div class="mb-3">

                        <h6 class="fw-bold text-secondary mb-3">
                            Material Receiving Form Checklist
                        </h6>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input id="chkCorrectQuantityDelivered"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkCorrectQuantityDelivered">
                                        Correct quantity delivered
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input id="chkTruckDoorLock"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkTruckDoorLock">
                                        Truck door lock is in place
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input id="chkVehicleClean"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkVehicleClean">
                                        Vehicle inspected for cleanliness
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input id="chkContainersCleanSealed"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkContainersCleanSealed">
                                        Bags / drums / boxes / containers are clean and sealed
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input id="chkNoVisibleContamination"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkNoVisibleContamination">
                                        No visible contamination or sign of spoilage
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input id="chkLabelsPresent"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkLabelsPresent">
                                        Labels are present and legible
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input id="chkDriverVerified"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkDriverVerified">
                                        Driver identity verified (ID seen)
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input id="chkNoUnauthorizedAccess"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkNoUnauthorizedAccess">
                                        No unauthorized access observed during unloading
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input id="chkHiddenCompartment"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkHiddenCompartment">
                                        Vehicle inspected for hidden compartments
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input id="chkAuthorizedZone"
                                           class="form-check-input"
                                           type="checkbox">

                                    <label class="form-check-label"
                                           for="chkAuthorizedZone">
                                        Raw material received only in authorized zone
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>


                    <div class="mt-4">

                        <label class="form-label fw-semibold">
                            Inspection Remarks
                        </label>

                        <textarea id="modalInspectionRemarks"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter missing documents, defects or other receiving observations"></textarea>

                    </div>

                </div>
            </div>

            </div>



            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button id="btnModalSaveIncoming"
                        type="button"
                        class="btn btn-success"
                        disabled>
                    Complete Warehouse Check
                </button>

            </div>

        </div>
    </div>
</div>
<div class="modal fade"
     id="scheduleDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-1">
                        Delivery Schedule Details
                    </h5>

                    <div class="text-muted small">
                        View scheduled, received, and remaining quantities.
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div id="scheduleDetailsLoading"
                     class="text-center text-muted py-5">
                    <div class="spinner-border spinner-border-sm me-2"></div>
                    Loading delivery schedule...
                </div>

                <div id="scheduleDetailsError"
                     class="alert alert-danger d-none">
                </div>

                <div id="scheduleDetailsContent"
                     class="d-none">

                    <div class="card border-0 bg-light mb-4">
                        <div class="card-body">

                            <div class="row g-3">

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">
                                        PO No
                                    </label>
                                    <input id="detailsPoNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        Schedule No
                                    </label>
                                    <input id="detailsScheduleNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">
                                        Scheduled Date
                                    </label>
                                    <input id="detailsScheduledDate"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        Status
                                    </label>
                                    <input id="detailsScheduleStatus"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        RR No
                                    </label>
                                    <input id="detailsRrNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">
                                        Supplier
                                    </label>
                                    <input id="detailsSupplierName"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        RR Status
                                    </label>
                                    <input id="detailsRrStatus"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        QC No
                                    </label>
                                    <input id="detailsQcNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        QC Status
                                    </label>
                                    <input id="detailsQcStatus"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        QC Decision
                                    </label>
                                    <input id="detailsQcDecision"
                                           class="form-control"
                                           readonly>
                                </div>

                            </div>

                        </div>
                    </div>

                    <div class="row g-3 mb-4">

                        <div class="col-md-4">
                            <div class="receiving-quantity-box">
                                <div class="text-muted small">
                                    Total Scheduled
                                </div>
                                <div id="detailsTotalScheduled"
                                     class="fs-4 fw-bold">
                                    0
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="receiving-quantity-box">
                                <div class="text-muted small">
                                    Total Received
                                </div>
                                <div id="detailsTotalReceived"
                                     class="fs-4 fw-bold text-success">
                                    0
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="receiving-quantity-box">
                                <div class="text-muted small">
                                    Total Remaining
                                </div>
                                <div id="detailsTotalRemaining"
                                     class="fs-4 fw-bold text-warning">
                                    0
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="table-responsive border rounded">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Material Code</th>
                                    <th>Material Name</th>
                                    <th class="text-end">PO Qty</th>
                                    <th class="text-end">Scheduled</th>
                                    <th class="text-end">Received</th>
                                    <th class="text-end">Remaining</th>
                                    <th>UOM</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody id="scheduleDetailsLineBody"></tbody>

                        </table>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <button id="btnOpenRescheduleModal"
                        type="button"
                        class="btn btn-warning d-none">
                    Reschedule Remaining
                </button>

            </div>

        </div>
    </div>
</div>


<div class="modal fade"
     id="rescheduleRemainingModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-1">
                        Reschedule Remaining Delivery
                    </h5>

                    <div class="text-muted small">
                        Create a new delivery schedule for the remaining quantity.
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
