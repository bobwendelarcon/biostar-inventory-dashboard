@{
    ViewData["Title"] = "Receiving Calendar";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <div class="text-muted small mb-1">
                Purchasing &gt; Receiving Reports &gt; Calendar
            </div>

            <h2 class="fw-bold mb-1">
                Receiving Calendar
            </h2>

            <div class="text-muted">
                Scheduled deliveries from approved Purchase Orders.
            </div>
        </div>

        <a href="/purchasing/receiving-reports"
           class="btn btn-outline-secondary">
            View Receiving Reports
        </a>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        Scheduled Deliveries
                    </div>

                    <div id="scheduledCount"
                         class="fs-3 fw-bold">
                        0
                    </div>
                </div>
            </div>
        </div>

     

        <div class="col-md-4">
            <div class="card border-0 shadow-sm summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        Open Delivery Schedules
                    </div>

                    <div id="approvedCount"
                         class="fs-3 fw-bold text-success">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        Partially Received
                    </div>

                    <div id="partialCount"
                         class="fs-3 fw-bold text-warning">
                        0
                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">

            <div class="d-flex flex-wrap align-items-center gap-3">

                <span class="fw-semibold text-secondary">
                    Legend
                </span>

                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-success"></span>
                    <span class="small">Scheduled Receiving</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-warning"></span>
                    <span class="small">Partially Received</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-info"></span>
                    <span class="small">Waiting for QA/QC</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot legend-purple"></span>
                    <span class="small">No Confirmation</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot legend-orange"></span>
                    <span class="small">Rescheduled</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-danger"></span>
                    <span class="small">Cancelled</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="legend-dot bg-secondary"></span>
                    <span class="small">Completed</span>
                </div>


            </div>

        </div>
    </div>

    <div class="card border-0 shadow-sm calendar-card">
        <div class="card-body">
            <div id="receivingCalendar"></div>
        </div>
    </div>

</div>

<div class="modal fade"
     id="createReceivingModal"
     tabindex="-1"
     aria-labelledby="createReceivingModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-1"
                        id="createReceivingModalLabel">
                        Create Receiving Report
                    </h5>

                    <div class="text-muted small">
                        Receive the actual truck arrival against the selected delivery schedule.
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <div id="receivingModalLoading"
                     class="text-center text-muted py-5">

                    <div class="spinner-border spinner-border-sm me-2"
                         role="status">
                    </div>

                    Loading receiving information...
                </div>

                <div id="receivingModalError"
                     class="alert alert-danger d-none">
                </div>

                <div id="receivingModalContent"
                     class="d-none">

                    <div class="card border-0 bg-light mb-4">
                        <div class="card-body">

                            <div class="row g-3">

                                <div class="col-lg-2 col-md-4">
                                    <label class="form-label">
                                        RR No
                                    </label>

                                    <input id="modalRrNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-lg-2 col-md-4">
                                    <label class="form-label">
                                        System PO No
                                    </label>

                                    <input id="modalPoNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-lg-2 col-md-4">
                                    <label class="form-label">
                                        Printed PO No
                                    </label>

                                    <input id="modalPrintedPoNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-lg-2 col-md-6">
                                    <label class="form-label">
                                        Supplier
                                    </label>

                                    <input id="modalSupplierName"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-lg-3 col-md-6">
                                    <label class="form-label">
                                        Receiving Branch
                                    </label>

                                    <select id="modalBranchId"
                                            class="form-select">
                                        <option value="">Select receiving branch</option>
                                    </select>
                                </div>

                                <div class="col-lg-2 col-md-6">
                                    <label class="form-label">
                                        Actual Delivery Date
                                    </label>

                                    <input id="modalDeliveryDate"
                                           type="date"
                                           class="form-control">
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">
                                        SI / DR No
                                    </label>

                                    <input id="modalSiDrNo"
                                           class="form-control"
                                           placeholder="Enter SI or DR number">
                                </div>

                                <div class="col-md-8">
                                    <label class="form-label">
                                        Remarks
                                    </label>

                                    <input id="modalRemarks"
                                           class="form-control"
                                           placeholder="Optional remarks">
                                </div>

                            </div>

                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h5 class="fw-bold mb-0">
                            Receiving Lines
                        </h5>

                        <div class="text-muted small">
                            Enter only the quantity received today.
                        </div>

                    </div>

                    <div class="table-responsive receiving-lines-wrapper">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Material Code</th>
                                    <th>Material Name</th>

                                    <th class="text-end">
                                        PO Qty
                                    </th>

                                    <th class="text-end">
                                        Previously Received
                                    </th>

                                    <th class="text-end">
                                        Scheduled Balance
                                    </th>

                                    <th class="text-end"
                                        style="width:150px;">
                                        Receive Qty
                                    </th>

                                    <th>UOM</th>

                                    <th style="min-width:190px;">
                                        Remarks
                                    </th>
                                </tr>
                            </thead>

                            <tbody id="modalRrLineBody">

                                <tr>
                                    <td colspan="8"
                                        class="text-center text-muted py-4">
                                        Waiting for Purchase Order data...
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button id="btnModalSaveRr"
                        type="button"
                        class="btn btn-success"
                        disabled>
                    Save Receiving Report
                </button>

            </div>

        </div>
    </div>
</div>
<div class="modal fade"
     id="scheduleDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-1">
                        Delivery Schedule Details
                    </h5>

                    <div class="text-muted small">
                        View scheduled, received, and remaining quantities.
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div id="scheduleDetailsLoading"
                     class="text-center text-muted py-5">
                    <div class="spinner-border spinner-border-sm me-2"></div>
                    Loading delivery schedule...
                </div>

                <div id="scheduleDetailsError"
                     class="alert alert-danger d-none">
                </div>

                <div id="scheduleDetailsContent"
                     class="d-none">

                    <div class="card border-0 bg-light mb-4">
                        <div class="card-body">

                            <div class="row g-3">

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">
                                        PO No
                                    </label>
                                    <input id="detailsPoNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        Schedule No
                                    </label>
                                    <input id="detailsScheduleNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">
                                        Scheduled Date
                                    </label>
                                    <input id="detailsScheduledDate"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        Status
                                    </label>
                                    <input id="detailsScheduleStatus"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        RR No
                                    </label>
                                    <input id="detailsRrNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">
                                        Supplier
                                    </label>
                                    <input id="detailsSupplierName"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        RR Status
                                    </label>
                                    <input id="detailsRrStatus"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        QC No
                                    </label>
                                    <input id="detailsQcNo"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        QC Status
                                    </label>
                                    <input id="detailsQcStatus"
                                           class="form-control"
                                           readonly>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">
                                        QC Decision
                                    </label>
                                    <input id="detailsQcDecision"
                                           class="form-control"
                                           readonly>
                                </div>

                            </div>

                        </div>
                    </div>

                    <div class="row g-3 mb-4">

                        <div class="col-md-4">
                            <div class="receiving-quantity-box">
                                <div class="text-muted small">
                                    Total Scheduled
                                </div>
                                <div id="detailsTotalScheduled"
                                     class="fs-4 fw-bold">
                                    0
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="receiving-quantity-box">
                                <div class="text-muted small">
                                    Total Received
                                </div>
                                <div id="detailsTotalReceived"
                                     class="fs-4 fw-bold text-success">
                                    0
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="receiving-quantity-box">
                                <div class="text-muted small">
                                    Total Remaining
                                </div>
                                <div id="detailsTotalRemaining"
                                     class="fs-4 fw-bold text-warning">
                                    0
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="table-responsive border rounded">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Material Code</th>
                                    <th>Material Name</th>
                                    <th class="text-end">PO Qty</th>
                                    <th class="text-end">Scheduled</th>
                                    <th class="text-end">Received</th>
                                    <th class="text-end">Remaining</th>
                                    <th>UOM</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody id="scheduleDetailsLineBody"></tbody>

                        </table>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <button id="btnOpenRescheduleModal"
                        type="button"
                        class="btn btn-warning d-none">
                    Reschedule Remaining
                </button>

            </div>

        </div>
    </div>
</div>


<div class="modal fade"
     id="rescheduleRemainingModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-1">
                        Reschedule Remaining Delivery
                    </h5>

                    <div class="text-muted small">
                        Create a new delivery schedule for the remaining quantity.
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="row g-3 mb-4">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            PO No
                        </label>
                        <input id="reschedulePoNo"
                               class="form-control"
                               readonly>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Source Schedule
                        </label>
                        <input id="rescheduleSourceSchedule"
                               class="form-control"
                               readonly>
                    </div>

                   

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Total Remaining
                        </label>
                        <input id="rescheduleTotalRemaining"
                               class="form-control"
                               readonly>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            Reason
                        </label>
                        <textarea id="rescheduleReason"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter rescheduling reason"></textarea>
                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>
                        <h6 class="fw-bold mb-1">
                            New Delivery Schedules
                        </h6>

                        <div class="text-muted small">
                            Assign all remaining quantities to one or more delivery dates.
                        </div>
                    </div>

                    <button id="btnAddRescheduleGroup"
                            type="button"
                            class="btn btn-outline-primary btn-sm">
                        Add Delivery Date
                    </button>

                </div>

                <div id="rescheduleScheduleGroups"></div>

                <div class="alert alert-light border mt-3 mb-0">

                    <div class="d-flex justify-content-between">
                        <span>Total Remaining:</span>

                        <strong id="rescheduleRequiredTotal">
                            0
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span>Total Assigned:</span>

                        <strong id="rescheduleAssignedTotal">
                            0
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span>Unassigned:</span>

                        <strong id="rescheduleUnassignedTotal"
                                class="text-danger">
                            0
                        </strong>
                    </div>

                </div>
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button id="btnSaveReschedule"
                        type="button"
                        class="btn btn-warning">
                    Create New Schedule
                </button>

            </div>

        </div>
    </div>
</div>






<style>
    .summary-card,
    .calendar-card {
        border-radius: 14px;
    }

    #receivingCalendar {
        min-height: 680px;
    }

    .fc .fc-toolbar {
        gap: 12px;
        flex-wrap: wrap;
    }

    .fc .fc-toolbar-title {
        font-size: 1.5rem;
        font-weight: 700;
    }

    .fc .fc-button {
        text-transform: capitalize;
    }

    .fc .fc-button-primary {
        background-color: #334155;
        border-color: #334155;
    }

        .fc .fc-button-primary:hover {
            background-color: #1e293b;
            border-color: #1e293b;
        }

        .fc .fc-button-primary:not(:disabled).fc-button-active {
            background-color: #4f46e5;
            border-color: #4f46e5;
        }

    .fc-daygrid-day-number {
        color: #111827;
        text-decoration: none;
        font-weight: 600;
    }

    .fc-col-header-cell-cushion {
        color: #111827;
        text-decoration: none;
        font-weight: 700;
    }

    .fc-day-today {
        background-color: #eef2ff !important;
    }

    .fc-daygrid-event {
        cursor: pointer;
        border-radius: 5px;
        padding: 3px 5px;
        white-space: normal;
        font-size: 12px;
    }

    .receiving-approved {
        background-color: #198754 !important;
        border-color: #198754 !important;
        color: white !important;
    }

    .receiving-partial {
        background-color: #ffc107 !important;
        border-color: #ffc107 !important;
        color: #212529 !important;
    }

    .receiving-qc {
        background: #0dcaf0 !important;
        border-color: #0dcaf0 !important;
        color: #212529 !important;
    }

    .receiving-no-confirmation {
        background: #8B5CF6 !important;
        border-color: #8B5CF6 !important;
        color: white !important;
    }

    .receiving-rescheduled {
        background: #F97316 !important;
        border-color: #F97316 !important;
        color: white !important;
    }

    .receiving-cancelled {
        background: #dc3545 !important;
        border-color: #dc3545 !important;
        color: white !important;
    }

    .receiving-quantity-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 16px;
    }

    .calendar-loading {
        text-align: center;
        padding: 40px;
        color: #6c757d;
    }


    #createReceivingModal .modal-dialog {
        max-width: 1700px;
    }

    #createReceivingModal .modal-content {
        border-radius: 14px;
    }

    #createReceivingModal .modal-header,
    #createReceivingModal .modal-footer {
        padding-left: 1.5rem;
        padding-right: 1.5rem;
    }

    #createReceivingModal .modal-body {
        padding: 1.5rem;
    }

    .receiving-lines-wrapper {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        max-height: 430px;
    }

        .receiving-lines-wrapper thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            white-space: nowrap;
        }

    #createReceivingModal .form-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: #374151;
    }

    #createReceivingModal input[readonly] {
        background-color: #f3f4f6;
    }

    .receiving-completed {
        background-color: #6c757d !important;
        border-color: #6c757d !important;
        color: white !important;
    }

    @@media (max-width: 768px) {
        #createReceivingModal .modal-dialog {
            margin: 0.5rem;
        }

        #createReceivingModal .modal-body {
            padding: 1rem;
        }
    }

    @@media (max-width: 768px) {
        .fc .fc-toolbar {
            display: block;
            text-align: center;
        }

        .fc .fc-toolbar-chunk {
            margin-bottom: 10px;
        }
    }

    .legend-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
        border: 1px solid rgba(0,0,0,.15);
    }

    .legend-purple {
        background: #8B5CF6;
    }

    .legend-orange {
        background: #F97316;
    }
</style>


<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<script>
        let calendar;
    let createReceivingModal;

       let scheduleDetailsModal;
    let rescheduleRemainingModal;

    let selectedScheduleDetailsId = 0;
    let selectedScheduleDetailsData = null;

        let rescheduleGroups = [];
    let nextRescheduleGroupId = 1;

    document.addEventListener("DOMContentLoaded", function () {





        document
    .getElementById("btnAddRescheduleGroup")
    .addEventListener("click", function () {
        addRescheduleGroup();
    });



            scheduleDetailsModal = new bootstrap.Modal(
        document.getElementById("scheduleDetailsModal")
    );

    rescheduleRemainingModal = new bootstrap.Modal(
        document.getElementById("rescheduleRemainingModal")
    );

    document
        .getElementById("btnOpenRescheduleModal")
        .addEventListener("click", openRescheduleRemainingModal);

    document
        .getElementById("btnSaveReschedule")
        .addEventListener("click", saveRescheduleRemaining);



          const modalElement =
        document.getElementById("createReceivingModal");

    createReceivingModal =
        new bootstrap.Modal(modalElement);

        const calendarElement =
            document.getElementById("receivingCalendar");

        calendar = new FullCalendar.Calendar(calendarElement, {

            initialView: "dayGridMonth",

            height: "auto",

            firstDay: 0,

            headerToolbar: {
                left: "prev,next today",
                center: "title",
                right: "dayGridMonth,listMonth"
            },

            buttonText: {
                today: "Today",
                month: "Month",
                list: "List"
            },

            noEventsContent: "No scheduled receiving for this period.",

            dayMaxEvents: 4,

            eventDisplay: "block",

            events: async function (
                fetchInfo,
                successCallback,
                failureCallback
            ) {
                try {
                    const start =
                        fetchInfo.startStr.substring(0, 10);

                    const end =
                        fetchInfo.endStr.substring(0, 10);

                    const response = await fetch(
                        `/purchasing/receiving-reports/calendar-list` +
                        `?start=${encodeURIComponent(start)}` +
                        `&end=${encodeURIComponent(end)}`
                    );

                    if (!response.ok) {
                        let message =
                            "Failed to load receiving calendar.";

                        try {
                            const errorResult =
                                await response.json();

                            message =
                                errorResult.message ?? message;
                        }
                        catch {
                        }

                        throw new Error(message);
                    }

                    const data = await response.json();

                    updateCalendarSummary(data);

                      const events = data.map(item => {

        let eventClass = "receiving-approved";

           switch (item.status) {
        case "OPEN":
            eventClass = "receiving-approved";
            break;

        case "PARTIALLY_RECEIVED":
            eventClass = "receiving-partial";
            break;

