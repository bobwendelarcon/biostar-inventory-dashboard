        loading.classList.remove("d-none");
        errorBox.classList.add("d-none");
        content.classList.add("d-none");

        saveButton.disabled = true;

        createReceivingModal.show();

        try {

            // ------------------------------------------
            // Load Delivery Schedule
            // ------------------------------------------

            const scheduleResponse =
                await fetch(
                    `/purchasing/incoming-receiving/schedule/${selectedReceivingScheduleId}`
                );

            const scheduleData =
                await readJsonResponse(
                    scheduleResponse,
                    "Unable to load delivery schedule."
                );


            // ------------------------------------------
            // Get next IR number
            // ------------------------------------------

            const numberResponse =
                await fetch(
                    "/purchasing/incoming-receiving/next-number"
                );

            const numberData =
                await readJsonResponse(
                    numberResponse,
                    "Unable to generate Incoming Receiving number."
                );


            await loadReceivingBranches();


            modalReceivingData =
                scheduleData;


            document
                .getElementById("modalIncomingNo")
                .value =
                    numberData.incoming_no ??
                    numberData.incomingNo ??
                    "";


            document
                .getElementById("modalPoNo")
                .value =
                    scheduleData.poNo ?? "";


