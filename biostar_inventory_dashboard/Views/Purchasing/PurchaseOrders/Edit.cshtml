@{
    ViewData["Title"] = "Edit Purchase Order";
    var poId = ViewBag.PoId;
}

<div class="container-fluid px-4 py-4">

    <input type="hidden" id="poId" value="@poId">

    <div class="mb-4">
        <div class="text-muted small mb-1">Purchasing &gt; Purchase Orders &gt; Edit</div>
        <h2 class="fw-bold mb-1">Edit Purchase Order</h2>
        <div class="text-muted">Edit draft purchase order details.</div>
    </div>

    <div class="mb-3">
        <a href="/purchasing/purchase-orders" class="btn btn-outline-secondary btn-sm">
            Back to PO List
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">System PO No</label>
                    <input id="poNo" class="form-control" readonly>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Printed PO No</label>
                    <input id="printedPoNo" class="form-control">
                </div>

                <div class="col-md-3">
                    <label class="form-label">PO Date</label>
                    <input id="poDate" type="date" class="form-control">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Delivery Date</label>
                    <input id="deliveryDate" type="date" class="form-control">
                </div>

                <div class="col-md-4">
                    <label class="form-label">Supplier</label>
                    <input id="supplierName" class="form-control" readonly>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Payment Terms</label>
                    <input id="paymentTerms" class="form-control">
                </div>

                <div class="col-md-4">
                    <label class="form-label">Requested By</label>
                    <input id="requestedBy" class="form-control">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Supplier Address</label>
                    <input id="supplierAddress" class="form-control">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Remarks</label>
                    <input id="remarks" class="form-control">
                </div>

            </div>

        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <h5 class="fw-bold mb-3">Materials</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Material</th>
                            <th class="text-end">PO Qty</th>
                            <th>UOM</th>
                            <th class="text-end">Quotation Price</th>
                            <th class="text-end">PO Unit Price</th>
                            <th class="text-end">Line Total</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody id="poLineBody">
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                Loading PO lines...
                            </td>
                        </tr>
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="5" class="text-end">Subtotal</th>
                            <th class="text-end" id="subtotal">0.00</th>
                            <th></th>
                        </tr>
                        <tr>
                            <th colspan="5" class="text-end">Others</th>
                            <th>
                                <input id="otherCharges"
                                       type="number"
                                       step="0.01"
                                       class="form-control form-control-sm text-end"
                                       value="0"
                                       oninput="updateGrandTotal()">
                            </th>
                            <th></th>
                        </tr>
                        <tr>
                            <th colspan="5" class="text-end">Total</th>
                            <th class="text-end" id="grandTotal">0.00</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="text-end mt-3">
                <button class="btn btn-primary" onclick="updatePo()">
                    Update Purchase Order
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    const poId = Number('@poId');
    let poLines = [];

    document.addEventListener("DOMContentLoaded", function () {
        loadPoDetails();
    });

    async function loadPoDetails() {
        const response = await fetch(`/purchasing/purchase-orders/details-json/${poId}`);

        if (!response.ok) {
            alert("Failed to load PO details.");
            return;
        }

        const data = await response.json();

        document.getElementById("poNo").value = data.poNo ?? "";
        document.getElementById("printedPoNo").value = data.printedPoNo ?? "";
        document.getElementById("poDate").value = toInputDate(data.poDate);
        document.getElementById("deliveryDate").value = toInputDate(data.deliveryDate);
        document.getElementById("supplierName").value = data.supplierName ?? "";
        document.getElementById("paymentTerms").value = data.paymentTerms ?? "";
        document.getElementById("requestedBy").value = data.requestedBy ?? "";
        document.getElementById("supplierAddress").value = data.supplierAddress ?? "";
        document.getElementById("remarks").value = data.remarks ?? "";
        document.getElementById("otherCharges").value = data.otherCharges ?? 0;

        poLines = (data.lines || []).map(x => ({
            poLineId: x.poLineId,
            materialId: x.materialId,
            materialName: x.materialName,
            poQty: x.poQty,
            uom: x.uom,
            quotationUnitPrice: x.quotationUnitPrice,
            poUnitPrice: x.poUnitPrice,
            remarks: x.remarks ?? ""
        }));

        renderLines();
    }

    function renderLines() {
        const tbody = document.getElementById("poLineBody");

        if (poLines.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No PO lines found.
                    </td>
                </tr>`;
            return;
        }

        tbody.innerHTML = poLines.map((line, index) => `
            <tr>
                <td>${escapeHtml(line.materialName)}</td>

                <td>
                    <input type="number"
                           step="0.0001"
                           class="form-control form-control-sm text-end"
                           value="${line.poQty}"
                           onchange="updateLine(${index}, 'poQty', this.value)">
                </td>

                <td>${escapeHtml(line.uom)}</td>

                <td class="text-end">${formatMoney(line.quotationUnitPrice)}</td>

                <td>
                    <input type="number"
                           step="0.0001"
                           class="form-control form-control-sm text-end"
                           value="${line.poUnitPrice}"
                           onchange="updateLine(${index}, 'poUnitPrice', this.value)">
                </td>

                <td class="text-end" id="lineTotal_${index}">
                    ${formatMoney(line.poQty * line.poUnitPrice)}
                </td>

                <td>
                    <input class="form-control form-control-sm"
                           value="${escapeAttr(line.remarks)}"
                           onchange="updateLine(${index}, 'remarks', this.value)">
                </td>
            </tr>
        `).join("");

        updateGrandTotal();
    }

    function updateLine(index, field, value) {
        if (field === "poQty" || field === "poUnitPrice") {
            poLines[index][field] = Number(value);
        } else {
            poLines[index][field] = value;
        }

        const total = poLines[index].poQty * poLines[index].poUnitPrice;
        document.getElementById(`lineTotal_${index}`).innerText = formatMoney(total);

        updateGrandTotal();
    }

    function updateGrandTotal() {
        const subtotal = poLines.reduce((sum, line) => {
            return sum + (Number(line.poQty) * Number(line.poUnitPrice));
        }, 0);

        const otherCharges = Number(document.getElementById("otherCharges").value || 0);
        const total = subtotal + otherCharges;

        document.getElementById("subtotal").innerText = formatMoney(subtotal);
        document.getElementById("grandTotal").innerText = formatMoney(total);
    }

    async function updatePo() {
        if (poLines.length === 0) {
            alert("No PO lines found.");
            return;
        }

        const payload = {
            printedPoNo: document.getElementById("printedPoNo").value,
            poDate: document.getElementById("poDate").value,
            deliveryDate: document.getElementById("deliveryDate").value || null,
            paymentTerms: document.getElementById("paymentTerms").value,
            supplierAddress: document.getElementById("supplierAddress").value,
            requestedBy: document.getElementById("requestedBy").value,
            remarks: document.getElementById("remarks").value,
            otherCharges: Number(document.getElementById("otherCharges").value || 0),

            lines: poLines.map(x => ({
                poLineId: x.poLineId,
                poQty: x.poQty,
                poUnitPrice: x.poUnitPrice,
                remarks: x.remarks
            }))
        };

        const response = await fetch(`/purchasing/purchase-orders/update/${poId}`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok) {
            alert(result.message ?? "Failed to update PO.");
            return;
        }

        alert("Purchase Order updated successfully.");
        window.location.href = `/purchasing/purchase-orders/details/${poId}`;
    }

    function toInputDate(value) {
        if (!value) return "";
        return String(value).substring(0, 10);
    }

    function formatMoney(value) {
        return Number(value ?? 0).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function escapeAttr(value) {
        return escapeHtml(value).replaceAll("`", "&#096;");
    }
</script>