@{
    ViewData["Title"] = "Purchase Order Details";
    var poId = ViewBag.PoId;
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <div class="text-muted small mb-1">Purchasing &gt; Purchase Orders &gt; Details</div>
        <h2 class="fw-bold mb-1" id="poTitle">Purchase Order</h2>
        <div class="text-muted">View PO information, material prices, and receiving balance.</div>
    </div>

    <div class="mb-3 d-flex gap-2">
        <a href="/purchasing/purchase-orders"
           class="btn btn-outline-secondary btn-sm">
            Back to PO List
        </a>

        <a href="/purchasing/receiving-reports/calendar"
           class="btn btn-success btn-sm">
            View Receiving Calendar
        </a>

        <button id="printPoButton"
                type="button"
                class="btn btn-primary btn-sm d-none"
                onclick="openPrintModal()">
            Print PO
        </button>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="text-muted small">PO No</label>
                    <div class="fw-semibold" id="poNo">-</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">Printed PO No</div>
                    <div id="printedPoNo">-</div>
                </div>

               

                <div class="col-md-3">
                    <label class="text-muted small">Supplier</label>
                    <div class="fw-semibold" id="supplierName">-</div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small">PO Date</label>
                    <div class="fw-semibold" id="poDate">-</div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small">First Scheduled Delivery</label>
                    <div class="fw-semibold" id="deliveryDate">-</div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small">Payment Terms</label>
                    <div class="fw-semibold" id="paymentTerms">-</div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small">Status</label>
                    <div id="poStatus">-</div>
                </div>
            </div>

            <hr>

            <label class="text-muted small">Remarks</label>
            <div id="poRemarks">-</div>

        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <h5 class="fw-bold mb-3">PO Materials</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Material Code</th>
                            <th>Material Name</th>
                            <th class="text-end">PO Qty</th>
                            <th>UOM</th>
                            <th class="text-end">Quotation Price</th>
                            <th class="text-end">PO Price</th>
                            <th class="text-end">Line Total</th>
                            <th class="text-end">Received</th>
                            <th class="text-end">Balance</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="poLineBody">
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                Loading PO details...
                            </td>
                        </tr>
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="6" class="text-end">Total</th>
                            <th class="text-end" id="grandTotal">0.00</th>
                            <th colspan="3"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </div>
    </div>
</div>

<div class="modal fade"
     id="printPoModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title">
                        Purchase Order Print Preview
                    </h5>
                    <small class="text-muted">
                        Preview alignment for the preprinted PO form.
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body bg-light">

                <div class="po-preview-wrapper">

                    <div id="poPrintArea"
                         class="po-paper">

                        <!-- PO NUMBER -->
                        <div id="prPrintedPoNo"
                             class="po-field po-number">
                        </div>

                        <!-- SUPPLIER -->
                        <div id="prSupplier"
                             class="po-field supplier">
                        </div>

                        <div id="prSupplierAddress"
                             class="po-field supplier-address">
                        </div>

                        <div id="prRequestedBy"
                             class="po-field requested-by">
                        </div>

                        <!-- DATES -->
                        <div id="prPoDate"
                             class="po-field po-date">
                        </div>

                        <div id="prDeliveryDate"
                             class="po-field delivery-date">
                        </div>

                        <div id="prTerms"
                             class="po-field terms">
                        </div>

                        <!-- MATERIALS -->
                        <div id="prMaterials"
                             class="materials-area">
                        </div>

                        <!-- MPRF NUMBER ONLY -->
                        <div id="prMprfNo"
                             class="po-field mprf-number">
                        </div>

                        <!-- TOTAL VALUES ONLY -->
                        <div id="prSubtotal"
                             class="po-field subtotal">
                        </div>

                        <div id="prOthers"
                             class="po-field others">
                        </div>

                        <div id="prTotal"
                             class="po-field total">
                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="printPurchaseOrder()">
                    Print
                </button>

            </div>

        </div>
    </div>
</div>

<style>
    /* ================================
           PO DOT-MATRIX PRINT PREVIEW
           ================================ */

    .po-preview-wrapper {
        overflow: auto;
        padding: 20px;
        text-align: center;
    }

    .po-paper {
        position: relative;
        width: 217mm;
        height: 175mm;
        margin: 0 auto;
        padding: 0;
        background: white;
        font-family: "Courier New", monospace;
        font-size: 10pt;
        color: #000;
        box-shadow: 0 0 8px rgba(0,0,0,.20);
        text-align: left;
        overflow: hidden;
    }



    .po-field {
        position: absolute;
        white-space: nowrap;
    }


    /* ================================
       HEADER VALUES
       ================================ */

    .po-number {
        top: 25mm;
        left: 174mm;
        width: 28mm;
    }

    .supplier {
        top: 48mm;
        left: 46mm;
        width: 100mm;
    }

    .supplier-address {
        top: 54mm;
        left: 46mm;
        width: 100mm;
    }

    .requested-by {
        top: 61mm;
        left: 46mm;
        width: 100mm;
    }

    .po-date {
        top: 48mm;
        left: 164mm;
    }

    .delivery-date {
        top: 54mm;
        left: 164mm;
    }

    .terms {
        top: 61mm;
        left: 164mm;
    }


    /* ================================
       MATERIALS
       ================================ */

    .materials-area {
        position: absolute;
        top: 78mm;
        left: 0;
        width: 217mm;
    }

    .print-material-row {
        position: relative;
        height: 6mm;
        line-height: 6mm;
    }

    /* QUANTITY */
    .print-qty {
        position: absolute;
        left: 12mm;
        width: 18mm;
        text-align: left;
    }

    /* UNIT */
    .print-uom {
        position: absolute;
        left: 30mm;
        width: 18mm;
        text-align: left;
    }

    /* DESCRIPTION */
    .print-description {
        position: absolute;
        left: 48mm;
        width: 87mm;
        overflow: hidden;
        white-space: nowrap;
    }

    /* UNIT PRICE */
    .print-price {
        position: absolute;
        left: 135mm;
        width: 30mm;
        text-align: right;
    }

    /* AMOUNT */
    .print-amount {
        position: absolute;
        left: 170mm;
        width: 35mm;
        text-align: right;
    }

    /* NOTHING FOLLOWS */
    .nothing-follows {
        position: relative;
        height: 6mm;
        line-height: 6mm;
        margin-left: 48mm;
        width: 87mm;
        text-align: center;
        font-weight: bold;
    }
    /* ================================
       BOTTOM VALUES - ACTUAL FORM
       ================================ */

    .mprf-number {
        top: 136mm;
        left: 30mm;
    }

    .subtotal {
        top: 136mm;
        left: 172mm;
        width: 33mm;
        text-align: right;
    }

    .others {
        top: 143mm;
        left: 172mm;
        width: 33mm;
        text-align: right;
    }

    .total {
        top: 149mm;
        left: 172mm;
        width: 33mm;
        text-align: right;
        font-weight: bold;
    }


    /* ================================
           ACTUAL PRINT
           ================================ */

 @@media print {
    @@page {
        size: 217mm 175mm;
        margin: 0;
    }

    html,
    body {
        width: 217mm !important;
        height: 175mm !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
    }

    body * {
        visibility: hidden !important;
    }

    #poPrintArea,
    #poPrintArea * {
        visibility: visible !important;
    }

    #poPrintArea {
        position: fixed !important;
        left: 0 !important;
        top: 0 !important;
        width: 217mm !important;
        height: 175mm !important;
        margin: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
        border: none !important;
        background: transparent !important;
        overflow: hidden !important;
    }

    .modal,
    .modal-dialog,
    .modal-content,
    .modal-body {
        overflow: visible !important;
    }
}
    

</style>

<script>
    const poId = '@poId';
    let currentPo = null;

    document.addEventListener("DOMContentLoaded", loadPoDetails);

    async function loadPoDetails() {
        try {
            const response = await fetch(`/purchasing/purchase-orders/${poId}`);
            const data = await response.json();
            currentPo = data;

            if (!response.ok) {
                alert(data.message ?? "PO not found.");
                return;
            }

            document.getElementById("poTitle").innerText = data.poNo;
            document.getElementById("poNo").innerText = data.poNo;
            document.getElementById("printedPoNo").innerText =data.printedPoNo ?? "-";

            document.getElementById("supplierName").innerText = data.supplierName;
            document.getElementById("poDate").innerText = formatDate(data.poDate);
            document.getElementById("deliveryDate").innerText = formatDate(data.deliveryDate);
            document.getElementById("paymentTerms").innerText = data.paymentTerms ?? "-";

                document.getElementById("poStatus").innerHTML =
        renderStatus(data.status);

    document.getElementById("poRemarks").innerText =
        data.remarks ?? "-";

    const printButton =
        document.getElementById("printPoButton");

       if (data.status === "APPROVED") {
        printButton.classList.remove("d-none");
    }
    else {
        printButton.classList.add("d-none");
    }

    renderLines(data.lines ?? []);

        } catch (error) {
            document.getElementById("poLineBody").innerHTML = `
                <tr>
                    <td colspan="10" class="text-center text-danger py-4">
                        Failed to load PO details.
                    </td>
                </tr>`;
        }
    }

        function printPurchaseOrder() {
        window.print();
    }


        function openPrintModal() {

        if (!currentPo) {
            alert("Purchase Order data is not loaded yet.");
            return;
        }

        // Header information
        document.getElementById("prPrintedPoNo").innerText =
            currentPo.printedPoNo ?? "";

        document.getElementById("prSupplier").innerText =
            currentPo.supplierName ?? "";

        document.getElementById("prSupplierAddress").innerText =
            currentPo.supplierAddress ?? "";

        document.getElementById("prRequestedBy").innerText =
            currentPo.department ?? currentPo.requestedBy ?? "";

        document.getElementById("prPoDate").innerText =
            formatDate(currentPo.poDate);

        document.getElementById("prDeliveryDate").innerText =
            formatDate(currentPo.deliveryDate);

        document.getElementById("prTerms").innerText =
            currentPo.paymentTerms ?? "";

        // MPRF NUMBER ONLY
        document.getElementById("prMprfNo").innerText =
            currentPo.mprfNo ?? "";

        // Materials
        renderPrintMaterials(currentPo.lines ?? []);

        // Totals
        let subtotal = 0;

        (currentPo.lines ?? []).forEach(line => {
            subtotal += Number(line.lineTotal ?? 0);
        });

        const others = Number(currentPo.others ?? 0);
        const total = subtotal + others;

        document.getElementById("prSubtotal").innerText =
            formatMoney(subtotal);

        document.getElementById("prOthers").innerText =
            formatMoney(others);

        document.getElementById("prTotal").innerText =
            formatMoney(total);

        const modal = new bootstrap.Modal(
            document.getElementById("printPoModal")
        );

        modal.show();
    }

        function renderPrintMaterials(lines) {

        const container =
            document.getElementById("prMaterials");

        container.innerHTML = "";

        lines.forEach(line => {

            const row = document.createElement("div");
            row.className = "print-material-row";

            row.innerHTML = `
                <div class="print-qty">
                    ${formatPrintQty(line.poQty)}
                </div>

                <div class="print-uom">
                    ${line.uom ?? ""}
                </div>

                <div class="print-description">
                    ${line.materialName ?? ""}
                </div>

                <div class="print-price">
                    ${formatMoney(line.poUnitPrice)}
                </div>

                <div class="print-amount">
                    ${formatMoney(line.lineTotal)}
                </div>
            `;

            container.appendChild(row);
        });

        const nothingFollows =
            document.createElement("div");

        nothingFollows.className =
            "nothing-follows";

        nothingFollows.innerText =
            "** NOTHING FOLLOWS **";

        container.appendChild(nothingFollows);
    }

        function formatPrintQty(value) {

        const number = Number(value ?? 0);

        return number.toLocaleString("en-US", {
            minimumFractionDigits: 0,
            maximumFractionDigits: 4
        });
    }

     

    function renderLines(lines) {
        const tbody = document.getElementById("poLineBody");
        tbody.innerHTML = "";

        if (lines.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        No PO materials found.
                    </td>
                </tr>`;
            return;
        }

        let grandTotal = 0;

        lines.forEach(line => {
            grandTotal += Number(line.lineTotal ?? 0);

            tbody.innerHTML += `
                <tr>
                    <td>${line.materialCode ?? ""}</td>
                    <td>${line.materialName ?? ""}</td>
                    <td class="text-end">${formatQty(line.poQty)}</td>
                    <td>${line.uom ?? ""}</td>
                    <td class="text-end">${formatMoney(line.quotationUnitPrice)}</td>
                    <td class="text-end fw-semibold">${formatMoney(line.poUnitPrice)}</td>
                    <td class="text-end">${formatMoney(line.lineTotal)}</td>
                    <td class="text-end">${formatQty(line.receivedQty)}</td>
                    <td class="text-end">${formatQty(line.balanceQty)}</td>
                    <td>${renderLineStatus(line.status)}</td>
                </tr>
            `;
        });

        document.getElementById("grandTotal").innerText = formatMoney(grandTotal);
    }

    function renderStatus(status) {
        let badge = "bg-secondary";

        if (status === "DRAFT") badge = "bg-warning text-dark";
        if (status === "FOR_APPROVAL") badge = "bg-info text-dark";
        if (status === "APPROVED") badge = "bg-success";
        if (status === "CANCELLED") badge = "bg-danger";
        if (status === "CLOSED") badge = "bg-dark";
            if (status === "PARTIALLY_RECEIVED") badge = "bg-warning text-dark";
    if (status === "FULLY_RECEIVED") badge = "bg-dark";

        return `<span class="badge ${badge}">${status}</span>`;
    }

    function renderLineStatus(status) {
        let badge = "bg-secondary";

        if (status === "OPEN") badge = "bg-primary";
        if (status === "PARTIAL") badge = "bg-warning text-dark";
        if (status === "COMPLETED") badge = "bg-success";
        if (status === "CANCELLED") badge = "bg-danger";
        if (status === "CLOSED") badge = "bg-success";

        return `<span class="badge ${badge}">${status}</span>`;
    }

    function formatDate(value) {
        if (!value) return "-";
        return new Date(value).toLocaleDateString();
    }

    function formatMoney(value) {
        return Number(value ?? 0).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function formatQty(value) {
        return Number(value ?? 0).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 4
        });
    }
</script>