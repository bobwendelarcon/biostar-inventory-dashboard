@{
    ViewData["Title"] = "Create Purchase Order";
    var canvassId = ViewBag.CanvassId;
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <div class="text-muted small mb-1">Purchasing &gt; Purchase Orders &gt; Create</div>
        <h2 class="fw-bold mb-1">Create Purchase Order</h2>
        <div class="text-muted">Create PO from completed supplier canvassing.</div>
    </div>

    <div class="mb-3">
        <a href="/purchasing/purchase-orders" class="btn btn-outline-secondary btn-sm">
            Back to PO List
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <input type="hidden" id="canvassId" value="@canvassId">

            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">System PO No</label>
                    <input id="poNo" class="form-control" readonly>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Printed PO No</label>
                    <input id="printedPoNo" class="form-control" placeholder="Example: 035932">
                </div>

                <div class="col-md-3">
                    <label class="form-label">PO Date</label>
                    <input id="poDate" type="date" class="form-control">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Delivery Plan</label>

                    <select id="deliveryPlanType"
                            class="form-select"
                            onchange="changeDeliveryPlanType()">
                        <option value="SINGLE">
                            One-Time Delivery
                        </option>

                        <option value="STAGGERED">
                            Planned Staggered Delivery
                        </option>
                    </select>
                </div>

                <div id="singleDeliveryDateColumn"
                     class="col-md-3">
                    <label class="form-label">Delivery Date</label>

                    <input id="deliveryDate"
                           type="date"
                           class="form-control">
                </div>

                <div class="col-md-4">
                    <label class="form-label">Supplier</label>
                    <select id="supplierId" class="form-select" onchange="renderSupplierLines()">
                        <option value="">Select Supplier</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Payment Terms</label>
                    <input id="paymentTerms" class="form-control" placeholder="Example: 30 Days">
                </div>

                <div class="col-md-4">
                    <label class="form-label">Requested By</label>
                    <input id="requestedBy" class="form-control" placeholder="Requested by">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Supplier Address</label>
                    <input id="supplierAddress" class="form-control" placeholder="Supplier address">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Remarks</label>
                    <input id="remarks" class="form-control">
                </div>

            </div>

        </div>
    </div>



<!-- Planned Delivery Schedule -->
<div id="plannedSchedulesCard"
     class="card border-0 shadow-sm mb-4 d-none">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h5 class="fw-bold mb-1">
                    Planned Delivery Schedules
                </h5>

                <div class="text-muted small">
                    Divide each material's PO quantity across one or more delivery dates.
                </div>
            </div>

            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    onclick="addPlannedSchedule()">
                Add Delivery Date
            </button>

        </div>

        <div id="plannedScheduleGroups"></div>

        <div class="alert alert-light border mb-0">

            <div class="d-flex justify-content-between">
                <span>Total PO Quantity</span>
                <strong id="plannedTotalPoQty">0.00</strong>
            </div>

            <div class="d-flex justify-content-between">
                <span>Total Scheduled</span>
                <strong id="plannedTotalAssigned">0.00</strong>
            </div>

            <div class="d-flex justify-content-between">
                <span>Unassigned</span>
                <strong id="plannedTotalUnassigned"
                        class="text-danger">
                    0.00
                </strong>
            </div>

        </div>

    </div>

</div>

<!-- Materials -->
<div class="card border-0 shadow-sm">
        <div class="card-body">

            <h5 class="fw-bold mb-3">Materials</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Material</th>
                            <th class="text-end">PO Qty</th>
                            <th>UOM</th>
                            <th class="text-end">Quotation Price</th>
                            <th class="text-end">PO Unit Price</th>
                            <th class="text-end">Line Total</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody id="poLineBody">
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                Select supplier to load materials.
                            </td>
                        </tr>
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="5" class="text-end">Subtotal</th>
                            <th class="text-end" id="subtotal">0.00</th>
                            <th></th>
                        </tr>
                        <tr>
                            <th colspan="5" class="text-end">Others</th>
                            <th>
                                <input id="otherCharges"
                                       type="number"
                                       step="0.01"
                                       class="form-control form-control-sm text-end"
                                       value="0"
                                       oninput="updateGrandTotal()">
                            </th>
                            <th></th>
                        </tr>
                        <tr>
                            <th colspan="5" class="text-end">Total</th>
                            <th class="text-end" id="grandTotal">0.00</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="text-end mt-3">
                <button class="btn btn-primary" onclick="savePo()">
                    Save Purchase Order
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    const canvassId = Number('@canvassId');
        const urlParams = new URLSearchParams(window.location.search);
    const preselectedSupplierId = Number(urlParams.get("supplierId") || 0);

    let canvassData = null;
    let supplierLines = [];

            let plannedSchedules = [];
        let nextPlannedScheduleId = 1;


    document.addEventListener("DOMContentLoaded", function () {
        setDefaultDates();
        loadNextPoNo();
        loadCreateOptions();
    });

    function setDefaultDates() {
        const today = new Date().toISOString().split("T")[0];
        document.getElementById("poDate").value = today;
    }

    async function loadNextPoNo() {
        const response = await fetch("/purchasing/purchase-orders/next-number");
        const data = await response.json();
        document.getElementById("poNo").value = data.po_no ?? "";
    }

    async function loadCanvassDetails() {
        const response = await fetch(`/purchasing/canvassing/details/${canvassId}`);

        if (!response.ok) {
            alert("Failed to load canvassing details.");
            return;
        }

        canvassData = await response.json();

        if (canvassData.header.status !== "COMPLETED") {
            alert("Only completed canvassing can create Purchase Order.");
            return;
        }

        loadSuppliersFromQuotes();
    }

        async function loadCreateOptions() {

        const response = await fetch(
            `/purchasing/purchase-orders/create-options/${canvassId}`
        );

        if (!response.ok) {
            alert("Failed to load PO options.");
            return;
        }

        const data = await response.json();

        canvassData = data;

        document.getElementById("requestedBy").value =
    data.requesting_department ??
    data.requestingDepartment ??
    "";

        const supplierSelect =
            document.getElementById("supplierId");

        supplierSelect.innerHTML =
            `<option value="">Select Supplier</option>`;

        (data.suppliers || []).forEach(s => {

            supplierSelect.innerHTML += `
                <option
                    value="${s.supplierId}"
                    data-terms="${escapeAttr(s.paymentTerms)}"
                    data-address="${escapeAttr(s.supplierAddress)}">

                    ${s.supplierName}
                    (${s.lineCount} Items)

                </option>`;
        });
            if (preselectedSupplierId > 0) {
        supplierSelect.value = preselectedSupplierId;
        renderSupplierLines();
    }
    else if ((data.suppliers || []).length === 1) {
        supplierSelect.value = data.suppliers[0].supplierId;
        renderSupplierLines();
    }
    }
        



    function loadSuppliersFromQuotes() {
        const supplierSelect = document.getElementById("supplierId");
        supplierSelect.innerHTML = `<option value="">Select Supplier</option>`;

        const suppliers = [];
        const lines = canvassData.lines ?? [];

        lines.forEach(line => {
            const quotes = line.quotes ?? [];

            quotes.forEach(q => {
                const supplierId = q.supplierId;
                const supplierName = q.supplierName;

                if (!supplierId) return;

                if (!suppliers.some(s => s.supplierId === supplierId)) {
                    suppliers.push({
                        supplierId: supplierId,
                        supplierName: supplierName,
                        paymentTerms: q.paymentTerms ?? "",
                        supplierAddress: q.address ?? q.supplierAddress ?? ""
                    });
                }
            });
        });

        suppliers.forEach(s => {
            supplierSelect.innerHTML += `
                <option value="${s.supplierId}"
                        data-terms="${escapeAttr(s.paymentTerms)}"
                        data-address="${escapeAttr(s.supplierAddress)}">
                    ${s.supplierName}
                </option>`;
        });
    }


        function changeDeliveryPlanType() {
            const type =
                document.getElementById("deliveryPlanType").value;

            const singleColumn =
                document.getElementById("singleDeliveryDateColumn");

            const staggeredCard =
                document.getElementById("plannedSchedulesCard");

            if (type === "STAGGERED") {
                singleColumn.classList.add("d-none");
                staggeredCard.classList.remove("d-none");

                if (plannedSchedules.length === 0 &&
                    supplierLines.length > 0) {
                    addPlannedSchedule(true);
                }
            }
            else {
                singleColumn.classList.remove("d-none");
                staggeredCard.classList.add("d-none");
            }

            updatePlannedScheduleTotals();
        }
                function resetPlannedSchedules() {
            plannedSchedules = [];
            nextPlannedScheduleId = 1;

            document.getElementById(
                "plannedScheduleGroups"
            ).innerHTML = "";

            if (
                document.getElementById("deliveryPlanType").value ===
                "STAGGERED" &&
                supplierLines.length > 0
            ) {
                addPlannedSchedule(true);
            }

            updatePlannedScheduleTotals();
        }


            function addPlannedSchedule(assignAll = false) {
        if (supplierLines.length === 0) {
            alert("Select a supplier first.");
            return;
        }

        const id = nextPlannedScheduleId++;

        const newLines = supplierLines.map(line => {
            const alreadyAssigned =
                getPlannedAssignedQty(line.canvassLineId);

            const remainingQty = Math.max(
                0,
                Number(line.poQty) - alreadyAssigned
            );

            return {
                canvassLineId: line.canvassLineId,
                materialName: line.materialName,
                uom: line.uom,
                poQty: Number(line.poQty),

                scheduledQty:
                    assignAll
                        ? Number(line.poQty)
                        : remainingQty
            };
        });

        const hasRemaining =
            newLines.some(line => line.scheduledQty > 0);

        if (!hasRemaining && plannedSchedules.length > 0) {
            alert("All PO quantities are already assigned.");
            return;
        }

        plannedSchedules.push({
            id: id,
            scheduledDate: "",
            remarks: "",
            lines: newLines
        });

        renderPlannedSchedules();
    }


                function removePlannedSchedule(id) {
            if (plannedSchedules.length <= 1) {
                alert("At least one delivery schedule is required.");
                return;
            }

            plannedSchedules =
                plannedSchedules.filter(x => x.id !== id);

            renderPlannedSchedules();
        }


                function renderPlannedSchedules() {
            const container =
                document.getElementById("plannedScheduleGroups");

            container.innerHTML = "";

            plannedSchedules.forEach((schedule, index) => {
                   const lineRows = schedule.lines.map(line => {
        const totalAssigned =
            getPlannedAssignedQty(line.canvassLineId);

        const remaining =
            Number(line.poQty) - totalAssigned;

        return `
            <tr>
                <td>
                    ${escapeAttr(line.materialName)}
                </td>

                <td class="text-end">
                    ${formatQty(line.poQty)}
                </td>

                   <td style="width:180px;">
        <input type="number"
               min="0"
               step="0.0001"
               class="form-control form-control-sm text-end"
               value="${line.scheduledQty}"
               onchange="updatePlannedScheduleQty(
                   ${schedule.id},
                   ${line.canvassLineId},
                   this.value
               )">
    </td>

    <td
        id="remaining_${schedule.id}_${line.canvassLineId}"
        class="text-end ${
            remaining > 0.0001
                ? "text-danger fw-semibold"
                : "text-success fw-semibold"
        }">
        ${formatQty(remaining)}
    </td>

                <td>${escapeAttr(line.uom)}</td>
            </tr>
        `;
    }).join("");

                container.insertAdjacentHTML("beforeend", `
                    <div class="card border mb-3">

                        <div class="card-header bg-light">

                            <div class="d-flex justify-content-between align-items-center">

                                <strong>
                                    Delivery Schedule ${index + 1}
                                </strong>

                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        onclick="removePlannedSchedule(${schedule.id})">
                                    Remove
                                </button>

                            </div>

                        </div>

                        <div class="card-body">

                            <div class="row g-3 mb-3">

                                <div class="col-md-4">
                                    <label class="form-label">
                                        Scheduled Date
                                    </label>

                                    <input type="date"
                                           class="form-control"
                                           value="${escapeAttr(schedule.scheduledDate)}"
                                           onchange="updatePlannedScheduleDate(
                                               ${schedule.id},
                                               this.value
                                           )">
                                </div>

                                <div class="col-md-8">
                                    <label class="form-label">
                                        Remarks
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           value="${escapeAttr(schedule.remarks)}"
                                           placeholder="Optional schedule remarks"
                                           onchange="updatePlannedScheduleRemarks(
                                               ${schedule.id},
                                               this.value
                                           )">
                                </div>

                            </div>

                            <div class="table-responsive border rounded">

                                <table class="table table-sm align-middle mb-0">

                                    <thead class="table-light">
                                            <tr>
        <th>Material</th>
        <th class="text-end">PO Qty</th>
        <th>Scheduled Qty</th>
        <th class="text-end">Unassigned</th>
        <th>UOM</th>
    </tr>
                                    </thead>

                                    <tbody>
                                        ${lineRows}
                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>
                `);
            });

            updatePlannedScheduleTotals();
        }

                function updatePlannedScheduleDate(id, value) {
            const schedule =
                plannedSchedules.find(x => x.id === id);

            if (schedule)
                schedule.scheduledDate = value;
        }

                function updatePlannedScheduleRemarks(id, value) {
            const schedule =
                plannedSchedules.find(x => x.id === id);

            if (schedule)
                schedule.remarks = value;
        }


            function updatePlannedScheduleQty(
        scheduleId,
        canvassLineId,
        value)
    {
        const schedule =
            plannedSchedules.find(x =>
                x.id === scheduleId);

        if (!schedule)
            return;

        const line =
            schedule.lines.find(x =>
                x.canvassLineId === canvassLineId);

        if (!line)
            return;

        let newQty = Number(value || 0);

        if (newQty < 0)
            newQty = 0;

        const assignedByOtherSchedules =
            plannedSchedules
                .filter(x => x.id !== scheduleId)
                .reduce((total, item) => {
                    const otherLine = item.lines.find(x =>
                        x.canvassLineId === canvassLineId);

                    return total +
                        Number(otherLine?.scheduledQty || 0);
                }, 0);

        const maximumAllowed = Math.max(
            0,
            Number(line.poQty) - assignedByOtherSchedules
        );

        if (newQty > maximumAllowed) {
            alert(
                `Maximum quantity available for this schedule is ` +
                `${formatQty(maximumAllowed)} ${line.uom}.`
            );

            newQty = maximumAllowed;
        }

           line.scheduledQty = newQty;

    // Only update totals
    updatePlannedScheduleTotals();

    // Update only the Unassigned cell
    const totalAssigned =
        getPlannedAssignedQty(canvassLineId);

    const remaining =
        Number(line.poQty) - totalAssigned;

    const remainingCell =
        document.getElementById(
            `remaining_${scheduleId}_${canvassLineId}`
        );

    if (remainingCell) {
        remainingCell.innerHTML = formatQty(remaining);

        remainingCell.className =
            "text-end " +
            (remaining > 0.0001
                ? "text-danger fw-semibold"
                : "text-success fw-semibold");
    }
    }


                function getPlannedAssignedQty(canvassLineId) {
            return plannedSchedules.reduce(
                (total, schedule) => {
                    const line = schedule.lines.find(x =>
                        x.canvassLineId === canvassLineId);

                    return total +
                        Number(line?.scheduledQty || 0);
                },
                0
            );
        }

                function updatePlannedScheduleTotals() {
            const totalPoQty = supplierLines.reduce(
                (sum, line) =>
                    sum + Number(line.poQty || 0),
                0
            );

            const assignedTotal = plannedSchedules.reduce(
                (scheduleTotal, schedule) =>
                    scheduleTotal +
                    schedule.lines.reduce(
                        (lineTotal, line) =>
                            lineTotal +
                            Number(line.scheduledQty || 0),
                        0
                    ),
                0
            );

            document.getElementById(
                "plannedTotalPoQty"
            ).textContent = formatQty(totalPoQty);

            document.getElementById(
                "plannedTotalAssigned"
            ).textContent = formatQty(assignedTotal);

            document.getElementById(
                "plannedTotalUnassigned"
            ).textContent = formatQty(
                totalPoQty - assignedTotal
            );
        }

                function formatQty(value) {
            return Number(value ?? 0).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 4
            });
        }


    function renderSupplierLines() {
        const supplierSelect = document.getElementById("supplierId");
        const supplierId = Number(supplierSelect.value);
        const tbody = document.getElementById("poLineBody");

        supplierLines = [];
        tbody.innerHTML = "";

        if (!supplierId) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        Select supplier to load materials.
                    </td>
                </tr>`;
             updateGrandTotal();
    resetPlannedSchedules();
            return;
        }

        const selectedOption = supplierSelect.options[supplierSelect.selectedIndex];

        document.getElementById("paymentTerms").value =
            selectedOption.getAttribute("data-terms") || "";

        document.getElementById("supplierAddress").value =
            selectedOption.getAttribute("data-address") || "";

                const lines =
        (canvassData.lines || [])
        .filter(x => x.supplierId === supplierId);

    supplierLines = [];

    lines.forEach(line => {

        supplierLines.push({
            canvassLineId: line.canvassLineId,
            quoteId: line.quoteId,
            materialId: line.materialId,
            materialName: line.material_name,
            poQty: line.qty,
            uom: line.uom,
            quotationUnitPrice: line.unitPrice,
            poUnitPrice: line.unitPrice,
            remarks: ""
        });

    });
      

        if (supplierLines.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        This supplier has no quoted materials.
                    </td>
                </tr>`;
            updateGrandTotal();
            return;
        }

        supplierLines.forEach((line, index) => {
            tbody.innerHTML += `
                <tr>
                    <td>${line.materialName}</td>

                    <td>
                        <input type="number" step="0.0001"
                               class="form-control form-control-sm text-end"
                               value="${line.poQty}"
                               onchange="updateLine(${index}, 'poQty', this.value)">
                    </td>

                    <td>${line.uom}</td>

                    <td class="text-end">${formatMoney(line.quotationUnitPrice)}</td>

                    <td>
                        <input type="number" step="0.0001"
                               class="form-control form-control-sm text-end"
                               value="${line.poUnitPrice}"
                               onchange="updateLine(${index}, 'poUnitPrice', this.value)">
                    </td>

                    <td class="text-end" id="lineTotal_${index}">
                        ${formatMoney(line.poQty * line.poUnitPrice)}
                    </td>

                    <td>
                        <input class="form-control form-control-sm"
                               onchange="updateLine(${index}, 'remarks', this.value)">
                    </td>
                </tr>`;
        });

        updateGrandTotal();
    }

    function updateLine(index, field, value) {
        if (field === "poQty" || field === "poUnitPrice") {
            supplierLines[index][field] = Number(value);
        } else {
            supplierLines[index][field] = value;
        }

                if (field === "poQty" &&
            document.getElementById("deliveryPlanType").value === "STAGGERED")
        {
            resetPlannedSchedules();
        }

        const total = supplierLines[index].poQty * supplierLines[index].poUnitPrice;
        document.getElementById(`lineTotal_${index}`).innerText = formatMoney(total);

        updateGrandTotal();
    }

    function updateGrandTotal() {
        const subtotal = supplierLines.reduce((sum, line) => {
            return sum + (Number(line.poQty) * Number(line.poUnitPrice));
        }, 0);

        const otherCharges = Number(document.getElementById("otherCharges").value || 0);
        const total = subtotal + otherCharges;

        document.getElementById("subtotal").innerText = formatMoney(subtotal);
        document.getElementById("grandTotal").innerText = formatMoney(total);
    }

    async function savePo() {
        const supplierId = Number(document.getElementById("supplierId").value);

        if (!supplierId) {
            alert("Please select supplier.");
            return;
        }

        if (supplierLines.length === 0) {
            alert("No materials selected.");
            return;
        }

                const deliveryPlanType =
            document.getElementById("deliveryPlanType").value;

        let schedules = [];

        if (deliveryPlanType === "SINGLE") {
            const deliveryDate =
                document.getElementById("deliveryDate").value;

            if (!deliveryDate) {
                alert("Delivery Date is required.");
                return;
            }
        }
        else {
            if (plannedSchedules.length === 0) {
                alert("Add at least one planned delivery schedule.");
                return;
            }

            for (const schedule of plannedSchedules) {
                if (!schedule.scheduledDate) {
                    alert("Every planned schedule must have a delivery date.");
                    return;
                }

                const hasQuantity =
                    schedule.lines.some(x =>
                        Number(x.scheduledQty) > 0);

                if (!hasQuantity) {
                    alert(
                        "Every planned schedule must contain at least one quantity."
                    );

                    return;
                }
            }

            for (const poLine of supplierLines) {
                const assigned =
                    getPlannedAssignedQty(poLine.canvassLineId);

                if (
                    Math.abs(
                        assigned - Number(poLine.poQty)
                    ) > 0.0001
                ) {
                    alert(
                        `${poLine.materialName}: scheduled quantity must equal ` +
                        `${formatQty(poLine.poQty)} ${poLine.uom}. ` +
                        `Currently assigned: ${formatQty(assigned)}.`
                    );

                    return;
                }
            }

            schedules = plannedSchedules.map(schedule => ({
                scheduledDate: schedule.scheduledDate,
                remarks: schedule.remarks,

                lines: schedule.lines
                    .filter(line =>
                        Number(line.scheduledQty) > 0)
                    .map(line => ({
                        canvassLineId: line.canvassLineId,
                        scheduledQty:
                            Number(line.scheduledQty)
                    }))
            }));
        }

        const payload = {
            canvassId: canvassId,
            supplierId: supplierId,

            printedPoNo: document.getElementById("printedPoNo").value,
            poDate: document.getElementById("poDate").value,
                    deliveryDate:
            deliveryPlanType === "SINGLE"
                ? document.getElementById("deliveryDate").value
                : null,

        schedules: schedules,

            paymentTerms: document.getElementById("paymentTerms").value,
            supplierAddress: document.getElementById("supplierAddress").value,
            requestedBy: document.getElementById("requestedBy").value,
            otherCharges: Number(document.getElementById("otherCharges").value || 0),

            remarks: document.getElementById("remarks").value,

            lines: supplierLines.map(x => ({
                canvassLineId: x.canvassLineId,
                quoteId: x.quoteId,
                materialId: x.materialId,
                poQty: x.poQty,
                uom: x.uom,
                quotationUnitPrice: x.quotationUnitPrice,
                poUnitPrice: x.poUnitPrice,
                remarks: x.remarks
            }))
        };

        const response = await fetch("/purchasing/purchase-orders/create", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok) {
            alert(result.message ?? "Failed to create PO.");
            return;
        }

        alert("Purchase Order created successfully.");

            window.location.href =
    `/purchasing/purchase-orders/details/${result.po_id}`;
    }

    function escapeAttr(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;");
    }

    function formatMoney(value) {
        return Number(value ?? 0).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }
</script>