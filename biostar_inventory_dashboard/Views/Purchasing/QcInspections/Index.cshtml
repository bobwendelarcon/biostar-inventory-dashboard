@{
    ViewData["Title"] = "QA/QC Inspection";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <div class="text-muted small mb-1">Purchasing &gt; QA/QC Inspection</div>
        <h2 class="fw-bold mb-1">QA/QC Inspection</h2>
        <div class="text-muted">Inspect received materials and record accepted or rejected quantities.</div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-4">
                    <input id="qcSearch"
                           type="text"
                           class="form-control"
                           placeholder="Search QC No, RR No, PO No, Supplier">
                </div>

                <div class="col-md-3">
                    <select id="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="FOR_INSPECTION">For Inspection</option>
                        <option value="ACCEPTED">Accepted</option>
                        <option value="PARTIALLY_ACCEPTED">Partially Accepted</option>
                        <option value="REJECTED">Rejected</option>
                        <option value="COMMITTED">Committed</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive overflow-visible">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>QC No</th>
                            <th>RR No</th>
                            <th>PO No</th>
                            <th>Supplier</th>
                            <th>Inspection Date</th>
                            <th>Inspector</th>
                            <th>Status</th>
                            <th>Decision</th>
                            <th class="text-end" style="width:120px;">Action</th>
                        </tr>
                    </thead>

                    <tbody id="qcTableBody">
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                Loading QC inspections...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

<script>
    let qcList = [];

    document.addEventListener("DOMContentLoaded", function () {
        loadQcInspections();

        document.getElementById("qcSearch").addEventListener("input", renderTable);
        document.getElementById("statusFilter").addEventListener("change", renderTable);
    });

    async function loadQcInspections() {
        try {
            const response = await fetch("/purchasing/qc-inspections/list");
            const data = await response.json();

            if (!response.ok) {
                document.getElementById("qcTableBody").innerHTML = `
                    <tr>
                        <td colspan="9" class="text-center text-danger py-4">
                            ${data.message ?? "Failed to load QC inspections."}
                        </td>
                    </tr>`;
                return;
            }

            qcList = data;
            renderTable();

        } catch (error) {
            document.getElementById("qcTableBody").innerHTML = `
                <tr>
                    <td colspan="9" class="text-center text-danger py-4">
                        Failed to load QC inspections.
                    </td>
                </tr>`;
        }
    }

    function renderTable() {
        const tbody = document.getElementById("qcTableBody");
        const search = document.getElementById("qcSearch").value.toLowerCase();
        const status = document.getElementById("statusFilter").value;

        let filtered = qcList.filter(qc => {
            const searchText = `
                ${qc.qcNo ?? ""}
                ${qc.rrNo ?? ""}
                ${qc.poNo ?? ""}
                ${qc.supplierName ?? ""}
            `.toLowerCase();

            const matchesSearch = searchText.includes(search);
            const matchesStatus = !status || qc.status === status;

            return matchesSearch && matchesStatus;
        });

        tbody.innerHTML = "";

        if (filtered.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        No QC inspections found.
                    </td>
                </tr>`;
            return;
        }

        filtered.forEach(qc => {
            tbody.innerHTML += `
                <tr>
                    <td class="fw-semibold">${qc.qcNo ?? ""}</td>
                    <td>${qc.rrNo ?? ""}</td>
                    <td>${qc.poNo ?? ""}</td>
                    <td>${qc.supplierName ?? ""}</td>
                    <td>${formatDate(qc.inspectionDate)}</td>
                    <td>${qc.inspectorId ?? "-"}</td>
                    <td>${renderStatus(qc.status)}</td>
                    <td>${qc.decision ?? "-"}</td>

                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-display="static">
                                Action
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item"
                                       href="/purchasing/qc-inspections/details/${qc.qcId}">
                                        View / Inspect
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            `;
        });
    }

    function renderStatus(status) {
        let badge = "bg-secondary";

        if (status === "FOR_INSPECTION") badge = "bg-info text-dark";
        if (status === "ACCEPTED") badge = "bg-success";
        if (status === "PARTIALLY_ACCEPTED") badge = "bg-warning text-dark";
        if (status === "REJECTED") badge = "bg-danger";
        if (status === "COMMITTED") badge = "bg-dark";

        return `<span class="badge ${badge}">${status}</span>`;
    }

    function formatDate(value) {
        if (!value) return "-";
        return new Date(value).toLocaleDateString();
    }
</script>