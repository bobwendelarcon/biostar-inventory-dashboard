@{
    ViewData["Title"] = "Manual Stock In";
    ViewData["Subtitle"] = "Encode stock receiving directly from the dashboard.";
}

<div class="container-fluid manual-stockin-page">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <small class="text-muted">Inventory &gt; Manual Stock IN</small>
            <h2 class="fw-bold mb-0">Manual Stock IN</h2>
            <small class="text-muted">
                Encode stock receiving directly from the dashboard.
            </small>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <form id="manualStockInForm">

                <!-- HEADER INFO -->
                <h5 class="fw-bold mb-3">Stock IN Details</h5>

                <div class="row g-3 mb-4">

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label fw-semibold">
                            Branch / Warehouse
                        </label>
                        <select class="form-select" id="branchId" required>
                            <option value="">Select branch</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label fw-semibold">
                            Supplier
                        </label>
                        <select class="form-select" id="supplierId">
                            <option value="">Select supplier</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label fw-semibold">
                            Transmittal #
                        </label>
                        <input type="text"
                               class="form-control"
                               id="transmittalNo"
                               placeholder="Enter transmittal no." />
                    </div>

                </div>

                <hr />

                <!-- PRODUCT SEARCH -->
                <h5 class="fw-bold mb-3">Search Product</h5>

                <div class="row g-3 mb-4">

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label fw-semibold">
                            Category / Product Line
                        </label>
                        <select class="form-select" id="categoryId">
                            <option value="">All Categories</option>
                        </select>
                    </div>

                    <div class="col-lg-7 col-md-6 position-relative">

                        <label class="form-label fw-semibold">
                            Generic Name / Brand Name
                        </label>

                        <input type="text"
                               class="form-control"
                               id="productSearch"
                               placeholder="Search generic or brand name..." />

                        <!-- SEARCH RESULTS -->
                        <div class="list-group position-absolute w-100 shadow-sm"
                             id="productSearchResults"
                             style="z-index:999;">
                        </div>

                    </div>

                    <div class="col-lg-2 col-md-12 d-flex align-items-end">
                        <button type="button"
                                class="btn btn-primary w-100"
                                id="btnAddSelectedProduct">
                            Add
                        </button>
                    </div>

                </div>

                <hr />

                <!-- TRANSMITTAL ITEMS -->
                <h5 class="fw-bold mb-3">Transmittal Items</h5>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle"
                           id="transmittalTable">

                        <thead class="table-light text-center">

                            <tr>
                                <th style="width:35%">
                                    Description
                                </th>

                                <th style="width:10%">
                                    Qty
                                </th>

                                <th style="width:12%">
                                    PACK
                                </th>

                                <th style="width:15%">
                                    Product Line
                                </th>

                                <th style="width:15%">
                                    Batch/Lot #
                                </th>

                                <th style="width:10%">
                                    Exp Date
                                </th>

                                <th style="width:3%">
                                    Action
                                </th>
                            </tr>

                        </thead>

                        <tbody id="transmittalRows">
                        </tbody>

                    </table>

                </div>

                <hr class="my-4" />

                <!-- REMARKS -->
                <h5 class="fw-bold mb-3">Remarks</h5>

                <div class="row">

                    <div class="col-12">

                        <label class="form-label fw-semibold">
                            Remarks
                        </label>

                        <textarea class="form-control"
                                  id="remarks"
                                  rows="3"></textarea>

                    </div>

                </div>

                <!-- BUTTONS -->
                <div class="d-flex justify-content-end gap-2 mt-4">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="btnClearStockIn">
                        Clear
                    </button>

                    <button type="submit"
                            class="btn btn-primary px-4"
                            id="btnSaveStockIn">
                        Save Stock IN
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

<div class="modal fade" id="confirmStockInModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Confirm Stock IN</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <strong>Branch:</strong> <span id="confirmBranch"></span><br>
                    <strong>Supplier:</strong> <span id="confirmSupplier"></span><br>
                    <strong>Transmittal #:</strong> <span id="confirmTransmittal"></span>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Stock IN Date
                        </label>

                        <input type="date"
                               id="confirmStockInDate"
                               class="form-control">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light text-center">
                            <tr>
                                <th>Description</th>
                                <th>Qty</th>
                                <th>Pack</th>
                                <th>Product Line</th>
                                <th>Batch/Lot #</th>
                                <th>Exp Date</th>
                            </tr>
                        </thead>
                        <tbody id="confirmStockInRows"></tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <strong>Remarks:</strong>
                    <div id="confirmRemarks" class="text-muted"></div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnConfirmSaveStockIn">
                    Confirm Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/manual-stock-in.js" asp-append-version="true"></script>
}