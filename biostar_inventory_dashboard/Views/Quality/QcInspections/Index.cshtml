        });

        refreshSingleQcLine(qcLineId);
    }

        function refreshSingleQcLine(qcLineId) {
        if (!currentQcData)
            return;

        renderModalLines(
            currentQcData.lines ?? [],
            currentQcData.status
        );
    }

        function lotQtyChanged(input) {
        const lotRow = input.closest(".lot-row");

        let receivedQty =
            Number(
                lotRow.querySelector(
                    ".lot-received-qty"
                ).value || 0
            );

        let acceptedQty =
            Number(
                lotRow.querySelector(
                    ".accepted-qty"
                ).value || 0
            );

        receivedQty = Math.max(0, receivedQty);
        acceptedQty = Math.max(
            0,
            Math.min(receivedQty, acceptedQty)
        );

        lotRow.querySelector(
            ".lot-received-qty"
        ).value = formatInputNumber(receivedQty);

        lotRow.querySelector(
            ".accepted-qty"
        ).value = formatInputNumber(acceptedQty);

        lotRow.querySelector(
            ".rejected-qty"
        ).value = formatInputNumber(
            receivedQty - acceptedQty
        );

        syncLotRowToData(lotRow);
        updateLineLotTotalsFromRow(lotRow);
    }

        function lotAcceptedQtyChanged(input) {
        const lotRow = input.closest(".lot-row");

        const receivedQty =
            Number(
                lotRow.querySelector(
                    ".lot-received-qty"
                ).value || 0
            );

        let acceptedQty =
            Number(input.value || 0);

        acceptedQty = Math.max(
            0,
            Math.min(receivedQty, acceptedQty)
        );

        input.value =
            formatInputNumber(acceptedQty);

        lotRow.querySelector(
            ".rejected-qty"
        ).value = formatInputNumber(
            receivedQty - acceptedQty
        );

        syncLotRowToData(lotRow);
        updateLineLotTotalsFromRow(lotRow);
    }

        function lotRejectedQtyChanged(input) {
        const lotRow = input.closest(".lot-row");

        const receivedQty =
            Number(
                lotRow.querySelector(
                    ".lot-received-qty"
                ).value || 0
            );

        let rejectedQty =
            Number(input.value || 0);

        rejectedQty = Math.max(
            0,
            Math.min(receivedQty, rejectedQty)
        );

        input.value =
            formatInputNumber(rejectedQty);

        lotRow.querySelector(
            ".accepted-qty"
        ).value = formatInputNumber(
            receivedQty - rejectedQty
        );

        syncLotRowToData(lotRow);
        updateLineLotTotalsFromRow(lotRow);
    }

        function syncLotRowToData(lotRow) {
        const lineRow =
            lotRow.closest(
                "tr[data-qc-line-id]"
            );

        if (!lineRow || !currentQcData)
            return;

        const qcLineId =
            Number(lineRow.dataset.qcLineId);

        const lotIndex =
            Number(lotRow.dataset.lotIndex);

        const line =
            currentQcData.lines.find(
                x => Number(x.qcLineId) === qcLineId
            );

        if (!line ||
            !Array.isArray(line.lots) ||
            !line.lots[lotIndex]) {
            return;
        }

        const lot = line.lots[lotIndex];

        lot.lotNo =
            lotRow.querySelector(
                ".lot-no"
            ).value.trim();

        lot.manufacturingDate =
            lotRow.querySelector(
                ".manufacturing-date"
            ).value || null;

        lot.expirationDate =
            lotRow.querySelector(
                ".expiration-date"
            ).value || null;

        lot.receivedQty =
            Number(
                lotRow.querySelector(
                    ".lot-received-qty"
                ).value || 0
            );

        lot.acceptedQty =
            Number(
                lotRow.querySelector(
                    ".accepted-qty"
                ).value || 0
            );

        lot.rejectedQty =
            Number(
                lotRow.querySelector(
                    ".rejected-qty"
                ).value || 0
            );

        lot.rejectionReason =
            lotRow.querySelector(
                ".rejection-reason"
            ).value.trim();

        lot.remarks =
            lotRow.querySelector(
                ".lot-remarks"
            ).value.trim();
    }

        function updateLineLotTotalsFromRow(lotRow) {
        const lineRow =
            lotRow.closest(
                "tr[data-qc-line-id]"
            );

        if (!lineRow)
            return;

        updateLineLotTotals(
            Number(lineRow.dataset.qcLineId)
        );
    }

        function updateLineLotTotals(qcLineId) {
        const lineRow =
            document.querySelector(
                `#modalQcLineBody tr[data-qc-line-id="${qcLineId}"]`
            );

        if (!lineRow)
            return;

        const lotRows =
            lineRow.querySelectorAll(".lot-row");

        let totalReceived = 0;
        let totalAccepted = 0;
        let totalRejected = 0;

        for (const lotRow of lotRows) {
            totalReceived += Number(
                lotRow.querySelector(
                    ".lot-received-qty"
                ).value || 0
            );

            totalAccepted += Number(
                lotRow.querySelector(
                    ".accepted-qty"
                ).value || 0
            );

            totalRejected += Number(
                lotRow.querySelector(
                    ".rejected-qty"
                ).value || 0
            );
        }

        lineRow.querySelector(
            ".lot-total-received"
        ).innerText = formatQty(totalReceived);

        lineRow.querySelector(
            ".lot-total-accepted"
        ).innerText = formatQty(totalAccepted);

        lineRow.querySelector(
            ".lot-total-rejected"
        ).innerText = formatQty(totalRejected);

        const qcReceivedQty =
            Number(lineRow.dataset.receivedQty || 0);

        let status = "PENDING";

        if (
            Math.abs(
                totalReceived - qcReceivedQty
            ) <= 0.0001
        ) {
            if (
                Math.abs(
                    totalAccepted - qcReceivedQty
                ) <= 0.0001
            ) {
                status = "ACCEPTED";
            }
            else if (
                Math.abs(
                    totalRejected - qcReceivedQty
                ) <= 0.0001
            ) {
                status = "REJECTED";
            }
            else {
                status = "PARTIALLY_ACCEPTED";
            }
        }

        lineRow.querySelector(
            ".line-status-cell"
        ).innerHTML =
            renderLineStatus(status);
    }

        function removeLotRow(button) {
        const lotRow =
            button.closest(".lot-row");

        const lineRow =
            button.closest("tr[data-qc-line-id]");

        if (!lotRow || !lineRow)
            return;

        const qcLineId =
            Number(lineRow.dataset.qcLineId);

        const lotIndex =
            Number(lotRow.dataset.lotIndex);

        const line =
            currentQcData?.lines?.find(
                x => Number(x.qcLineId) === qcLineId
            );

        if (!line || !Array.isArray(line.lots))
            return;

        line.lots.splice(lotIndex, 1);

        refreshSingleQcLine(qcLineId);
    }
        function formatDateInput(value) {
        if (!value)
            return "";

        return String(value).split("T")[0];
    }

    function acceptedQtyChanged(input) {
        const row = input.closest(
            "tr[data-qc-line-id]"
        );

        const receivedQty =
            Number(row.dataset.receivedQty || 0);

        let acceptedQty =
            Number(input.value || 0);

        acceptedQty =
            Math.max(
                0,
                Math.min(receivedQty, acceptedQty)
            );

        input.value = acceptedQty;

        const rejectedInput =
            row.querySelector(".rejected-qty");

        rejectedInput.value =
            formatInputNumber(
                receivedQty - acceptedQty
            );

        updateLiveLineStatus(row);
    }

    function rejectedQtyChanged(input) {
        const row = input.closest(
            "tr[data-qc-line-id]"
        );

        const receivedQty =
            Number(row.dataset.receivedQty || 0);

        let rejectedQty =
            Number(input.value || 0);

        rejectedQty =
            Math.max(
                0,
                Math.min(receivedQty, rejectedQty)
            );

        input.value = rejectedQty;

        const acceptedInput =
            row.querySelector(".accepted-qty");

        acceptedInput.value =
            formatInputNumber(
                receivedQty - rejectedQty
            );

        updateLiveLineStatus(row);
    }

    function updateLiveLineStatus(row) {
        const receivedQty =
            Number(row.dataset.receivedQty || 0);

        const acceptedQty =
            Number(
                row.querySelector(
                    ".accepted-qty"
                ).value || 0
            );

        const rejectedQty =
            Number(
                row.querySelector(
                    ".rejected-qty"
                ).value || 0
            );

        let status = "PENDING";

        if (
            Math.abs(
                acceptedQty - receivedQty
            ) <= 0.0001
        ) {
            status = "ACCEPTED";
        }
        else if (
            Math.abs(
                rejectedQty - receivedQty
            ) <= 0.0001
        ) {
            status = "REJECTED";
        }
        else if (
            acceptedQty > 0 ||
            rejectedQty > 0
        ) {
            status = "PARTIALLY_ACCEPTED";
        }

        row.querySelector(
            ".line-status-cell"
        ).innerHTML =
            renderLineStatus(status);
    }

      async function completeQcInspection() {
        const qcId =
            Number(
                document.getElementById(
                    "modalQcId"
                ).value
            );

        if (!qcId) {
            alert("QC inspection was not loaded.");
            return;
        }

        if (!currentQcData) {
            alert("QC inspection data was not loaded.");
            return;
        }

        const lines = [];

        const rows =
            document.querySelectorAll(
                "#modalQcLineBody tr[data-qc-line-id]"
            );

        for (const row of rows) {
            const qcLineId =
                Number(row.dataset.qcLineId);

            const receivedQty =
                Number(row.dataset.receivedQty || 0);

            const isLotTracked =
                String(row.dataset.isLotTracked)
                    .toLowerCase() === "true";

            const lineData =
                currentQcData.lines?.find(
                    x =>
                        Number(x.qcLineId) ===
                        qcLineId
                );

            if (!lineData) {
                alert(
                    `QC line ${qcLineId} was not found.`
                );

                return;
            }

            const lineRemarks =
                row.querySelector(
                    ".line-remarks"
                )?.value.trim() ?? "";

            const lots = [];

            /*
             * LOT-TRACKED MATERIAL
             */
            if (isLotTracked) {
                const lotRows =
                    row.querySelectorAll(".lot-row");

                if (lotRows.length === 0) {
                    alert(
                        `${lineData.materialName}: At least one lot is required.`
                    );

                    return;
                }

                let totalLotReceived = 0;

                for (const lotRow of lotRows) {
                    const qcLineLotIdValue =
                        lotRow.dataset.qcLineLotId;

                    const lotNo =
                        lotRow.querySelector(
                            ".lot-no"
                        )?.value.trim() ?? "";

                    const manufacturingDate =
                        lotRow.querySelector(
                            ".manufacturing-date"
                        )?.value || null;

                    const expirationDate =
                        lotRow.querySelector(
                            ".expiration-date"
                        )?.value || null;

                    const lotReceivedQty =
                        Number(
                            lotRow.querySelector(
                                ".lot-received-qty"
                            )?.value || 0
                        );

                    const acceptedQty =
                        Number(
                            lotRow.querySelector(
                                ".accepted-qty"
                            )?.value || 0
                        );

                    const rejectedQty =
                        Number(
                            lotRow.querySelector(
                                ".rejected-qty"
                            )?.value || 0
                        );

                    const rejectionReason =
                        lotRow.querySelector(
                            ".rejection-reason"
                        )?.value.trim() ?? "";

                    const remarks =
                        lotRow.querySelector(
                            ".lot-remarks"
                        )?.value.trim() ?? "";

                    if (!lotNo) {
                        alert(
                            `${lineData.materialName}: Lot number is required.`
                        );

                        lotRow.querySelector(
                            ".lot-no"
                        )?.focus();

                        return;
                    }

                    if (lotReceivedQty <= 0) {
                        alert(
                            `${lineData.materialName}: Lot received quantity must be greater than zero.`
                        );

                        return;
                    }

                    if (
                        acceptedQty < 0 ||
                        rejectedQty < 0
                    ) {
                        alert(
                            `${lineData.materialName}: Accepted and rejected quantities cannot be negative.`
                        );

                        return;
                    }

                    if (
                        Math.abs(
                            acceptedQty +
                            rejectedQty -
                            lotReceivedQty
                        ) > 0.0001
                    ) {
                        alert(
                            `${lineData.materialName}: Accepted plus rejected must equal the lot received quantity.`
                        );

                        return;
                    }

                    if (
                        rejectedQty > 0 &&
                        !rejectionReason
                    ) {
                        alert(
                            `${lineData.materialName}: Rejection reason is required for lot ${lotNo}.`
                        );

                        lotRow.querySelector(
                            ".rejection-reason"
                        )?.focus();

                        return;
                    }

                    if (
                        manufacturingDate &&
                        expirationDate &&
                        expirationDate <
                        manufacturingDate
                    ) {
                        alert(
                            `${lineData.materialName}: Expiration date cannot be earlier than manufacturing date.`
                        );

                        return;
                    }

                    totalLotReceived += lotReceivedQty;

                    lots.push({
                        qcLineLotId:
                            qcLineLotIdValue
                                ? Number(
                                    qcLineLotIdValue
                                )
                                : null,

                        lotNo,
                        manufacturingDate,
                        expirationDate,
                        receivedQty:
                            lotReceivedQty,
                        acceptedQty,
                        rejectedQty,
                        rejectionReason:
                            rejectionReason || null,
                        remarks:
                            remarks || null
                    });
                }

                if (
                    Math.abs(
                        totalLotReceived -
                        receivedQty
                    ) > 0.0001
                ) {
                    alert(
                        `${lineData.materialName}: Total lot received quantity must equal ${formatQty(receivedQty)}.`
                    );

                    return;
                }
            }

            /*
             * NON-LOT-TRACKED MATERIAL
             */
            else {
                const acceptedQty =
                    Number(
                        row.querySelector(
                            ".nonlot-accepted-qty"
                        )?.value || 0
                    );

                const rejectedQty =
                    Number(
                        row.querySelector(
                            ".nonlot-rejected-qty"
                        )?.value || 0
                    );

                const rejectionReason =
                    row.querySelector(
                        ".nonlot-rejection-reason"
                    )?.value.trim() ?? "";

                if (
                    acceptedQty < 0 ||
                    rejectedQty < 0
                ) {
                    alert(
                        `${lineData.materialName}: Accepted and rejected quantities cannot be negative.`
                    );

                    return;
                }

                if (
                    Math.abs(
                        acceptedQty +
                        rejectedQty -
                        receivedQty
                    ) > 0.0001
                ) {
                    alert(
                        `${lineData.materialName}: Accepted plus rejected quantity must equal received quantity.`
                    );

                    return;
                }

                if (
                    rejectedQty > 0 &&
                    !rejectionReason
                ) {
                    alert(
                        `${lineData.materialName}: Rejection reason is required.`
                    );

                    row.querySelector(
                        ".nonlot-rejection-reason"
                    )?.focus();

                    return;
                }

                const existingAllocation =
                    Array.isArray(lineData.lots)
                        ? lineData.lots[0]
                        : null;

                lots.push({
                    qcLineLotId:
                        existingAllocation?.qcLineLotId ??
                        null,

                    lotNo: "",
                    manufacturingDate: null,
                    expirationDate: null,
                    receivedQty,
                    acceptedQty,
                    rejectedQty,
                    rejectionReason:
                        rejectionReason || null,
                    remarks: null
                });
            }

            lines.push({
                qcLineId,
                remarks:
                    lineRemarks || null,
                lots
            });
        }

        if (lines.length === 0) {
            alert(
                "QC inspection must contain at least one line."
            );

            return;
        }

        if (
            !confirm(
                "Complete this QA/QC inspection?"
            )
        ) {
            return;
        }

        const button =
            document.getElementById(
                "btnCompleteInspection"
            );

        button.disabled = true;
        button.innerText =
            "Completing Inspection...";

        const payload = {
            inspectionDate:
                document.getElementById(
                    "modalInspectionDate"
                ).value || null,

            remarks:
                document.getElementById(
                    "modalQcRemarks"
                ).value.trim() || null,

            lines
        };

        console.log(
            "QC Save Payload:",
            payload
        );

        try {
            const response = await fetch(
                `/quality/qc-inspections/${qcId}/save-inspection`,
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify(payload)
                }
            );

            const result =
                await readJsonResponse(response);

            if (!response.ok) {
                throw new Error(
                    result.message ??
                    "Failed to complete QC inspection."
                );
            }

            alert(
                result.message ??
                "QC inspection completed successfully."
            );

            qcInspectionModal.hide();

            await loadQcInspections();
        }
        catch (error) {
            console.error(
                "QC inspection error:",
                error
            );

            alert(
                error.message ??
                "Failed to complete QC inspection."
            );
        }
        finally {
            button.disabled = false;
            button.innerText =
                "Complete Inspection";
        }
    }

    function renderStatus(status) {
        const normalized =
            normalizeStatus(status);

        let badge = "bg-secondary";

        if (normalized === "FOR_INSPECTION")
            badge = "bg-info text-dark";

        if (normalized === "INSPECTED")
            badge = "bg-success";

        if (normalized === "COMMITTED")
            badge = "bg-dark";

        return `
            <span class="badge ${badge}">
                ${escapeHtml(formatStatus(normalized))}
            </span>
        `;
    }

    function renderDecision(decision) {
        const normalized =
            normalizeStatus(decision);

        if (!normalized)
            return "-";

        let badge = "bg-secondary";

        if (normalized === "ACCEPTED")
            badge = "bg-success";

        if (normalized === "PARTIALLY_ACCEPTED")
            badge = "bg-warning text-dark";

        if (normalized === "REJECTED")
            badge = "bg-danger";

        return `
            <span class="badge ${badge}">
                ${escapeHtml(formatStatus(normalized))}
            </span>
        `;
    }

    function renderLineStatus(status) {
        const normalized =
            normalizeStatus(status);

        let badge = "bg-secondary";

        if (normalized === "PENDING")
            badge = "bg-warning text-dark";

        if (normalized === "ACCEPTED")
            badge = "bg-success";

        if (normalized === "PARTIALLY_ACCEPTED")
            badge = "bg-warning text-dark";

        if (normalized === "REJECTED")
            badge = "bg-danger";

        return `
            <span class="badge ${badge}">
                ${escapeHtml(formatStatus(normalized))}
            </span>
        `;
    }

    async function readJsonResponse(response) {
        const text =
            await response.text();

        if (!text)
            return {};

        try {
            return JSON.parse(text);
        }
        catch {
            return {
                message: text
            };
        }
    }

    function normalizeStatus(value) {
        return String(value ?? "")
            .trim()
            .toUpperCase();
    }

    function formatStatus(value) {
        if (!value)
            return "-";

        return String(value)
            .replaceAll("_", " ");
    }

    function formatDate(value) {
        if (!value)
            return "-";

        const date = new Date(value);

        if (Number.isNaN(date.getTime()))
            return "-";

        return date.toLocaleDateString();
    }

    function formatQty(value) {
        return Number(value ?? 0)
            .toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 4
            });
    }

    function formatInputNumber(value) {
        return Number(value ?? 0)
            .toFixed(4)
            .replace(/\.?0+$/, "");
    }

    function getTodayDate() {
        const now = new Date();

        const timezoneOffset =
            now.getTimezoneOffset() * 60000;

        return new Date(
            now.getTime() - timezoneOffset
        )
        .toISOString()
        .split("T")[0];
    }

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function escapeAttribute(value) {
        return escapeHtml(value);
    }
</script>