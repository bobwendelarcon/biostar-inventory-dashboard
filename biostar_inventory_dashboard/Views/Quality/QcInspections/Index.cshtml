@{
    ViewData["Title"] = "QA/QC Inspections";
}

<style>
    .qc-summary-card {
        border: 0;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0, 0, 0, .06);
    }

        .qc-summary-card .count {
            font-size: 24px;
            font-weight: 700;
        }

    .qc-table-wrapper {
        position: relative;
        overflow: visible !important;
    }

    .qc-modal-header-card {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 16px;
    }

    .qc-modal-table {
        min-width: 1100px;
    }

    .accepted-qty {
        background-color: #ecfdf5;
    }

    .rejected-qty {
        background-color: #fff1f2;
    }

    .modal-dialog-qc {
        max-width: 96vw;
    }

    .inspection-note {
        font-size: 13px;
        color: #6c757d;
    }
</style>

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <div class="text-muted small mb-1">
            Quality Control &gt; QA/QC Inspections
        </div>

        <h2 class="fw-bold mb-1">
            QA/QC Inspections
        </h2>

        <div class="text-muted">
            Evaluate deliveries submitted by the warehouse.
        </div>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card qc-summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        For Inspection
                    </div>

                    <div id="forInspectionCount"
                         class="count text-info">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card qc-summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        Accepted
                    </div>

                    <div id="acceptedCount"
                         class="count text-success">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card qc-summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        Partially Accepted
                    </div>

                    <div id="partiallyAcceptedCount"
                         class="count text-primary">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card qc-summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        Rejected
                    </div>

                    <div id="rejectedCount"
                         class="count text-danger">
                        0
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- QC list -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="row g-2 mb-3">

                <div class="col-md-4">
                    <input id="qcSearch"
                           type="text"
                           class="form-control"
                           placeholder="Search QC No, RR No, PO No, Supplier">
                </div>

                <div class="col-md-3">
                    <select id="statusFilter"
                            class="form-select">

                        <option value="">
                            All Status
                        </option>

                        <option value="FOR_INSPECTION">
                            For Inspection
                        </option>

                        <option value="COMMITTED">
                            Committed
                        </option>

                    </select>
                </div>

            </div>

            <div class="table-responsive qc-table-wrapper">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>QC No</th>
                            <th>RR No</th>
                            <th>PO No</th>
                            <th>Supplier</th>
                            <th>Inspection Date</th>
                            <th>Inspector</th>
                            <th>Status</th>
                            <th>Decision</th>
                            <th class="text-end"
                                style="width:120px;">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody id="qcTableBody">
                        <tr>
                            <td colspan="9"
                                class="text-center text-muted py-4">
                                Loading QC inspections...
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<!-- QA/QC Inspection Modal -->
<div class="modal fade"
     id="qcInspectionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-qc modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title fw-bold mb-1">
                        QA/QC Inspection
                    </h5>

                    <div class="text-muted small">
                        Evaluate the received delivery and record the final disposition.
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="modalQcId">

                <!-- Header details -->
                <div class="qc-modal-header-card mb-4">

                    <div class="row g-3">

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                QC No
                            </label>

                            <input id="modalQcNo"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                RR No
                            </label>

                            <input id="modalRrNo"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                PO No
                            </label>

                            <input id="modalPoNo"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                Supplier
                            </label>

                            <input id="modalSupplier"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                Inspection Date
                            </label>

                            <input id="modalInspectionDate"
                                   type="date"
                                   class="form-control">
                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">

                    <h5 class="fw-bold mb-0">
                        Inspection Lines
                    </h5>

                    <div class="inspection-note">
                        Accepted Qty + Rejected Qty must equal Received Qty.
                    </div>

                </div>

                <div class="table-responsive border rounded">

                    <table class="table table-hover align-middle mb-0 qc-modal-table">

                        <thead class="table-light">
                            <tr>
                                <th style="width:100%;">
                                    Inspection Lines
                                </th>
                            </tr>
                        </thead>

                        <tbody id="modalQcLineBody">

                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    Loading inspection...
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

                <div class="mt-4">

                    <label class="form-label fw-semibold">
                        Overall Remarks
                    </label>

                    <textarea id="modalQcRemarks"
                              class="form-control"
                              rows="3"
                              placeholder="Enter overall QC findings, follow-up requirements, or laboratory notes"></textarea>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="btnCompleteInspection"
                        class="btn btn-success">
                    Complete Inspection
                </button>

            </div>

        </div>

    </div>

</div>

<script>
    let qcList = [];
    let qcInspectionModal = null;
    let currentQcData = null;

    document.addEventListener("DOMContentLoaded", function () {

        qcInspectionModal = new bootstrap.Modal(
            document.getElementById("qcInspectionModal")
        );

        document
            .getElementById("qcSearch")
            .addEventListener("input", renderTable);

        document
            .getElementById("statusFilter")
            .addEventListener("change", renderTable);

        document
            .getElementById("btnCompleteInspection")
            .addEventListener("click", completeQcInspection);

            document
    .getElementById("modalQcLineBody")
    .addEventListener("input", function (event) {
        const lotRow =
            event.target.closest(".lot-row");

        if (!lotRow)
            return;

        syncLotRowToData(lotRow);
    });

        loadQcInspections();
    });

    async function loadQcInspections() {
        const tbody =
            document.getElementById("qcTableBody");

        tbody.innerHTML = `
            <tr>
                <td colspan="9"
                    class="text-center text-muted py-4">
                    Loading QC inspections...
                </td>
            </tr>
        `;

        try {
            const response = await fetch(
                "/quality/qc-inspections/list"
            );

            const data = await readJsonResponse(response);

            if (!response.ok) {
                throw new Error(
                    data.message ??
                    "Failed to load QC inspections."
                );
            }

            qcList = Array.isArray(data)
                ? data
                : [];

            updateSummaryCards();
            renderTable();

        } catch (error) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="9"
                        class="text-center text-danger py-4">
                        ${escapeHtml(
                            error.message ??
                            "Failed to load QC inspections."
                        )}
                    </td>
                </tr>
            `;
        }
    }

    function updateSummaryCards() {
        const forInspection =
            qcList.filter(x =>
                normalizeStatus(x.status) === "FOR_INSPECTION"
            ).length;

        const accepted =
            qcList.filter(x =>
                normalizeStatus(x.decision) === "ACCEPTED"
            ).length;

        const partiallyAccepted =
            qcList.filter(x =>
                normalizeStatus(x.decision) ===
                "PARTIALLY_ACCEPTED"
            ).length;

        const rejected =
            qcList.filter(x =>
                normalizeStatus(x.decision) === "REJECTED"
            ).length;

        document.getElementById(
            "forInspectionCount"
        ).innerText = forInspection;

        document.getElementById(
            "acceptedCount"
        ).innerText = accepted;

        document.getElementById(
            "partiallyAcceptedCount"
        ).innerText = partiallyAccepted;

        document.getElementById(
            "rejectedCount"
        ).innerText = rejected;
    }

    function renderTable() {
        const tbody =
            document.getElementById("qcTableBody");

        const search =
            document.getElementById("qcSearch")
                .value
                .trim()
                .toLowerCase();

        const selectedStatus =
            normalizeStatus(
                document.getElementById(
                    "statusFilter"
                ).value
            );

        const filtered = qcList.filter(qc => {

            const searchText = [
                qc.qcNo,
                qc.rrNo,
                qc.poNo,
                qc.supplierName
            ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();

            const matchesSearch =
                !search ||
                searchText.includes(search);

            const matchesStatus =
                !selectedStatus ||
                normalizeStatus(qc.status) ===
                selectedStatus;

            return matchesSearch && matchesStatus;
        });

        tbody.innerHTML = "";

        if (filtered.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="9"
                        class="text-center text-muted py-4">
                        No QC inspections found.
                    </td>
                </tr>
            `;

            return;
        }

        for (const qc of filtered) {
            const canInspect =
                normalizeStatus(qc.status) ===
                "FOR_INSPECTION";

            tbody.insertAdjacentHTML(
                "beforeend",
                `
                    <tr>
                        <td class="fw-semibold">
                            ${escapeHtml(qc.qcNo ?? "")}
                        </td>

                        <td>
                            ${escapeHtml(qc.rrNo ?? "")}
                        </td>

                        <td>
                            ${escapeHtml(qc.poNo ?? "")}
                        </td>

                        <td>
                            ${escapeHtml(qc.supplierName ?? "")}
                        </td>

                        <td>
                            ${formatDate(qc.inspectionDate)}
                        </td>

                        <td>
                               ${escapeHtml(
        qc.inspectorName ??
        qc.inspectorId ??
        "-"
    )}
                        </td>

                        <td>
                            ${renderStatus(qc.status)}
                        </td>

                        <td>
                            ${renderDecision(qc.decision)}
                        </td>

                        <td class="text-end">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    onclick="openQcInspection(${Number(qc.qcId)})">

                                ${canInspect ? "Inspect" : "View"}

                            </button>
                        </td>
                    </tr>
                `
            );
        }
    }

    async function openQcInspection(qcId) {
        resetInspectionModal();

        qcInspectionModal.show();

        try {
            const response = await fetch(
                `/quality/qc-inspections/${qcId}`
            );

            const data = await readJsonResponse(response);

            if (!response.ok) {
                throw new Error(
                    data.message ??
                    "QC inspection not found."
                );
            }

            currentQcData = data;

            document.getElementById(
                "modalQcId"
            ).value = data.qcId;

            document.getElementById(
                "modalQcNo"
            ).value = data.qcNo ?? "";

            document.getElementById(
                "modalRrNo"
            ).value = data.rrNo ?? "";

            document.getElementById(
                "modalPoNo"
            ).value = data.poNo ?? "";

            document.getElementById(
                "modalSupplier"
            ).value = data.supplierName ?? "";

            document.getElementById(
                "modalInspectionDate"
            ).value =
                data.inspectionDate
                    ? String(data.inspectionDate)
                        .split("T")[0]
                    : getTodayDate();

            document.getElementById(
                "modalQcRemarks"
            ).value = data.remarks ?? "";

            renderModalLines(
                data.lines ?? [],
                data.status
            );

            const editable =
                normalizeStatus(data.status) ===
                "FOR_INSPECTION";

            document.getElementById(
                "modalInspectionDate"
            ).disabled = !editable;

            document.getElementById(
                "modalQcRemarks"
            ).disabled = !editable;

            document.getElementById(
                "btnCompleteInspection"
            ).classList.toggle(
                "d-none",
                !editable
            );

        } catch (error) {
            document.getElementById(
                "modalQcLineBody"
            ).innerHTML = `
                <tr>
                    <td colspan="7"
                        class="text-center text-danger py-4">
                        ${escapeHtml(
                            error.message ??
                            "Failed to load inspection."
                        )}
                    </td>
                </tr>
            `;
        }
    }

    function resetInspectionModal() {
        currentQcData = null;

        document.getElementById(
            "modalQcId"
        ).value = "";

        document.getElementById(
            "modalQcNo"
        ).value = "";

        document.getElementById(
            "modalRrNo"
        ).value = "";

        document.getElementById(
            "modalPoNo"
        ).value = "";

        document.getElementById(
            "modalSupplier"
        ).value = "";

        document.getElementById(
            "modalInspectionDate"
        ).value = getTodayDate();

        document.getElementById(
            "modalQcRemarks"
        ).value = "";

        document.getElementById(
            "modalQcLineBody"
        ).innerHTML = `
            <tr>
                <td colspan="7"
                    class="text-center text-muted py-4">
                    Loading inspection...
                </td>
            </tr>
        `;

        document.getElementById(
            "btnCompleteInspection"
        ).classList.add("d-none");
    }

        function renderLotTrackedInspection(line, editable) {
        return `
            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>
                    <span class="fw-semibold">
                        Lot Breakdown
                    </span>

                    <span class="text-muted small ms-2">
                        Total lot received quantity must equal
                        ${formatQty(line.receivedQty)}.
                    </span>
                </div>

                ${
                    editable
                        ? `
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    onclick="addLotRow(${Number(line.qcLineId)})">
                                + Add Lot
                            </button>
                          `
                        : ""
                }

            </div>

            <div class="table-responsive">

                <table class="table table-bordered align-middle mb-2">

                    <thead class="table-light">
                        <tr>
                            <th style="min-width:140px;">
                                Lot No
                            </th>

                            <th style="min-width:140px;">
                                Mfg Date
                            </th>

                            <th style="min-width:140px;">
                                Exp Date
                            </th>

                            <th style="min-width:120px;">
                                Received
                            </th>

                            <th style="min-width:120px;">
                                Accepted
                            </th>

                            <th style="min-width:120px;">
                                Rejected
                            </th>

                            <th style="min-width:220px;">
                                Rejection Reason
                            </th>

                            <th style="min-width:220px;">
                                Remarks
                            </th>

                            ${
                                editable
                                    ? `
                                        <th style="width:80px;">
                                            Remove
                                        </th>
                                      `
                                    : ""
                            }
                        </tr>
                    </thead>

                    <tbody class="lot-table-body"
                           data-qc-line-id="${Number(line.qcLineId)}">

                        ${renderLotRows(line, editable)}

                    </tbody>

                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3"
                                class="text-end">
                                Totals
                            </th>

                            <th class="lot-total-received">
                                0
                            </th>

                            <th class="lot-total-accepted">
                                0
                            </th>

                            <th class="lot-total-rejected">
                                0
                            </th>

                            <th colspan="${editable ? 3 : 2}">
                            </th>
                        </tr>
                    </tfoot>

                </table>

            </div>

            <div class="row g-3 mt-1">

                <div class="col-md-8">
                    <label class="form-label">
                        Line Remarks
                    </label>

                    <input type="text"
                           class="form-control line-remarks"
                           value="${escapeAttribute(line.remarks ?? "")}"
                           placeholder="Optional line remarks"
                           ${editable ? "" : "disabled"}>
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Line Status
                    </label>

                    <div class="line-status-cell pt-2">
                        ${renderLineStatus(line.status)}
                    </div>
                </div>

            </div>
        `;
    }

        function renderNonLotInspection(line, editable) {
        const allocation =
            line.lots?.[0] ?? {};

        const receivedQty =
            Number(line.receivedQty ?? 0);

        let acceptedQty =
            Number(allocation.acceptedQty ?? line.acceptedQty ?? 0);

        let rejectedQty =
            Number(allocation.rejectedQty ?? line.rejectedQty ?? 0);

        /*
         * For a new inspection, default all quantity to accepted.
         */
        if (
            acceptedQty === 0 &&
            rejectedQty === 0 &&
            receivedQty > 0
        ) {
            acceptedQty = receivedQty;
            rejectedQty = 0;

            allocation.acceptedQty = acceptedQty;
            allocation.rejectedQty = rejectedQty;
        }

        return `
            <div class="alert alert-light border mb-3">
                This material does not require a supplier lot number.
                Enter only the accepted and rejected quantities.
            </div>

            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Received Quantity
                    </label>

                    <input type="number"
                           class="form-control text-end nonlot-received-qty"
                           value="${formatInputNumber(receivedQty)}"
                           readonly>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Accepted Quantity
                    </label>

                    <input type="number"
                           class="form-control text-end accepted-qty nonlot-accepted-qty"
                           min="0"
                           step="0.0001"
                           value="${formatInputNumber(acceptedQty)}"
                           oninput="nonLotAcceptedChanged(this)"
                           ${editable ? "" : "disabled"}>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Rejected Quantity
                    </label>

                    <input type="number"
                           class="form-control text-end rejected-qty nonlot-rejected-qty"
                           min="0"
                           step="0.0001"
                           value="${formatInputNumber(rejectedQty)}"
                           oninput="nonLotRejectedChanged(this)"
                           ${editable ? "" : "disabled"}>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Line Status
                    </label>

                    <div class="line-status-cell pt-2">
                        ${renderLineStatus(line.status)}
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Rejection Reason
                    </label>

                    <input type="text"
                           class="form-control nonlot-rejection-reason"
                           value="${escapeAttribute(
                               allocation.rejectionReason ?? ""
                           )}"
                           placeholder="Required when rejected quantity is greater than zero"
                           ${editable ? "" : "disabled"}>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Line Remarks
                    </label>

                    <input type="text"
                           class="form-control line-remarks"
                           value="${escapeAttribute(line.remarks ?? "")}"
                           placeholder="Optional line remarks"
                           ${editable ? "" : "disabled"}>
                </div>

            </div>
        `;
    }

        function nonLotAcceptedChanged(input) {
        const row =
            input.closest("tr[data-qc-line-id]");

        if (!row)
            return;

        const receivedQty =
            Number(row.dataset.receivedQty || 0);

        let acceptedQty =
            Number(input.value || 0);

        acceptedQty = Math.max(
            0,
            Math.min(receivedQty, acceptedQty)
        );

        const rejectedQty =
            receivedQty - acceptedQty;

        input.value =
            formatInputNumber(acceptedQty);

        row.querySelector(
            ".nonlot-rejected-qty"
        ).value =
            formatInputNumber(rejectedQty);

        syncNonLotRowToData(row);
        updateNonLotStatus(
            Number(row.dataset.qcLineId)
        );
    }

    function nonLotRejectedChanged(input) {
        const row =
            input.closest("tr[data-qc-line-id]");

        if (!row)
            return;

        const receivedQty =
            Number(row.dataset.receivedQty || 0);

        let rejectedQty =
            Number(input.value || 0);

        rejectedQty = Math.max(
            0,
            Math.min(receivedQty, rejectedQty)
        );

        const acceptedQty =
            receivedQty - rejectedQty;

        input.value =
            formatInputNumber(rejectedQty);

        row.querySelector(
            ".nonlot-accepted-qty"
        ).value =
            formatInputNumber(acceptedQty);

        syncNonLotRowToData(row);
        updateNonLotStatus(
            Number(row.dataset.qcLineId)
        );
    }

        function syncNonLotRowToData(row) {
        if (!currentQcData)
            return;

        const qcLineId =
            Number(row.dataset.qcLineId);

        const line =
            currentQcData.lines?.find(
                x => Number(x.qcLineId) === qcLineId
            );

        if (!line)
            return;

        if (!Array.isArray(line.lots)) {
            line.lots = [];
        }

        if (line.lots.length === 0) {
            line.lots.push({
                qcLineLotId: null,
                lotNo: "",
                manufacturingDate: null,
                expirationDate: null,
                receivedQty:
                    Number(line.receivedQty ?? 0),
                acceptedQty: 0,
                rejectedQty: 0,
                rejectionReason: "",
                remarks: "",
                status: "PENDING"
            });
        }

        const allocation =
            line.lots[0];

        allocation.receivedQty =
            Number(line.receivedQty ?? 0);

        allocation.acceptedQty =
            Number(
                row.querySelector(
                    ".nonlot-accepted-qty"
                ).value || 0
            );

        allocation.rejectedQty =
            Number(
                row.querySelector(
                    ".nonlot-rejected-qty"
                ).value || 0
            );

        allocation.rejectionReason =
            row.querySelector(
                ".nonlot-rejection-reason"
            ).value.trim();

        allocation.lotNo = "";
        allocation.manufacturingDate = null;
        allocation.expirationDate = null;
    }

        function updateNonLotStatus(qcLineId) {
        const row =
            document.querySelector(
                `#modalQcLineBody tr[data-qc-line-id="${qcLineId}"]`
            );

        if (!row)
            return;

        const receivedQty =
            Number(row.dataset.receivedQty || 0);

        const acceptedQty =
            Number(
                row.querySelector(
                    ".nonlot-accepted-qty"
                )?.value || 0
            );

        const rejectedQty =
            Number(
                row.querySelector(
                    ".nonlot-rejected-qty"
                )?.value || 0
            );

        let status = "PENDING";

        if (
            Math.abs(
                acceptedQty + rejectedQty - receivedQty
            ) <= 0.0001
        ) {
            if (
                Math.abs(
                    acceptedQty - receivedQty
                ) <= 0.0001
            ) {
                status = "ACCEPTED";
            }
            else if (
                Math.abs(
                    rejectedQty - receivedQty
                ) <= 0.0001
            ) {
                status = "REJECTED";
            }
            else {
                status = "PARTIALLY_ACCEPTED";
            }
        }

        row.querySelector(
            ".line-status-cell"
        ).innerHTML =
            renderLineStatus(status);
    }

            function renderModalLines(lines, status) {
        const tbody =
            document.getElementById("modalQcLineBody");

        tbody.innerHTML = "";

        if (!Array.isArray(lines) || lines.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td class="text-center text-muted py-4">
                        No QC inspection lines found.
                    </td>
                </tr>
            `;

            return;
        }

        const editable =
            normalizeStatus(status) === "FOR_INSPECTION";

        for (const line of lines) {
            line.isLotTracked =
                line.isLotTracked === true;

            if (!Array.isArray(line.lots)) {
                line.lots = [];
            }

            /*
             * Non-lot-tracked materials still use one internal
             * inspection allocation object.
             */
            if (!line.isLotTracked && line.lots.length === 0) {
                line.lots.push({
                    qcLineLotId: null,
                    lotNo: "",
                    manufacturingDate: null,
                    expirationDate: null,
                    receivedQty:
                        Number(line.receivedQty ?? 0),
                    acceptedQty:
                        Number(line.acceptedQty ?? line.receivedQty ?? 0),
                    rejectedQty:
                        Number(line.rejectedQty ?? 0),
                    rejectionReason: "",
                    remarks: "",
                    status: "PENDING"
                });
            }

            tbody.insertAdjacentHTML(
                "beforeend",
                `
                    <tr data-qc-line-id="${Number(line.qcLineId)}"
                        data-received-qty="${Number(line.receivedQty ?? 0)}"
                        data-is-lot-tracked="${line.isLotTracked}">

                        <td class="p-3">

                            <div class="card border">

                                <div class="card-header bg-light">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <div>
                                            <div class="fw-bold">
                                                ${escapeHtml(line.materialName ?? "")}
                                            </div>

                                            <div class="text-muted small">
                                                ${escapeHtml(line.materialCode ?? "")}
                                            </div>

                                            <div class="mt-1">
                                                ${
                                                    line.isLotTracked
                                                        ? `
                                                            <span class="badge bg-primary">
                                                                Lot Tracked
                                                            </span>
                                                          `
                                                        : `
                                                            <span class="badge bg-secondary">
                                                                Non-Lot Tracked
                                                            </span>
                                                          `
                                                }
                                            </div>
                                        </div>

                                        <div class="text-end">
                                            <div class="text-muted small">
                                                Received Quantity
                                            </div>

                                            <div class="fw-bold">
                                                ${formatQty(line.receivedQty)}
                                            </div>
                                        </div>

                                    </div>

                                </div>

                                <div class="card-body">

                                    ${
                                        line.isLotTracked
                                            ? renderLotTrackedInspection(
                                                line,
                                                editable
                                            )
                                            : renderNonLotInspection(
                                                line,
                                                editable
                                            )
                                    }

                                </div>

                            </div>

                        </td>

                    </tr>
                `
            );

            if (line.isLotTracked) {
                updateLineLotTotals(
                    Number(line.qcLineId)
                );
            } else {
                updateNonLotStatus(
                    Number(line.qcLineId)
                );
            }
        }
    }

        function renderLotRows(line, editable) {
        const lots =
            Array.isArray(line.lots)
                ? line.lots
                : [];

        if (lots.length === 0) {
            return `
                <tr class="no-lot-row">
                    <td colspan="${editable ? 9 : 8}"
                        class="text-center text-muted py-3">
                        No lots added.
                    </td>
                </tr>
            `;
        }

        return lots
            .map((lot, index) => renderLotRow(
                line.qcLineId,
                lot,
                index,
                editable
            ))
            .join("");
    }

       

