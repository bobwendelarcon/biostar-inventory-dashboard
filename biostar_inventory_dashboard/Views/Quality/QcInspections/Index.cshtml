     function addLotRow(qcLineId) {
        const line =
            currentQcData?.lines?.find(
                x => Number(x.qcLineId) === Number(qcLineId)
            );

        if (!line)
            return;

        if (!Array.isArray(line.lots))
            line.lots = [];

        line.lots.push({
            qcLineLotId: null,
            lotNo: "",
            manufacturingDate: null,
            expirationDate: null,
