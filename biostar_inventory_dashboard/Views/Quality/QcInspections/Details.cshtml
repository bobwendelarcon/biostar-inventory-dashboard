@{
    ViewData["Title"] = "QA/QC Inspection Details";
    var qcId = ViewBag.QcId;
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <div class="text-muted small mb-1">Purchasing &gt; QA/QC Inspection &gt; Details</div>
        <h2 class="fw-bold mb-1" id="qcTitle">QA/QC Inspection</h2>
        <div class="text-muted">Input accepted and rejected quantities for received materials.</div>
    </div>

    <div class="mb-3 d-flex gap-2">
        <a href="/quality/qc-inspections" class="btn btn-outline-secondary btn-sm">
            Back to QC List
        </a>

        <button id="btnSaveInspection" class="btn btn-success btn-sm d-none">
            Save Inspection
        </button>

        <button id="btnReleaseMaterial"
                class="btn btn-primary btn-sm d-none">
            Release to RMW
        </button>

     
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="text-muted small">QC No</label>
                    <div class="fw-semibold" id="qcNo">-</div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small">
                        Incoming No
                    </label>

                    <div class="fw-semibold"
                         id="incomingNo">
                        -
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small">PO No</label>
                    <div class="fw-semibold" id="poNo">-</div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small">Supplier</label>
                    <div class="fw-semibold" id="supplierName">-</div>
                </div>

                <div class="col-md-3">
                    <label class="text-muted small">Status</label>
                    <div id="qcStatus">-</div>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Inspection Date</label>
                    <input id="inspectionDate" type="date" class="form-control">
                </div>

                <div class="col-md-6">
                    <label class="form-label">QC Remarks</label>
                    <input id="remarks" class="form-control" placeholder="Optional QC remarks">
                </div>
            </div>

        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <h5 class="fw-bold mb-3">
                Raw Material Evaluation
            </h5>

            <div id="qcLineBody">
                <div class="text-center text-muted py-4">
                    Loading raw material evaluation...
                </div>
            </div>

        </div>
    </div>

</div>

<script>
    const qcId = '@qcId';
    let qcData = null;

        document.addEventListener(
        "DOMContentLoaded",
        function () {

            loadQcDetails();

            document
                .getElementById("btnSaveInspection")
                .addEventListener(
                    "click",
                    saveInspection
                );

            document
                .getElementById("btnReleaseMaterial")
                .addEventListener(
                    "click",
                    releaseMaterial
                );
        }
    );

    async function loadQcDetails() {
        try {
            const response = await fetch(`/quality/qc-inspections/${qcId}`);
            const data = await response.json();

            if (!response.ok) {
                alert(data.message ?? "QC inspection not found.");
               window.location.href = "/quality/qc-inspections";
                return;
            }

            qcData = data;

            document.getElementById("qcTitle").innerText = data.qcNo;
            document.getElementById("qcNo").innerText = data.qcNo ?? "-";
            document.getElementById("incomingNo").innerText =
    data.incomingNo ?? "-";
            document.getElementById("poNo").innerText = data.poNo ?? "-";
            document.getElementById("supplierName").innerText = data.supplierName ?? "-";
            document.getElementById("qcStatus").innerHTML = renderStatus(data.status);

            document.getElementById("inspectionDate").value =
                data.inspectionDate ? data.inspectionDate.split("T")[0] : new Date().toISOString().split("T")[0];

            document.getElementById("remarks").value = data.remarks ?? "";

            renderLines(data.lines ?? []);
            setupButtons(data);

           } catch (error) {

        console.error("loadQcDetails error:", error);

        document.getElementById("qcLineBody").innerHTML = `
            <div class="alert alert-danger mb-0">
                Failed to load QC inspection.
            </div>
        `;
    }
    }

    function renderLines(lines) {
        const tbody = document.getElementById("qcLineBody");
        tbody.innerHTML = "";

        if (lines.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        No QC lines found.
                    </td>
                </tr>`;
            return;
        }

        const editable = qcData.status === "FOR_INSPECTION";

        lines.forEach(line => {
            tbody.innerHTML += `
                <tr data-qc-line-id="${line.qcLineId}" data-received-qty="${line.receivedQty}">
                    <td>${line.materialCode ?? ""}</td>
                    <td>${line.materialName ?? ""}</td>
                    <td class="text-end fw-semibold">${formatQty(line.receivedQty)}</td>

                    <td>
                        <input type="number"
                               class="form-control form-control-sm text-end accepted-qty"
                               min="0"
                               step="0.0001"
                               value="${line.acceptedQty ?? 0}"
                               ${editable ? "" : "disabled"}>
                    </td>

                    <td>
                        <input type="number"
                               class="form-control form-control-sm text-end rejected-qty"
                               min="0"
                               step="0.0001"
                               value="${line.rejectedQty ?? 0}"
                               ${editable ? "" : "disabled"}>
                    </td>

                    <td>
                        <input type="text"
                               class="form-control form-control-sm rejection-reason"
                               value="${line.rejectionReason ?? ""}"
                               placeholder="Reason if rejected"
                               ${editable ? "" : "disabled"}>
                    </td>

                    <td>
                        <input type="text"
                               class="form-control form-control-sm line-remarks"
                               value="${line.remarks ?? ""}"
                               ${editable ? "" : "disabled"}>
                    </td>

                    <td>${renderLineStatus(line.status)}</td>
                </tr>
            `;
        });
    }

            function setupButtons(qc) {

        const btnSave =
            document.getElementById(
                "btnSaveInspection"
            );

        const btnRelease =
            document.getElementById(
                "btnReleaseMaterial"
            );

        btnSave.classList.add("d-none");
        btnRelease.classList.add("d-none");
            btnRelease.disabled = false;
    btnRelease.innerText = "Release to RMW";



        // --------------------------------------------
        // QC still needs inspection
        // --------------------------------------------

        if (qc.status === "FOR_INSPECTION") {

            btnSave.classList.remove("d-none");

            return;
        }


        // --------------------------------------------
        // QC completed and material can be released
        // --------------------------------------------

        if (
            qc.status === "INSPECTED" &&
            (
                qc.decision === "ACCEPTED" ||
                qc.decision === "PARTIALLY_ACCEPTED"
            ) &&
            qc.quarantineId &&
            qc.quarantineStatus ===
                "WAITING_FOR_QA_RELEASE"
        ) {

            btnRelease.classList.remove("d-none");

            return;
        }


        // --------------------------------------------
        // Already released
        // --------------------------------------------

        if (
            qc.quarantineStatus === "RELEASED"
        ) {

            btnRelease.classList.remove("d-none");



            btnRelease.disabled = true;

            btnRelease.innerText =
                "Released to RMW";
        }


    }

        async function saveInspection() {

        if (!qcData) {
            alert("QC inspection data is not loaded.");
            return;
        }

        const lines = [];

        const rows = document.querySelectorAll(
            "#qcLineBody [data-qc-line-id]"
        );

        for (const row of rows) {

            const qcLineId =
                Number(row.dataset.qcLineId);

            const receivedQty =
                Number(row.dataset.receivedQty || 0);

            const lineData =
                qcData.lines?.find(
                    x =>
                        Number(x.qcLineId) ===
                        qcLineId
                );

            if (!lineData) {
                alert(
                    `QC line ${qcLineId} was not found.`
                );

                return;
            }

            // ============================================================
            // CURRENT SCREEN:
            // NON-LOT-TRACKED MATERIAL
            // ============================================================

            if (lineData.isLotTracked) {
                alert(
                    `${lineData.materialName} is lot-tracked. ` +
                    `Lot-tracked evaluation will be handled separately.`
                );

                return;
            }

            const acceptedQty =
                Number(
                    row.querySelector(
                        ".accepted-qty"
                    )?.value || 0
                );

            const rejectedQty =
                Number(
                    row.querySelector(
                        ".rejected-qty"
                    )?.value || 0
                );

            const rejectionReason =
                row.querySelector(
                    ".rejection-reason"
                )?.value.trim() ?? "";

            const lineRemarks =
                row.querySelector(
                    ".line-remarks"
                )?.value.trim() ?? "";


            // ============================================================
            // VALIDATION
            // ============================================================

            if (
                acceptedQty < 0 ||
                rejectedQty < 0
            ) {
                alert(
                    `${lineData.materialName}: ` +
                    `Accepted and rejected quantities cannot be negative.`
                );

                return;
            }

            if (
                Math.abs(
                    acceptedQty +
                    rejectedQty -
                    receivedQty
                ) > 0.0001
            ) {
                alert(
                    `${lineData.materialName}: ` +
                    `Accepted quantity plus rejected quantity ` +
                    `must equal received quantity ` +
                    `(${formatQty(receivedQty)}).`
                );

                return;
            }

            if (
                rejectedQty > 0 &&
                rejectionReason === ""
            ) {
                alert(
                    `${lineData.materialName}: ` +
                    `Rejection reason is required when ` +
                    `rejected quantity is greater than zero.`
                );

                row.querySelector(
                    ".rejection-reason"
                )?.focus();

                return;
            }


            // ============================================================
            // EXISTING INTERNAL QC LOT
            // In case this evaluation was previously saved.
            // ============================================================

            const existingLot =
                Array.isArray(lineData.lots) &&
                lineData.lots.length > 0
                    ? lineData.lots[0]
                    : null;


            // ============================================================
            // BUILD LINE + ONE INTERNAL NON-LOT ALLOCATION
            // ============================================================

            lines.push({

                qcLineId: qcLineId,

                remarks:
                    lineRemarks || null,

                lots: [
                    {
                        qcLineLotId:
                            existingLot?.qcLineLotId ??
                            null,

                        // Blank is correct for non-lot materials.
                        // Backend will generate its internal NOLOT key.
                        lotNo: "",

                        manufacturingDate:
                            null,

                        expirationDate:
                            null,

                        receivedQty:
                            receivedQty,

                        acceptedQty:
                            acceptedQty,

                        rejectedQty:
                            rejectedQty,

                        rejectionReason:
                            rejectionReason || null,

                        remarks:
                            lineRemarks || null
                    }
                ]
            });
        }


        if (lines.length === 0) {
            alert(
                "Raw Material Evaluation must contain at least one material."
            );

            return;
        }


        // ============================================================
        // PAYLOAD
        // ============================================================

        const payload = {

            inspectionDate:
                document.getElementById(
                    "inspectionDate"
                ).value || null,

            remarks:
                document.getElementById(
                    "remarks"
                ).value.trim() || null,

            lines: lines
        };


        console.log(
            "Raw Material Evaluation Payload:",
            payload
        );


        if (
            !confirm(
                "Complete this Raw Material Evaluation?"
            )
        ) {
            return;
        }


        const button =
            document.getElementById(
                "btnSaveInspection"
            );

        button.disabled = true;
        button.innerText =
            "Saving Evaluation...";


        try {

            const response = await fetch(
                `/quality/qc-inspections/${qcId}/save-inspection`,
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify(payload)
                }
            );

            const result =
                await response.json();


            if (!response.ok) {
                throw new Error(
                    result.message ??
                    "Failed to save Raw Material Evaluation."
                );
            }


            alert(
                result.message ??
                "Raw Material Evaluation saved successfully."
            );

            await loadQcDetails();
        }
        catch (error) {

            console.error(
                "saveInspection error:",
                error
            );

            alert(
                error.message ??
                "Failed to save Raw Material Evaluation."
            );

            button.disabled = false;
            button.innerText =
                "Save Inspection";
        }
    }

        async function releaseMaterial() {

        if (!qcData) {
            alert("QC inspection data is not loaded.");
            return;
        }

        if (!qcData.quarantineId) {
            alert(
                "No quarantine record was found for this QC inspection."
            );
            return;
        }

        const quarantineNo =
            qcData.quarantineNo ??
            "this material";

        const confirmed =
            confirm(
                `Release ${quarantineNo} to Raw Material Warehouse?\n\n` +
                `The accepted material will become available ` +
                `for warehouse weighing/counting.`
            );

        if (!confirmed) {
            return;
        }

        const btn =
            document.getElementById(
                "btnReleaseMaterial"
            );

        btn.disabled = true;
        btn.innerText = "Releasing...";

        try {

            const response =
                await fetch(
                    `/quality/qc-inspections/quarantine/${qcData.quarantineId}/release`,
                    {
                        method: "POST"
                    }
                );

            const result =
                await response.json();

            if (!response.ok) {
                throw new Error(
                    result.message ??
                    "Unable to release material."
                );
            }

            alert(
                result.message ??
                "Material released to Raw Material Warehouse."
            );

            await loadQcDetails();
        }
        catch (error) {

            console.error(error);

            alert(
                error.message ??
                "Unable to release material."
            );

            btn.disabled = false;
            btn.innerText = "Release to RMW";
        }
    }



       function renderStatus(status) {
        let badge = "bg-secondary";

        if (status === "FOR_INSPECTION")
            badge = "bg-info text-dark";

        if (status === "INSPECTED")
            badge = "bg-success";

        if (status === "COMMITTED")
            badge = "bg-dark";

        return `
            <span class="badge ${badge}">
                ${formatStatus(status)}
            </span>
        `;
    }

        function formatStatus(value) {
        if (!value)
            return "-";

        return String(value)
            .replaceAll("_", " ");
    }

        function renderLines(lines) {

        const container =
            document.getElementById("qcLineBody");

        container.innerHTML = "";

        if (lines.length === 0) {

            container.innerHTML = `
                <div class="text-center text-muted py-4">
                    No raw materials found.
                </div>
            `;

            return;
        }

        const editable =
            qcData.status === "FOR_INSPECTION";

        lines.forEach(line => {

            const lotNo =
                line.receivingLotNo || "N/A";

            const manufacturingDate =
                formatDate(line.receivingManufacturingDate);

            const expirationDate =
                formatDate(line.receivingExpirationDate);

            const manufacturer =
                line.manufacturerName || "N/A";

            const itemCount =
                line.receivingItemCount != null
                    ? formatQty(line.receivingItemCount)
                    : "N/A";

            const weight =
                line.receivingWeight != null
                    ? formatQty(line.receivingWeight)
                    : "N/A";

            const receivingRemarks =
                line.receivingRemarks || "N/A";

            container.innerHTML += `

                <div class="card border mb-4"
                     data-qc-line-id="${line.qcLineId}"
                     data-received-qty="${line.receivedQty}">

                    <div class="card-header bg-light">

                        <div class="d-flex justify-content-between
                                    align-items-center">

                            <div>
                                <strong>
                                    ${escapeHtml(line.materialCode)}
                                </strong>

                                <span class="ms-2">
                                    ${escapeHtml(line.materialName)}
                                </span>
                            </div>

                            <div>
                                ${renderLineStatus(line.status)}
                            </div>

                        </div>

                    </div>

                    <div class="card-body">

                        <!-- RECEIVING INFORMATION -->

                        <h6 class="fw-bold mb-3">
                            Receiving Information
                        </h6>

                        <div class="row g-3 mb-4">

                            <div class="col-md-3">
                                <div class="text-muted small">
                                    Manufacturer
                                </div>
                                <div class="fw-semibold">
                                    ${escapeHtml(manufacturer)}
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="text-muted small">
                                    Lot No.
                                </div>
                                <div class="fw-semibold">
                                    ${escapeHtml(lotNo)}
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="text-muted small">
                                    Manufacturing Date
                                </div>
                                <div class="fw-semibold">
                                    ${manufacturingDate}
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="text-muted small">
                                    Expiration Date
                                </div>
                                <div class="fw-semibold">
                                    ${expirationDate}
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="text-muted small">
                                    No. of Items
                                </div>
                                <div class="fw-semibold">
                                    ${itemCount}
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="text-muted small">
                                    Weight
                                </div>
                                <div class="fw-semibold">
                                    ${weight}
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="text-muted small">
                                    Received Quantity
                                </div>
                                <div class="fw-semibold">
                                    ${formatQty(line.receivedQty)}
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="text-muted small">
                                    Lot Tracked
                                </div>
                                <div class="fw-semibold">
                                    ${line.isLotTracked ? "Yes" : "No"}
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="text-muted small">
                                    Receiving Remarks
                                </div>
                                <div>
                                    ${escapeHtml(receivingRemarks)}
                                </div>
                            </div>

                        </div>


                        <hr>


                        <!-- EVALUATION -->

                        <h6 class="fw-bold mb-3">
                            Evaluation
                        </h6>

                        <div class="row g-3">

                            <div class="col-md-3">

                                <label class="form-label">
                                    Accepted Qty
                                </label>

                                <input type="number"
                                       class="form-control accepted-qty"
                                       min="0"
                                       step="0.0001"
                                       value="${line.acceptedQty ?? 0}"
                                       ${editable ? "" : "disabled"}>

                            </div>


                            <div class="col-md-3">

                                <label class="form-label">
                                    Rejected Qty
                                </label>

                                <input type="number"
                                       class="form-control rejected-qty"
                                       min="0"
                                       step="0.0001"
                                       value="${line.rejectedQty ?? 0}"
                                       ${editable ? "" : "disabled"}>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Rejection Reason
                                </label>

                                <input type="text"
                                       class="form-control rejection-reason"
                                       value="${escapeHtml(
                                           line.rejectionReason || ""
                                       )}"
                                       placeholder="Required if rejected"
                                       ${editable ? "" : "disabled"}>

                            </div>


                            <div class="col-12">

                                <label class="form-label">
                                    Evaluation Remarks
                                </label>

                                <textarea
                                    class="form-control line-remarks"
                                    rows="2"
                                    ${editable ? "" : "disabled"}
                                >${escapeHtml(
                                    line.remarks || ""
                                )}</textarea>

                            </div>

                        </div>

                    </div>

                </div>
            `;
        });
    }

    function formatQty(value) {
        return Number(value ?? 0).toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 4
        });
    }

        function formatDate(value) {

        if (!value)
            return "N/A";

        const date = new Date(value);

        if (isNaN(date.getTime()))
            return "N/A";

        return date.toLocaleDateString();
    }


    function escapeHtml(value) {

        if (value === null || value === undefined)
            return "";

        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

        function renderLineStatus(status) {

        let badge = "bg-secondary";

        if (status === "PENDING")
            badge = "bg-warning text-dark";

        if (status === "ACCEPTED")
            badge = "bg-success";

        if (status === "PARTIALLY_ACCEPTED")
            badge = "bg-warning text-dark";

        if (status === "REJECTED")
            badge = "bg-danger";

        return `
            <span class="badge ${badge}">
                ${formatStatus(status)}
            </span>
        `;
    }



</script>