    // =============================================================
    // OPEN INSPECTION
    // =============================================================

    async function openInspection(
        incomingReceivingId
    ) {

        resetModal();

        qaReceivingModal.show();

        try {

            const [
                detailResponse,
                numberResponse
            ] =
                await Promise.all([
                    fetch(
                        `/quality/qa-qc-receiving/incoming/${incomingReceivingId}`
                    ),

                    fetch(
                        "/quality/qa-qc-receiving/next-number"
                    )
                ]);


            const detailResult =
                await readJsonResponse(
                    detailResponse
                );

            const numberResult =
                await readJsonResponse(
                    numberResponse
                );


            if (!detailResponse.ok) {
                throw new Error(
                    detailResult.message ??
                    "Unable to load receiving details."
                );
            }


            currentReceiving =
                detailResult.data ??
                detailResult;


            document.getElementById(
                "incomingReceivingId"
            ).value =
                currentReceiving
                    .incomingReceivingId;


            document.getElementById(
                "incomingNo"
            ).value =
                currentReceiving
                    .incomingNo ?? "";


            document.getElementById(
                "poNo"
            ).value =
                currentReceiving
                    .poNo ?? "";


            document.getElementById(
                "supplierName"
            ).value =
                currentReceiving
                    .supplierName ?? "";


            document.getElementById(
                "inspectionNo"
            ).value =
                extractInspectionNumber(
                    numberResult
                );


            document.getElementById(
                "inspectionDate"
            ).value =
                getTodayDate();


            renderMaterials(
                currentReceiving.lines ?? []
            );

        }
        catch (error) {

            document.getElementById(
                "materialInspectionContainer"
            ).innerHTML = `
                <div class="alert alert-danger">
                    ${escapeHtml(
                        error.message ??
                        "Unable to load inspection form."
                    )}
                </div>
            `;
        }
    }


