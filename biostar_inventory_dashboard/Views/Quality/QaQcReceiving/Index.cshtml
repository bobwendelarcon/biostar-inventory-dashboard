@{
    ViewData["Title"] = "QA/QC Receiving Inspection";
}

<style>
    .summary-card {
        border: 0;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
    }

        .summary-card .count {
            font-size: 24px;
            font-weight: 700;
        }

    .inspection-header {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 16px;
    }

    .inspection-section {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        margin-bottom: 18px;
        overflow: hidden;
    }

    .inspection-section-title {
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        padding: 10px 14px;
        font-weight: 700;
    }

    .inspection-section-body {
        padding: 14px;
    }

    .material-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        margin-bottom: 18px;
        overflow: hidden;
    }

    .material-card-header {
        background: #f8f9fa;
        padding: 12px 16px;
        border-bottom: 1px solid #dee2e6;
    }

    .receiving-detail-box {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 15px;
    }

    .modal-dialog-qa-receiving {
        max-width: 96vw;
    }

    .result-select {
        min-width: 160px;
    }
</style>

<div class="container-fluid px-4 py-4">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="mb-4">
        <div class="text-muted small mb-1">
            Quality Control &gt; QA/QC Receiving Inspection
        </div>

        <h2 class="fw-bold mb-1">
            Raw Material Inspection & Receiving
        </h2>

        <div class="text-muted">
            Inspect materials received by Raw Material Warehouse
            before placing them under quarantine.
        </div>
    </div>


    <!-- ========================================================= -->
    <!-- SUMMARY -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card summary-card">
                <div class="card-body">
                    <div class="text-muted small">
                        For QA/QC Inspection
                    </div>

                    <div id="pendingCount"
                         class="count text-primary">
                        0
                    </div>
                </div>
            </div>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PENDING RECEIVING LIST -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="row g-2 mb-3">

                <div class="col-md-5">
                    <input id="searchInput"
                           type="text"
                           class="form-control"
                           placeholder="Search Incoming No, PO No, Supplier">
                </div>

                <div class="col-md-2">
                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            onclick="loadPending()">
                        Refresh
                    </button>
                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Incoming No</th>
                            <th>PO No</th>
                            <th>Supplier</th>
                            <th>Delivery Date</th>
                            <th>Received By</th>
                            <th>Verified By</th>
                            <th>Status</th>
                            <th class="text-end"
                                style="width:130px;">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody id="pendingBody">

                        <tr>
                            <td colspan="8"
                                class="text-center text-muted py-4">
                                Loading receiving records...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- QA/QC RECEIVING INSPECTION MODAL -->
<!-- ============================================================= -->

<div class="modal fade"
     id="qaReceivingModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-qa-receiving
                modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title fw-bold mb-1">
                        Raw Material Inspection and Receiving Form
                    </h5>

                    <div class="text-muted small">
                        QA/QC receiving inspection before quarantine
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <input type="hidden"
                       id="incomingReceivingId">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <div class="inspection-header mb-4">

                    <div class="row g-3">

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                Inspection No
                            </label>

                            <input id="inspectionNo"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                Incoming No
                            </label>

                            <input id="incomingNo"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                PO No
                            </label>

                            <input id="poNo"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                Supplier
                            </label>

                            <input id="supplierName"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                Inspection Date
                            </label>

                            <input id="inspectionDate"
                                   type="date"
                                   class="form-control">
                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- MATERIAL INSPECTIONS -->
                <!-- ================================================= -->

                <div id="materialInspectionContainer">

                    <div class="text-center text-muted py-5">
                        Loading inspection form...
                    </div>

                </div>


                <!-- ================================================= -->
                <!-- FINAL INFORMATION -->
                <!-- ================================================= -->

                <div class="card border-0 bg-light mt-4">

                    <div class="card-body">

                        <h5 class="fw-bold mb-3">
                            Inspection Information
                        </h5>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    QA/QC Received By
                                </label>

                                <input id="receivedBy"
                                       class="form-control"
                                       readonly>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    Noted By
                                </label>

                                <input id="notedBy"
                                       class="form-control"
                                       placeholder="Supervisor / Approver">
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-semibold">
                                    Overall Remarks
                                </label>

                                <textarea id="overallRemarks"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter overall QA/QC receiving findings"></textarea>
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <button type="button"
                        id="btnSaveInspection"
                        class="btn btn-success">
                    Complete QA/QC Receiving Inspection
                </button>

            </div>

        </div>

    </div>

</div>


<script>



    let pendingList = [];
    let currentReceiving = null;
    let qaReceivingModal = null;

        const loggedInFullName =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ViewBag.LoggedInFullName ?? ""
                ));

    const loggedInUserId =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        ViewBag.LoggedInUserId ?? ""
                ));


    document.addEventListener(
        "DOMContentLoaded",
        function () {

            qaReceivingModal =
                new bootstrap.Modal(
                    document.getElementById(
                        "qaReceivingModal"
                    )
                );

                document
    .getElementById("materialInspectionContainer")
    .addEventListener(
        "change",
        handleInspectionFieldChange
    );

            document
                .getElementById("searchInput")
                .addEventListener(
                    "input",
                    renderPending
                );

            document
                .getElementById("btnSaveInspection")
                .addEventListener(
                    "click",
                    saveInspection
                );

            loadPending();
        }
    );


    // =============================================================
    // LOAD PENDING RMW RECEIVINGS
    // =============================================================

    async function loadPending() {

        const tbody =
            document.getElementById("pendingBody");

        tbody.innerHTML = `
            <tr>
                <td colspan="8"
                    class="text-center text-muted py-4">
                    Loading receiving records...
                </td>
            </tr>
        `;

        try {

            const response =
                await fetch(
                    "/quality/qa-qc-receiving/pending"
                );

            const data =
                await readJsonResponse(response);

            if (!response.ok) {
                throw new Error(
                    data.message ??
                    "Unable to load receiving records."
                );
            }

            pendingList =
                Array.isArray(data)
                    ? data
                    : [];

            document.getElementById(
                "pendingCount"
            ).innerText =
                pendingList.length;

            renderPending();

        }
        catch (error) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="8"
                        class="text-center text-danger py-4">
                        ${escapeHtml(error.message)}
                    </td>
                </tr>
            `;
        }
    }


    // =============================================================
    // RENDER PENDING TABLE
    // =============================================================

    function renderPending() {

        const tbody =
            document.getElementById("pendingBody");

        const search =
            document.getElementById(
                "searchInput"
            )
            .value
            .trim()
            .toLowerCase();

        const filtered =
            pendingList.filter(x => {

                const searchable = [
                    x.incomingNo,
                    x.poNo,
                    x.supplierName,
                    x.receivedBy,
                    x.verifiedBy
                ]
                .filter(Boolean)
                .join(" ")
                .toLowerCase();

                return !search ||
                    searchable.includes(search);
            });


        tbody.innerHTML = "";


        if (filtered.length === 0) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="8"
                        class="text-center text-muted py-4">
                        No receiving records waiting for QA/QC inspection.
                    </td>
                </tr>
            `;

            return;
        }


        for (const row of filtered) {

            tbody.insertAdjacentHTML(
                "beforeend",
                `
                    <tr>

                        <td class="fw-semibold">
                            ${escapeHtml(
                                row.incomingNo ?? ""
                            )}
                        </td>

                        <td>
                            ${escapeHtml(
                                row.poNo ?? ""
                            )}
                        </td>

                        <td>
                            ${escapeHtml(
                                row.supplierName ?? ""
                            )}
                        </td>

                        <td>
                            ${formatDate(
                                row.deliveryDate
                            )}
                        </td>

                        <td>
                            ${escapeHtml(
                                row.receivedBy ?? "-"
                            )}
                        </td>

                        <td>
                            ${escapeHtml(
                                row.verifiedBy ?? "-"
                            )}
                        </td>

                        <td>
                            <span class="badge bg-warning text-dark">
                                For QA/QC Inspection
                            </span>
                        </td>

                        <td class="text-end">

                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    onclick="openInspection(
                                        ${Number(
                                            row.incomingReceivingId
                                        )}
                                    )">
                                Inspect
                            </button>

                        </td>

                    </tr>
                `
            );
        }
    }


    // =============================================================
    // OPEN INSPECTION
    // =============================================================

    async function openInspection(
        incomingReceivingId
    ) {

        resetModal();

        qaReceivingModal.show();

        try {

            const [
                detailResponse,
                numberResponse
            ] =
                await Promise.all([
                    fetch(
                        `/quality/qa-qc-receiving/incoming/${incomingReceivingId}`
                    ),

                    fetch(
                        "/quality/qa-qc-receiving/next-number"
                    )
                ]);


            const detailResult =
                await readJsonResponse(
                    detailResponse
                );

            const numberResult =
                await readJsonResponse(
                    numberResponse
                );


            if (!detailResponse.ok) {
                throw new Error(
                    detailResult.message ??
                    "Unable to load receiving details."
                );
            }


            currentReceiving =
                detailResult.data ??
                detailResult;


            document.getElementById(
                "incomingReceivingId"
            ).value =
                currentReceiving
                    .incomingReceivingId;


            document.getElementById(
                "incomingNo"
            ).value =
                currentReceiving
                    .incomingNo ?? "";


            document.getElementById(
                "poNo"
            ).value =
                currentReceiving
                    .poNo ?? "";


            document.getElementById(
                "supplierName"
            ).value =
                currentReceiving
                    .supplierName ?? "";


            document.getElementById(
                "inspectionNo"
            ).value =
                extractInspectionNumber(
                    numberResult
                );


            document.getElementById(
                "inspectionDate"
            ).value =
                getTodayDate();


            renderMaterials(
                currentReceiving.lines ?? []
            );

        }
        catch (error) {

            document.getElementById(
                "materialInspectionContainer"
            ).innerHTML = `
                <div class="alert alert-danger">
                    ${escapeHtml(
                        error.message ??
                        "Unable to load inspection form."
                    )}
                </div>
            `;
        }
    }


    // =============================================================
    // RENDER MATERIALS
    // =============================================================

    function renderMaterials(lines) {

        const container =
            document.getElementById(
                "materialInspectionContainer"
            );

        container.innerHTML = "";


        if (!Array.isArray(lines) ||
            lines.length === 0) {

            container.innerHTML = `
                <div class="alert alert-warning">
                    No received material lines found.
                </div>
            `;

            return;
        }


        for (const line of lines) {

            let lots =
                Array.isArray(line.lots)
                    ? line.lots
                    : [];


            /*
             * Every inspection row needs a receiving-detail
             * reference when one exists.
             *
             * For safety, if no receiving detail exists,
             * create one UI inspection entry with null lot ID.
             */
            if (lots.length === 0) {

                lots = [{
                    incomingReceivingLineLotId: null,
                    manufacturerName: null,
                    lotNo: null,
                    manufacturingDate: null,
                    expirationDate: null,
                    itemCount: null,
                    weight: null,
                    remarks: null
                }];
            }


            const detailsHtml =
                lots.map(
                    (lot, index) =>
                        renderInspectionDetail(
                            line,
                            lot,
                            index
                        )
                )
                .join("");


            container.insertAdjacentHTML(
                "beforeend",
                `
                    <div class="material-card">

                        <div class="material-card-header">

                            <div class="d-flex
                                        justify-content-between
                                        align-items-center">

                                <div>

                                    <div class="fw-bold">
                                        ${escapeHtml(
                                            line.materialName ?? ""
                                        )}
                                    </div>

                                    <div class="text-muted small">
                                        ${escapeHtml(
                                            line.materialCode ?? ""
                                        )}
                                    </div>

                                </div>

                                <div class="text-end">

                                    <div class="text-muted small">
                                        Delivered Quantity
                                    </div>

                                    <div class="fw-bold">
                                        ${formatQty(
                                            line.deliveredQty
                                        )}
                                        ${escapeHtml(
                                            line.uom ?? ""
                                        )}
                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="p-3">

                            ${detailsHtml}

                        </div>

                    </div>
                `
            );
        }

        initializeInspectionFields();
    }

        function initializeInspectionFields() {

        const rows =
            document.querySelectorAll(
                ".qa-inspection-row"
            );

        rows.forEach(row => {

            // =========================================================
            // ASSAY
            // =========================================================

            const assay =
                row.querySelector(
                    ".assay-result"
                );

            if (assay) {
                assay.dispatchEvent(
                    new Event(
                        "change",
                        { bubbles: true }
                    )
                );
            }


            // =========================================================
            // SOLUBILITY
            // =========================================================

            const solubility =
                row.querySelector(
                    ".solubility-result"
                );

            if (solubility) {
                solubility.dispatchEvent(
                    new Event(
                        "change",
                        { bubbles: true }
                    )
                );
            }


            // =========================================================
            // COLOR
            // =========================================================

            const color =
                row.querySelector(
                    ".color-result"
                );

            if (color) {
                color.dispatchEvent(
                    new Event(
                        "change",
                        { bubbles: true }
                    )
                );
            }


            // =========================================================
            // ODOR
            // =========================================================

            const odor =
                row.querySelector(
                    ".odor-result"
                );

            if (odor) {
                odor.dispatchEvent(
                    new Event(
                        "change",
                        { bubbles: true }
                    )
                );
            }


                const appearance =
        row.querySelector(".appearance-na");

    if (appearance) {
        appearance.dispatchEvent(
            new Event(
                "change",
                { bubbles: true }
            )
        );
    }

        });
    }


    // =============================================================
    // ONE RECEIVING DETAIL / LOT INSPECTION
    // =============================================================

    function renderInspectionDetail(
        line,
        lot,
        index
    ) {

        const lineId =
            Number(
                line.incomingReceivingLineId
            );

        const lotId =
            lot.incomingReceivingLineLotId ??
            "";


                const isLotTracked =
        line.isLotTracked === true;

    const lotTrackingHtml =
        isLotTracked
            ? `
                <div class="col-md-2">
                    <div class="text-muted small">
                        Lot Number
                    </div>

                    <div class="fw-semibold">
                        ${escapeHtml(
                            lot.lotNo ?? "-"
                        )}
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="text-muted small">
                        Manufacturing Date
                    </div>

                    <div class="fw-semibold">
                        ${formatDate(
                            lot.manufacturingDate
                        )}
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="text-muted small">
                        Expiration Date
                    </div>

                    <div class="fw-semibold">
                        ${formatDate(
                            lot.expirationDate
                        )}
                    </div>
                </div>
            `
            : "";


        return `
            <div class="qa-inspection-row"
                 data-incoming-line-id="${lineId}"
                 data-incoming-lot-id="${lotId}">


                <!-- ================================================ -->
                <!-- RECEIVING INFORMATION -->
                <!-- ================================================ -->

                  <div class="receiving-detail-box">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div class="fw-bold">
                Receiving Details
                ${index + 1}
            </div>

            <span class="badge ${
                isLotTracked
                    ? "bg-primary"
                    : "bg-secondary"
            }">
                ${
                    isLotTracked
                        ? "Lot Tracked"
                        : "Non-Lot Tracked"
                }
            </span>

        </div>

        <div class="row g-3">

            <div class="col-md-3">
                <div class="text-muted small">
                    Manufacturer
                </div>

                <div class="fw-semibold">
                    ${escapeHtml(
                        lot.manufacturerName ?? "-"
                    )}
                </div>
            </div>

            ${lotTrackingHtml}

            <div class="col-md-2">
                <div class="text-muted small">
                    No. Item
                </div>

                <div class="fw-semibold">
                    ${formatNullableQty(
                        lot.itemCount
                    )}
                </div>
            </div>

            <div class="col-md-2">
                <div class="text-muted small">
                    Weight
                </div>

                <div class="fw-semibold">
                    ${formatNullableQty(
                        lot.weight
                    )}
                </div>
            </div>

        </div>

    </div>

                <!-- ================================================ -->
                <!-- 1 APPEARANCE OF PACKAGING -->
                <!-- ================================================ -->

                <div class="inspection-section">

                    <div class="inspection-section-title">
                        1. Appearance of Packaging
                    </div>

                    <div class="inspection-section-body">

                        <div class="row g-3">

                            ${renderYesNoCheck(
                                "packaging-clean",
                                "Clean"
                            )}

                            ${renderYesNoCheck(
                                "readable-label",
                                "Readable Label"
                            )}

                            ${renderYesNoCheck(
                                "properly-sealed",
                                "Closed and Properly Sealed"
                            )}

                            ${renderYesNoCheck(
                                "no-deterioration",
                                "No Sign of Deterioration"
                            )}

                        </div>

                    </div>

                </div>


                <!-- ================================================ -->
                <!-- 2 RAW MATERIAL APPEARANCE -->
                <!-- ================================================ -->

                <div class="inspection-section">

                    <div class="inspection-section-title">
                        2. Appearance of Raw Material
                    </div>

                    <div class="inspection-section-body">

                        <div class="row g-3">


                            ${renderYesNoCheck(
                                "no-foreign-matter",
                                "No Foreign Matter Observed"
                            )}


                            ${renderYesNoCheck(
                                "no-infestation",
                                "No Infestation"
                            )}


                            <div class="col-md-3">

                                <label class="form-label">
                                    Appearance
                                </label>

                                <select class="form-select appearance-na">

                                    <option value="false">
                                        Applicable
                                    </option>

                                    <option value="true">
                                        Not Applicable
                                    </option>

                                </select>

                            </div>


                            <div class="col-md-3">

                                <label class="form-label">
                                    Powder - No Lump Formation
                                </label>

                                ${renderOptionalResultSelect(
                                    "powder-no-lump"
                                )}

                            </div>


                            <div class="col-md-3">

                                <label class="form-label">
                                    Powder - Good Flowability
                                </label>

                                ${renderOptionalResultSelect(
                                    "powder-good-flowability"
                                )}

                            </div>


                            <div class="col-md-3">

                                <label class="form-label">
                                    Liquid - No Solidification
                                </label>

                                ${renderOptionalResultSelect(
                                    "liquid-no-solidification"
                                )}

                            </div>


                            <div class="col-md-3">

                                <label class="form-label">
                                    Liquid - No Precipitation
                                </label>

                                ${renderOptionalResultSelect(
                                    "liquid-no-precipitation"
                                )}

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================ -->
                <!-- 3 COLOR -->
                <!-- ================================================ -->

                <div class="inspection-section">

                    <div class="inspection-section-title">
                        3. Color
                    </div>

                    <div class="inspection-section-body">

                        <div class="row g-3">

                            <div class="col-md-4">

                                <label class="form-label">
                                    Result
                                </label>

                                ${renderComplianceSelect(
                                    "color-result"
                                )}

                            </div>

                            <div class="col-md-8">

                                <label class="form-label">
                                    Actual Color
                                </label>

                                <input type="text"
                                       class="form-control actual-color"
                                       placeholder="Observed color">

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================ -->
                <!-- 4 ODOR -->
                <!-- ================================================ -->

                <div class="inspection-section">

                    <div class="inspection-section-title">
                        4. Odor
                    </div>

                    <div class="inspection-section-body">

                        <div class="row g-3">

                            <div class="col-md-4">

                                <label class="form-label">
                                    Result
                                </label>

                                ${renderComplianceSelect(
                                    "odor-result"
                                )}

                            </div>

                            <div class="col-md-8">

                                <label class="form-label">
                                    Actual Odor
                                </label>

