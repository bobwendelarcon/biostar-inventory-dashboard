    function setDetailText(id, value) {

        const element =
            document.getElementById(id);

        if (!element)
            return;

        element.textContent =
            value === null ||
            value === undefined ||
            value === ""
                ? "-"
                : value;
    }


    function detailItem(label, value) {

        const displayValue =
            value === null ||
            value === undefined ||
            value === ""
                ? "-"
                : value;

        return `
            <div class="col-md-3">

                <small class="text-muted d-block">
                    ${escapeHtml(label)}
                </small>

                <span>
                    ${escapeHtml(
                        String(displayValue)
                    )}
                </span>

            </div>
        `;
    }


    function checkRow(label, value) {

        return `
            <tr>

                <td>
                    ${escapeHtml(label)}
                </td>

                <td style="width:180px;">
                    ${
                        value === true
                            ? `<span class="badge bg-success">YES</span>`
                            : `<span class="badge bg-danger">NO</span>`
                    }
                </td>

            </tr>
        `;
    }


    function nullableCheckRow(label, value) {

        let badge;

        if (value === true) {

            badge =
                `<span class="badge bg-success">YES</span>`;

        }
        else if (value === false) {

            badge =
                `<span class="badge bg-danger">NO</span>`;

        }
        else {

            badge =
                `<span class="badge bg-secondary">N/A</span>`;
        }


        return `
            <tr>

                <td>
                    ${escapeHtml(label)}
                </td>

                <td style="width:180px;">
                    ${badge}
                </td>

            </tr>
        `;
    }


    function qualityResultSection(
        title,
        result,
        details
    ) {

        const normalized =
            (result ?? "")
                .toString()
                .toUpperCase();


        let badgeClass =
            "bg-secondary";


        if (normalized === "COMPLIANT") {

            badgeClass =
                "bg-success";

        }
        else if (
            normalized === "NON_COMPLIANT" ||
            normalized === "FAILED"
        ) {

            badgeClass =
                "bg-danger";
        }


        const displayResult =
            result || "N/A";


        const detailHtml =
            (details ?? [])
                .map(item => {

                    const value =
                        item.value === null ||
                        item.value === undefined ||
                        item.value === ""
                            ? "-"
                            : item.value;


                    return `

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                ${escapeHtml(item.label)}
                            </small>

                            <span>
                                ${escapeHtml(
                                    String(value)
                                )}
                            </span>

                        </div>

                    `;

                })
                .join("");


        return `

            <div class="mb-4">

                <h6 class="fw-semibold">
                    ${escapeHtml(title)}
                </h6>

                <div class="row g-3">

                    <div class="col-md-3">

                        <small class="text-muted d-block">
                            Result
                        </small>

                        <span class="badge ${badgeClass}">
                            ${escapeHtml(displayResult)}
                        </span>

                    </div>

                    ${detailHtml}

                </div>

            </div>
        `;
    }


    function buildResultBadge(status) {

        const normalized =
            (status ?? "")
                .toString()
                .toUpperCase();


        if (normalized === "PASSED") {

            return `
                <span class="badge bg-success">
                    PASSED
                </span>
            `;
        }


        if (normalized === "FAILED") {

            return `
                <span class="badge bg-danger">
                    FAILED
                </span>
            `;
        }


        return `
            <span class="badge bg-secondary">
                ${escapeHtml(status || "-")}
            </span>
        `;
    }


    function buildStageBadge(status) {

        const normalized =
            (status ?? "")
                .toString()
                .toUpperCase();


        let badgeClass =
            "bg-secondary";


        if (
            normalized === "QUARANTINED" ||
            normalized === "COMPLETED" ||
            normalized === "COMMITTED"
        ) {
            badgeClass =
                "bg-success";
        }
        else if (
            normalized.includes("FAILED") ||
            normalized.includes("REJECT")
        ) {
            badgeClass =
                "bg-danger";
        }
        else if (
            normalized.includes("PROCESS") ||
            normalized.includes("WEIGH") ||
            normalized.includes("COUNT") ||
            normalized.includes("STICKER")
        ) {
            badgeClass =
                "bg-warning text-dark";
        }


        const display =
            status
                ? status
                    .replaceAll("_", " ")
                : "-";


        return `
            <span class="badge ${badgeClass}">
                ${escapeHtml(display)}
            </span>
        `;
    }


    function formatHistoryDate(value) {

        if (!value)
            return "-";

        const date =
            new Date(value);

        if (Number.isNaN(date.getTime()))
            return "-";

        return date.toLocaleDateString();
    }


    function formatHistoryDateTime(value) {

        if (!value)
            return "-";

        const date =
            new Date(value);

        if (Number.isNaN(date.getTime()))
            return "-";

        return date.toLocaleString();
    }


    function formatQty(value) {

        const number =
            Number(value ?? 0);

        if (!Number.isFinite(number))
            return "0";

        return number.toLocaleString(
            undefined,
            {
                maximumFractionDigits: 4
            }
        );
    }


    function formatNullableQty(value) {

        if (
            value === null ||
            value === undefined ||
            value === ""
        ) {
            return "-";
        }

        const number =
            Number(value);

        if (!Number.isFinite(number))
            return "-";

        return number.toLocaleString(
            undefined,
            {
                maximumFractionDigits: 4
            }
        );
    }


