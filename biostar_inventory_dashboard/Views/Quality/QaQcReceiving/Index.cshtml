@{
    ViewData["Title"] = "QA/QC Receiving Inspection";
}

<style>
    .summary-card {
        border: 0;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
    }

        .summary-card .count {
            font-size: 24px;
            font-weight: 700;
        }

    .inspection-header {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 16px;
    }

    .inspection-section {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        margin-bottom: 18px;
        overflow: hidden;
    }

    .inspection-section-title {
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        padding: 10px 14px;
        font-weight: 700;
    }

    .inspection-section-body {
        padding: 14px;
    }

    .material-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        margin-bottom: 18px;
        overflow: hidden;
    }

    .material-card-header {
        background: #f8f9fa;
        padding: 12px 16px;
        border-bottom: 1px solid #dee2e6;
    }

    .receiving-detail-box {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 15px;
    }

    .modal-dialog-qa-receiving {
        max-width: 96vw;
    }

    .result-select {
        min-width: 160px;
    }
</style>

<div class="container-fluid px-4 py-4">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="mb-4">
        <div class="text-muted small mb-1">
            Quality Control &gt; QA/QC Receiving Inspection
        </div>

        <h2 class="fw-bold mb-1">
            Raw Material Inspection & Receiving
        </h2>

        <div class="text-muted">
            Inspect materials received by Raw Material Warehouse
            before placing them under quarantine.
        </div>
    </div>


    <!-- ========================================================= -->
    <!-- SUMMARY -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- Pending -->
        <div class="col-md-3">
            <div class="card summary-card">
                <div class="card-body">

                    <div class="text-muted small">
                        For QA/QC Inspection
                    </div>

                    <div id="pendingCount"
                         class="count text-primary">
                        0
                    </div>

                </div>
            </div>
        </div>

        <!-- Completed -->
        <div class="col-md-3">
            <div class="card summary-card">
                <div class="card-body">

                    <div class="text-muted small">
                        Completed Inspections
                    </div>

                    <div id="historyCount"
                         class="count text-success">
                        0
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PENDING RECEIVING LIST -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="row g-2 mb-3">

                <div class="col-md-5">
                    <input id="searchInput"
                           type="text"
                           class="form-control"
                           placeholder="Search Incoming No, PO No, Supplier">
                </div>

                <div class="col-md-2">
                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            onclick="loadPending()">
                        Refresh
                    </button>
                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Incoming No</th>
                            <th>PO No</th>
                            <th>Printed PO No</th>
                            <th>Supplier</th>
                            <th>Delivery Date</th>
                            <th>Received By</th>
                            <th>Verified By</th>
                            <th>Status</th>
                            <th class="text-end"
                                style="width:130px;">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody id="pendingBody">

                        <tr>
                            <td colspan="9"
                                class="text-center text-muted py-4">
                                Loading receiving records...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- QA/QC INSPECTION HISTORY -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-header bg-white border-0 pt-3 px-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        QA/QC Inspection History
                    </h5>

                    <div class="text-muted small">
                        Completed raw material receiving inspections
                    </div>
                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="row g-2 mb-3">

                <div class="col-md-5">

                    <input id="historySearchInput"
                           type="text"
                           class="form-control"
                           placeholder="Search Inspection No, Incoming No, PO No, Supplier">

                </div>

                <div class="col-md-2">

                    <select id="historyStatusFilter"
                            class="form-select">

                        <option value="">
                            All Results
                        </option>

                        <option value="PASSED">
                            Passed
                        </option>

                        <option value="FAILED">
                            Failed
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            onclick="loadHistory()">
                        Refresh
                    </button>

                </div>

            </div>


            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Inspection No</th>
                            <th>Incoming No</th>
                            <th>PO No</th>
                            <th>Printed PO No</th>
                            <th>Supplier</th>
                            <th>Inspection Date</th>
                            <th>Inspected By</th>
                            <th>Result</th>
                            <th>Current Stage</th>
                            <th class="text-center">Action</th>
                        </tr>

                    </thead>

                    <tbody id="historyBody">

                        <tr>
                            <td colspan="10"
                                class="text-center text-muted py-4">
                                Loading inspection history...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- QA/QC RECEIVING INSPECTION MODAL -->
<!-- ============================================================= -->

<div class="modal fade"
     id="qaReceivingModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-qa-receiving
                modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title fw-bold mb-1">
                        Raw Material Inspection and Receiving Form
                    </h5>

                    <div class="text-muted small">
                        QA/QC receiving inspection before quarantine
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <input type="hidden"
                       id="incomingReceivingId">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <div class="inspection-header mb-4">

                    <div class="row g-3">

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                Inspection No
                            </label>

                            <input id="inspectionNo"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                Incoming No
                            </label>

                            <input id="incomingNo"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label fw-semibold">
                                PO No
                            </label>

                            <input id="poNo"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                Supplier
                            </label>

                            <input id="supplierName"
                                   class="form-control"
                                   readonly>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                Inspection Date
                            </label>

                            <input id="inspectionDate"
                                   type="date"
                                   class="form-control">
                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- MATERIAL INSPECTIONS -->
                <!-- ================================================= -->

                <div id="materialInspectionContainer">

                    <div class="text-center text-muted py-5">
                        Loading inspection form...
                    </div>

                </div>


                <!-- ================================================= -->
                <!-- FINAL INFORMATION -->
                <!-- ================================================= -->

                <div class="card border-0 bg-light mt-4">

                    <div class="card-body">

                        <h5 class="fw-bold mb-3">
                            Inspection Information
                        </h5>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    QA/QC Received By
                                </label>

                                <input id="receivedBy"
                                       class="form-control"
                                       readonly>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    Noted By
                                </label>

                                <input id="notedBy"
                                       class="form-control"
                                       placeholder="Supervisor / Approver">
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-semibold">
                                    Overall Remarks
                                </label>

                                <textarea id="overallRemarks"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter overall QA/QC receiving findings"></textarea>
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <button type="button"
                        id="btnSaveInspection"
                        class="btn btn-success">
                    Complete QA/QC Receiving Inspection
                </button>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================ -->
<!-- COMPLETED QA/QC INSPECTION DETAILS MODAL -->
<!-- ============================================================ -->

<div class="modal fade"
     id="qaQcHistoryDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title mb-0">
                        QA/QC Receiving Inspection Details
                    </h5>

                    <small class="text-muted">
                        Completed Raw Material Inspection
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <!-- LOADING -->
                <div id="historyDetailsLoading"
                     class="text-center py-5">

                    <div class="spinner-border text-primary mb-3"
                         role="status">
                    </div>

                    <div class="text-muted">
                        Loading inspection details...
                    </div>

                </div>


                <!-- ERROR -->
                <div id="historyDetailsError"
                     class="alert alert-danger d-none">
                </div>


                <!-- CONTENT -->
                <div id="historyDetailsContent"
                     class="d-none">

                    <!-- ======================================== -->
                    <!-- HEADER INFORMATION -->
                    <!-- ======================================== -->

                    <div class="card mb-3">

                        <div class="card-header fw-semibold">
                            Inspection Information
                        </div>

                        <div class="card-body">

                            <div class="row g-3">

                                <div class="col-md-3">
                                    <small class="text-muted d-block">
                                        Inspection No
                                    </small>
                                    <span id="detailInspectionNo"
                                          class="fw-semibold">
                                    </span>
                                </div>

                                <div class="col-md-3">
                                    <small class="text-muted d-block">
                                        Incoming No
                                    </small>
                                    <span id="detailIncomingNo"></span>
                                </div>

                                <div class="col-md-3">
                                    <small class="text-muted d-block">
                                        PO No
                                    </small>
                                    <span id="detailPoNo"></span>
                                </div>

                                <div class="col-md-3">
                                    <small class="text-muted d-block">
                                        Printed PO No
                                    </small>
                                    <span id="detailPrintedPoNo"></span>
                                </div>


                                <div class="col-md-6">
                                    <small class="text-muted d-block">
                                        Supplier
                                    </small>
                                    <span id="detailSupplier"></span>
                                </div>

                                <div class="col-md-3">
                                    <small class="text-muted d-block">
                                        Inspection Date
                                    </small>
                                    <span id="detailInspectionDate"></span>
                                </div>

                                <div class="col-md-3">
                                    <small class="text-muted d-block">
                                        Delivery Date
                                    </small>
                                    <span id="detailDeliveryDate"></span>
                                </div>


                                <div class="col-md-3">
                                    <small class="text-muted d-block">
                                        SI / DR No
                                    </small>
                                    <span id="detailSiDrNo"></span>
                                </div>

                                <div class="col-md-3">
                                    <small class="text-muted d-block">
                                        Result
                                    </small>
                                    <span id="detailOverallStatus"></span>
                                </div>

                                <div class="col-md-3">
                                    <small class="text-muted d-block">
                                        Current Stage
                                    </small>
                                    <span id="detailCurrentStage"></span>
                                </div>

                                <div class="col-md-3">
                                    <small class="text-muted d-block">
                                        Created At
                                    </small>
                                    <span id="detailCreatedAt"></span>
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ======================================== -->
                    <!-- MATERIAL INSPECTIONS -->
                    <!-- ======================================== -->

                    <div class="d-flex justify-content-between
                                align-items-center mb-2">

                        <h6 class="mb-0 fw-semibold">
                            Material Inspection Details
                        </h6>

                        <span id="detailMaterialCount"
                              class="badge bg-secondary">
                        </span>

                    </div>

                    <div id="historyMaterialDetails">
                    </div>


                    <!-- ======================================== -->
                    <!-- APPROVAL / REMARKS -->
                    <!-- ======================================== -->

                    <div class="card mt-3">

                        <div class="card-header fw-semibold">
                            Inspection Summary
                        </div>

                        <div class="card-body">

                            <div class="row g-3">

                                <div class="col-12">
                                    <small class="text-muted d-block">
                                        Overall Remarks
                                    </small>

                                    <div id="detailOverallRemarks"
                                         class="border rounded p-2 bg-light"
                                         style="min-height:45px;">
                                    </div>
                                </div>


                                <div class="col-md-4">
                                    <small class="text-muted d-block">
                                        Inspected By
                                    </small>
                                    <span id="detailInspectedBy"></span>
                                </div>

                                <div class="col-md-4">
                                    <small class="text-muted d-block">
                                        Received By
                                    </small>
                                    <span id="detailReceivedBy"></span>
                                </div>

                                <div class="col-md-4">
                                    <small class="text-muted d-block">
                                        Noted By
                                    </small>
                                    <span id="detailNotedBy"></span>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

            </div>

        </div>

    </div>

</div>


<script>



       let pendingList = [];
    let historyList = [];

    let currentReceiving = null;
    let qaReceivingModal = null;



        const loggedInFullName =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ViewBag.LoggedInFullName ?? ""
                ));

    const loggedInUserId =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        ViewBag.LoggedInUserId ?? ""
                ));


    document.addEventListener(
        "DOMContentLoaded",
        function () {

            qaReceivingModal =
                new bootstrap.Modal(
                    document.getElementById(
                        "qaReceivingModal"
                    )
                );

                document
    .getElementById("materialInspectionContainer")
    .addEventListener(
        "change",
        handleInspectionFieldChange
    );

            document
                .getElementById("searchInput")
                .addEventListener(
                    "input",
                    renderPending
                );

            document
                .getElementById("btnSaveInspection")
                .addEventListener(
                    "click",
                    saveInspection
                );

                    document
        .getElementById("historySearchInput")
        .addEventListener(
            "input",
            renderHistory
        );

    document
        .getElementById("historyStatusFilter")
        .addEventListener(
            "change",
            renderHistory
        );

                loadPending();
    loadHistory();
        }
    );
        // =============================================================
    // LOAD QA/QC INSPECTION HISTORY
    // =============================================================

    async function loadHistory() {

        const tbody =
            document.getElementById("historyBody");

        tbody.innerHTML = `
            <tr>
                <td colspan="10"
                    class="text-center text-muted py-4">
                    Loading inspection history...
                </td>
            </tr>
        `;

        try {

            const response =
                await fetch(
                    "/quality/qa-qc-receiving/history"
                );

            const data =
                await readJsonResponse(response);

            if (!response.ok) {
                throw new Error(
                    data.message ??
                    "Unable to load inspection history."
                );
            }

            historyList =
                Array.isArray(data)
                    ? data
                    : [];

            document.getElementById(
                "historyCount"
            ).innerText =
                historyList.length;

            renderHistory();
        }
        catch (error) {

            historyList = [];

            document.getElementById(
                "historyCount"
            ).innerText = "0";

            tbody.innerHTML = `
                <tr>
                    <td colspan="10"
                        class="text-center text-danger py-4">
                        ${escapeHtml(error.message)}
                    </td>
                </tr>
            `;
        }
    }


        // ============================================================
    // VIEW COMPLETED QA/QC INSPECTION DETAILS
    // ============================================================

    async function viewInspectionDetails(qaReceivingId) {

        if (!qaReceivingId)
            return;

        const modalElement =
            document.getElementById(
                "qaQcHistoryDetailsModal"
            );

        const modal =
            bootstrap.Modal.getOrCreateInstance(
                modalElement
            );


        const loading =
            document.getElementById(
                "historyDetailsLoading"
            );

        const error =
            document.getElementById(
                "historyDetailsError"
            );

        const content =
            document.getElementById(
                "historyDetailsContent"
            );


        // RESET
        loading.classList.remove("d-none");
        error.classList.add("d-none");
        content.classList.add("d-none");

        error.textContent = "";

        document.getElementById(
            "historyMaterialDetails"
        ).innerHTML = "";


        modal.show();


        try {

            const response =
                await fetch(
                    `/quality/qa-qc-receiving/history/${qaReceivingId}`,
                    {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );


            const result =
                await response.json();


            if (!response.ok) {

                throw new Error(
                    result?.message ??
                    "Unable to load inspection details."
                );
            }


            const data =
                result?.data;


            if (!data) {

                throw new Error(
                    "Inspection details were not returned."
                );
            }


            renderHistoryDetails(data);


            loading.classList.add("d-none");
            content.classList.remove("d-none");

        }
        catch (err) {

            console.error(
                "QA/QC history details error:",
                err
            );

            loading.classList.add("d-none");

            error.textContent =
                err?.message ??
                "Unable to load inspection details.";

            error.classList.remove("d-none");
        }
    }

        // ============================================================
    // RENDER COMPLETED INSPECTION DETAILS
    // ============================================================

    function renderHistoryDetails(data) {

        setDetailText(
            "detailInspectionNo",
            data.inspectionNo
        );

        setDetailText(
            "detailIncomingNo",
            data.incomingNo
        );

        setDetailText(
            "detailPoNo",
            data.poNo
        );

        setDetailText(
            "detailPrintedPoNo",
            data.printedPoNo
        );

        setDetailText(
            "detailSupplier",
            data.supplierName
        );

        setDetailText(
            "detailInspectionDate",
            formatHistoryDate(
                data.inspectionDate
            )
        );

        setDetailText(
            "detailDeliveryDate",
            formatHistoryDate(
                data.deliveryDate
            )
        );

        setDetailText(
            "detailSiDrNo",
            data.siDrNo
        );

        setDetailText(
            "detailCreatedAt",
            formatHistoryDateTime(
                data.createdAt
            )
        );


        // ========================================================
        // OVERALL STATUS
        // ========================================================

        const overallStatus =
            document.getElementById(
                "detailOverallStatus"
            );

        overallStatus.innerHTML =
            buildResultBadge(
                data.status
            );


        // ========================================================
        // CURRENT STAGE
        // ========================================================

        const currentStage =
            document.getElementById(
                "detailCurrentStage"
            );

        currentStage.innerHTML =
            buildStageBadge(
                data.currentReceivingStatus
            );


        // ========================================================
        // PEOPLE / REMARKS
        // ========================================================

        setDetailText(
            "detailInspectedBy",
            data.inspectedBy
        );

        setDetailText(
            "detailReceivedBy",
            data.receivedBy
        );

        setDetailText(
            "detailNotedBy",
            data.notedBy
        );

        setDetailText(
            "detailOverallRemarks",
            data.remarks
        );


            // ============================================================
    // RENDER MATERIAL INSPECTION LINES
    // ============================================================

    function renderHistoryMaterialLines(lines) {

        const container =
            document.getElementById(
                "historyMaterialDetails"
            );


        if (!lines.length) {

            container.innerHTML = `
                <div class="alert alert-light border text-muted">
                    No material inspection details found.
                </div>
            `;

            return;
        }


        container.innerHTML =
            lines.map((line, index) => {

                const materialStatus =
                    buildResultBadge(
                        line.status
                    );


                const appearanceValue =
                    line.appearanceNotApplicable
                        ? `<span class="badge bg-secondary">N/A</span>`
                        : `<span class="badge bg-success">APPLICABLE</span>`;


                return `

                    <div class="card mb-3">

                        <!-- ====================================== -->
                        <!-- MATERIAL HEADER -->
                        <!-- ====================================== -->

                        <div class="card-header">

                            <div class="d-flex
                                        justify-content-between
                                        align-items-center
                                        flex-wrap gap-2">

                                <div>

                                    <span class="fw-semibold">
                                        Material ${index + 1}
                                    </span>

                                    <span class="ms-2">
                                        ${escapeHtml(
                                            line.materialCode ?? "-"
                                        )}
                                    </span>

                                    <span class="text-muted ms-1">
                                        -
                                        ${escapeHtml(
                                            line.materialName ?? "-"
                                        )}
                                    </span>

                                </div>

                                <div>
                                    ${materialStatus}
                                </div>

                            </div>

                        </div>


                        <div class="card-body">

                            <!-- ================================== -->
                            <!-- RECEIVING DETAILS -->
                            <!-- ================================== -->

                            <h6 class="fw-semibold mb-3">
                                Receiving / Lot Information
                            </h6>


                            <div class="row g-3 mb-4">

                                ${detailItem(
                                    "Scheduled Qty",
                                    formatQty(
                                        line.scheduledQty
                                    )
                                )}

                                ${detailItem(
                                    "Delivered Qty",
                                    formatQty(
                                        line.deliveredQty
                                    )
                                )}

                                ${detailItem(
                                    "UOM",
                                    line.uom
                                )}

                                ${detailItem(
                                    "Tare Weight",
                                    formatNullableQty(
                                        line.tareWeight
                                    )
                                )}


                                ${detailItem(
                                    "Manufacturer",
                                    line.manufacturerName
                                )}

