        function handleInspectionFieldChange(event) {

        const target = event.target;

        if (!target)
            return;

        const row =
            target.closest(".qa-inspection-row");

        if (!row)
            return;


        // =========================================================
        // ASSAY
        // =========================================================

        if (target.classList.contains("assay-result")) {

            const isNA =
                target.value === "N/A";

            const coa =
                row.querySelector(
                    ".coa-assay-result"
                );

            const specification =
                row.querySelector(
                    ".bnpi-assay-specification"
                );

            coa.disabled = isNA;
            specification.disabled = isNA;

            if (isNA) {
                coa.value = "";
                specification.value = "";
            }
        }


        // =========================================================
        // SOLUBILITY
        // =========================================================

        if (target.classList.contains("solubility-result")) {

            const isNA =
                target.value === "N/A";

            const test =
                row.querySelector(
                    ".solubility-test"
                );

            test.disabled = isNA;

            if (isNA) {
                test.value = "";
            }
        }



            // =========================================================
    // COLOR
    // =========================================================

    if (target.classList.contains("color-result")) {

        const isNA =
            target.value === "N/A";

        const actualColor =
            row.querySelector(".actual-color");

        if (actualColor) {
            actualColor.disabled = isNA;

            if (isNA)
                actualColor.value = "";
        }
    }


    // =========================================================
    // ODOR
    // =========================================================

    if (target.classList.contains("odor-result")) {

        const isNA =
            target.value === "N/A";

        const actualOdor =
            row.querySelector(".actual-odor");

        if (actualOdor) {
            actualOdor.disabled = isNA;

            if (isNA)
                actualOdor.value = "";
        }
    }


  


        // =========================================================
    // RAW MATERIAL APPEARANCE
    // =========================================================

    if (target.classList.contains("appearance-na")) {

        const isNA =
            target.value === "true";

        const noForeignMatter =
            row.querySelector(".no-foreign-matter");

        const noInfestation =
            row.querySelector(".no-infestation");

        const powderNoLump =
            row.querySelector(".powder-no-lump");

        const powderGoodFlowability =
            row.querySelector(".powder-good-flowability");

        const liquidNoSolidification =
            row.querySelector(".liquid-no-solidification");

        const liquidNoPrecipitation =
            row.querySelector(".liquid-no-precipitation");


        if (noForeignMatter) {
            noForeignMatter.disabled = isNA;

            if (isNA)
                noForeignMatter.value = "true";
        }

        if (noInfestation) {
            noInfestation.disabled = isNA;

            if (isNA)
                noInfestation.value = "true";
        }

        const optionalFields = [
            powderNoLump,
            powderGoodFlowability,
            liquidNoSolidification,
            liquidNoPrecipitation
        ];

        optionalFields.forEach(field => {

            if (!field)
                return;

            field.disabled = isNA;

            if (isNA)
                field.value = "";
        });
    }


      }


    // =============================================================
    // SAVE
    // =============================================================

    async function saveInspection() {

        if (!currentReceiving)
            return;


        const rows =
            document.querySelectorAll(
                ".qa-inspection-row"
            );


        if (rows.length === 0) {

            alert(
                "No inspection lines found."
            );

            return;
        }


        const lines = [];


        for (const row of rows) {

            lines.push({

                incomingReceivingLineId:
                    Number(
                        row.dataset.incomingLineId
                    ),

                incomingReceivingLineLotId:
                    row.dataset.incomingLotId
                        ? Number(
                            row.dataset.incomingLotId
                          )
                        : null,


                packagingClean:
                    getYesNo(
                        row,
                        ".packaging-clean"
                    ),

                readableLabel:
                    getYesNo(
                        row,
                        ".readable-label"
                    ),

                properlySealed:
                    getYesNo(
                        row,
                        ".properly-sealed"
                    ),

                noDeterioration:
                    getYesNo(
                        row,
                        ".no-deterioration"
                    ),


                noForeignMatter:
                    getYesNo(
                        row,
                        ".no-foreign-matter"
                    ),

                noInfestation:
                    getYesNo(
                        row,
                        ".no-infestation"
                    ),

                appearanceNotApplicable:
                    row.querySelector(
                        ".appearance-na"
                    ).value === "true",


                powderNoLump:
                    getOptionalBoolean(
                        row,
                        ".powder-no-lump"
                    ),

                powderGoodFlowability:
                    getOptionalBoolean(
                        row,
                        ".powder-good-flowability"
                    ),

                liquidNoSolidification:
                    getOptionalBoolean(
                        row,
                        ".liquid-no-solidification"
                    ),

                liquidNoPrecipitation:
                    getOptionalBoolean(
                        row,
                        ".liquid-no-precipitation"
                    ),


                colorResult:
                    row.querySelector(
                        ".color-result"
                    ).value,

                actualColor:
                    getInputValue(
                        row,
                        ".actual-color"
                    ),


                odorResult:
                    row.querySelector(
                        ".odor-result"
                    ).value,

                actualOdor:
                    getInputValue(
                        row,
                        ".actual-odor"
                    ),


                assayResultStatus:
                    row.querySelector(
                        ".assay-result"
                    ).value,

                coaAssayResult:
                    getInputValue(
                        row,
                        ".coa-assay-result"
                    ),

                bnpiAssaySpecification:
                    getInputValue(
                        row,
                        ".bnpi-assay-specification"
                    ),


                solubilityResult:
                    row.querySelector(
                        ".solubility-result"
                    ).value,

                solubilityTest:
                    getInputValue(
                        row,
                        ".solubility-test"
                    ),


                remarks:
                    getInputValue(
                        row,
                        ".line-remarks"
                    )
            });
        }


        const inspectionDate =
            document.getElementById(
                "inspectionDate"
            ).value;


        if (!inspectionDate) {

            alert(
                "Inspection date is required."
            );

            return;
        }


        const payload = {

            incomingReceivingId:
                Number(
                    currentReceiving
                        .incomingReceivingId
                ),

            inspectionDate:
                inspectionDate,

            remarks:
                document.getElementById(
                    "overallRemarks"
                ).value.trim() || null,

    receivedBy:
        loggedInUserId || null,

            notedBy:
                document.getElementById(
                    "notedBy"
                ).value.trim() || null,

            lines:
                lines
        };


        const confirmed =
            confirm(
                "Complete this QA/QC Receiving Inspection?\n\n" +
                "If all inspection requirements pass, " +
                "the material will automatically be placed under QUARANTINE."
            );


        if (!confirmed)
            return;


        const button =
            document.getElementById(
                "btnSaveInspection"
            );


        button.disabled = true;

        button.innerText =
            "Saving Inspection...";


        try {

            const response =
                await fetch(
                    "/quality/qa-qc-receiving/save",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify(payload)
                    }
                );


            const result =
                await readJsonResponse(
                    response
                );


            if (!response.ok) {

                throw new Error(
                    result.message ??
                    "Unable to save QA/QC inspection."
                );
            }


            alert(
                result.message ??
                "QA/QC Receiving Inspection saved successfully."
            );


            qaReceivingModal.hide();

            currentReceiving = null;

                await Promise.all([
        loadPending(),
        loadHistory()
    ]);

        }
        catch (error) {

            alert(
                error.message ??
                "Unable to save QA/QC inspection."
            );
        }
        finally {

            button.disabled = false;

            button.innerText =
                "Complete QA/QC Receiving Inspection";
        }
    }


    // =============================================================
    // UI HELPERS
    // =============================================================

    function renderYesNoCheck(
        cssClass,
        label
    ) {

        return `
            <div class="col-md-3">

                <label class="form-label">
                    ${escapeHtml(label)}
                </label>

                <select class="form-select ${cssClass}">

                    <option value="true">
                        Yes
                    </option>

                    <option value="false">
                        No
                    </option>

                </select>

            </div>
        `;
    }


    function renderOptionalResultSelect(
        cssClass
    ) {

        return `
            <select class="form-select ${cssClass}">

                <option value="">
                    N/A
                </option>

                <option value="true">
                    Yes
                </option>

                <option value="false">
                    No
                </option>

            </select>
        `;
    }


     function renderComplianceSelect(
        cssClass,
        defaultValue = "COMPLIANT"
    ) {

        return `
            <select class="form-select result-select ${cssClass}">

                <option value="COMPLIANT"
                    ${defaultValue === "COMPLIANT" ? "selected" : ""}>
                    Compliant
                </option>

                <option value="NON_COMPLIANT"
                    ${defaultValue === "NON_COMPLIANT" ? "selected" : ""}>
                    Non Compliant
                </option>

                <option value="N/A"
                    ${defaultValue === "N/A" ? "selected" : ""}>
                    N/A
                </option>

            </select>
        `;
    }


    function getYesNo(
        row,
        selector
    ) {

        return row.querySelector(
            selector
        ).value === "true";
    }


    function getOptionalBoolean(
        row,
        selector
    ) {

        const value =
            row.querySelector(
                selector
            ).value;


        if (value === "")
            return null;


        return value === "true";
    }


    function getInputValue(
        row,
        selector
    ) {

        const value =
            row.querySelector(
                selector
            )?.value
            ?.trim();


        return value || null;
    }


    function extractInspectionNumber(
        result
    ) {

        if (!result)
            return "";


        if (typeof result === "string")
            return result;


        return (
            result.inspectionNo ??
            result.number ??
            result.data ??
            ""
        );
    }


    function resetModal() {

        currentReceiving = null;


        document.getElementById(
            "incomingReceivingId"
        ).value = "";


        document.getElementById(
            "inspectionNo"
        ).value = "";


        document.getElementById(
            "incomingNo"
        ).value = "";


        document.getElementById(
            "poNo"
        ).value = "";


        document.getElementById(
            "supplierName"
        ).value = "";


        document.getElementById(
            "inspectionDate"
        ).value =
            getTodayDate();


           document.getElementById(
        "receivedBy"
    ).value =
        loggedInFullName;


        document.getElementById(
            "notedBy"
        ).value = "";


        document.getElementById(
            "overallRemarks"
        ).value = "";


        document.getElementById(
            "materialInspectionContainer"
        ).innerHTML = `
            <div class="text-center text-muted py-5">
                Loading inspection form...
            </div>
        `;
    }


    // =============================================================
    // GENERAL HELPERS
    // =============================================================

    async function readJsonResponse(
        response
    ) {

        const text =
            await response.text();


        if (!text)
            return {};


        try {
            return JSON.parse(text);
        }
        catch {
            return {
                message: text
            };
        }
    }


    function getTodayDate() {

        const now =
            new Date();

        const year =
            now.getFullYear();

        const month =
            String(
                now.getMonth() + 1
            ).padStart(2, "0");

        const day =
            String(
                now.getDate()
            ).padStart(2, "0");


        return `${year}-${month}-${day}`;
    }


    function formatDate(
        value
    ) {

        if (!value)
            return "-";


        const date =
            new Date(value);


        if (isNaN(date.getTime()))
            return "-";


        return date.toLocaleDateString();
    }


    function formatQty(
        value
    ) {

        return Number(
            value ?? 0
        ).toLocaleString(
            undefined,
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 4
            }
        );
    }


    function formatNullableQty(
        value
    ) {

        if (
            value === null ||
            value === undefined ||
            value === ""
        ) {
            return "-";
        }


        return Number(
            value
        ).toLocaleString(
            undefined,
            {
                maximumFractionDigits: 4
            }
        );
    }


    function escapeHtml(
        value
    ) {

        return String(
            value ?? ""
        )
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

</script>