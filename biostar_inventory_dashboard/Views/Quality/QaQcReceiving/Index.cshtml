                                </div>

                            </div>

                        </div>


                        <div class="p-3">

                            ${detailsHtml}

                        </div>

                    </div>
                `
            );
        }

        initializeInspectionFields();
    }

        function initializeInspectionFields() {

        const rows =
            document.querySelectorAll(
                ".qa-inspection-row"
            );

        rows.forEach(row => {

            // =========================================================
            // ASSAY
            // =========================================================

            const assay =
                row.querySelector(
                    ".assay-result"
                );

            if (assay) {
                assay.dispatchEvent(
                    new Event(
                        "change",
                        { bubbles: true }
                    )
                );
            }


            // =========================================================
            // SOLUBILITY
            // =========================================================

            const solubility =
                row.querySelector(
                    ".solubility-result"
                );

            if (solubility) {
                solubility.dispatchEvent(
                    new Event(
                        "change",
                        { bubbles: true }
                    )
                );
            }


            // =========================================================
            // COLOR
            // =========================================================

            const color =
                row.querySelector(
                    ".color-result"
                );

            if (color) {
                color.dispatchEvent(
                    new Event(
                        "change",
                        { bubbles: true }
                    )
                );
            }


            // =========================================================
            // ODOR
            // =========================================================

            const odor =
                row.querySelector(
                    ".odor-result"
                );

            if (odor) {
                odor.dispatchEvent(
                    new Event(
                        "change",
                        { bubbles: true }
                    )
                );
            }


                const appearance =
        row.querySelector(".appearance-na");

    if (appearance) {
        appearance.dispatchEvent(
            new Event(
                "change",
                { bubbles: true }
            )
        );
    }

        });
    }


