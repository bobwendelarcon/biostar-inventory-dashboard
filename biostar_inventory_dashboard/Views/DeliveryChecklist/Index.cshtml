@{
    ViewData["Title"] = "Delivery Checklist";
}

@section Styles {
    @* <link rel="stylesheet" href="~/css/dispatch.css" /> *@
}




<div class="dispatch-page">

    
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <small class="text-muted">Dashboard > Dispatch</small>
            <h2 class="fw-bold mb-0">Delivery Checklist</h2>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" type="button" onclick="loadChecklistList()">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>

            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createChecklistModal">
                <i class="bi bi-plus-circle"></i> Create Checklist
            </button>
        </div>
    </div>

    <div class="row mb-3">

        <div class="col-md-2">
            <label>Date</label>
            <input type="date" id="filterDate" class="form-control">
        </div>

        <div class="col-md-2">
            <label>Status</label>
            <select id="filterStatus" class="form-select">
                <option value="">All</option>
                <option value="READY">Ready</option>
                <option value="LOADING">Loading</option>
                <option value="PARTIAL">Partial</option>
                <option value="COMPLETED">Completed</option>
            </select>
        </div>

        <div class="col-md-2">
            <label>Truck</label>
            <input type="text" id="filterTruck" class="form-control">
        </div>

        <div class="col-md-3">
            <label>Search</label>
            <input type="text" id="filterSearch" class="form-control" placeholder="DR No ">
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary" onclick="applyFilters()">
                Apply
            </button>
            <button class="btn btn-outline-secondary" onclick="resetFilters()">
                Reset
            </button>
        </div>

    </div>

    <!-- TABLE -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Checklist No</th>
                            <th>Date</th>
                            <th>Route</th>
                            <th>Truck</th>
                            <th>Driver</th>
                            <th>Total Customers</th>
                            <th>Created By</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="checklistTableBody">
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                Loading...
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>

        </div>
    </div>
    

</div>

<!-- ============================= -->
<!-- CREATE CHECKLIST MODAL -->
<!-- ============================= -->

<div class="modal fade" id="createChecklistModal">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content rounded-4">

           
            <div class="modal-header">
                <div>
                    <h5 class="fw-bold mb-0">Create Delivery Checklist</h5>
                    <small class="text-muted">Select orders to include in this trip</small>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <!-- CHECKLIST INFO -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <label class="form-label">Delivery Date</label>
                        <input type="date" class="form-control" id="create_delivery_date">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Route</label>
                        <input type="text" class="form-control" id="create_route" placeholder="e.g Laguna">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Truck</label>
                        <input type="text" class="form-control" id="create_truck">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Driver</label>
                        <input type="text" class="form-control" id="create_driver">
                    </div>
                </div>

                <!-- ORDER TABLE -->
                <div class="table-responsive">
                    <table class="table table-sm align-middle">

                        <thead>
                            <tr>
                                <th><input type="checkbox" id="selectAllOrders"></th>
                                <th>Order No</th>
                                <th>Customer</th>
                                <th>Route</th>
                                <th>Product</th>
                                <th>Remaining Order</th>
                                <th>Allocated</th>
                                <th>Delivery Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody id="createChecklistTableBody">
                            <tr>
                                <td colspan="9" class="text-center text-muted py-3">
                                    Loading...
                                </td>
                            </tr>
                        </tbody>

                    </table>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-primary" onclick="submitCreateChecklist()">
                    Create Checklist
                </button>
            </div>

        </div>
    </div>
    

</div>

<!-- ============================= -->
<!-- VIEW CHECKLIST MODAL -->
<!-- ============================= -->

<div class="modal fade" id="viewChecklistModal">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content rounded-4">

         
            <div class="modal-header">
                <div>
                    <h5 class="fw-bold mb-0">Checklist Details</h5>
                    <small class="text-muted">Multi-customer delivery</small>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <!-- HEADER INFO -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <small class="text-muted">Checklist No</small>
                        <div class="fw-semibold" id="view_checklist_no"></div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Route</small>
                        <div class="fw-semibold" id="view_route"></div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Truck</small>
                        <div class="fw-semibold" id="view_truck"></div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Driver</small>
                        <div class="fw-semibold" id="view_driver"></div>
                    </div>
                </div>

                <!-- DELIVERY LINES -->
                <div class="card border-0 bg-light rounded-4">
                    <div class="card-body">

                        <h6 class="fw-bold mb-3">Delivery Lines</h6>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Product</th>
                                        <th>Warehouse</th>
                                        <th>Lot No</th>
                                        <th>Mfg Date</th>
                                        <th>Expiry Date</th>
                                        <th>Qty</th>
                                        <th>Status</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>

                                <tbody id="viewChecklistLinesBody">
                                    <tr>
                                        <td colspan="9" class="text-center text-muted">
                                            No data
                                        </td>
                                    </tr>
                                </tbody>

                            </table>
                        </div>

                    </div>
                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-danger"
                        id="btnDeleteChecklist">
                    Delete Checklist
                </button>

                <button class="btn btn-secondary"
                        id="btnPrintChecklist">
                    Print
                </button>

                <button class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

            </div>

        </div>
    </div>
  
   
</div>


<div class="modal fade" id="completeLineModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4">

            <div class="modal-header">
                <div>
                    <h5 class="fw-bold mb-0">Complete Checklist Line</h5>
                    <small class="text-muted">Confirm loading and delivery documents</small>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="complete_line_id">

                <div class="border rounded-3 bg-light p-3 mb-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <small class="text-muted">Customer</small>
                            <div class="fw-semibold" id="complete_customer_text">-</div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Product</small>
                            <div class="fw-semibold" id="complete_product_text">-</div>

                            <div class="text-primary small fw-semibold mt-1"
                                 id="complete_product_description_text"></div>
                        </div>

                        <div class="col-md-4">
                            <small class="text-muted">Warehouse</small>
                            <div class="fw-semibold" id="complete_warehouse_text">-</div>
                        </div>

                        <div class="col-md-4">
                            <small class="text-muted">Lot No</small>
                            <div class="fw-semibold" id="complete_lot_no_text">-</div>
                        </div>

                        <div class="col-md-4">
                            <small class="text-muted">Available Qty</small>
                            <div class="fw-semibold" id="complete_available_qty_text">-</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Quantity Out</label>
                        <input type="number" class="form-control" id="complete_quantity_out" min="0" step="0.01" readonly>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">DR No <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="complete_dr_no">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Invoice No</label>
                        <input type="text" class="form-control" id="complete_inv_no">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">PO No</label>
                        <input type="text" class="form-control" id="complete_po_no">
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Remarks</label>
                        <input type="text" class="form-control" id="complete_remarks" placeholder="Delivered to / reason">
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-success" onclick="submitCompleteLine()">
                    Save & Complete
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="editChecklistLotModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <div>
                    <h5 class="fw-bold mb-0">Change Checklist Lot</h5>
                    <small class="text-muted" id="editLotProductText"></small>
                </div>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="editLotChecklistLineId">

                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Lot No</th>
                            <th>Warehouse</th>
                            <th>MFG</th>
                            <th>EXP</th>
                            <th>On Hand</th>
                            <th>Reserved</th>
                            <th>Available</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="editChecklistLotTableBody"></tbody>
                </table>
            </div>


            <div class="modal-footer">
                <div class="me-auto">
                    <div class="fw-bold">
                        Required:
                        <span id="editLotRequiredQty">0</span>
                    </div>

                    <div class="fw-bold text-primary">
                        Total Allocation:
                        <span id="editLotTotalAllocation">0</span>
                    </div>

                    <div class="fw-bold text-danger">
                        Remaining:
                        <span id="editLotRemainingQty">0</span>
                    </div>
                </div>

                <div style="width: 300px;">
                    <input type="text"
                           class="form-control"
                           id="editLotReason"
                           placeholder="Reason e.g. dents, damaged packaging">
                </div>

                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-primary" onclick="saveChecklistLotReplacement()">
                    Save Replacement
                </button>
            </div>


        </div>
    </div>
</div>

@section Scripts {
    <style>
        .modal-parent-dim .modal-content {
            filter: blur(2px);
            opacity: .35;
            pointer-events: none;
        }

        #editChecklistLotModal {
            z-index: 1080 !important;
        }

            #editChecklistLotModal .modal-dialog {
                z-index: 1081 !important;
            }

        

       
    </style>
    <script>
        window.currentUserId = "@ViewBag.CurrentUser";
        window.currentUserName = "@ViewBag.CurrentUser";
    </script>


    <script src="~/js/delivery-checklist.js" asp-append-version="true"></script>
}
