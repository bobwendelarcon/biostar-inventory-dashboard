@{
    ViewData["Title"] = "New Material Requisition";

    var currentUserId =
        ViewBag.CurrentUserId?.ToString() ?? "";

    var currentUserName =
        ViewBag.CurrentUserName?.ToString() ?? "";
}

<style>
    .mrs-form-page {
        padding-bottom: 40px;
    }

    .mrs-form-card {
        border: 0;
        border-radius: 12px;
    }

    .mrs-title {
        font-weight: 700;
        letter-spacing: .02em;
    }

    .mrs-table th {
        font-size: .78rem;
        text-transform: uppercase;
        vertical-align: middle;
        white-space: nowrap;
        background: #f8f9fa;
    }

    .mrs-table td {
        vertical-align: middle;
    }

    .material-info {
        font-size: .75rem;
        color: #6c757d;
        margin-top: 3px;
    }

    .available-stock {
        font-size: .75rem;
        color: #198754;
        margin-top: 3px;
    }

    /* ==========================================
       DIRECT MATERIAL SEARCH
       ========================================== */

    .material-search-wrapper {
        position: relative;
        margin-bottom: 5px;
    }

    .material-search-input {
        font-size: .78rem;
    }


    .material-search-results {
        position: fixed;
        width: 320px;
        max-height: 260px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, .12);
        z-index: 1050;
    }


    .material-search-result {
        display: block;
        width: 100%;
        padding: 8px 12px;
        border: 0;
        border-bottom: 1px solid #f1f3f5;
        background: #fff;
        text-align: left;
        cursor: pointer;
    }

        .material-search-result:hover,
        .material-search-result:focus {
            background: #eaf3ff;
        }

    .material-search-name {
        font-size: .82rem;
        font-weight: 600;
        color: #212529;
    }

    .material-search-code {
        font-size: .72rem;
        color: #6c757d;
    }

    .material-search-empty {
        padding: 10px;
        font-size: .78rem;
        color: #6c757d;
    }


</style>

<div class="container-fluid mrs-form-page">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h3 class="mb-0">
                Material Requisition Slip
            </h3>

            <small class="text-muted">
                Raw material requisition and warehouse release.
            </small>
        </div>

        <a href="/inventory/material-requisitions"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back
        </a>

    </div>


    <div class="card mrs-form-card shadow-sm">

        <div class="card-body">

            <div id="mrsAlert"
                 class="alert d-none">
            </div>


            <!-- Header -->
            <div class="row g-3 mb-4">

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Date
                        <span class="text-danger">*</span>
                    </label>

                    <input type="date"
                           id="requisitionDate"
                           class="form-control">

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Branch
                        <span class="text-danger">*</span>
                    </label>

                    <select id="branchId"
                            class="form-select">

                        <option value="">
                            Select Branch
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Requisition No.
                    </label>

                    <input type="text"
                           id="requisitionNo"
                           class="form-control"
                           value="Auto-generated"
                           disabled>

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <input type="text"
                           class="form-control"
                           value="DRAFT"
                           disabled>

                </div>

            </div>


            <!-- Material table -->
            <div class="d-flex justify-content-between align-items-center mb-2">

                <h5 class="mb-0 mrs-title">
                    Materials
                </h5>

                <button type="button"
                        id="btnAddLine"
                        class="btn btn-sm btn-outline-primary">

                    <i class="bi bi-plus-circle me-1"></i>
                    Add Material
                </button>

            </div>


            <div class="table-responsive">

                <table class="table table-bordered mrs-table">

                    <thead>
                        <tr>
                            <th style="min-width:160px;">
                                Category
                            </th>

                            <th style="min-width:170px;">
                                Subcategory
                            </th>

                            <th style="min-width:300px;">
                                Item
                            </th>

                            <th style="min-width:130px;">
                                Quantity
                            </th>

                            <th style="min-width:170px;">
                                Lot / Batch No.
                            </th>

                            <th style="min-width:135px;">
                                Expiration
                            </th>

                            <th style="min-width:140px;">
                                Actual Weight
                            </th>

                            <th style="min-width:180px;">
                                Remarks
                            </th>

                            <th style="width:60px;">
                            </th>
                        </tr>
                    </thead>

                    <tbody id="mrsLinesBody">
                    </tbody>

                </table>

            </div>


            <hr class="my-4">


            <!-- Footer fields from paper MRS -->
            <div class="row g-3">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Requested By
                    </label>

                    <input type="text"
                           id="requestedBy"
                           class="form-control"
                           value="@currentUserName"
                           disabled>

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Released By
                    </label>

                    <input type="text"
                           id="releasedBy"
                           class="form-control"
                           disabled
                           placeholder="Set during posting">

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Verified By
                    </label>

                    <input type="text"
                           id="verifiedBy"
                           class="form-control"
                           disabled
                           placeholder="Set during posting">

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Time Requested
                    </label>

                    <input type="time"
                           id="timeRequested"
                           class="form-control">

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Time Served
                    </label>

                    <input type="time"
                           id="timeServed"
                           class="form-control"
                           disabled>

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Received By
                    </label>

                    <input type="text"
                           id="receivedBy"
                           class="form-control"
                           disabled
                           placeholder="Set during posting">

                </div>

                <div class="col-12">

                    <label class="form-label fw-semibold">
                        Remarks
                    </label>

                    <textarea id="mrsRemarks"
                              class="form-control"
                              rows="3"
                              maxlength="500"></textarea>

                </div>

            </div>

        </div>


        <div class="card-footer bg-white d-flex justify-content-end gap-2">

            <a href="/inventory/material-requisitions"
               class="btn btn-secondary">

                Cancel
            </a>

            <button type="button"
                    id="btnSaveDraft"
                    class="btn btn-primary">

                <span id="saveSpinner"
                      class="spinner-border spinner-border-sm me-1 d-none">
                </span>

                <i class="bi bi-save me-1"></i>

                Save Draft
            </button>

        </div>

    </div>

</div>


@section Scripts {

    <script>

               let materials = [];
        let categories = [];
        let subCategories = [];
        let lineCounter = 0;

        const lotRequestVersions = new Map();



        document.addEventListener(
            "DOMContentLoaded",
            async function () {

                setDefaultDateTime();

                bindEvents();

                bindMaterialSearchEvents();

                await loadBranches();
                await loadCategories();
                await loadSubCategories();
                await loadMaterials();

                addMaterialLine();
            }
        );



                function bindEvents() {

            document.getElementById(
                "btnAddLine"
            ).addEventListener(
                "click",
                addMaterialLine
            );

            document.getElementById(
                "btnSaveDraft"
            ).addEventListener(
                "click",
                saveDraft
            );

            document.getElementById(
                "branchId"
            ).addEventListener(
                "change",
                handleBranchChange
            );
        }


        function setDefaultDateTime() {

            const now = new Date();

            document.getElementById(
                "requisitionDate"
            ).value =
                now.toISOString()
                   .substring(0, 10);

            document.getElementById(
                "timeRequested"
            ).value =
                now.toTimeString()
                   .substring(0, 5);

        }



                async function handleBranchChange() {

            const rows =
                document.querySelectorAll(
                    "#mrsLinesBody tr"
                );

            for (const row of rows) {

                const lineId =
                    row.id.replace(
                        "mrsLine_",
                        ""
                    );

                const materialValue =
                    document.getElementById(
                        `material_${lineId}`
                    ).value;

                if (!materialValue) {

                    document.getElementById(
                        `lot_${lineId}`
                    ).innerHTML = `
                        <option value="">
                            Select Material First
                        </option>
                    `;

                    document.getElementById(
                        `lot_${lineId}`
                    ).disabled = true;

                    document.getElementById(
                        `expiration_${lineId}`
                    ).value = "—";

                    document.getElementById(
                        `availableStock_${lineId}`
                    ).textContent = "";

                    continue;
                }

                await handleMaterialChange(
                    lineId
                );
            }
        }


        async function loadBranches() {

            try {

                const response = await fetch(
                    "/inventory/raw-materials/branches"
                );

                if (!response.ok) {
                    return;
                }

                const branches =
                    await response.json();

                const select =
                    document.getElementById(
                        "branchId"
                    );

                if (!Array.isArray(branches)) {
                    return;
                }

                branches.forEach(
                    function (branch) {

                        const id =
                            branch.branch_id ??
                            branch.branchId;

                        const name =
                            branch.branch_name ??
                            branch.branchName ??
                            id;

                        if (!id) {
                            return;
                        }

                        select.insertAdjacentHTML(
                            "beforeend",
                            `
                            <option value="${escapeAttribute(id)}">
                                ${escapeHtml(name)}
                            </option>
                            `
                        );
                    }
                );
            }
            catch (error) {
                console.error(error);
            }
        }

                async function loadCategories() {

            try {

                const response = await fetch(
                    "/manufacturing/materials/categories/list"
                );

                if (!response.ok) {
                    throw new Error(
                        await response.text()
                    );
                }

                const result =
                    await response.json();

                categories =
                    result.data ??
                    result.items ??
                    result.categories ??
                    result;

                if (!Array.isArray(categories)) {
                    categories = [];
                }

            }
            catch (error) {

                console.error(
                    "Unable to load categories:",
                    error
                );

                categories = [];
            }
        }


        async function loadSubCategories() {

            try {

                const response = await fetch(
                    "/manufacturing/materials/subcategories/list"
                );

                if (!response.ok) {
                    throw new Error(
                        await response.text()
                    );
                }

                const result =
                    await response.json();

                subCategories =
                    result.data ??
                    result.items ??
                    result.subCategories ??
                    result;

                if (!Array.isArray(subCategories)) {
                    subCategories = [];
                }

            }
            catch (error) {

                console.error(
                    "Unable to load subcategories:",
                    error
                );

                subCategories = [];
            }
        }
        async function loadMaterials() {

            try {

                const response = await fetch(
                    "/manufacturing/materials/list"
                );

                if (!response.ok) {

                    throw new Error(
                        await response.text()
                    );
                }

                const result =
                    await response.json();

                materials =
                    result.data ??
                    result.items ??
                    result.materials ??
                    result;

                if (!Array.isArray(materials)) {
                    materials = [];
                }

                materials =
                    materials.filter(
                        x =>
                            x.is_active !== false
                    );

            }
            catch (error) {

                console.error(error);

                materials = [];
            }

        }


        function addMaterialLine() {

            lineCounter++;

            const id = lineCounter;

            const tbody =
                document.getElementById(
                    "mrsLinesBody"
                );

            const row =
                document.createElement(
                    "tr"
                );

            row.id =
                `mrsLine_${id}`;

            row.innerHTML = `

                <td>

                    <select class="form-select form-select-sm"
                            id="category_${id}"
                            onchange="handleCategoryChange(${id})">

                        ${getCategoryOptions()}

                    </select>

                </td>


                <td>

                    <select class="form-select form-select-sm"
                            id="subcategory_${id}"
                            disabled
                            onchange="handleSubCategoryChange(${id})">

                        <option value="">
                            Select Category First
                        </option>

                    </select>

                </td>


                <td>


       

            <!-- DIRECT MATERIAL SEARCH -->

            <div class="material-search-wrapper">

                <div class="input-group input-group-sm">

                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           id="materialSearch_${id}"
                           class="form-control material-search-input"
                           placeholder="Search ID, code or name"
                           autocomplete="off"
                           oninput="searchMaterials(${id})"
                           onfocus="searchMaterials(${id})">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            title="Clear search"
                            onclick="clearMaterialSearch(${id})">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>

                <div id="materialSearchResults_${id}"
                     class="material-search-results d-none">
                </div>

            </div>

            <!-- EXISTING MATERIAL DROPDOWN -->

            <select class="form-select form-select-sm"
                    id="material_${id}"
                    disabled
                    onchange="handleMaterialChange(${id})">

                <option value="">
                    Select Subcategory First
                </option>

            </select>

            <div id="materialInfo_${id}"
                 class="material-info">
            </div>

            <div id="availableStock_${id}"
                 class="available-stock">
            </div>

        </td>



                <td>

                    <div class="input-group input-group-sm">

                        <input type="number"
                               id="requestedQty_${id}"
                               class="form-control"
                               min="0.0001"
                               step="0.0001"
                               placeholder="0">

                        <span id="uom_${id}"
                              class="input-group-text">
                            UOM
                        </span>

                    </div>

                </td>


                <td>

                    <select id="lot_${id}"
                            class="form-select form-select-sm"
                            disabled
                            onchange="handleLotChange(${id})">

                        <option value="">
                            Select Item First
                        </option>

                    </select>

                </td>


                <td>

                    <input type="text"
                           id="expiration_${id}"
                           class="form-control form-control-sm"
                           value="—"
                           disabled>

                </td>


                <td>

                    <input type="number"
                           id="actualQty_${id}"
                           class="form-control form-control-sm"
                           placeholder="Posted later"
                           disabled>

                </td>


                <td>

                    <input type="text"
                           id="lineRemarks_${id}"
                           class="form-control form-control-sm"
                           maxlength="500">

                </td>


                <td class="text-center">

                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="removeMaterialLine(${id})">

                        <i class="bi bi-trash"></i>

                    </button>

                </td>
            `;

            tbody.appendChild(row);
        }


        function closeMaterialSearchResults(lineId) {

            const results =
                document.getElementById(
                    `materialSearchResults_${lineId}`
                );

            if (!results) {
                return;
            }

            results.classList.add("d-none");
        }


        function closeAllMaterialSearchResults(
            exceptLineId = null
        ) {

            document.querySelectorAll(
                ".material-search-results"
            ).forEach(results => {

                if (
                    exceptLineId !== null &&
                    results.id ===
                        `materialSearchResults_${exceptLineId}`
                ) {
                    return;
                }

                results.classList.add("d-none");
            });
        }

        function bindMaterialSearchEvents() {

            // ==========================================
            // CLOSE WHEN CLICKING OUTSIDE
            // ==========================================

            document.addEventListener(
                "click",
                function (event) {

                    if (
                        !event.target.closest(
                            ".material-search-wrapper"
                        )
                    ) {

                        closeAllMaterialSearchResults();
                    }
                }
            );


            // ==========================================
            // CLOSE WHEN PRESSING ESCAPE
            // ==========================================

            document.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {

                        closeAllMaterialSearchResults();
                    }
                }
            );


            // ==========================================
            // CLOSE WHEN SCROLLING
            // ==========================================

            window.addEventListener(
                "scroll",
                function (event) {

                    // Allow scrolling inside search results.

                    if (
                        event.target instanceof Element &&
                        event.target.closest(
                            ".material-search-results"
                        )
                    ) {
                        return;
                    }

                    closeAllMaterialSearchResults();
                },
                {
                    capture: true,
                    passive: true
                }
            );


            // ==========================================
            // CLOSE WHEN RESIZING WINDOW
            // ==========================================

            window.addEventListener(
                "resize",
                function () {

                    closeAllMaterialSearchResults();
                }
            );
        }


        function positionMaterialSearchResults(lineId) {

            const input =
                document.getElementById(
                    `materialSearch_${lineId}`
                );

            const results =
                document.getElementById(
                    `materialSearchResults_${lineId}`
                );

            if (!input || !results) {
                return;
            }

            const wrapper =
                input.closest(".material-search-wrapper");

            const rect =
                wrapper.getBoundingClientRect();

            const viewportWidth =
                window.innerWidth;

            const viewportHeight =
                window.innerHeight;

            const width = Math.min(
                Math.max(rect.width, 320),
                viewportWidth - 16
            );

            const left = Math.max(
                8,
                Math.min(
                    rect.left,
                    viewportWidth - width - 8
                )
            );

            const spaceBelow =
                viewportHeight - rect.bottom - 8;

            const spaceAbove =
                rect.top - 8;

            results.style.width =
                `${width}px`;

            results.style.left =
                `${left}px`;

            if (spaceBelow < 260 &&
                spaceAbove > spaceBelow) {

                // OPEN ABOVE THE SEARCH FIELD

                results.style.top = "auto";

                results.style.bottom =
                    `${viewportHeight - rect.top + 4}px`;

                results.style.maxHeight =
                    `${Math.max(0, Math.min(260, spaceAbove - 4))}px`;

            } else {

                // OPEN BELOW THE SEARCH FIELD

                results.style.bottom = "auto";

                results.style.top =
                    `${rect.bottom + 4}px`;

                results.style.maxHeight =
                    `${Math.max(0, Math.min(260, spaceBelow - 4))}px`;
            }
        }


        function searchMaterials(lineId) {
            closeAllMaterialSearchResults(lineId);
            const input =
                document.getElementById(
                    `materialSearch_${lineId}`
                );

            const results =
                document.getElementById(
                    `materialSearchResults_${lineId}`
                );

            const keyword =
                input.value.trim().toLowerCase();

            results.innerHTML = "";

            // ==========================================
            // EMPTY SEARCH
            // ==========================================

            if (!keyword) {

                results.classList.add("d-none");

                return;
            }

            // ==========================================
            // SEARCH MATERIAL MASTER FILE
            // ==========================================

            const matchingMaterials =
                materials.filter(material => {

                    const id = String(
                        material.material_id ??
                        material.materialId ??
                        ""
                    );

                    const code = String(
                        material.material_code ??
                        material.materialCode ??
                        ""
                    ).toLowerCase();

                    const name = String(
                        material.material_name ??
                        material.materialName ??
                        ""
                    ).toLowerCase();

                    return (
                        id.includes(keyword) ||
                        code.includes(keyword) ||
                        name.includes(keyword)
                    );
                });

            // ==========================================
            // SORT SEARCH RESULTS
            // ==========================================

            matchingMaterials.sort((a, b) => {

                const nameA =
                    a.material_name ??
                    a.materialName ??
                    "";

                const nameB =
                    b.material_name ??
                    b.materialName ??
                    "";

                return String(nameA)
                    .localeCompare(String(nameB));
            });

            // ==========================================
            // NO MATCHING MATERIALS
            // ==========================================

            if (matchingMaterials.length === 0) {

                results.innerHTML = `
                    <div class="material-search-empty">
                        No matching materials found.
                    </div>
                `;

                      positionMaterialSearchResults(lineId);

        results.classList.remove("d-none");

                return;
            }

            // ==========================================
            // DISPLAY SEARCH RESULTS
            // ==========================================

            matchingMaterials
                .slice(0, 30)
                .forEach(material => {

                    const materialId = Number(
                        material.material_id ??
                        material.materialId
                    );

                    if (!Number.isSafeInteger(materialId)
                            || materialId <= 0) {
                        return;
                    }

                    const code =
                        material.material_code ??
                        material.materialCode ??
                        "";

                    const name =
                        material.material_name ??
                        material.materialName ??
                        "";

                    const uom =
                        material.uom ?? "";

                    results.insertAdjacentHTML(
                        "beforeend",
                        `
                        <button type="button"
                                class="material-search-result"
                                onclick="selectSearchMaterial(
                                    ${lineId},
                                    ${materialId}
                                )">

                            <div class="material-search-name">
                                ${escapeHtml(name)}
                            </div>

                            <div class="material-search-code">
                                ${escapeHtml(code)}
                                | ID: ${materialId}
                                | ${escapeHtml(uom)}
                            </div>

                        </button>
                        `
                    );
                });

            // ==========================================
            // LIMIT DISPLAYED RESULTS
            // ==========================================

            if (matchingMaterials.length > 30) {

                results.insertAdjacentHTML(
                    "beforeend",
                    `
                    <div class="material-search-empty">
                        Showing 30 of ${matchingMaterials.length}
                        results. Refine your search.
                    </div>
                    `
                );
            }

                 positionMaterialSearchResults(lineId);

        results.classList.remove("d-none");
        }


        async function selectSearchMaterial(lineId, materialId) {

            // ==========================================
            // FIND SELECTED MATERIAL
            // ==========================================

            const material = materials.find(x =>
                Number(
                    x.material_id ??
                    x.materialId
                ) === Number(materialId)
            );

            if (!material) {
                return;
            }

            // ==========================================
            // GET MATERIAL INFORMATION
            // ==========================================

            const categoryId = String(
                material.material_category_id ??
                material.materialCategoryId ??
                ""
            );

            const rawSubCategoryId =
                material.material_subcategory_id ??
                material.materialSubcategoryId;

            const subCategoryId =
                rawSubCategoryId
                    ? String(rawSubCategoryId)
                    : "NONE";

            const materialName =
                material.material_name ??
                material.materialName ??
                "";

            const materialCode =
                material.material_code ??
                material.materialCode ??
                "";

            // ==========================================
            // GET ROW CONTROLS
            // ==========================================

            const categorySelect =
                document.getElementById(
                    `category_${lineId}`
                );

            const subCategorySelect =
                document.getElementById(
                    `subcategory_${lineId}`
                );

            const materialSelect =
                document.getElementById(
                    `material_${lineId}`
                );

            const searchInput =
                document.getElementById(
                    `materialSearch_${lineId}`
                );

            const searchResults =
                document.getElementById(
                    `materialSearchResults_${lineId}`
                );

            // ==========================================
            // VALIDATE CATEGORY
            // ==========================================

            if (!categoryId ||
                !Array.from(categorySelect.options)
                    .some(x => x.value === categoryId)) {

                showAlert(
                    "danger",
                    "The selected material has an invalid category."
                );

                return;
            }

            // ==========================================
            // SELECT CATEGORY
            // ==========================================

            categorySelect.value = categoryId;

            handleCategoryChange(lineId);

            // ==========================================
            // SELECT SUBCATEGORY
            // ==========================================

            subCategorySelect.value = subCategoryId;

            if (subCategorySelect.value !== subCategoryId) {

                showAlert(
                    "danger",
                    "Unable to select the material subcategory."
                );

                return;
            }

            handleSubCategoryChange(lineId);

            // ==========================================
            // SELECT MATERIAL
            // ==========================================

            materialSelect.value = String(materialId);

            if (materialSelect.value !== String(materialId)) {

                showAlert(
                    "danger",
                    "Unable to select the material."
                );

                return;
            }

            // ==========================================
            // UPDATE SEARCH FIELD
            // ==========================================

            searchInput.value =
                `${materialCode} - ${materialName}`;

            searchResults.innerHTML = "";

            searchResults.classList.add("d-none");

            // ==========================================
            // RESET PREVIOUS REQUESTED QUANTITY
            // ==========================================

            const quantityInput =
                document.getElementById(
                    `requestedQty_${lineId}`
                );

            quantityInput.value = "";

            quantityInput.dataset.available = "";

            // ==========================================
            // LOAD MATERIAL INFORMATION AND LOTS
            // ==========================================

            await handleMaterialChange(lineId);
        }

        function clearMaterialSearch(lineId) {

            const input =
                document.getElementById(
                    `materialSearch_${lineId}`
                );

            const results =
                document.getElementById(
                    `materialSearchResults_${lineId}`
                );

            input.value = "";

            results.innerHTML = "";

            results.classList.add("d-none");

            input.focus();
        }



               function getCategoryOptions() {

            let html = `
                <option value="">
                    Select Category
                </option>
            `;

            [...categories]
                .sort((a, b) => {

                    const nameA =
                        a.category_name ??
                        a.categoryName ??
                        "";

                    const nameB =
                        b.category_name ??
                        b.categoryName ??
                        "";

                    return String(nameA)
                        .localeCompare(String(nameB));
                })
                .forEach(category => {

                    const id =
                        category.material_category_id ??
                        category.materialCategoryId;

                    const name =
                        category.category_name ??
                        category.categoryName ??
                        "";

                    if (!id) {
                        return;
                    }

                    html += `
                        <option value="${escapeAttribute(id)}">
                            ${escapeHtml(name)}
                        </option>
                    `;
                });

            return html;
        }


        function getSubCategoryOptions(categoryId) {

            let html = `
                <option value="">
                    Select Subcategory
                </option>
            `;

            const matchingSubCategories =
                subCategories.filter(sc =>

                    String(
                        sc.material_category_id ??
                        sc.materialCategoryId
                    ) === String(categoryId)
                );

            matchingSubCategories
                .sort((a, b) => {

                    const nameA =
                        a.subcategory_name ??
                        a.subcategoryName ??
                        "";

                    const nameB =
                        b.subcategory_name ??
                        b.subcategoryName ??
                        "";

                    return String(nameA)
                        .localeCompare(String(nameB));
                })
                .forEach(sc => {

                    const id =
                        sc.material_subcategory_id ??
                        sc.materialSubcategoryId;

                    const name =
                        sc.subcategory_name ??
                        sc.subcategoryName ??
                        "";

                    if (!id) {
                        return;
                    }

                    html += `
                        <option value="${escapeAttribute(id)}">
                            ${escapeHtml(name)}
                        </option>
                    `;
                });


            // Materials under this category that do not
            // have a subcategory.
            const hasUncategorizedMaterials =
                materials.some(m => {

                    const materialCategoryId =
                        m.material_category_id ??
                        m.materialCategoryId;

                    const materialSubCategoryId =
                        m.material_subcategory_id ??
                        m.materialSubcategoryId;

                    return (
                        String(materialCategoryId) ===
                            String(categoryId) &&
                        !materialSubCategoryId
                    );
                });


            if (hasUncategorizedMaterials) {

                html += `
                    <option value="NONE">
                        No Subcategory
                    </option>
                `;
            }


            return html;
        }


        function getFilteredMaterialOptions(
            categoryId,
            subCategoryId) {

            let html = `
                <option value="">
                    Select Item
                </option>
            `;


            const filtered =
                materials.filter(material => {

                    const materialCategoryId =
                        material.material_category_id ??
                        material.materialCategoryId;

                    const materialSubCategoryId =
                        material.material_subcategory_id ??
                        material.materialSubcategoryId;


                    if (
                        String(materialCategoryId) !==
                        String(categoryId)
                    ) {
                        return false;
                    }


                    if (subCategoryId === "NONE") {

                        return !materialSubCategoryId;
                    }


                    return (
                        String(materialSubCategoryId) ===
                        String(subCategoryId)
                    );
                });


            filtered
                .sort((a, b) => {

                    const nameA =
                        a.material_name ??
                        a.materialName ??
                        "";

                    const nameB =
                        b.material_name ??
                        b.materialName ??
                        "";

                    return String(nameA)
                        .localeCompare(String(nameB));
                })
                .forEach(material => {

                    const id =
                        material.material_id ??
                        material.materialId;

                    const code =
                        material.material_code ??
                        material.materialCode ??
                        "";

                    const name =
                        material.material_name ??
                        material.materialName ??
                        "";

                    html += `
                        <option value="${escapeAttribute(id)}">
                            ${escapeHtml(code)} - ${escapeHtml(name)}
                        </option>
                    `;
                });


            return html;
        }

                function handleCategoryChange(lineId) {

            const categoryId =
                document.getElementById(
                    `category_${lineId}`
                ).value;

            const subCategorySelect =
                document.getElementById(
                    `subcategory_${lineId}`
                );

            resetMaterialSelection(lineId);


            if (!categoryId) {

                subCategorySelect.disabled = true;

                subCategorySelect.innerHTML = `
                    <option value="">
                        Select Category First
                    </option>
                `;

                return;
            }


            subCategorySelect.innerHTML =
                getSubCategoryOptions(
                    categoryId
                );

            subCategorySelect.disabled = false;
        }


        function handleSubCategoryChange(lineId) {

            const categoryId =
                document.getElementById(
                    `category_${lineId}`
                ).value;

            const subCategoryId =
                document.getElementById(
                    `subcategory_${lineId}`
                ).value;

            const materialSelect =
                document.getElementById(
                    `material_${lineId}`
                );


            resetMaterialSelection(
                lineId,
                false
            );


            if (!categoryId ||
                !subCategoryId) {

                materialSelect.disabled = true;

                materialSelect.innerHTML = `
                    <option value="">
                        Select Subcategory First
                    </option>
                `;

                return;
            }


            materialSelect.innerHTML =
                getFilteredMaterialOptions(
                    categoryId,
                    subCategoryId
                );

            materialSelect.disabled = false;
        }

        function resetMaterialSearch(lineId) {

            const input =
                document.getElementById(
                    `materialSearch_${lineId}`
                );

            const results =
                document.getElementById(
                    `materialSearchResults_${lineId}`
                );

            if (input) {
                input.value = "";
            }

            if (results) {

                results.innerHTML = "";

                results.classList.add("d-none");
            }
        }


           function resetMaterialSelection(
        lineId,
        resetMaterialDropdown = true) {

        invalidateLotRequest(lineId);

        resetMaterialSearch(lineId);

        // Continue existing code...

                resetMaterialSearch(lineId);

            const materialSelect =
                document.getElementById(
                    `material_${lineId}`
                );

            const lotSelect =
                document.getElementById(
                    `lot_${lineId}`
                );

            if (resetMaterialDropdown) {

                materialSelect.innerHTML = `
                    <option value="">
                        Select Subcategory First
                    </option>
                `;

                materialSelect.disabled = true;
            }


            lotSelect.innerHTML = `
                <option value="">
                    Select Item First
                </option>
            `;

            lotSelect.disabled = true;


            document.getElementById(
                `materialInfo_${lineId}`
            ).textContent = "";


            document.getElementById(
                `availableStock_${lineId}`
            ).textContent = "";


            document.getElementById(
                `expiration_${lineId}`
            ).value = "—";


            document.getElementById(
                `uom_${lineId}`
            ).textContent = "UOM";


            const qtyInput =
                document.getElementById(
                    `requestedQty_${lineId}`
                );

            qtyInput.dataset.available = "";
        }

        function syncMaterialSearch(lineId, material) {

            const input =
                document.getElementById(
                    `materialSearch_${lineId}`
                );

            if (!input) {
                return;
            }

            if (!material) {

                resetMaterialSearch(lineId);

                return;
            }

            const code =
                material.material_code ??
                material.materialCode ??
                "";

            const name =
                material.material_name ??
                material.materialName ??
                "";

            input.value = code
                ? `${code} - ${name}`
                : name;

            closeMaterialSearchResults(lineId);
        }



        async function handleMaterialChange(lineId) {


        invalidateLotRequest(lineId);

        document.getElementById(
            `requestedQty_${lineId}`
        ).dataset.available = "";


            const materialId =
                Number(
                    document.getElementById(
                        `material_${lineId}`
                    ).value
                );

            const material =
                materials.find(
                    x =>
                        Number(
                            x.material_id ??
                            x.materialId
                        ) === materialId
                );
                syncMaterialSearch(lineId, material);
           
                const lotSelect =
                document.getElementById(
                    `lot_${lineId}`
                );

            const info =
                document.getElementById(
                    `materialInfo_${lineId}`
                );

            const uom =
                document.getElementById(
                    `uom_${lineId}`
                );


            document.getElementById(
                `expiration_${lineId}`
            ).value = "—";

            document.getElementById(
                `availableStock_${lineId}`
            ).textContent = "";


            if (!material) {

                info.textContent = "";

                uom.textContent = "UOM";

                lotSelect.disabled = true;

                lotSelect.innerHTML = `
                    <option value="">
                        Select Material First
                    </option>
                `;

                return;
            }


            uom.textContent =
                material.uom || "UOM";


            const isLotTracked =
                material.is_lot_tracked === true;


            info.textContent =
                isLotTracked
                    ? "Lot Tracked"
                    : "Not Lot Tracked";


            const branchId =
                document.getElementById(
                    "branchId"
                ).value;


            if (!branchId) {

                lotSelect.disabled = true;

                lotSelect.innerHTML = `
                    <option value="">
                        Select Branch First
                    </option>
                `;

                return;
            }


            await loadAvailableLots(
                lineId,
                materialId,
                branchId,
                isLotTracked
            );

        }

        function invalidateLotRequest(lineId) {

            const key = String(lineId);

            const version =
                (lotRequestVersions.get(key) ?? 0) + 1;

            lotRequestVersions.set(key, version);

            return version;
        }


        function isCurrentLotRequest(
            lineId,
            version,
            materialId,
            branchId
        ) {

            const key = String(lineId);

            const materialSelect =
                document.getElementById(
                    `material_${lineId}`
                );

            const branchSelect =
                document.getElementById("branchId");

            if (!materialSelect || !branchSelect) {
                return false;
            }

            return (
                lotRequestVersions.get(key) === version &&

                String(materialSelect.value) ===
                    String(materialId) &&

                String(branchSelect.value) ===
                    String(branchId)
            );
        }


        async function loadAvailableLots(
            lineId,
            materialId,
            branchId,
            isLotTracked) {

                    const requestVersion =
        invalidateLotRequest(lineId);

            const select =
                document.getElementById(
                    `lot_${lineId}`
                );

            select.disabled = true;

            select.innerHTML = `
                <option value="">
                    Loading...
                </option>
            `;


            try {

                const response = await fetch(
                    `/inventory/material-requisitions/available-lots` +
                    `?materialId=${materialId}` +
                    `&branchId=${encodeURIComponent(branchId)}`
                );


                if (!response.ok) {

                    throw new Error(
                        await response.text()
                    );
                }


                const lots =
                    await response.json();


        // IGNORE OUTDATED API RESPONSES

        if (!isCurrentLotRequest(
            lineId,
            requestVersion,
            materialId,
            branchId
        )) {
            return;
        }



                if (!Array.isArray(lots) ||
                    lots.length === 0) {

                    select.innerHTML = `
                        <option value="">
                            No Available Stock
                        </option>
                    `;

                    return;
                }


                if (!isLotTracked) {

                    const lot =
                        lots[0];

                    select.innerHTML = `
                        <option value="${escapeAttribute(
                            lot.materialLotId
                        )}">
                            Not Lot Tracked
                        </option>
                    `;

                    select.value =
                        String(
                            lot.materialLotId
                        );

                                document.getElementById(
            `requestedQty_${lineId}`
        ).dataset.available =
            String(lot.quantity ?? 0);

                    document.getElementById(
                        `availableStock_${lineId}`
                    ).textContent =
                        `Available: ${formatQuantity(
                            lot.quantity
                        )} ${escapeHtml(
                            lot.uom || ""
                        )}`;

                    return;
                }


                select.innerHTML = `
                    <option value="">
                        Select Lot / Batch
                    </option>
                `;


                lots.forEach(
                    function (lot) {

                        select.insertAdjacentHTML(
                            "beforeend",
                            `
                            <option
                                value="${escapeAttribute(lot.materialLotId)}"
                                data-expiration="${escapeAttribute(lot.expirationDate || "")}"
                                data-quantity="${escapeAttribute(lot.quantity || 0)}"
                                data-uom="${escapeAttribute(lot.uom || "")}">

                                ${escapeHtml(lot.lotNo)}
                                - ${formatQuantity(lot.quantity)}
                                ${escapeHtml(lot.uom || "")}

                            </option>
                            `
                        );

                    }
                );


                select.disabled = false;

            }
            catch (error) {

                console.error(error);

                select.innerHTML = `
                    <option value="">
                        Unable to Load Lots
                    </option>
                `;

            }

        }


            function handleLotChange(lineId) {

            const select =
                document.getElementById(
                    `lot_${lineId}`
                );

            const option =
                select.options[
                    select.selectedIndex
                ];

            const requestedQtyInput =
                document.getElementById(
                    `requestedQty_${lineId}`
                );

            if (!option ||
                !option.value) {

                document.getElementById(
                    `expiration_${lineId}`
                ).value = "—";

                document.getElementById(
                    `availableStock_${lineId}`
                ).textContent = "";

                requestedQtyInput.dataset.available = "";

                return;
            }

            const expiration =
                option.dataset.expiration;

            const quantity =
                Number(
                    option.dataset.quantity ??
                    0
                );

            const uom =
                option.dataset.uom ??
                "";

            requestedQtyInput.dataset.available =
                String(quantity);

            document.getElementById(
                `expiration_${lineId}`
            ).value =
                formatDate(expiration);

            document.getElementById(
                `availableStock_${lineId}`
            ).textContent =
                `Available: ${formatQuantity(quantity)} ${uom}`;
        }


        function removeMaterialLine(lineId) {

            const rows =
                document.querySelectorAll(
                    "#mrsLinesBody tr"
                );

            if (rows.length <= 1) {

                alert(
                    "At least one material line is required."
                );

                return;
            }

            document.getElementById(
                `mrsLine_${lineId}`
            )?.remove();

            lotRequestVersions.delete(String(lineId));

        }


        async function saveDraft() {

            hideAlert();

            const branchId =
                document.getElementById(
                    "branchId"
                ).value;

            const requisitionDate =
                document.getElementById(
                    "requisitionDate"
                ).value;

            if (!branchId) {

                showAlert(
                    "danger",
                    "Please select a branch."
                );

                return;
            }


            if (!requisitionDate) {

                showAlert(
                    "danger",
                    "Requisition date is required."
                );

                return;
            }


            const lines = [];

            const rows =
                document.querySelectorAll(
                    "#mrsLinesBody tr"
                );


            for (const row of rows) {

                const lineId =
                    row.id.replace(
                        "mrsLine_",
                        ""
                    );

                const materialId =
                    Number(
                        document.getElementById(
                            `material_${lineId}`
                        ).value
                    );

                const requestedQty =
                    Number(
                        document.getElementById(
                            `requestedQty_${lineId}`
                        ).value
                    );


                if (!materialId) {

                    showAlert(
                        "danger",
                        "Please select a material for every line."
                    );

                    return;
                }


                if (!requestedQty ||
                    requestedQty <= 0) {

                    showAlert(
                        "danger",
                        "Requested quantity must be greater than zero."
                    );

                    return;
                }

                        const requestedQtyInput =
            document.getElementById(
                `requestedQty_${lineId}`
            );

        const availableQty =
            Number(
                requestedQtyInput.dataset.available ??
                0
            );

        if (availableQty <= 0) {

            showAlert(
                "danger",
                "The selected material has no available stock."
            );

            return;
        }

        if (requestedQty > availableQty) {

            showAlert(
                "danger",
                `Requested quantity cannot exceed available stock of ${formatQuantity(availableQty)}.`
            );

            requestedQtyInput.focus();

            return;
        }




                const material =
                    materials.find(
                        x =>
                            Number(
                                x.material_id ??
                                x.materialId
                            ) === materialId
                    );


                const materialLotIdValue =
                    document.getElementById(
                        `lot_${lineId}`
                    ).value;


                if (material?.is_lot_tracked &&
                    !materialLotIdValue) {

                    showAlert(
                        "danger",
                        "Please select a lot/batch for lot-tracked materials."
                    );

                    return;
                }


                lines.push({

                    materialId:
                        materialId,

                    materialLotId:
                        materialLotIdValue
                            ? Number(
                                materialLotIdValue
                            )
                            : null,

                    lotNo:
                        null,

                    requestedQuantity:
                        requestedQty,

                    remarks:
                        document.getElementById(
                            `lineRemarks_${lineId}`
                        ).value.trim()

                });

            }


            const date =
                requisitionDate;


            const timeRequested =
                document.getElementById(
                    "timeRequested"
                ).value;


                   const dto = {

            branchId:
                branchId,

            requisitionDate:
                `${date}T00:00:00`,

            timeRequested:
                timeRequested
                    ? `${date}T${timeRequested}:00`
                    : null,

            remarks:
                document.getElementById(
                    "mrsRemarks"
                ).value.trim() || null,

            lines:
                lines
        };


            setSaving(true);


            try {

                const response =
                    await fetch(
                        "/inventory/material-requisitions/create",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify(dto)
                        }
                    );


                const result =
                    await response.json();


                if (!response.ok) {

                    throw new Error(
                        result.message ??
                        "Unable to save material requisition."
                    );
                }


                window.location.href =
                    `/inventory/material-requisitions/${result.requisitionId}`;

            }
            catch (error) {

                console.error(error);

                showAlert(
                    "danger",
                    error.message
                );

            }
            finally {

                setSaving(false);
            }

        }


        function setSaving(value) {

            document.getElementById(
                "btnSaveDraft"
            ).disabled =
                value;

            document.getElementById(
                "saveSpinner"
            ).classList.toggle(
                "d-none",
                !value
            );

        }


        function showAlert(type, message) {

            const alert =
                document.getElementById(
                    "mrsAlert"
                );

            alert.className =
                `alert alert-${type}`;

            alert.textContent =
                message;

            alert.classList.remove(
                "d-none"
            );

        }


        function hideAlert() {

            document.getElementById(
                "mrsAlert"
            ).classList.add(
                "d-none"
            );

        }


        function formatQuantity(value) {

            return Number(
                value ?? 0
            ).toLocaleString(
                "en-PH",
                {
                    maximumFractionDigits: 4
                }
            );

        }


        function formatDate(value) {

            if (!value) {
                return "—";
            }

            const date =
                new Date(value);

            if (
                Number.isNaN(
                    date.getTime()
                )
            ) {
                return "—";
            }

            return date.toLocaleDateString(
                "en-PH"
            );

        }


        function escapeHtml(value) {

            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");

        }


        function escapeAttribute(value) {

            return escapeHtml(value);

        }

    </script>

}