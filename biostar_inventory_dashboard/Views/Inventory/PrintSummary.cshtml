@model List<biostar_inventory_dashboard.Models.InventoryPrintSummaryDto>

@{
    Layout = null;
    ViewData["Title"] = "Daily Inventory";

    var inventoryItems =
        Model ?? new List<biostar_inventory_dashboard.Models.InventoryPrintSummaryDto>();

    /*
     * Number of report lines placed on each half of a Legal landscape page.
     * A category heading also counts as one line.
     */
    const int linesPerSide = 40;

    var reportColumns = BuildReportColumns(
        inventoryItems,
        linesPerSide
    );

    int totalPages = reportColumns.Count == 0
        ? 1
        : (int)Math.Ceiling(reportColumns.Count / 2.0);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Daily Inventory</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #ffffff;
            color: #000000;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            padding: 10px;
        }

        .print-toolbar {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 10px;
        }

        .print-toolbar button {
            padding: 7px 15px;
            border: 1px solid #444444;
            border-radius: 4px;
            background: #ffffff;
            color: #111111;
            cursor: pointer;
            font-size: 13px;
        }

        .print-toolbar .btn-print {
            background: #111111;
            color: #ffffff;
        }

        /*
         * Browser preview width only.
         * This fixed width is removed completely when printing.
         */
        .report-page {
            width: 13.5in;
            max-width: 100%;
            margin: 0 auto 12px auto;
            padding: 0.20in;
            background: #ffffff;
        }

        .report-header {
            position: relative;
            min-height: 0.34in;
            text-align: center;
        }

        .report-title {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.1;
        }

        .report-subtitle {
            margin-top: 1px;
            font-size: 8px;
        }

        .generated-info {
            position: absolute;
            top: 0;
            right: 0;
            font-size: 7px;
            text-align: right;
        }

        .report-meta {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            min-height: 0.30in;
            margin-bottom: 3px;
            font-size: 7px;
            line-height: 1.3;
        }

        .report-meta-right {
            text-align: right;
        }

        .meta-label {
            font-weight: 700;
        }

        .inventory-table {
            width: 100%;
            margin: 0;
            border-collapse: collapse;
            table-layout: fixed;
        }

        /*
         * The six columns total exactly 100%.
         * Each half of the page totals 50%.
         */
        .inventory-table th.left-product,
        .inventory-table td.left-product,
        .inventory-table th.right-product,
        .inventory-table td.right-product {
            width: 39.5%;
        }

        .inventory-table th.left-qty,
        .inventory-table td.left-qty,
        .inventory-table th.right-qty,
        .inventory-table td.right-qty {
            width: 4%;
        }

        .inventory-table th.left-pack,
        .inventory-table td.left-pack,
        .inventory-table th.right-pack,
        .inventory-table td.right-pack {
            width: 6.5%;
        }

        .inventory-table th,
        .inventory-table td {
            height: 17px;
            border: 1px solid #555555;
            padding: 1px 3px;
            overflow: hidden;
            vertical-align: middle;
            font-size: 7.5px;
            line-height: 1;
        }

        .inventory-table th {
            background: #eeeeee;
            text-align: center;
            font-weight: 700;
            white-space: nowrap;
        }

        .inventory-table tr {
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .middle-divider {
            border-left: 2px solid #333333 !important;
        }

        .category-cell {
            height: 18px !important;
            padding: 2px 4px !important;
            background: #f2c54b;
            font-size: 8px !important;
            font-weight: 700;
            text-transform: uppercase;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .product-name {
            display: block;
            width: 100%;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            font-size: 7.6px;
            font-weight: 700;
            line-height: 1;
        }

        .product-description {
            display: block;
            width: 100%;
            margin-top: 1px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            color: #555555;
            font-size: 6.7px;
            line-height: 1;
        }

        .left-qty,
        .right-qty,
        .left-pack,
        .right-pack {
            text-align: right;
            white-space: nowrap;
        }

        .quantity-text,
        .pack-text {
            display: block;
            width: 100%;
            overflow: hidden;
            white-space: nowrap;
            text-align: right;
            font-weight: 700;
        }

        .zero-stock {
            color: #777777;
            font-weight: 400;
        }

        .blank-cell {
            background: #ffffff;
        }

        .no-data {
            padding: 20px !important;
            text-align: center;
            font-size: 12px !important;
        }

        .page-footer {
            display: flex;
            justify-content: space-between;
            margin-top: 3px;
            font-size: 6.2px;
            color: #444444;
        }

        @@media print {

            @@page {
                size: legal landscape;
                margin: 0 !important;
            }

            html,
            body {
                margin: 0 !important;
                padding: 0 !important;
                width: 14in !important;
                background: white !important;
            }

            body {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .print-toolbar {
                display: none !important;
            }
            /*
             * Do not use margin-left.
             *
             * The Epson IPP driver appears to ignore or miscalculate it.
             * This creates actual blank space INSIDE the printed page.
             */
            .report-page {
                display: block !important;
                width: 14in !important;
                max-width: 14in !important;
                min-width: 14in !important;
                margin: 0 !important;
                padding-top: 0.30in !important;
                padding-right: 0.50in !important;
                padding-bottom: 0.30in !important;
                padding-left: 1.75in !important;
                box-sizing: border-box !important;
                background: white !important;
                overflow: visible !important;
                page-break-after: always !important;
                break-after: page !important;
            }

                .report-page:last-child {
                    page-break-after: auto !important;
                    break-after: auto !important;
                }
            /*
             * Actual usable width:
             *
             * 14in paper
             * - 1.75in left safety area
             * - 0.50in right safety area
             * = 11.75in content area
             */
            .report-header,
            .report-meta,
            .page-footer,
            .inventory-table {
                width: 100% !important;
                max-width: 100% !important;
                min-width: 0 !important;
                margin: 0 !important;
            }

            .inventory-table {
                border-collapse: collapse !important;
                table-layout: fixed !important;
            }

                .inventory-table th.left-product,
                .inventory-table td.left-product,
                .inventory-table th.right-product,
                .inventory-table td.right-product {
                    width: 39.5% !important;
                }

                .inventory-table th.left-qty,
                .inventory-table td.left-qty,
                .inventory-table th.right-qty,
                .inventory-table td.right-qty {
                    width: 4% !important;
                }

                .inventory-table th.left-pack,
                .inventory-table td.left-pack,
                .inventory-table th.right-pack,
                .inventory-table td.right-pack {
                    width: 6.5% !important;
                }

                .inventory-table th,
                .inventory-table td {
                    height: 15px !important;
                    min-width: 0 !important;
                    border: 1px solid #555555 !important;
                    padding: 1px 2px !important;
                    overflow: hidden !important;
                    vertical-align: middle !important;
                    font-size: 6.5px !important;
                    line-height: 1 !important;
                }

                    .inventory-table th.left-product,
                    .inventory-table td.left-product {
                        padding-left: 5px !important;
                    }

                    .inventory-table th.left-qty,
                    .inventory-table td.left-qty,
                    .inventory-table th.right-qty,
                    .inventory-table td.right-qty,
                    .inventory-table th.left-pack,
                    .inventory-table td.left-pack,
                    .inventory-table th.right-pack,
                    .inventory-table td.right-pack {
                        padding-left: 1px !important;
                        padding-right: 1px !important;
                        text-align: right !important;
                        white-space: nowrap !important;
                        font-size: 5.9px !important;
                    }

            .product-name {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                overflow: hidden !important;
                white-space: nowrap !important;
                text-overflow: ellipsis !important;
                font-size: 6.7px !important;
                font-weight: 700 !important;
                line-height: 1 !important;
            }

            .product-description {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
                margin: 1px 0 0 0 !important;
                padding: 0 !important;
                overflow: hidden !important;
                white-space: nowrap !important;
                text-overflow: ellipsis !important;
                font-size: 5.9px !important;
                line-height: 1 !important;
            }

            .quantity-text,
            .pack-text {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
                overflow: hidden !important;
                white-space: nowrap !important;
                text-align: right !important;
            }

            .category-cell {
                height: 16px !important;
                padding: 2px 5px !important;
                font-size: 7px !important;
                line-height: 1 !important;
            }

            .middle-divider {
                border-left: 2px solid #333333 !important;
            }

            .inventory-table tr {
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

            .inventory-table th,
            .category-cell {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }
    </style>
</head>

<body>

    <div class="print-toolbar">
        <button type="button"
                onclick="window.close()">
            Close
        </button>

        <button type="button"
                class="btn-print"
                onclick="window.print()">
            Print
        </button>
    </div>

    @if (reportColumns.Count == 0)
    {
        <section class="report-page">

            <div class="report-header">
                <h1 class="report-title">
                    DAILY INVENTORY
                </h1>

                <div class="report-subtitle">
                    Product Inventory Summary
                </div>
            </div>

            <table class="inventory-table">
                <tbody>
                    <tr>
                        <td colspan="6" class="no-data">
                            No inventory products found.
                        </td>
                    </tr>
                </tbody>
            </table>

        </section>
    }
    else
    {
        @for (int pageIndex = 0;
              pageIndex < totalPages;
              pageIndex++)
        {
            int leftColumnIndex = pageIndex * 2;
            int rightColumnIndex = leftColumnIndex + 1;

            var leftColumn = reportColumns[leftColumnIndex];

            var rightColumn =
                rightColumnIndex < reportColumns.Count
                    ? reportColumns[rightColumnIndex]
                    : new List<InventoryReportLine>();

            int rowsOnPage = Math.Max(
                leftColumn.Count,
                rightColumn.Count
            );

            <section class="report-page">

                <div class="report-header">

                    <h1 class="report-title">
                        DAILY INVENTORY
                    </h1>

                    <div class="report-subtitle">
                        Product Inventory Summary
                    </div>

                    <div class="generated-info">
                        <div>
                            <span class="meta-label">
                                Generated:
                            </span>

                            @ViewBag.GeneratedAt
                        </div>
                    </div>

                </div>

                <div class="report-meta">

                    <div>
                        <div>
                            <span class="meta-label">
                                Warehouse:
                            </span>

                            @ViewBag.Warehouse
                        </div>

                        <div>
                            <span class="meta-label">
                                Category:
                            </span>

                            @ViewBag.Category
                        </div>
                    </div>

                    <div class="report-meta-right">
                        <div>
                            <span class="meta-label">
                                Total Products:
                            </span>

                            @ViewBag.TotalRecords
                        </div>

                        <div>
                            <span class="meta-label">
                                Printed By:
                            </span>

                            @ViewBag.PrintedBy
                        </div>
                    </div>

                </div>

                <table class="inventory-table">

                    <thead>
                        <tr>
                            <th class="left-product">
                                Product / Description
                            </th>

                            <th class="left-qty">
                                Qty
                            </th>

                            <th class="left-pack">
                                Pack
                            </th>

                            <th class="right-product middle-divider">
                                Product / Description
                            </th>

                            <th class="right-qty">
                                Qty
                            </th>

                            <th class="right-pack">
                                Pack
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @for (int rowIndex = 0;
                              rowIndex < rowsOnPage;
                              rowIndex++)
                        {
                            InventoryReportLine leftLine =
                                rowIndex < leftColumn.Count
                                    ? leftColumn[rowIndex]
                                    : null;

                            InventoryReportLine rightLine =
                                rowIndex < rightColumn.Count
                                    ? rightColumn[rowIndex]
                                    : null;

                            <tr>

                                @* LEFT SIDE *@

                                @if (leftLine == null)
                                {
                                    <td class="blank-cell"></td>
                                    <td class="blank-cell"></td>
                                    <td class="blank-cell"></td>
                                }
                                else if (leftLine.IsCategory)
                                {
                                    <td colspan="3"
                                        class="category-cell">
                                        @leftLine.CategoryName
                                    </td>
                                }
                                else if (leftLine.Item != null)
                                {
                                    var item = leftLine.Item;
                                    bool hasStock = item.available_qty > 0;

                                    <td class="left-product">

                                        <div class="product-name">
                                            @(string.IsNullOrWhiteSpace(item.product_name)
                                                ? "-"
                                                : item.product_name)
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.product_description))
                                        {
                                            <div class="product-description">
                                                @item.product_description
                                            </div>
                                        }

                                    </td>

                                    <td class="left-qty">

                                        <span class="quantity-text @(hasStock ? "" : "zero-stock")">
                                            @FormatNumber(item.available_qty)

                                            @if (!string.IsNullOrWhiteSpace(item.uom))
                                            {
                                                <text> @item.uom</text>
                                            }
                                        </span>

                                    </td>

                                    <td class="left-pack">

                                        <span class="pack-text @(hasStock ? "" : "zero-stock")">
                                            @GetPackDisplay(item)
                                        </span>

                                    </td>
                                }

                                @* RIGHT SIDE *@

                                @if (rightLine == null)
                                {
                                    <td class="blank-cell middle-divider"></td>
                                    <td class="blank-cell"></td>
                                    <td class="blank-cell"></td>
                                }
                                else if (rightLine.IsCategory)
                                {
                                    <td colspan="3"
                                        class="category-cell middle-divider">
                                        @rightLine.CategoryName
                                    </td>
                                }
                                else if (rightLine.Item != null)
                                {
                                    var item = rightLine.Item;
                                    bool hasStock = item.available_qty > 0;

                                    <td class="right-product middle-divider">

                                        <div class="product-name">
                                            @(string.IsNullOrWhiteSpace(item.product_name)
                                                ? "-"
                                                : item.product_name)
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.product_description))
                                        {
                                            <div class="product-description">
                                                @item.product_description
                                            </div>
                                        }

                                    </td>

                                    <td class="right-qty">

                                        <span class="quantity-text @(hasStock ? "" : "zero-stock")">
                                            @FormatNumber(item.available_qty)

                                            @if (!string.IsNullOrWhiteSpace(item.uom))
                                            {
                                                <text> @item.uom</text>
                                            }
                                        </span>

                                    </td>

                                    <td class="right-pack">

                                        <span class="pack-text @(hasStock ? "" : "zero-stock")">
                                            @GetPackDisplay(item)
                                        </span>

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>
                </table>

                <div class="page-footer">

                    <div>
                        Available quantities are grouped by product.
                    </div>

                    <div>
                        Page @(pageIndex + 1) of @totalPages
                    </div>

                </div>

            </section>
        }
    }

</body>
</html>

@functions {

    public class InventoryReportLine
    {
        public bool IsCategory { get; set; }

        public string CategoryName { get; set; } = "";

        public biostar_inventory_dashboard.Models.InventoryPrintSummaryDto Item
        {
            get;
            set;
        }
    }

    public List<List<InventoryReportLine>> BuildReportColumns(
        List<biostar_inventory_dashboard.Models.InventoryPrintSummaryDto> items,
        int linesPerSide)
    {
        var columns =
            new List<List<InventoryReportLine>>();

        var currentColumn =
            new List<InventoryReportLine>();

        var groupedCategories = items
            .GroupBy(x =>
                string.IsNullOrWhiteSpace(x.category_name)
                    ? "UNCATEGORIZED"
                    : x.category_name.Trim())
            .OrderBy(x => x.Key)
            .ToList();

        foreach (var categoryGroup in groupedCategories)
        {
            var categoryItems = categoryGroup
                .OrderBy(x => x.product_name)
                .ThenBy(x => x.product_description)
                .ToList();

            /*
             * Prevent a category heading from becoming
             * the final line in a report column.
             */
            if (currentColumn.Count >= linesPerSide - 1)
            {
                columns.Add(currentColumn);

                currentColumn =
                    new List<InventoryReportLine>();
            }

            currentColumn.Add(
                new InventoryReportLine
                {
                    IsCategory = true,
                    CategoryName = categoryGroup.Key
                }
            );

            foreach (var item in categoryItems)
            {
                if (currentColumn.Count >= linesPerSide)
                {
                    columns.Add(currentColumn);

                    currentColumn =
                        new List<InventoryReportLine>();

                    currentColumn.Add(
                        new InventoryReportLine
                        {
                            IsCategory = true,
                            CategoryName =
                                categoryGroup.Key + " - CONTINUED"
                        }
                    );
                }

                currentColumn.Add(
                    new InventoryReportLine
                    {
                        IsCategory = false,
                        Item = item
                    }
                );
            }
        }

        if (currentColumn.Count > 0)
        {
            columns.Add(currentColumn);
        }

        return columns;
    }

    public string FormatNumber(decimal value)
    {
        return value % 1 == 0
            ? value.ToString("0")
            : value.ToString("0.##");
    }

    public string GetPackDisplay(
        biostar_inventory_dashboard.Models.InventoryPrintSummaryDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.pack_display))
        {
            return item.pack_display;
        }

        if (item.available_qty <= 0)
        {
            if (!string.IsNullOrWhiteSpace(item.pack_uom))
            {
                return $"0 {item.pack_uom}";
            }

            if (!string.IsNullOrWhiteSpace(item.uom))
            {
                return $"0 {item.uom}";
            }

            return "0";
        }

        return
            $"{FormatNumber(item.available_qty)} {item.uom}".Trim();
    }
}
