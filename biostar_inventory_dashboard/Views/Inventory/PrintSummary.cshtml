@model List<biostar_inventory_dashboard.Models.InventoryPrintSummaryDto>

@{
    Layout = null;
    ViewData["Title"] = "Daily Inventory";

    var inventoryItems =
        Model ?? new List<biostar_inventory_dashboard.Models.InventoryPrintSummaryDto>();

    /*
     * Number of lines in each side of the page.
     *
     * One category heading also counts as one line.
     * Increase this to fit more products per page.
     *
     * Recommended:
     * 36 = larger rows
     * 40 = balanced
     * 44 = compact
     */
    const int linesPerSide = 40;

    var reportColumns = BuildReportColumns(
        inventoryItems,
        linesPerSide
    );

    int totalPages = reportColumns.Count == 0
        ? 1
        : (int)Math.Ceiling(reportColumns.Count / 2.0);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Daily Inventory</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #ffffff;
            color: #000000;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            padding: 10px;
        }

        /* Screen toolbar */
        .print-toolbar {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 10px;
        }

            .print-toolbar button {
                padding: 7px 15px;
                border: 1px solid #444444;
                border-radius: 4px;
                background: #ffffff;
                color: #111111;
                cursor: pointer;
                font-size: 13px;
            }

            .print-toolbar .btn-print {
                background: #111111;
                color: #ffffff;
            }

        /* Legal landscape page */
        .report-page {
            width: 14in;
            height: 8.5in;
            margin: 0 auto 18px;
            padding: 0.25in 0.35in;
            overflow: hidden;
            background: #ffffff;
            page-break-inside: avoid;
            break-inside: avoid;
        }

            .report-page + .report-page {
                page-break-before: always;
                break-before: page;
            }

        /* Header */
        .report-header {
            position: relative;
            min-height: 0.34in;
            margin: 0;
            text-align: center;
        }

        .report-title {
            margin: 0;
            padding: 0;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: 0.5px;
        }

        .report-subtitle {
            margin-top: 1px;
            font-size: 8px;
            line-height: 1;
        }

        .generated-info {
            position: absolute;
            top: 0;
            right: 0;
            font-size: 7px;
            line-height: 1.3;
            text-align: right;
        }

        /* Report details */
        .report-meta {
            min-height: 0.30in;
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: start;
            margin: 0 0 3px;
            font-size: 7px;
            line-height: 1.3;
        }

        .report-meta-right {
            text-align: right;
        }

        .meta-label {
            font-weight: 700;
        }

        /* Two-column page */
        .print-columns {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            column-gap: 0.08in;
            width: 100%;
            align-items: start;
        }

        .print-column {
            min-width: 0;
            overflow: hidden;
        }

        /* Inventory table */
        .inventory-table {
            width: 100%;
            margin: 0;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .inventory-table col.product-col {
                width: 71%;
            }

            .inventory-table col.qty-col {
                width: 13%;
            }

            .inventory-table col.pack-col {
                width: 16%;
            }

            .inventory-table th,
            .inventory-table td {
                height: 15px;
                border: 1px solid #555555;
                padding: 1px 2px;
                overflow: hidden;
                vertical-align: middle;
                font-size: 6.7px;
                line-height: 1;
            }

            .inventory-table th {
                background: #eeeeee;
                text-align: center;
                font-weight: 700;
            }

            .inventory-table tr {
                page-break-inside: avoid;
                break-inside: avoid;
            }

        /* Category heading */
        .category-cell {
            height: 16px !important;
            padding: 2px 4px !important;
            background: #f2c54b;
            font-size: 7.2px !important;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Product details */
        .product-name {
            overflow: hidden;
            font-size: 6.9px;
            font-weight: 700;
            line-height: 1;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .product-description {
            overflow: hidden;
            margin-top: 1px;
            color: #555555;
            font-size: 6px;
            line-height: 1;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        /* Quantity and pack */
        .qty-cell,
        .pack-cell {
            text-align: right;
            white-space: nowrap;
        }

        .quantity-text,
        .pack-text {
            display: inline-block;
            font-weight: 700;
            white-space: nowrap;
        }

        .zero-stock {
            color: #777777;
            font-weight: 400;
        }

        /* Empty state */
        .no-data {
            padding: 20px !important;
            text-align: center;
            color: #666666;
            font-size: 10px !important;
        }

        /* Footer */
        .page-footer {
            display: flex;
            justify-content: space-between;
            min-height: 0.16in;
            margin-top: 3px;
            font-size: 6.2px;
            line-height: 1;
            color: #444444;
        }

        /* Print */
        @@media print {
            @@page {
                size: 14in 8.5in;
                margin: 0;
            }

            html,
            body {
                width: 14in;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff;
            }

            body {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .print-toolbar {
                display: none !important;
            }

            .report-page {
                width: 14in !important;
                height: 8.5in !important;
                margin: 0 !important;
                padding: 0.25in 0.35in !important;
                overflow: hidden !important;
                page-break-after: always;
                break-after: page;
                page-break-inside: avoid;
                break-inside: avoid;
            }

                .report-page:last-child {
                    page-break-after: auto;
                    break-after: auto;
                }

            .print-columns {
                display: grid !important;
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
                column-gap: 0.08in !important;
                width: 100% !important;
            }

            .print-column {
                min-width: 0 !important;
                overflow: hidden !important;
            }

            .inventory-table {
                width: 100% !important;
                margin: 0 !important;
                border-collapse: collapse !important;
                table-layout: fixed !important;
            }

                .inventory-table th,
                .inventory-table td {
                    height: 15px !important;
                    padding: 1px 2px !important;
                    font-size: 6.7px !important;
                    line-height: 1 !important;
                }

                .inventory-table tr {
                    page-break-inside: avoid !important;
                    break-inside: avoid !important;
                }

                .inventory-table th,
                .category-cell {
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }
        }
    </style>
</head>

<body>

    <div class="print-toolbar">
        <button type="button"
                onclick="window.close()">
            Close
        </button>

        <button type="button"
                class="btn-print"
                onclick="window.print()">
            Print
        </button>
    </div>

    @if (reportColumns.Count == 0)
    {
        <section class="report-page">

            <div class="report-header">
                <h1 class="report-title">
                    DAILY INVENTORY
                </h1>

                <div class="report-subtitle">
                    Product Inventory Summary
                </div>
            </div>

            <table class="inventory-table">
                <tbody>
                    <tr>
                        <td colspan="6" class="no-data">
                            No inventory products found.
                        </td>
                    </tr>
                </tbody>
            </table>

        </section>
    }
    else
    {
        @for (int pageIndex = 0;
            pageIndex < totalPages;
            pageIndex++)
        {
            int leftColumnIndex = pageIndex * 2;
            int rightColumnIndex = leftColumnIndex + 1;

            var leftColumn = reportColumns[leftColumnIndex];

            var rightColumn =
            rightColumnIndex < reportColumns.Count
            ? reportColumns[rightColumnIndex]
            : new List<InventoryReportLine>();

            int rowsOnPage = Math.Max(
            leftColumn.Count,
            rightColumn.Count
            );

            <section class="report-page">

                <div class="report-header">

                    <h1 class="report-title">
                        DAILY INVENTORY
                    </h1>

                    <div class="report-subtitle">
                        Product Inventory Summary
                    </div>

                    <div class="generated-info">
                        <div>
                            <span class="meta-label">
                                Generated:
                            </span>

                            @ViewBag.GeneratedAt
                        </div>
                    </div>

                </div>

                <div class="report-meta">

                    <div>
                        <div>
                            <span class="meta-label">
                                Warehouse:
                            </span>

                            @ViewBag.Warehouse
                        </div>

                        <div>
                            <span class="meta-label">
                                Category:
                            </span>

                            @ViewBag.Category
                        </div>
                    </div>

                    <div class="report-meta-right">
                        <div>
                            <span class="meta-label">
                                Total Products:
                            </span>

                            @ViewBag.TotalRecords
                        </div>

                        <div>
                            <span class="meta-label">
                                Printed By:
                            </span>

                            @ViewBag.PrintedBy
                        </div>
                    </div>

                </div>

                <table class="inventory-table">

                    <thead>
                        <tr>
                            <th class="left-product">
                                Product / Description
                            </th>

                            <th class="left-qty">
                                Qty
                            </th>

                            <th class="left-pack">
                                Pack
                            </th>

                            <th class="right-product middle-divider">
                                Product / Description
                            </th>

                            <th class="right-qty">
                                Qty
                            </th>

                            <th class="right-pack">
                                Pack
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @for (int rowIndex = 0;
                                        rowIndex < rowsOnPage;
                                        rowIndex++)
                        {
                            InventoryReportLine leftLine =
                            rowIndex < leftColumn.Count
                            ? leftColumn[rowIndex]
                            : null;

                            InventoryReportLine rightLine =
                            rowIndex < rightColumn.Count
                            ? rightColumn[rowIndex]
                            : null;

                            <tr>

                                @* LEFT SIDE *@

                                @if (leftLine == null)
                                {
                                    <td class="blank-cell"></td>
                                    <td class="blank-cell"></td>
                                    <td class="blank-cell"></td>
                                }
                                else if (leftLine.IsCategory)
                                {
                                    <td colspan="3"
                                        class="category-cell">
                                        @leftLine.CategoryName
                                    </td>
                                }
                                else if (leftLine.Item != null)
                                {
                                    var item = leftLine.Item;
                                    bool hasStock =
                                    item.available_qty > 0;

                                    <td class="left-product">

                                        <div class="product-name">
                                            @(string.IsNullOrWhiteSpace(
                                                                        item.product_name)
                                                                        ? "-"
                                                                        : item.product_name)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                                                item.product_description))
                                        {
                                            <div class="product-description">
                                                @item.product_description
                                            </div>
                                        }

                                    </td>

                                    <td class="left-qty">

                                        <span class="quantity-text @(hasStock ? "" : "zero-stock")">
                                            @FormatNumber(item.available_qty)

                                            @if (!string.IsNullOrWhiteSpace(item.uom))
                                            {
                                                <text> @item.uom</text>
                                            }
                                        </span>

                                    </td>

                                    <td class="left-pack">

                                        <span class="pack-text @(hasStock ? "" : "zero-stock")">
                                            @GetPackDisplay(item)
                                        </span>

                                    </td>
                                }

                                @* RIGHT SIDE *@

                                @if (rightLine == null)
                                {
                                    <td class="blank-cell middle-divider"></td>
                                    <td class="blank-cell"></td>
                                    <td class="blank-cell"></td>
                                }
                                else if (rightLine.IsCategory)
                                {
                                    <td colspan="3"
                                        class="category-cell middle-divider">
                                        @rightLine.CategoryName
                                    </td>
                                }
                                else if (rightLine.Item != null)
                                {
                                    var item = rightLine.Item;
                                    bool hasStock =
                                    item.available_qty > 0;

                                    <td class="right-product middle-divider">

                                        <div class="product-name">
                                            @(string.IsNullOrWhiteSpace(
                                                                        item.product_name)
                                                                        ? "-"
                                                                        : item.product_name)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                                                item.product_description))
                                        {
                                            <div class="product-description">
                                                @item.product_description
                                            </div>
                                        }

                                    </td>

                                    <td class="right-qty">

                                        <span class="quantity-text @(hasStock ? "" : "zero-stock")">
                                            @FormatNumber(item.available_qty)

                                            @if (!string.IsNullOrWhiteSpace(item.uom))
                                            {
                                                <text> @item.uom</text>
                                            }
                                        </span>

                                    </td>

                                    <td class="right-pack">

                                        <span class="pack-text @(hasStock ? "" : "zero-stock")">
                                            @GetPackDisplay(item)
                                        </span>

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>
                </table>

                <div class="page-footer">

                    <div>
                        Available quantities are grouped by product.
                    </div>

                    <div>
                        Page @(pageIndex + 1) of @totalPages
                    </div>

                </div>

            </section>
        }
    }

</body>
</html>

@functions {

    public class InventoryReportLine
    {
        public bool IsCategory { get; set; }

        public string CategoryName { get; set; } = "";

        public biostar_inventory_dashboard.Models.InventoryPrintSummaryDto
            Item
        { get; set; }
    }

    public List<List<InventoryReportLine>> BuildReportColumns(
        List<biostar_inventory_dashboard.Models.InventoryPrintSummaryDto> items,
        int linesPerSide)
    {
        var columns =
            new List<List<InventoryReportLine>>();

        var currentColumn =
            new List<InventoryReportLine>();

        var groupedCategories = items
            .GroupBy(x =>
                string.IsNullOrWhiteSpace(x.category_name)
                    ? "UNCATEGORIZED"
                    : x.category_name.Trim())
            .OrderBy(x => x.Key)
            .ToList();

        foreach (var categoryGroup in groupedCategories)
        {
            var categoryItems = categoryGroup
                .OrderBy(x => x.product_name)
                .ThenBy(x => x.product_description)
                .ToList();

            /*
             * Do not leave the category title as the
             * final line of a column.
             */
            if (currentColumn.Count >= linesPerSide - 1)
            {
                columns.Add(currentColumn);

                currentColumn =
                    new List<InventoryReportLine>();
            }

            currentColumn.Add(
                new InventoryReportLine
                {
                    IsCategory = true,
                    CategoryName = categoryGroup.Key
                }
            );

            foreach (var item in categoryItems)
            {
                if (currentColumn.Count >= linesPerSide)
                {
                    columns.Add(currentColumn);

                    currentColumn =
                        new List<InventoryReportLine>();

                    currentColumn.Add(
                        new InventoryReportLine
                        {
                            IsCategory = true,
                            CategoryName =
                                categoryGroup.Key + " - CONTINUED"
                        }
                    );
                }

                currentColumn.Add(
                    new InventoryReportLine
                    {
                        IsCategory = false,
                        Item = item
                    }
                );
            }
        }

        if (currentColumn.Count > 0)
        {
            columns.Add(currentColumn);
        }

        return columns;
    }

    public string FormatNumber(decimal value)
    {
        return value % 1 == 0
            ? value.ToString("0")
            : value.ToString("0.##");
    }

    public string GetPackDisplay(
        biostar_inventory_dashboard.Models.InventoryPrintSummaryDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.pack_display))
        {
            return item.pack_display;
        }

        if (item.available_qty <= 0)
        {
            if (!string.IsNullOrWhiteSpace(item.pack_uom))
            {
                return $"0 {item.pack_uom}";
            }

            if (!string.IsNullOrWhiteSpace(item.uom))
            {
                return $"0 {item.uom}";
            }

            return "0";
        }

        return
            $"{FormatNumber(item.available_qty)} {item.uom}".Trim();
    }
}