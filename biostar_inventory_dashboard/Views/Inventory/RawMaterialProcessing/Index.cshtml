    async function loadMaterialProcessing() {

        const tbody =
            document.getElementById(
                "materialTableBody"
            );

        try {

            const response =
                await fetch(
                    "/inventory/raw-material-processing/list"
                );

            const data =
                await response.json();

            if (!response.ok) {
                throw new Error(
                    data.message ??
                    "Failed to load materials."
                );
            }

            materialProcessingList =
                Array.isArray(data)
                    ? data
                    : [];

            updateMaterialSummary();
            renderMaterialTable();

        }
        catch (error) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="10"
                        class="text-center text-danger py-4">
                        ${escapeHtml(error.message)}
                    </td>
                </tr>
            `;
        }
    }


    function updateMaterialSummary() {

        const onHold =
            materialProcessingList.filter(x =>
                normalizeStatus(x.status) ===
                "WAITING_FOR_QA_RELEASE"
            ).length;

        const released =
            materialProcessingList.filter(x =>
                normalizeStatus(x.status) ===
                "RELEASED"
            ).length;

        const lots =
            materialProcessingList.reduce(
                (total, x) =>
                    total +
                    (
                        Array.isArray(x.lines)
                            ? x.lines.length
                            : 0
                    ),
                0
            );

        document.getElementById(
            "onHoldCount"
        ).innerText = onHold;

        document.getElementById(
            "releasedCount"
        ).innerText = released;

        document.getElementById(
            "lotCount"
        ).innerText = lots;
    }


    function renderMaterialTable() {

        const tbody =
            document.getElementById(
                "materialTableBody"
            );

        const search =
            document.getElementById(
                "materialSearch"
            ).value
            .trim()
            .toLowerCase();

        const statusFilter =
            normalizeStatus(
                document.getElementById(
                    "materialStatusFilter"
                ).value
            );

        const rows = [];

        for (
            const header of materialProcessingList
        ) {

            const headerStatus =
                normalizeStatus(
                    header.status
                );

                    if (headerStatus === "COMPLETED") {
        continue;
    }

            if (
                statusFilter &&
                headerStatus !== statusFilter
            ) {
                continue;
            }


            const lines =
                Array.isArray(header.lines)
                    ? header.lines
                    : [];

            for (const line of lines) {

                const searchText = [
                    header.quarantineNo,
                    header.qcNo,
                    header.incomingNo,
                    header.supplierName,
                    line.materialCode,
                    line.materialName,
                    line.lotNo
                ]
                .filter(Boolean)
                .join(" ")
                .toLowerCase();


                if (
                    search &&
                    !searchText.includes(search)
                ) {
                    continue;
                }


                rows.push({
                    header,
                    line
                });
            }
        }


        if (rows.length === 0) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="10"
                        class="text-center text-muted py-4">
                        No materials found.
                    </td>
                </tr>
            `;

            return;
        }


        tbody.innerHTML = rows
            .map(x => {

                const header = x.header;
                const line = x.line;

                return `
                    <tr>

                        <td class="fw-semibold">
                            ${escapeHtml(
                                header.quarantineNo ?? "-"
                            )}
                        </td>

                        <td>
                            ${escapeHtml(
                                header.qcNo ?? "-"
                            )}
                        </td>

                        <td>
                            ${escapeHtml(
                                header.incomingNo ?? "-"
                            )}
                        </td>

                        <td>
                            <div class="fw-semibold">
                                ${escapeHtml(
                                    line.materialName ?? ""
                                )}
                            </div>

                            <div class="text-muted small">
                                ${escapeHtml(
                                    line.materialCode ?? ""
                                )}
                            </div>
                        </td>

                        <td>
                            ${escapeHtml(
                                line.lotNo ?? "-"
                            )}
                        </td>

                        <td>
                            ${formatDate(
                                line.manufacturingDate
                            )}
                        </td>

                        <td>
                            ${formatDate(
                                line.expirationDate
                            )}
                        </td>

                        <td class="text-end fw-semibold">
                               ${formatQty(
        line.qaAcceptedQty
    )}
                        </td>

                        <td>
                            ${renderMaterialStatus(
                                line.status ??
                                header.status
                            )}
                        </td>

                            <td>
        ${
               normalizeStatus(header.status) !== "COMPLETED" &&
    [
        "READY_FOR_WEIGHING",
        "WEIGHING_IN_PROGRESS",
        "WEIGHING_COMPLETED",
        "STICKER_COMPLETED",
        "READY_FOR_FINAL_RR"
    ].includes(
        normalizeStatus(
            line.status ?? header.status
        )
    )
                ? `
                    <button type="button"
                            class="btn btn-sm btn-primary"
                            onclick="openMaterialProcessing(
                                ${Number(header.processingId)},
                                ${Number(line.processingLineId)}
                            )">
                        Process
                    </button>
                  `
                : `
                    <span class="text-muted small">
                        ${escapeHtml(line.status ?? header.status ?? "-")}
                    </span>
                  `
        }
    </td>

                    </tr>
                `;
            })
            .join("");
    }


    function renderMaterialStatus(status) {

        const value =
            normalizeStatus(status);

        if (
            value ===
            "WAITING_FOR_QA_RELEASE"
        ) {
            return `
                <span class="badge bg-warning text-dark">
                    ON HOLD (QUARANTINE)
                </span>
            `;
        }

        if (value === "RELEASED") {
            return `
                <span class="badge bg-success">
                    RELEASED TO RMW
                </span>
            `;
        }

        return `
            <span class="badge bg-secondary">
                ${escapeHtml(value || "-")}
            </span>
        `;
    }


    function normalizeStatus(value) {
        return String(value ?? "")
            .trim()
            .toUpperCase();
    }


    function formatQty(value) {

        const number =
            Number(value ?? 0);

        return number.toLocaleString(
            undefined,
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }
        );
    }


    function formatDate(value) {

        if (!value)
            return "-";

        const date =
            new Date(value);

        if (Number.isNaN(date.getTime()))
            return "-";

        return date.toLocaleDateString();
    }


    function escapeHtml(value) {

        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }
</script>