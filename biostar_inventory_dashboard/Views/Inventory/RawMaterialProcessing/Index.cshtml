    const finalReady =
        normalizeStatus(
            currentProcessingHeader?.status
        ) === "READY_FOR_FINAL_RR";

    if (finalReady) {

        setProcessingBadge(
            "READY FOR FINAL RR",
            "bg-primary"
        );

    } else {

        setProcessingBadge(
            "STICKER COMPLETED",
            "bg-primary"
        );
    }

    break;


                case "READY_FOR_FINAL_RR":

    actualInput.value =
        state.actualQty ?? "";

    actualInput.disabled = true;

    btnSticker.disabled = true;

   

    document.getElementById(
        "stickerActualQty"
    ).value =
        state.actualQty != null
            ? formatQty(
                state.actualQty
            )
            : "";

    calculateVariance();

    setProcessingBadge(
        "READY FOR FINAL RR",
        "bg-primary"
    );

    break;


            default:

                actualInput.disabled = true;

                btnStart.classList.remove(
                    "d-none"
                );

                setProcessingBadge(
                    "READY FOR WEIGHING",
                    "bg-info text-dark"
                );

                break;
        }
    }


