    <!-- TRANSACTION TABLE -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <strong>Inventory Transaction History</strong>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive"
                 style="overflow-x:auto;">

                <table class="table table-hover align-middle mb-0"
                       style="min-width:1450px;">

                    <thead class="table-light">
                        <tr>
                            <th style="min-width:230px;">
                                Material / Description
                            </th>

                            <th style="min-width:130px;">
                                Lot No.
                            </th>

                            <th style="min-width:120px;">
                                Date
                            </th>

                            <th style="min-width:110px;">
                                Time
                            </th>

                            <th style="min-width:130px;">
                                Warehouse
                            </th>

                            <th style="min-width:80px;">
                                Type
                            </th>

                            <th class="text-end"
                                style="min-width:100px;">
                                Qty
                            </th>

                            <th style="min-width:80px;">
                                UOM
                            </th>

                            @* <th class="text-end"
                                style="min-width:110px;">
                                Balance
                            </th> *@

                            <th style="min-width:130px;">
                                User
                            </th>

                            <th style="min-width:150px;">
                                Reference
                            </th>

                            <th style="width:140px; min-width:140px; max-width:140px;">
                                Remarks
                            </th>

                            <th style="min-width:90px;">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody id="transactionTableBody">
                        <tr>
                            <td colspan="12"
                                class="text-center text-muted py-4">
                                No inventory transactions loaded yet.
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<style>
    .transaction-remarks {
        width: 140px;
        max-width: 140px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: help;
    }

    #transactionTableBody td {
        vertical-align: middle;
    }
</style>

@section Scripts
{
    <script src="~/js/manufacturing/materials/raw-material-transactions.js?v=1"></script>
}