@{
    ViewData["Title"] = "Inventory List";
}

@section Styles {
    <link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4 page-header-row">
    <div>
        <small class="text-muted">Dashboard &gt; Inventory</small>
        <h2 class="fw-bold mt-2">Inventory List</h2>
    </div>

    <div class="action-buttons">
        <button class="btn btn-outline-secondary" id="btnPrintInventory" type="button">
            Print
        </button>
        <button class="btn btn-outline-primary">Import</button>
        <button class="btn btn-primary" id="btnExportInventory">Export</button>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 filter-card">
    <div class="card-body">
        <div class="row g-2 align-items-end">

            <div class="col-md-3">
                <label class="form-label fw-semibold">Lot No</label>
                <input type="text" class="form-control" id="lotNoFilter" placeholder="Lot no">
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Generic Name</label>
                <input type="text" class="form-control" id="genericNameFilter" placeholder="Generic name">
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Brand Name</label>
                <input type="text" class="form-control" id="brandNameFilter" placeholder="Brand name">
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">From</label>
                <input type="date" class="form-control" id="dateFromFilter">
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">To</label>
                <input type="date" class="form-control" id="dateToFilter">
            </div>

            <div class="col-md-1 d-flex align-items-end">
                <button class="btn btn-primary w-100 mb-1"
                        id="applyFilters"
                        type="button">
                    Go
                </button>
            </div>
        </div>

        <div class="mt-2 d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                Advanced Filters
            </button>
            <button class="btn btn-outline-danger btn-sm" id="clearFilters" type="button">
                Clear
            </button>
        </div>

        <div class="collapse mt-3" id="advancedFilters">
            <div class="row g-2">

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Warehouse</label>
                    <select class="form-select" id="warehouseFilter">
                        <option value="">All Warehouses</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Category</label>
                    <select class="form-select" id="categoryFilter">
                        <option value="">All Categories</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Order</label>
                    <select class="form-select" id="orderFilter">
                        <option value="desc">Descending</option>
                        <option value="asc">Ascending</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Stock Status</label>
                    <select class="form-select" id="stockStatusFilter">
                        <option value="">All</option>
                        <option value="zero">Out of Stock</option>
                        <option value="low">Low Stock</option>
                        <option value="normal">Normal</option>
                        <option value="over">Over Stock</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Expiry Status</label>
                    <select class="form-select" id="expiryStatusFilter">
                        <option value="">All</option>
                        <option value="available" selected>Available / Not Expired</option>
                        <option value="expired">Expired</option>
                        <option value="near">Expiring Soon</option>
                        <option value="safe">Safe</option>
                        <option value="noexp">No Expiry Date</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Months Left</label>
                    <select class="form-select" id="monthsFilter">
                        <option value="">All</option>
                        <option value="1">Less than / up to 1 month</option>
                        <option value="3">Up to 3 months</option>
                        <option value="6">Up to 6 months</option>
                        <option value="12">Up to 12 months</option>
                        <option value="over12">More than 12 months</option>
                    </select>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="pagination-container d-flex justify-content-end align-items-center gap-2 mb-3">
            <span id="rangeText">0–0 of 0</span>
            <button id="prevBtn" class="btn btn-sm btn-light" type="button">◀</button>
            <button id="nextBtn" class="btn btn-sm btn-light" type="button">▶</button>
        </div>
        <div class="table-scroll-top">
            <div></div>
        </div>

        <div class="table-scroll-box inventory-table-wrapper">
       
                <table class="table inventory-table align-middle">
                    <thead>
                        <tr>
                            <th>Product / Description</th>
                            <th>Category</th>
                            <th>Qty Available</th>
                            <th>Pack</th>
                            <th>Stock Level</th>
                            <th>Lot No</th>
                            <th>MFG. & EXP. Date</th>
                            <th>EXPIRES IN</th>
                            <th>Warehouse</th>
                            <th class="text-center action-col">Action</th>
                        </tr>
                    </thead>
                    <tbody id="inventoryTable">
                        <tr>
                            <td colspan="8" class="empty-state-cell">Loading inventory data...</td>
                        </tr>
                    </tbody>
                </table>
           
        </div>
    </div>
</div>

<div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-0">Transfer Stock</h5>
                    <small class="text-muted">Move available stock to another warehouse.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="transferProduct">
                <input type="hidden" id="transferLot">
                <input type="hidden" id="transferFromBranch">

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">From Warehouse</label>
                        <div id="transferFromBranchLabel" class="form-control bg-light"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Available Qty</label>
                        <div id="transferAvailableQty" class="form-control bg-light fw-semibold"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Transfer Qty</label>
                    <input type="number" id="transferQty" class="form-control" min="0" step="0.01" placeholder="Enter quantity">
                </div>

                <div class="mb-3">
                    <label class="form-label">Destination Warehouse</label>
                    <select id="transferBranch" class="form-select">
                        <option value="">Select destination warehouse</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnConfirmTransfer">Confirm Transfer</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="adjustModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Adjust Inventory</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="adjustProduct">
                <input type="hidden" id="adjustLot">
                <input type="hidden" id="adjustBranch">

                <div class="mb-2">
                    <label class="form-label">Current Qty</label>
                    <div id="adjustCurrentQty" class="form-control bg-light"></div>
                </div>

                <div class="mb-2">
                    <label class="form-label">Adjustment Type</label>
                    <select id="adjustType" class="form-control">
                        <option value="ADD">Add</option>
                        <option value="DEDUCT">Deduct</option>
                        <option value="SET">Set Exact Qty</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label">Quantity</label>
                    <input type="number" id="adjustQty" class="form-control" min="0" step="0.01">
                </div>

                <div class="mb-2">
                    <label class="form-label">Remarks</label>
                    <input type="text" id="adjustRemarks" class="form-control" placeholder="Reason for adjustment">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-warning" onclick="saveAdjust()">Save Adjustment</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Inventory History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 150px;">Date & Time</th>
                                <th style="width: 80px;">Type</th>
                                <th style="width: 130px;">Qty</th>
                                <th style="width: 170px;">Reference</th>
                                <th style="width: 130px;">Warehouse</th>
                                <th>Remarks</th>
                                <th style="width: 120px;">User</th>
                            </tr>
                        </thead>
                        <tbody id="historyTable">
                            <tr>
                                <td colspan="7" class="text-center text-muted">No history loaded.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="reservedDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-0">Reserved Stock Details</h5>
                    <small class="text-muted" id="reservedModalSubTitle"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="reserved-summary-card">
                            <div class="reserved-label">On-Hand</div>
                            <div class="reserved-value" id="reservedOnHand">0</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="reserved-summary-card">
                            <div class="reserved-label">Reserved</div>
                            <div class="reserved-value text-warning" id="reservedQty">0</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="reserved-summary-card">
                            <div class="reserved-label">Available</div>
                            <div class="reserved-value text-success" id="reservedAvailable">0</div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Order No</th>
                                <th>Customer</th>
                                <th class="text-end">Reserved Qty</th>
                            </tr>
                        </thead>
                        <tbody id="reservedDetailsTable">
                            <tr>
                                <td colspan="3" class="text-center text-muted">
                                    No reserved stock for this lot.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="editLotModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Edit Lot Number</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="editLotProductId">
                <input type="hidden" id="editLotBranchId">
                <input type="hidden" id="editLotOldNo">

                <label class="form-label">Current Lot No</label>
                <input type="text" id="editLotCurrentDisplay" class="form-control mb-3" readonly>

                <label class="form-label">New Lot No</label>
                <input type="text" id="editLotNewNo" class="form-control" placeholder="Enter new lot no">
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveLotNo">Save</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="stockOutModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Manual Stock Out</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="stockOutProduct">
                <input type="hidden" id="stockOutLot">
                <input type="hidden" id="stockOutBranch">

                <div class="mb-2">
                    <label class="form-label">Available Qty</label>
                    <div id="stockOutAvailableQty" class="form-control bg-light"></div>
                </div>

                <div class="mb-2">
                    <label class="form-label">Quantity Out</label>
                    <input type="number" id="stockOutQty" class="form-control" min="0" step="0.01">
                </div>

                <div class="mb-2">
                    <label class="form-label">DR #</label>
                    <input type="text" id="stockOutDrNo" class="form-control">
                </div>

                <div class="mb-2">
                    <label class="form-label">INV #</label>
                    <input type="text" id="stockOutInvNo" class="form-control">
                </div>

                <div class="mb-2">
                    <label class="form-label">PO #</label>
                    <input type="text" id="stockOutPoNo" class="form-control">
                </div>

                <div class="mb-2">
                    <label class="form-label">Remarks</label>
                    <input type="text" id="stockOutRemarks" class="form-control" placeholder="Delivered to / reason">
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnSaveStockOut">Save Stock Out</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="productLotsModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-0">Product Lots</h5>
                    <small class="text-muted" id="productLotsSubTitle"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="productLotsLocationSummary" class="mb-3"></div>
                <table class="table table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Lot No</th>
                            <th>Category</th>
                            <th>Warehouse</th>
                            <th>Available Qty</th>
                            <th>Pack Qty</th>
                            <th>MFG Date</th>
                            <th>EXP Date</th>
                            <th>Stock Level</th>
                        </tr>
                    </thead>
                    <tbody id="productLotsTable"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editDateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Edit MFG / EXP Date</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="editDateProductId">
                <input type="hidden" id="editDateBranchId">
                <input type="hidden" id="editDateLotNo">

                <div class="mb-3">
                    <label class="form-label">Lot No</label>
                    <input type="text" id="editDateLotDisplay" class="form-control bg-light" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label">Manufacturing Date</label>
                    <input type="month" id="editMfgDate" class="form-control">
                </div>

                <div class="mb-3">
                    <label class="form-label">Expiration Date</label>
                    <input type="month" id="editExpDate" class="form-control">
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveDates">Save Dates</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <div id="inventoryActionMenu"
         class="position-fixed bg-white border rounded shadow d-none"
         style="width:180px; z-index:99999;">

        <button type="button" id="menuTransfer" class="dropdown-item">
            Transfer
        </button>

        <button type="button" id="menuStockOut" class="dropdown-item text-danger">
            Stock Out
        </button>

        <button type="button" id="menuAdjust" class="dropdown-item">
            Adjust
        </button>

        <button type="button" id="menuHistory" class="dropdown-item">
            History
        </button>

    </div>



    <script>
        window.currentUserRole = "@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value";
    </script>

    

    <script src="~/js/inventory.js" asp-append-version="true"></script>
}